{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade9v3:explorer-spec:1.0",
  "title": "Grade9V3 explorer spec",
  "description": "What an author writes to make a guided explorer of one hard concept: the numbers as expressions, the picture as elements of a closed vocabulary, the route's content stage by stage. The page itself (layout, gating, behaviour) is generated by Shared/tools/explorer_build.py from the blueprint BP-EXPLORER-GCDR; nothing here is code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "title",
    "product",
    "blueprint_ref",
    "target",
    "context",
    "parameters",
    "quantities",
    "scene",
    "second_view",
    "predict",
    "manipulate",
    "observe",
    "contradict",
    "deconstruct",
    "reconstruct",
    "invariants",
    "oracles",
    "boundary",
    "fade",
    "transfer"
  ],
  "properties": {
    "schema": {
      "const": "grade9v3-explorer-spec-v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "product": {
      "type": "string",
      "pattern": "^TEST/[A-Za-z0-9_./-]+\\.manifest\\.json$",
      "description": "The product manifest the toughest concept is derived from."
    },
    "blueprint_ref": {
      "type": "string",
      "pattern": "^BP-[A-Z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_ref",
        "quantity",
        "failure",
        "operation",
        "invariant",
        "boundary"
      ],
      "properties": {
        "question_ref": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/name"
        },
        "failure": {
          "$ref": "#/$defs/text"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "invariant": {
          "$ref": "#/$defs/text"
        },
        "boundary": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation"
      ],
      "properties": {
        "situation": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/quantity"
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "job",
        "description",
        "world",
        "elements"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "job": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/range"
            },
            "y": {
              "$ref": "#/$defs/range"
            }
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "second_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "job",
        "description",
        "x",
        "series"
      ],
      "properties": {
        "kind": {
          "const": "graph"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "job": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "x": {
          "$ref": "#/$defs/name"
        },
        "y_label": {
          "type": "string",
          "maxLength": 60
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "label"
            ],
            "properties": {
              "quantity": {
                "$ref": "#/$defs/name"
              },
              "label": {
                "$ref": "#/$defs/short"
              },
              "role": {
                "$ref": "#/$defs/role"
              }
            }
          }
        },
        "guides": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expr",
              "label"
            ],
            "properties": {
              "expr": {
                "$ref": "#/$defs/expr"
              },
              "label": {
                "$ref": "#/$defs/short"
              },
              "orient": {
                "enum": [
                  "h",
                  "v"
                ]
              }
            }
          }
        },
        "ghost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "label"
          ],
          "properties": {
            "quantity": {
              "$ref": "#/$defs/name"
            },
            "label": {
              "$ref": "#/$defs/short"
            }
          }
        }
      }
    },
    "predict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "options",
        "correct"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/claimOption"
          }
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "manipulate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statements"
      ],
      "properties": {
        "statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "claim",
              "truth",
              "why"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "claim": {
                "$ref": "#/$defs/expr"
              },
              "truth": {
                "enum": [
                  "always",
                  "never",
                  "sometimes"
                ]
              },
              "why": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "contradict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrong_model",
        "imposes",
        "goal",
        "why_correct",
        "why_wrong"
      ],
      "properties": {
        "wrong_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "quantity"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/short"
            },
            "quantity": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "imposes": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/goal"
        },
        "why_correct": {
          "$ref": "#/$defs/text"
        },
        "why_wrong": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deconstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "reveals"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "reveals": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "#/$defs/elementId"
                }
              },
              "ask": {
                "$ref": "#/$defs/ask"
              }
            }
          }
        }
      }
    },
    "reconstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "equation"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "quantity"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "quantity": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        "equation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "expr"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "expr": {
              "$ref": "#/$defs/expr"
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "lhs",
          "rel",
          "rhs",
          "try"
        ],
        "properties": {
          "text": {
            "$ref": "#/$defs/text"
          },
          "lhs": {
            "$ref": "#/$defs/expr"
          },
          "rel": {
            "enum": [
              "==",
              "<=",
              ">="
            ]
          },
          "rhs": {
            "$ref": "#/$defs/expr"
          },
          "try": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "left",
          "right"
        ],
        "properties": {
          "text": {
            "$ref": "#/$defs/text"
          },
          "left": {
            "$ref": "#/$defs/expr"
          },
          "right": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption",
        "learner_must_identify",
        "cases"
      ],
      "properties": {
        "assumption": {
          "$ref": "#/$defs/text"
        },
        "learner_must_identify": {
          "$ref": "#/$defs/text"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "set",
              "shortcut_label",
              "shortcut",
              "expect"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "set": {
                "$ref": "#/$defs/setMap"
              },
              "shortcut_label": {
                "$ref": "#/$defs/short"
              },
              "shortcut": {
                "$ref": "#/$defs/expr"
              },
              "expect": {
                "enum": [
                  "holds",
                  "fails"
                ]
              }
            }
          }
        }
      }
    },
    "fade": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "transfer": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "expr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$"
    },
    "elementId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,23}$"
    },
    "role": {
      "enum": [
        "object",
        "given",
        "result",
        "wrong",
        "helper",
        "frame"
      ]
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "setMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/expr"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "label": {
          "$ref": "#/$defs/short"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value": {
          "type": "number"
        },
        "fixed": {
          "type": "boolean"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "expr"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "label": {
          "$ref": "#/$defs/short"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "show": {
          "type": "boolean"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "kind": {
          "enum": [
            "point",
            "segment",
            "arrow",
            "circle",
            "arc",
            "polygon",
            "curve",
            "text"
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "label": {
          "$ref": "#/$defs/short"
        },
        "reveal": {
          "enum": [
            "start",
            "manipulate",
            "contradict",
            "deconstruct"
          ]
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "r": {
          "$ref": "#/$defs/expr"
        },
        "from_deg": {
          "$ref": "#/$defs/expr"
        },
        "to_deg": {
          "$ref": "#/$defs/expr"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "param": {
          "$ref": "#/$defs/name"
        },
        "steps": {
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "x": {
          "$ref": "#/$defs/expr"
        },
        "y": {
          "$ref": "#/$defs/expr"
        },
        "text": {
          "$ref": "#/$defs/short"
        },
        "anchor": {
          "enum": [
            "start",
            "middle",
            "end"
          ]
        },
        "t_min": {
          "$ref": "#/$defs/expr"
        },
        "t_max": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "claimOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "tests"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "set",
              "holds"
            ],
            "properties": {
              "set": {
                "$ref": "#/$defs/setMap"
              },
              "holds": {
                "$ref": "#/$defs/expr"
              },
              "says": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "goal",
        "hint"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/expr"
        },
        "hint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "options",
        "correct",
        "why"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/short"
          }
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "why": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "set",
        "answer",
        "tolerance",
        "why"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "set": {
          "$ref": "#/$defs/setMap"
        },
        "answer": {
          "$ref": "#/$defs/expr"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "worked": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
