{
  "schema_version": "1.0",
  "registry_version": "1.3.0",
  "shell": {
    "id": "G9-TABLET-SHELL-V1",
    "fixed_header": true,
    "controls": [
      "BACK",
      "HOME",
      "SUBJECT_CONTEXT",
      "QUESTION_BANK",
      "SEARCH",
      "REFRESH",
      "DISPLAY",
      "OVERFLOW"
    ],
    "responsive_modes": [
      "COMPACT",
      "MEDIUM",
      "EXPANDED"
    ],
    "typography_policy": {
      "base_text_css_px": 17,
      "minimum_learner_text_css_px": 14,
      "exception_policy": "EXPLICIT_NON_LEARNER_METADATA_ONLY"
    },
    "math_policy": {
      "static_relation_format": "RESTRICTED_PRESENTATION_MATHML",
      "dynamic_question_format": "TYPED_TEX_SEGMENTS",
      "dynamic_renderer": "LOCAL_KATEX",
      "runtime_text_inference": "FORBIDDEN"
    },
    "representation_accessibility_policy": {
      "instructional_visual_requires_accessible_name": true,
      "instructional_visual_requires_description": true,
      "color_only_meaning": "FORBIDDEN"
    },
    "data_representation_policy": {
      "comparative_relations": "TABLE_OR_MATRIX_ALLOWED",
      "independent_facts": "CARDS_OR_TILES_ALLOWED",
      "tag_count_as_quality_metric": "FORBIDDEN"
    },
    "vendor_policy": {
      "pages_external_runtime": "FORBIDDEN",
      "publication_rewrite": "BUILD_PIPELINE",
      "unknown_runtime_dependency": "FAIL_CLOSED"
    },
    "version": "1.1.0"
  },
  "component_policy": {
    "levels": {
      "REQUIRED": "The page is a gap while the component is absent or has fewer than min_items: the renderer records a typed gap that names the record to author, and the rendered-page gate fails the product.",
      "EXPECTED": "A learner should see it. Its absence is an advisory that names the record field to author, never a silent omission, and never a reason to invent content.",
      "OPTIONAL": "Shown when the record has it."
    },
    "column": {
      "FULL": "A band across the whole page width.",
      "PRIMARY": "The main column of the expanded two-column layout; in the compact flow it comes first.",
      "SUPPORT": "The support column of the expanded layout; it follows the primary column in the compact flow."
    },
    "waivers": "NONE: a page never waives a component. A product that cannot supply a REQUIRED component stays a draft with its gap.",
    "depth": "min_items is the floor below which a component does not count as present. target_items is the depth of the reference page: between the floor and the target the renderer says so as an advisory, and new authoring (a scaffolded owner bank) is held to the target."
  },
