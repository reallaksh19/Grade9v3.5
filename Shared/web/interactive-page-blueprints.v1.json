      "components": [
        {
          "id": "IDENTITY",
          "slot": "identity",
          "level": "REQUIRED",
          "presentation": "HEADER",
          "purpose": "Say whose question this is and what kind of question it is before anything else.",
          "benchmark": "selected_question_bank_TABLET_STUDY: question id, source line and badges in the header band",
          "source": [
            "id",
            "original_identifier",
            "extensions.grade9v3:source_custody"
          ],
          "authoring": {
            "hint": "Identity comes from the question's custody. An owner-supplied question shows 'Owner-supplied question' and carries no exam, year or paper."
          }
        },
        {
          "id": "DIFFICULTY_WHY",
          "slot": "identity",
          "level": "EXPECTED",
          "presentation": "DISCLOSURE_GRID",
          "purpose": "Show the difficulty band and the five reasons behind it, folded away until asked.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the D-pill and the 'Why this difficulty?' grid",
          "source": [
            "extensions.grade9v3:analysis.difficulty"
          ],
          "authoring": {
            "hint": "Fill extensions['grade9v3:analysis'].difficulty: five components (each 0 to 2), score (their sum), band for that score, basis (one sentence). It is your estimate and is shown as one."
          }
        },
        {
          "id": "STEM",
          "slot": "attempt",
          "level": "REQUIRED",
          "presentation": "STEM",
          "purpose": "The question exactly as set, under the label 'Attempt first'.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the left column's eyebrow and stem",
          "source": [
            "stem"
          ]
        },
        {
          "id": "CONDITIONS",
          "slot": "attempt",
          "level": "EXPECTED",
          "presentation": "CALLOUT_INFO",
          "purpose": "The givens and assumptions the question states, apart from the question itself.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the 'Conditions.' callout under the options",
          "source": [
            "conditions"
          ],
          "authoring": {
            "hint": "List each stated condition (a constraint or assumption the question gives) as one entry of conditions[]. Never list a method or a result there.",
            "skeleton": {
              "conditions": []
            }
          }
        },
        {
          "id": "TRAP",
          "slot": "attempt",
          "level": "EXPECTED",
          "presentation": "CALLOUT_WARN",
          "purpose": "Name the tempting wrong route so the learner can watch for it.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the 'Common wrong route.' box",
          "source": [
            "extensions.grade9v3:analysis.common_wrong_route"
          ],
          "authoring": {
            "hint": "One sentence naming the wrong route learners take and why it tempts. It must not give the answer or the right route.",
            "skeleton": {
              "extensions": {
                "grade9v3:analysis": {
                  "common_wrong_route": ""
                }
              }
            }
          }
        },
        {
          "id": "ATTEMPT",
          "slot": "attempt",
          "level": "REQUIRED",
          "presentation": "ATTEMPT",
          "purpose": "Ask for a typed commitment before any answer or working opens.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the options cards; the commit step is this app's own attempt-first rule",
          "source": [
            "response",
            "options"
          ]
        },
        {
          "id": "REPRESENTATION",
          "slot": "representation",
          "level": "EXPECTED",
          "presentation": "VISUAL_CARD",
          "purpose": "Show the situation as a picture drawn only from what the question states.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the 'Representation' card with the question-aligned schematic",
          "source": [
            "figure_refs"
          ],
          "min_items": 1,
          "authoring": {
            "hint": "Add a representation to the package with an authored SVG (role=img, aria-labelledby or aria-label, <title> and <desc>) drawn only from the question's own data, then name its id in figure_refs. If the question is not about a picture, leave figure_refs empty and say so; never invent one.",
            "skeleton": {
              "figure_refs": []
            }
          }
        },
        {
          "id": "HINT_LADDER",
          "slot": "support",
          "level": "REQUIRED",
          "presentation": "LADDER",
          "purpose": "Let the learner ask for help one rung at a time; every rung says what it gives away and who wrote it.",
          "benchmark": "selected_question_bank_TABLET_STUDY: 'Hint ladder · reveal only what you need', H0 to H4 with SOURCE and EXPANSION pills",
          "source": [
            "scaffolds",
            "hints",
            "hint_ladder"
          ],
          "min_items": 2,
          "authoring": {
            "hint": "Write 3 or more scaffolds[], one per move of answer.reasoning_route, in the order a learner meets them. Each has text (the hint), prompt (a question that makes the learner do the step), support_kind (REPRESENT, CONNECT or EXECUTE), reveals (CONCEPT or METHOD; ANSWER is held back until the solution), learner_stage (KEY_CONCEPT, REPRESENTATION, FIRST_MOVE or OTHER) and supports_move_ref (the id of the move it prepares). A rung must teach something specific to this question and must not repeat another rung or state the answer.",
            "skeleton": {
              "scaffolds": [
                {
                  "text": "",
                  "prompt": "",
                  "support_kind": "CONNECT",
                  "reveals": "CONCEPT",
                  "learner_stage": "KEY_CONCEPT",
                  "supports_move_ref": "{qid}-MOVE-1"
                },
                {
                  "text": "",
                  "prompt": "",
                  "support_kind": "REPRESENT",
                  "reveals": "METHOD",
                  "learner_stage": "REPRESENTATION",
                  "supports_move_ref": "{qid}-MOVE-2"
                },
                {
                  "text": "",
                  "prompt": "",
                  "support_kind": "EXECUTE",
                  "reveals": "METHOD",
                  "learner_stage": "FIRST_MOVE",
                  "supports_move_ref": "{qid}-MOVE-3"
                }
              ]
            }
          },
          "target_items": 3
        },
        {
          "id": "CONCEPT_NAV",
          "slot": "support",
          "level": "OPTIONAL",
          "presentation": "LINK_LIST",
          "purpose": "Send the learner back to the concept page for the idea the question uses.",
          "benchmark": "selected_question_bank_TABLET_STUDY: concept links beside the hints (the Core1A cross-link)",
          "source": [
            "primary_capability_ref",
            "secondary_capability_refs"
          ]
        },
        {
          "id": "SOLUTION",
          "slot": "solution",
          "level": "REQUIRED",
          "presentation": "DISCLOSURE",
          "purpose": "Open the full working only after an attempt.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the 'Teacher solution · complete derivation' disclosure",
          "source": [
            "answer"
          ]
        },
        {
          "id": "SOLUTION_STEPS",
          "slot": "solution",
          "level": "REQUIRED",
          "presentation": "STEP_LIST",
          "purpose": "Show the working as numbered moves: what is done, why it is valid, what it gives.",
          "benchmark": "selected_question_bank_TABLET_STUDY: numbered steps with a bold lead and the reason",
          "parent": "SOLUTION",
          "source": [
            "answer.reasoning_route",
            "answer.crux_move_ref"
          ],
          "min_items": 2,
          "authoring": {
            "hint": "Write answer.reasoning_route[] with 3 or more moves. Each move has id, kind (DECIDE, REPRESENT, CONNECT, TRANSFORM or VERIFY), action (what is done), why_valid (the physical or logical reason this step is allowed; not 'this follows from the model'), inputs and output. Set crux_move_ref to the id of the move a learner is most likely to miss.",
            "skeleton": {
              "answer": {
                "reasoning_route": [
                  {
                    "id": "{qid}-MOVE-1",
                    "kind": "DECIDE",
                    "action": "",
                    "why_valid": "",
                    "inputs": [],
                    "output": ""
                  },
                  {
                    "id": "{qid}-MOVE-2",
                    "kind": "REPRESENT",
                    "action": "",
                    "why_valid": "",
                    "inputs": [],
                    "output": ""
                  },
                  {
                    "id": "{qid}-MOVE-3",
                    "kind": "TRANSFORM",
                    "action": "",
                    "why_valid": "",
                    "inputs": [],
                    "output": ""
                  }
                ],
                "crux_move_ref": ""
              }
            }
          },
          "target_items": 3
        },
        {
          "id": "ANSWER",
          "slot": "solution",
          "level": "REQUIRED",
          "presentation": "ANSWER_BOX",
          "purpose": "State the final answer in one place.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the green answer box",
          "parent": "SOLUTION",
          "source": [
            "answer.summary"
          ]
        },
        {
          "id": "CHECK",
          "slot": "solution",
          "level": "EXPECTED",
          "presentation": "CHECK_BOX",
          "purpose": "Test the answer by a route the working did not use.",
          "benchmark": "selected_question_bank_TABLET_STUDY: the 'Check.' line under the answer",
          "parent": "SOLUTION",
          "source": [
            "answer.check"
          ],
          "authoring": {
            "hint": "One sentence that tests the result independently: a limiting case, a unit check or a special value.",
            "skeleton": {
              "answer": {
                "check": ""
              }
            }
          }
        }
      ]
    },
