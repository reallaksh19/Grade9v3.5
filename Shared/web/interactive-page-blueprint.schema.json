{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade9v3:interactive-page-blueprints:1.0",
  "title": "Grade9V3 Interactive Page Blueprint Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "shell",
    "component_policy",
    "blueprints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "shell": {
      "$ref": "#/$defs/shell"
    },
    "blueprints": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/blueprint"
      }
    },
    "component_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "column",
        "waivers",
        "depth",
        "held_to",
        "coverage",
        "promotion",
        "typeset",
        "admission",
        "evidence"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "REQUIRED",
            "EXPECTED",
            "OPTIONAL"
          ],
          "properties": {
            "REQUIRED": {
              "type": "string",
              "minLength": 1
            },
            "EXPECTED": {
              "type": "string",
              "minLength": 1
            },
            "OPTIONAL": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "column": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "FULL",
            "PRIMARY",
            "SUPPORT"
          ],
          "properties": {
            "FULL": {
              "type": "string",
              "minLength": 1
            },
            "PRIMARY": {
              "type": "string",
              "minLength": 1
            },
            "SUPPORT": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "waivers": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        },
        "held_to": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "denominator",
            "rule",
            "held_to",
            "component",
            "duty",
            "sources"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "denominator": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "held_to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "FLOOR",
                "REFERENCE"
              ],
              "properties": {
                "FLOOR": {
                  "enum": [
                    "ADVISORY",
                    "GAP"
                  ]
                },
                "REFERENCE": {
                  "enum": [
                    "ADVISORY",
                    "GAP"
                  ]
                }
              }
            },
            "component": {
              "const": "COVERAGE"
            },
            "duty": {
              "const": "AUTHOR_COVERAGE"
            },
            "sources": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "selectable_statuses",
            "refused_statuses",
            "applies_to",
            "refusal",
            "note"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "selectable_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "refused_statuses": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "microtopics",
                  "core2",
                  "core2a",
                  "core2b"
                ]
              }
            },
            "refusal": {
              "type": "string",
              "pattern": "^PRODUCT_[A-Z_]+$"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "typeset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "rule",
            "held_to",
            "component",
            "duty"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "held_to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "FLOOR",
                "REFERENCE"
              ],
              "properties": {
                "FLOOR": {
                  "enum": [
                    "ADVISORY",
                    "GAP"
                  ]
                },
                "REFERENCE": {
                  "enum": [
                    "ADVISORY",
                    "GAP"
                  ]
                }
              }
            },
            "component": {
              "const": "TYPESET"
            },
            "duty": {
              "const": "AUTHOR_TYPESET"
            }
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "authority",
            "points",
            "note"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "points": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "statement",
                  "severity"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^(QUESTION|ANSWER)_[A-Z_]+$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 10
                  },
                  "severity": {
                    "enum": [
                      "BLOCK",
                      "ADVISE"
                    ]
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "line_endings",
            "attributes_file",
            "note"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "line_endings": {
              "const": "LF"
            },
            "attributes_file": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "CORE1",
        "CORE2",
        "CORE1A",
        "CORE1B",
        "CORE2A",
        "CORE2B",
        "EXPLORER"
      ]
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixed_header",
        "controls",
        "responsive_modes",
        "standalone_policy"
      ],
      "properties": {
        "id": {
          "const": "G9-TABLET-SHELL-V1"
        },
        "fixed_header": {
          "const": true
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "BACK",
              "HOME",
              "SUBJECT_CONTEXT",
              "QUESTION_BANK",
              "PRINT_PDF",
              "SEARCH",
              "REFRESH",
              "DISPLAY",
              "OVERFLOW"
            ]
          },
          "uniqueItems": true
        },
        "responsive_modes": {
          "type": "array",
          "items": {
            "enum": [
              "COMPACT",
              "MEDIUM",
              "EXPANDED"
            ]
          },
          "uniqueItems": true,
          "minItems": 3
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "typography_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_text_css_px",
            "minimum_learner_text_css_px",
            "exception_policy"
          ],
          "properties": {
            "base_text_css_px": {
              "type": "integer",
              "minimum": 12
            },
            "minimum_learner_text_css_px": {
              "type": "integer",
              "minimum": 12
            },
            "exception_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "math_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "static_relation_format",
            "dynamic_question_format",
            "dynamic_renderer",
            "runtime_text_inference"
          ],
          "properties": {
            "static_relation_format": {
              "type": "string",
              "minLength": 1
            },
            "dynamic_question_format": {
              "type": "string",
              "minLength": 1
            },
            "dynamic_renderer": {
              "type": "string",
              "minLength": 1
            },
            "runtime_text_inference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "representation_accessibility_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instructional_visual_requires_accessible_name",
            "instructional_visual_requires_description",
            "color_only_meaning"
          ],
          "properties": {
            "instructional_visual_requires_accessible_name": {
              "type": "boolean"
            },
            "instructional_visual_requires_description": {
              "type": "boolean"
            },
            "color_only_meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data_representation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparative_relations",
            "independent_facts",
            "tag_count_as_quality_metric"
          ],
          "properties": {
            "comparative_relations": {
              "type": "string",
              "minLength": 1
            },
            "independent_facts": {
              "type": "string",
              "minLength": 1
            },
            "tag_count_as_quality_metric": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "vendor_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pages_external_runtime",
            "publication_rewrite",
            "unknown_runtime_dependency"
          ],
          "properties": {
            "pages_external_runtime": {
              "type": "string",
              "minLength": 1
            },
            "publication_rewrite": {
              "type": "string",
              "minLength": 1
            },
            "unknown_runtime_dependency": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "print_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "applies_to_roles",
            "icon",
            "accessible_name",
            "target",
            "target_pattern",
            "never_linked",
            "opens",
            "target_css_px_min",
            "in_print",
            "single_file_mode"
          ],
          "properties": {
            "control": {
              "const": "PRINT_PDF"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "applies_to_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "CORE1",
                  "CORE1A",
                  "CORE1B",
                  "CORE2",
                  "CORE2A",
                  "CORE2B"
                ]
              }
            },
            "icon": {
              "const": "PDF"
            },
            "accessible_name": {
              "type": "string",
              "minLength": 10
            },
            "target": {
              "const": "GENERATED_LEARNER_PDF"
            },
            "target_pattern": {
              "type": "string",
              "pattern": "^\\{page_stem\\}\\.pdf$"
            },
            "never_linked": {
              "type": "array",
              "minItems": 1,
              "items": {
                "const": "KEY_PDF"
              }
            },
            "opens": {
              "enum": [
                "NEW_TAB",
                "SAME_TAB"
              ]
            },
            "target_css_px_min": {
              "type": "integer",
              "minimum": 44
            },
            "in_print": {
              "const": "HIDDEN"
            },
            "single_file_mode": {
              "enum": [
                "NO_CONTROL"
              ]
            },
            "link_must_resolve": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "standalone_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "applies_to",
            "governed_roots",
            "unknown_page",
            "zoom_max_scale_min",
            "rules",
            "checker",
            "ledger",
            "ledger_rule",
            "browser_audit"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "applies_to": {
              "const": "LEARNER_HTML_OUTSIDE_THE_RENDERER"
            },
            "governed_roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unknown_page": {
              "const": "FAIL_CLOSED"
            },
            "zoom_max_scale_min": {
              "type": "number",
              "minimum": 2
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "severity",
                  "executes",
                  "statement"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z_]+$"
                  },
                  "severity": {
                    "enum": [
                      "BLOCK",
                      "ADVISE"
                    ]
                  },
                  "executes": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            },
            "checker": {
              "type": "string",
              "minLength": 1
            },
            "ledger": {
              "type": "string",
              "minLength": 1
            },
            "ledger_rule": {
              "type": "string",
              "minLength": 10
            },
            "browser_audit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool",
                "profile",
                "measures",
                "note"
              ],
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                },
                "measures": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accepts_blocks",
        "required",
        "column"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "accepts_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        },
        "column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "core_roles",
        "learner_job",
        "shell_ref",
        "layout_family",
        "slots",
        "interaction_policy",
        "representation_policy",
        "responsive_policy",
        "touch_policy",
        "packaging_modes",
        "forbidden"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BP-[A-Z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "DEPRECATED"
          ]
        },
        "core_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "learner_job": {
          "type": "string",
          "minLength": 1
        },
        "shell_ref": {
          "const": "G9-TABLET-SHELL-V1"
        },
        "layout_family": {
          "enum": [
            "READING_ORIENTATION",
            "READING_CONSTRUCTION",
            "GUIDED_RECONSTRUCTION",
            "QUESTION_READER",
            "QUESTION_STUDY",
            "TRANSFER_ATTEMPT",
            "STAGE_SUPPORT",
            "LIST_DETAIL",
            "FULL_LAB"
          ]
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "interaction_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_before_reveal",
            "progressive_support",
            "solution_policy"
          ],
          "properties": {
            "attempt_before_reveal": {
              "enum": [
                "FROM_PROJECTION",
                "ALWAYS",
                "NEVER"
              ]
            },
            "progressive_support": {
              "type": "boolean"
            },
            "solution_policy": {
              "enum": [
                "FROM_PROJECTION",
                "LEARNER_OPENABLE",
                "POST_ATTEMPT",
                "NOT_APPLICABLE"
              ]
            }
          }
        },
        "representation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preferred_mount_modes",
            "legacy_iframe"
          ],
          "properties": {
            "preferred_mount_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "PORTABLE_SCENE",
                  "COMPONENT",
                  "STATIC_FIGURE"
                ]
              }
            },
            "legacy_iframe": {
              "const": "MIGRATION_ONLY"
            }
          }
        },
        "responsive_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compact",
            "medium",
            "expanded",
            "primary_fraction",
            "support_fraction"
          ],
          "properties": {
            "compact": {
              "enum": [
                "SINGLE_PANE"
              ]
            },
            "medium": {
              "enum": [
                "SINGLE_PANE",
                "STACKED_SUPPORT"
              ]
            },
            "expanded": {
              "enum": [
                "SINGLE_PANE",
                "STAGE_SUPPORT",
                "LIST_DETAIL"
              ]
            },
            "primary_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "support_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "expanded_min_px": {
              "type": "integer",
              "minimum": 600,
              "maximum": 1600,
              "description": "Viewport width from which the expanded layout applies."
            },
            "support_sticky": {
              "type": "boolean",
              "description": "Whether the support column stays in view while the primary column scrolls."
            },
            "tablet_12_7": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference_viewport",
                "identity_max_px",
                "figure_min_text_css_px"
              ],
              "description": "The 12.7-inch tablet as the design target: the viewport the layout is judged at and what must hold there. The portrait viewport is the same size turned.",
              "properties": {
                "reference_viewport": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 800
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 600
                    }
                  },
                  "description": "Landscape CSS pixels of the reference tablet (1366 x 854)."
                },
                "identity_max_px": {
                  "type": "integer",
                  "minimum": 60,
                  "description": "The tallest the identity block (title, provenance, metadata, difficulty) may be at the reference viewport, so the first screen shows the work and not the labels."
                },
                "figure_min_text_css_px": {
                  "type": "integer",
                  "minimum": 12,
                  "description": "The smallest rendered height of a figure label at the reference viewport; an authored figure whose labels would render smaller is a gap for new authoring."
                },
                "support_scrolls_inside": {
                  "type": "boolean",
                  "description": "With support_sticky: a support column taller than the screen scrolls inside itself, so none of it is out of reach while it is pinned."
                }
              }
            }
          }
        },
        "touch_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_target_css_px",
            "minimum_control_gap_css_px"
          ],
          "properties": {
            "minimum_target_css_px": {
              "type": "integer",
              "minimum": 48
            },
            "minimum_control_gap_css_px": {
              "type": "integer",
              "minimum": 8
            }
          }
        },
        "packaging_modes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PUBLIC",
              "PAGES",
              "OFFLINE_DIRECTORY",
              "SINGLE_FILE",
              "EMBED"
            ]
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "presentation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_theme"
          ],
          "properties": {
            "default_theme": {
              "enum": [
                "light",
                "dark"
              ],
              "description": "The theme the page opens in; the learner can change it."
            }
          }
        },
        "route": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": "For a guided route (an explorer): the components that are the learner's steps, in the order the learner meets them. The page walks them one at a time, each only after the one before is done."
        }
      }
    },
    "column": {
      "enum": [
        "FULL",
        "PRIMARY",
        "SUPPORT"
      ]
    },
    "presentation": {
      "enum": [
        "HEADER",
        "DISCLOSURE_GRID",
        "STEM",
        "CALLOUT_INFO",
        "CALLOUT_WARN",
        "ATTEMPT",
        "VISUAL_CARD",
        "LADDER",
        "LINK_LIST",
        "DISCLOSURE",
        "STEP_LIST",
        "ANSWER_BOX",
        "CHECK_BOX",
        "CONCEPT_HEADER",
        "TILE",
        "CHIPS",
        "BANNER",
        "UNIT_HEADER",
        "STEP_CARDS",
        "EQUATION_CARD",
        "WORKED_CARD",
        "STAGED_VISUAL",
        "TRAP_CARD",
        "TRIAD",
        "RECALL_CARD",
        "ROUTE_RAIL",
        "STAGE_VIEW",
        "CONTROL_PANEL",
        "ROUTE_STEP"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "level",
        "presentation",
        "purpose",
        "benchmark"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "REQUIRED",
            "EXPECTED",
            "OPTIONAL"
          ]
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "What the learner gets from it, in a sentence."
        },
        "benchmark": {
          "type": "string",
          "minLength": 1,
          "description": "The part of the reference page this component comes from."
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "A component this one is shown inside; it takes its slot and place from the parent."
        },
        "repeat": {
          "enum": [
            "PER_CONSTRUCTION_UNIT"
          ],
          "description": "One instance per construction unit instead of one per page."
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Record fields that feed it."
        },
        "min_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Fewest items (rungs, steps, stages, checks) it needs to count as present."
        },
        "duty": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "A duty that already reports this component's absence, so the renderer does not report it twice."
        },
        "authoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hint": {
              "type": "string",
              "minLength": 1,
              "description": "What an author writes, and where, to supply it."
            },
            "skeleton": {
              "type": "object",
              "description": "Empty record fields to scaffold a new record with; {qid} stands for the record id."
            }
          }
        },
        "target_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Depth of the reference page. Below it, above min_items, is an advisory; new authoring is held to it."
        },
        "target_items_by_band": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "D1": {
              "type": "integer",
              "minimum": 1
            },
            "D2": {
              "type": "integer",
              "minimum": 1
            },
            "D3": {
              "type": "integer",
              "minimum": 1
            },
            "D4": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Reference depth by the difficulty band the record declares at band_source."
        },
        "band_source": {
          "type": "string",
          "minLength": 1,
          "description": "Dotted path to the record's difficulty band."
        },
        "compact_order": {
          "type": "integer",
          "minimum": 0,
          "description": "Where the component comes in the single-column flow of a phone or a portrait tablet, where both columns are stacked: lower first. It lets the picture follow the question it belongs to and the ladder follow the attempt, whichever column each sits in."
        }
      }
    }
  }
}
