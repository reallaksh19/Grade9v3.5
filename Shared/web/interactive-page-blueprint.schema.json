{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade9v3:interactive-page-blueprints:1.0",
  "title": "Grade9V3 Interactive Page Blueprint Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "shell",
    "component_policy",
    "blueprints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "shell": {
      "$ref": "#/$defs/shell"
    },
    "blueprints": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/blueprint"
      }
    },
    "component_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "column",
        "waivers",
        "depth"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "REQUIRED",
            "EXPECTED",
            "OPTIONAL"
          ],
          "properties": {
            "REQUIRED": {
              "type": "string",
              "minLength": 1
            },
            "EXPECTED": {
              "type": "string",
              "minLength": 1
            },
            "OPTIONAL": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "column": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "FULL",
            "PRIMARY",
            "SUPPORT"
          ],
          "properties": {
            "FULL": {
              "type": "string",
              "minLength": 1
            },
            "PRIMARY": {
              "type": "string",
              "minLength": 1
            },
            "SUPPORT": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "waivers": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "CORE1",
        "CORE2",
        "CORE1A",
        "CORE1B",
        "CORE2A",
        "CORE2B"
      ]
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixed_header",
        "controls",
        "responsive_modes"
      ],
      "properties": {
        "id": {
          "const": "G9-TABLET-SHELL-V1"
        },
        "fixed_header": {
          "const": true
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "BACK",
              "HOME",
              "SUBJECT_CONTEXT",
              "QUESTION_BANK",
              "SEARCH",
              "REFRESH",
              "DISPLAY",
              "OVERFLOW"
            ]
          },
          "uniqueItems": true
        },
        "responsive_modes": {
          "type": "array",
          "items": {
            "enum": [
              "COMPACT",
              "MEDIUM",
              "EXPANDED"
            ]
          },
          "uniqueItems": true,
          "minItems": 3
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "typography_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_text_css_px",
            "minimum_learner_text_css_px",
            "exception_policy"
          ],
          "properties": {
            "base_text_css_px": {
              "type": "integer",
              "minimum": 12
            },
            "minimum_learner_text_css_px": {
              "type": "integer",
              "minimum": 12
            },
            "exception_policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "math_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "static_relation_format",
            "dynamic_question_format",
            "dynamic_renderer",
            "runtime_text_inference"
          ],
          "properties": {
            "static_relation_format": {
              "type": "string",
              "minLength": 1
            },
            "dynamic_question_format": {
              "type": "string",
              "minLength": 1
            },
            "dynamic_renderer": {
              "type": "string",
              "minLength": 1
            },
            "runtime_text_inference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "representation_accessibility_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instructional_visual_requires_accessible_name",
            "instructional_visual_requires_description",
            "color_only_meaning"
          ],
          "properties": {
            "instructional_visual_requires_accessible_name": {
              "type": "boolean"
            },
            "instructional_visual_requires_description": {
              "type": "boolean"
            },
            "color_only_meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data_representation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparative_relations",
            "independent_facts",
            "tag_count_as_quality_metric"
          ],
          "properties": {
            "comparative_relations": {
              "type": "string",
              "minLength": 1
            },
            "independent_facts": {
              "type": "string",
              "minLength": 1
            },
            "tag_count_as_quality_metric": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "vendor_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pages_external_runtime",
            "publication_rewrite",
            "unknown_runtime_dependency"
          ],
          "properties": {
            "pages_external_runtime": {
              "type": "string",
              "minLength": 1
            },
            "publication_rewrite": {
              "type": "string",
              "minLength": 1
            },
            "unknown_runtime_dependency": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "accepts_blocks",
        "required",
        "column"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "accepts_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        },
        "column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "core_roles",
        "learner_job",
        "shell_ref",
        "layout_family",
        "slots",
        "interaction_policy",
        "representation_policy",
        "responsive_policy",
        "touch_policy",
        "packaging_modes",
        "forbidden"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BP-[A-Z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "DEPRECATED"
          ]
        },
        "core_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "learner_job": {
          "type": "string",
          "minLength": 1
        },
        "shell_ref": {
          "const": "G9-TABLET-SHELL-V1"
        },
        "layout_family": {
          "enum": [
            "READING_ORIENTATION",
            "READING_CONSTRUCTION",
            "GUIDED_RECONSTRUCTION",
            "QUESTION_READER",
            "QUESTION_STUDY",
            "TRANSFER_ATTEMPT",
            "STAGE_SUPPORT",
            "LIST_DETAIL",
            "FULL_LAB"
          ]
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "interaction_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_before_reveal",
            "progressive_support",
            "solution_policy"
          ],
          "properties": {
            "attempt_before_reveal": {
              "enum": [
                "FROM_PROJECTION",
                "ALWAYS",
                "NEVER"
              ]
            },
            "progressive_support": {
              "type": "boolean"
            },
            "solution_policy": {
              "enum": [
                "FROM_PROJECTION",
                "LEARNER_OPENABLE",
                "POST_ATTEMPT",
                "NOT_APPLICABLE"
              ]
            }
          }
        },
        "representation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preferred_mount_modes",
            "legacy_iframe"
          ],
          "properties": {
            "preferred_mount_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "PORTABLE_SCENE",
                  "COMPONENT",
                  "STATIC_FIGURE"
                ]
              }
            },
            "legacy_iframe": {
              "const": "MIGRATION_ONLY"
            }
          }
        },
        "responsive_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compact",
            "medium",
            "expanded",
            "primary_fraction",
            "support_fraction"
          ],
          "properties": {
            "compact": {
              "enum": [
                "SINGLE_PANE"
              ]
            },
            "medium": {
              "enum": [
                "SINGLE_PANE",
                "STACKED_SUPPORT"
              ]
            },
            "expanded": {
              "enum": [
                "SINGLE_PANE",
                "STAGE_SUPPORT",
                "LIST_DETAIL"
              ]
            },
            "primary_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "support_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "expanded_min_px": {
              "type": "integer",
              "minimum": 600,
              "maximum": 1600,
              "description": "Viewport width from which the expanded layout applies."
            },
            "support_sticky": {
              "type": "boolean",
              "description": "Whether the support column stays in view while the primary column scrolls."
            }
          }
        },
        "touch_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_target_css_px",
            "minimum_control_gap_css_px"
          ],
          "properties": {
            "minimum_target_css_px": {
              "type": "integer",
              "minimum": 48
            },
            "minimum_control_gap_css_px": {
              "type": "integer",
              "minimum": 8
            }
          }
        },
        "packaging_modes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PUBLIC",
              "PAGES",
              "OFFLINE_DIRECTORY",
              "SINGLE_FILE",
              "EMBED"
            ]
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "column": {
      "enum": [
        "FULL",
        "PRIMARY",
        "SUPPORT"
      ]
    },
    "presentation": {
      "enum": [
        "HEADER",
        "DISCLOSURE_GRID",
        "STEM",
        "CALLOUT_INFO",
        "CALLOUT_WARN",
        "ATTEMPT",
        "VISUAL_CARD",
        "LADDER",
        "LINK_LIST",
        "DISCLOSURE",
        "STEP_LIST",
        "ANSWER_BOX",
        "CHECK_BOX",
        "CONCEPT_HEADER",
        "TILE",
        "CHIPS",
        "BANNER",
        "UNIT_HEADER",
        "STEP_CARDS",
        "EQUATION_CARD",
        "WORKED_CARD",
        "STAGED_VISUAL",
        "TRAP_CARD",
        "CHECK_LIST",
        "RECALL_CARD"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "level",
        "presentation",
        "purpose",
        "benchmark"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "REQUIRED",
            "EXPECTED",
            "OPTIONAL"
          ]
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "What the learner gets from it, in a sentence."
        },
        "benchmark": {
          "type": "string",
          "minLength": 1,
          "description": "The part of the reference page this component comes from."
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "A component this one is shown inside; it takes its slot and place from the parent."
        },
        "repeat": {
          "enum": [
            "PER_CONSTRUCTION_UNIT"
          ],
          "description": "One instance per construction unit instead of one per page."
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Record fields that feed it."
        },
        "min_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Fewest items (rungs, steps, stages, checks) it needs to count as present."
        },
        "duty": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "A duty that already reports this component's absence, so the renderer does not report it twice."
        },
        "authoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hint": {
              "type": "string",
              "minLength": 1,
              "description": "What an author writes, and where, to supply it."
            },
            "skeleton": {
              "type": "object",
              "description": "Empty record fields to scaffold a new record with; {qid} stands for the record id."
            }
          }
        },
        "target_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Depth of the reference page. Below it, above min_items, is an advisory; new authoring is held to it."
        }
      }
    }
  }
}
