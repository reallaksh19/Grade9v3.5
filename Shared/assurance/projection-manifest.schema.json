{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/projection-manifest.schema.json",
  "title": "Projection manifest",
  "description": "Every generated projection SHALL carry or reference its canonical basis digest (spec §22).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection_type",
    "canonical_snapshot_digest",
    "generator",
    "generator_input_digest",
    "record_ids",
    "artifact_digest",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "projection-manifest/v1"
    },
    "projection_type": {
      "enum": ["WEB", "STANDALONE", "PDF", "SEARCH", "BROWSER_DATA"]
    },
    "canonical_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name":    { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generator_input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "notes": {
      "type": "string"
    }
  }
}
