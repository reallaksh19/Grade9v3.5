{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "assurance-bundle/v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^AB-[0-9a-f]{16}$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "PRODUCT",
            "CANONICAL_RECORD"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "canonical_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AE-"
      }
    },
    "required_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundled_at": {
      "type": "string",
      "format": "date-time"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "CANONICAL_RECORD",
              "PRODUCT",
              "PROJECTION",
              "SOURCE"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id",
          "digest",
          "path"
        ]
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL",
          "INCONCLUSIVE",
          "NOT_APPLICABLE",
          "NOT_RUN",
          "MISSING",
          "STALE"
        ]
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "subject",
          "reason"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema",
    "bundle_id",
    "subject",
    "canonical_snapshot_digest",
    "policies",
    "subjects",
    "evidence_refs",
    "required_types",
    "missing_types",
    "outcomes",
    "missing",
    "problems",
    "bundle_digest",
    "bundled_at"
  ],
  "$id": "assurance-bundle/v1",
  "additionalProperties": false,
  "description": "The evidence for a product at a canonical snapshot, and what it leaves missing. bundle_digest is over the record without bundle_digest and bundled_at. A consumer recomputes everything here from the evidence; nothing in a bundle is trusted."
}
