{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/demand-review-adapter.schema.json",
  "title": "Subject specialization for the shared cognitive-demand review matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "subject",
    "vocabulary_ref",
    "basis_refs",
    "demands"
  ],
  "properties": {
    "schema": {
      "const": "demand-review-adapter/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "Physics",
        "Chemistry",
        "Mathematics"
      ]
    },
    "vocabulary_ref": {
      "type": "string",
      "minLength": 1
    },
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "demands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RETRIEVE",
        "EXPLAIN",
        "APPLY",
        "MODEL",
        "REPRESENT",
        "SYNTHESIZE",
        "JUSTIFY"
      ],
      "properties": {
        "RETRIEVE": {
          "$ref": "#/$defs/demand"
        },
        "EXPLAIN": {
          "$ref": "#/$defs/demand"
        },
        "APPLY": {
          "$ref": "#/$defs/demand"
        },
        "MODEL": {
          "$ref": "#/$defs/demand"
        },
        "REPRESENT": {
          "$ref": "#/$defs/demand"
        },
        "SYNTHESIZE": {
          "$ref": "#/$defs/demand"
        },
        "JUSTIFY": {
          "$ref": "#/$defs/demand"
        }
      }
    }
  },
  "$defs": {
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_focus",
        "representation_kinds",
        "check_types",
        "misconception_patterns"
      ],
      "properties": {
        "review_focus": {
          "type": "string",
          "minLength": 1
        },
        "representation_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "misconception_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wrong_idea",
              "diagnostic_prompt",
              "repair"
            ],
            "properties": {
              "wrong_idea": {
                "type": "string",
                "minLength": 1
              },
              "diagnostic_prompt": {
                "type": "string",
                "minLength": 1
              },
              "repair": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
