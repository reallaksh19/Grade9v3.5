{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grade9v3/qrt-pipeline-run/v1",
  "title": "QRT minimal-prompt governed run",
  "type": "object",
  "$defs": {
    "auditCheck": {
      "type": "object",
      "required": [
        "result",
        "evidence"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "selfAudit": {
      "type": "object",
      "required": [
        "status",
        "summary_evidence",
        "basis_refs",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "summary_evidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/auditCheck"
          }
        }
      },
      "additionalProperties": true
    },
    "hint": {
      "type": "object",
      "required": [
        "id",
        "text",
        "calculation_bearing",
        "calculation_refs",
        "self_audit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "calculation_bearing": {
          "type": "boolean"
        },
        "calculation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "self_audit": {
          "$ref": "#/$defs/selfAudit"
        }
      },
      "additionalProperties": true
    },
    "solutionStep": {
      "type": "object",
      "required": [
        "id",
        "action",
        "why_valid_here",
        "result",
        "calculation_bearing",
        "calculation_refs",
        "self_audit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "why_valid_here": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "calculation_bearing": {
          "type": "boolean"
        },
        "calculation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "self_audit": {
          "$ref": "#/$defs/selfAudit"
        }
      },
      "additionalProperties": true
    },
    "calculation": {
      "type": "object",
      "required": [
        "id",
        "expression",
        "result",
        "self_audit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "self_audit": {
          "$ref": "#/$defs/selfAudit"
        }
      },
      "additionalProperties": true
    },
    "interactiveChromiumReceipt": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_sha256",
        "head_sha",
        "tool",
        "engine",
        "profile",
        "status",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tool": {
          "const": "tools/site-audit/interactive-page-audit.mjs"
        },
        "engine": {
          "const": "playwright.chromium"
        },
        "profile": {
          "const": "tablet-12.7"
        },
        "status": {
          "const": "PASS"
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "purposeDeliveryItem": {
      "type": "object",
      "required": [
        "id",
        "roles",
        "source_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CORE1A",
              "CORE2"
            ]
          }
        },
        "source_kind": {
          "enum": [
            "VERIFIED_COMPETITIVE_SOURCE",
            "AUTHOR_CREATED_COMPETITION_STYLE",
            "AUTHOR_CREATED_REVISION_TRANSFER"
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "purposeDelivery": {
      "type": "object",
      "required": [
        "purpose",
        "support_policy",
        "projection",
        "items"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "REVISION",
            "COMPETITION"
          ]
        },
        "support_policy": {
          "enum": [
            "REDUCED_SUPPORT",
            "NO_MID_TASK_BRIDGING"
          ]
        },
        "projection": {
          "type": "object",
          "required": [
            "CORE1A",
            "CORE2"
          ],
          "properties": {
            "CORE1A": {
              "type": "object",
              "required": [
                "section_kind",
                "item_refs"
              ],
              "properties": {
                "section_kind": {
                  "enum": [
                    "NEXT_LEVEL",
                    "CHALLENGE_SET"
                  ]
                },
                "item_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "CORE2": {
              "type": "object",
              "required": [
                "section_kind",
                "item_refs"
              ],
              "properties": {
                "section_kind": {
                  "enum": [
                    "NEXT_LEVEL",
                    "CHALLENGE_SET"
                  ]
                },
                "item_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/purposeDeliveryItem"
          }
        }
      },
      "additionalProperties": true
    },
    "reviewJudgement": {
      "type": "object",
      "properties": {
        "applicability": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "verdict": {
          "enum": [
            "YES",
            "PARTLY",
            "NO"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "required": [
              "verdict",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "PARTLY",
                  "NO"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "fix"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "renderedArtifact": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sha256",
        "head_sha"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": true
    },
    "semanticReview": {
      "type": "object",
      "required": [
        "question_ref"
      ],
      "properties": {
        "question_ref": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "AUTHOR_ONLY",
            "RENDERED",
            "INDEPENDENT_RENDERED"
          ],
          "description": "Review evidence basis. RENDERED proves review of the bound artifact but does not imply reviewer independence; INDEPENDENT_RENDERED additionally declares an independently governed reviewer identity."
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Stable declared reviewer identity/reference. Required for INDEPENDENT_RENDERED. This field records provenance; schema validation does not prove social or organizational independence."
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "judgements": {
          "type": "object",
          "properties": {
            "H1": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "H2": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "H3": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "S1": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "S2": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "S3": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "P1": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "P2": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "P3": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "M1": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "M2": {
              "$ref": "#/$defs/reviewJudgement"
            },
            "M3": {
              "$ref": "#/$defs/reviewJudgement"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "AUTHOR_ONLY"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "basis"
            ],
            "description": "Author assessment retained without rendered acceptance credit."
          },
          "else": {
            "required": [
              "artifact_ref",
              "artifact_sha256",
              "judgements"
            ],
            "properties": {
              "judgements": {
                "required": [
                  "H1",
                  "H2",
                  "H3",
                  "S1",
                  "S2",
                  "S3",
                  "P1",
                  "P2",
                  "P3",
                  "M1",
                  "M2",
                  "M3"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "INDEPENDENT_RENDERED"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "reviewer_ref"
            ]
          }
        }
      ],
      "additionalProperties": true,
      "description": "Canonical pipeline review. Missing basis preserves legacy rendered semantics. AUTHOR_ONLY cannot satisfy post-render review. RENDERED is exact-artifact review with independence unspecified; INDEPENDENT_RENDERED additionally records an independently governed reviewer reference."
    }
  },
  "required": [
    "schema",
    "run_identity",
    "owner_prompt",
    "owner_events",
    "learner_profile",
    "questions",
    "pre_attempt_graphs",
    "concept_evidence",
    "rendered_artifacts",
    "reviews",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "qrt-pipeline-run/v1"
    },
    "run_identity": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "head_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": true
    },
    "owner_prompt": {
      "type": "object",
      "required": [
        "text",
        "sha256",
        "source_ref"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "owner_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source_ref",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "PROMPT",
              "CLARIFICATION_REPLY",
              "SPECIAL_DIRECTIVE"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "learner_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "purpose",
        "purpose_owner_event_ref",
        "held"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "STARTER",
            "PRACTICE",
            "REVISION",
            "COMPETITION"
          ]
        },
        "purpose_owner_event_ref": {
          "type": "string",
          "minLength": 1
        },
        "held": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "state",
              "owner_event_ref"
            ],
            "properties": {
              "state": {
                "enum": [
                  "DEMONSTRATED",
                  "UNCERTAIN",
                  "MISSING"
                ]
              },
              "owner_event_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "verbatim_text",
          "owner_prompt_sha256",
          "verified_answer",
          "slots",
          "blueprint_ref",
          "hints",
          "solution_steps",
          "calculations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verbatim_text": {
            "type": "string",
            "minLength": 1
          },
          "owner_prompt_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "verified_answer": {
            "type": "string",
            "minLength": 1
          },
          "blueprint_ref": {
            "type": "string",
            "minLength": 3
          },
          "slots": {
            "type": "object",
            "required": [
              "X",
              "Y",
              "Z",
              "W"
            ],
            "properties": {
              "X": {
                "type": "object",
                "required": [
                  "text",
                  "basis"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "Y": {
                "type": "object",
                "required": [
                  "text",
                  "capability_ref"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "capability_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "Z": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "W": {
                "type": "object",
                "required": [
                  "text",
                  "protected_move_ref"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "protected_move_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "additionalProperties": true
          },
          "hints": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hint"
            }
          },
          "solution_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/solutionStep"
            }
          },
          "calculations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/calculation"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "pre_attempt_graphs": {
      "type": "array"
    },
    "concept_evidence": {
      "type": "array"
    },
    "rendered_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/renderedArtifact"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticReview"
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independent_rendered_review_required": {
          "type": "boolean",
          "description": "Opt-in acceptance requirement. When true, every question needs an INDEPENDENT_RENDERED review in addition to exact-artifact binding. Absent/false preserves legacy post-render review semantics."
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "interactive_chromium_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interactiveChromiumReceipt"
          }
        }
      },
      "additionalProperties": true
    },
    "purpose_delivery": {
      "$ref": "#/$defs/purposeDelivery"
    }
  },
  "additionalProperties": true
}
