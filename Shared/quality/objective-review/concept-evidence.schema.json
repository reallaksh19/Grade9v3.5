{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade9v3:objective-review:concept-evidence:1.0.0",
  "title": "ConceptEvidenceRecord",
  "description": "Evidence and trace aggregation for Core1A authoring. It never overrides canonical academic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "concept_evidence_id", "canonical_refs", "evidence_question_ids", "demand_cells", "entry_foundations", "target_concept_ref", "inferential_leaps", "misconceptions", "representation_needs", "model_boundaries", "transfer_conditions", "authority_note"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "concept_evidence_id": {"type": "string", "minLength": 1},
    "canonical_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "demand_cells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^QRT-D[1-4]-(RCL|CON|REP|PRC|MOD|PRF|EVD)$"}},
    "entry_foundations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_concept_ref": {"type": "string", "minLength": 1},
    "inferential_leaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["wrong_idea", "diagnostic_prompt", "repair", "evidence_question_ids"],
        "properties": {
          "wrong_idea": {"type": "string", "minLength": 1},
          "diagnostic_prompt": {"type": "string", "minLength": 1},
          "repair": {"type": "string", "minLength": 1},
          "evidence_question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "representation_needs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "transfer_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_note": {"const": "Evidence from Core2 guides emphasis and traceability; Core1A academic truth remains grounded in canonical academic truth/research."}
  }
}
