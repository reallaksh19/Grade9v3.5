{
  "schema": "learner-quality-contract/v1",
  "version": "1.2.0",
  "purpose": "Subject-neutral quality rules for the six Core learner products. Each rule judges a learner observation (Shared/quality/learner-observation.schema.json), i.e. what a learner can see and do, never what a record claims. Rules carry the audit findings they would have caught (audit_refs) and the owner-reference grammar step they encode (grammar). Calibration: every negative specimen in benchmarks/quality-calibration fails for its expected findings; the positive references pass the rules that encode their grammar.",
  "families": {
    "DEPTH": "Content a learner needs, at the depth the references show.",
    "INTERACTION": "When content becomes visible: attempt before reveal, progressive support.",
    "PAGE": "Standalone web page, shell and tablet policies.",
    "INTEGRITY": "Where the product came from and what it may never show."
  },
  "measures": {
    "STATIC": "Decidable from the delivered files.",
    "RENDERED": "Needs a browser (tools/site-audit/core-page-audit.mjs); skipped as NOT_MEASURED when page.rendered is null."
  },
  "blocks": {
    "CORE1": [
      "scope",
      "conventions",
      "hard_transition",
      "governing_relation",
      "compact_anchor",
      "exit_prompt"
    ],
    "CORE1A": [
      "entry_assumptions",
      "inferential_jump",
      "construction",
      "representation_bridge",
      "worked_anchor",
      "wrong_path",
      "diagnose",
      "repair",
      "independent_check",
      "exit_task",
      "exit_answer"
    ],
    "CORE1B": [
      "predict",
      "attempt_prompt",
      "reconstruct",
      "diagnose",
      "repair",
      "model_response",
      "rejoin_jump",
      "boundary_test",
      "boundary_answer"
    ],
    "CORE2": [
      "source_identity",
      "stem",
      "conditions",
      "options",
      "source_hints",
      "answer",
      "working"
    ],
    "CORE2A": [
      "provenance",
      "family_identity",
      "stem",
      "conditions",
      "trap",
      "reasoning_route",
      "solution",
      "answer",
      "independent_check",
      "failure_signal",
      "repair",
      "exposure_closure"
    ],
    "CORE2B": [
      "provenance",
      "stem",
      "lineage",
      "conditions",
      "invariant_changed",
      "safe_support",
      "changed_demand",
      "protected_move",
      "reasoning_route",
      "answer",
      "rubric",
      "independent_check",
      "repair",
      "lineage_check"
    ]
  },
  "thresholds": {
    "max_decisions_per_anchor": 4,
    "min_support_levels": 3,
    "min_figure_reveal_stages": 2,
    "placeholder_patterns": [
      "none supplied by the governed record",
      "not supplied",
      "\\bTBD\\b",
      "\\bTODO\\b",
      "lorem ipsum",
      "placeholder",
      "use the linked canonical explorer where supplied",
      "\\b(?:CAP|MIC|REP|FAM|REL|CU|VIS|SRC|ACT|Q|BUCKET|LIB)-[A-Z0-9][A-Z0-9]*(?:-[A-Z0-9]+){1,}\\b"
    ],
    "escape_state_tokens": [
      "HOLD",
      "BLOCKED",
      "INCOMPLETE",
      "FAILED",
      "PENDING_OWNER",
      "VISUAL_HOLD",
      "HOLD_WORKED_ANCHOR"
    ],
    "calibration_note": "Values chosen on the corpus: max_decisions_per_anchor=4 flags only the compressed R3 construction (7 decisions, 1 anchor) among the 8 Core1A concepts of specimen S1, whose others have 3-4; min_support_levels=3 is the reference question bank's rung count (every item has 3). C2A-BLOCKS does not require a separate conditions block: 3 of the reference's 77 items have none."
  },
  "rules": [
    {
      "id": "C1-RELATION",
      "family": "DEPTH",
      "measure": "STATIC",
      "roles": [
        "CORE1"
      ],
      "unit_kind": "CONCEPT",
      "severity": "S2",
      "check": {
        "op": "blocks_present",
        "blocks": [
          "governing_relation",
          "compact_anchor"
        ]
      },
      "audit_refs": [
        "A1-001"
      ],
      "grammar": "R1:equation-meaning-validity bridge",
      "text": "Each Core1 microtopic states its governing relation with meaning and validity conditions, and one compact anchor."
    },
    {
      "id": "C1-REPRESENTATION",
      "family": "DEPTH",
      "measure": "STATIC",
      "roles": [
        "CORE1"
      ],
      "severity": "S2",
      "check": {
        "op": "page_figures_min",
        "min": 1
      },
      "audit_refs": [
        "A1-001"
      ],
      "grammar": "R1:staged illustration/derivation",
      "text": "The Core1 map mounts at least one canonical representation, not only links to it."
    },
    {
      "id": "C1A-BLOCKS",
      "family": "DEPTH",
      "measure": "STATIC",
      "roles": [
        "CORE1A"
      ],
      "unit_kind": "CONCEPT",
      "severity": "S1",
      "check": {
