          "TEACHING",
          "PRE_ATTEMPT"
        ],
        "no_unmounted_refs": true
      },
      "audit_refs": [
        "A1-002"
      ],
      "grammar": "R1:staged illustration/derivation",
      "text": "Every Core1A concept, canonical included, mounts its representation; naming a representation id is not a representation."
    },
    {
