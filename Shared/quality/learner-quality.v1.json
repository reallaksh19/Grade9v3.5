      "audit_refs": [
        "A1-003"
      ],
      "grammar": "R1:easy mistake",
      "text": "Every Core1A concept has entry assumptions, the inferential jump, a reasoned construction, a worked anchor, wrong path, diagnosis, repair, an independent check and an exit task."
    },
    {
