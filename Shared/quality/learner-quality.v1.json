      "audit_refs": [
        "A1-005"
      ],
      "grammar": "R1:physical/concept opening",
      "text": "Every entry assumption links to a unit that teaches it (in this product or a named prior capability, possibly in another subject)."
    },
    {
      "id": "C1B-BLOCKS",
      "family": "DEPTH",
      "measure": "STATIC",
      "roles": [
        "CORE1B"
      ],
      "unit_kind": "CONCEPT",
      "severity": "S2",
      "check": {
        "op": "blocks_present",
        "blocks": [
          "predict",
          "attempt_prompt",
          "reconstruct",
          "diagnose",
          "repair",
          "boundary_test"
        ]
