      "severity": "S2",
      "check": {
        "op": "figure_reveal_stages_min",
        "min_from": "min_figure_reveal_stages"
      },
      "audit_refs": [],
      "grammar": "R1:staged illustration/derivation",
      "text": "A Core1A representation builds up in at least two stages that follow the construction (the textbook reference's staged figures)."
    },
    {
      "id": "C1A-ANCHOR-PER-DECISION",
      "family": "DEPTH",
      "measure": "STATIC",
      "roles": [
        "CORE1A"
      ],
      "unit_kind": "CONCEPT",
      "severity": "S1",
      "check": {
