{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/interaction-brief.schema.json",
  "title": "Derived Interaction Brief",
  "description": "A bounded Study-to-Interactive engineering handoff. It references canonical academic truth; it does not own curriculum, difficulty priority, learner evidence, or implementation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "subject",
    "academic_target",
    "learner_goal",
    "interaction_intent",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "brief_id": {
      "type": "string",
      "pattern": "^IBR-[A-F0-9]{20}$"
    },
    "subject": {
      "enum": ["Physics", "Mathematics", "Chemistry"]
    },
    "academic_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "microtopic_refs",
        "capability_refs",
        "question_refs",
        "representation_refs"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "microtopic_refs": {
          "$ref": "#/$defs/refs"
        },
        "capability_refs": {
          "$ref": "#/$defs/refs"
        },
        "question_refs": {
          "$ref": "#/$defs/refs"
        },
        "representation_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "learner_goal": {
      "type": "string",
      "minLength": 1
    },
    "interaction_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_manipulates",
        "becomes_visible",
        "misconception_targeted",
        "expected_decision_or_observation"
      ],
      "properties": {
        "learner_manipulates": {
          "type": "string",
          "minLength": 1
        },
        "becomes_visible": {
          "type": "string",
          "minLength": 1
        },
        "misconception_targeted": {
          "type": "string",
          "minLength": 1
        },
        "expected_decision_or_observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_core",
        "pre_attempt_protected_refs"
      ],
      "properties": {
        "required_core": {
          "type": ["string", "null"],
          "enum": [null, "CORE1", "CORE1A", "CORE1B", "CORE2", "CORE2A", "CORE2B"]
        },
        "pre_attempt_protected_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_kind",
        "canonical_record_refs",
        "canonical_input_digest",
        "repository_basis"
      ],
      "properties": {
        "authority": {
          "const": "DERIVED_INTERACTION_HANDOFF_ONLY"
        },
        "source_kind": {
          "enum": ["GRADE9V3_INTERACTIVE_IDEA", "DERIVED_CANONICAL_INTENT"]
        },
        "canonical_record_refs": {
          "$ref": "#/$defs/non_empty_refs"
        },
        "canonical_input_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "repository_basis": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "non_empty_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
