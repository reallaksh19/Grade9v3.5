{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/source-inventory.schema.json",
  "title": "Item inventory for a pinned source scope",
  "description": "An advisory denominator linked to acquisition records and existing evidence cards; no content refusal or acceptance authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inventory_id", "subject", "members", "declared_scope", "completeness_unit", "items", "counts", "digest", "supersedes"],
  "properties": {
    "schema": {"const": "source-inventory/v1"},
    "inventory_id": {"type": "string", "minLength": 3},
    "subject": {"enum": ["Physics", "Mathematics", "Chemistry"]},
    "members": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["acquisition_ref", "sha256", "pages"],
        "properties": {
          "acquisition_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pages": {"type": "string", "minLength": 1}
        }}
    },
    "declared_scope": {"enum": ["FULL_SOURCE", "CHAPTER", "SPECIMEN", "PAGE_RANGE"]},
    "completeness_unit": {"type": "string", "minLength": 3},
    "items": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
        "required": ["item_id", "locator", "format", "question_card", "key"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "locator": {"type": "object", "additionalProperties": false,
            "required": ["acquisition_ref", "page", "label"],
            "properties": {
              "acquisition_ref": {"type": "string", "minLength": 1},
              "page": {"type": "integer", "minimum": 1},
              "label": {"type": "string", "minLength": 1}
            }},
          "format": {"enum": ["SINGLE_CORRECT", "MULTIPLE_CORRECT", "TRUE_FALSE", "MATCH", "ASSERTION_REASON",
                               "COMPREHENSION", "NUMERIC", "SHORT", "LONG", "HOTS", "FILL_BLANK", "OTHER"]},
          "question_card": {"type": "string", "minLength": 1},
          "key": {"type": "object", "additionalProperties": false, "required": ["state"],
            "properties": {
              "state": {"enum": ["PRESENT", "ABSENT", "AMBIGUOUS"]},
              "card": {"type": "string", "minLength": 1}
            }}
        }}
    },
    "counts": {"type": "object", "additionalProperties": false,
      "required": ["items", "key_present", "key_absent", "key_ambiguous"],
      "properties": {
        "items": {"type": "integer", "minimum": 0},
        "key_present": {"type": "integer", "minimum": 0},
        "key_absent": {"type": "integer", "minimum": 0},
        "key_ambiguous": {"type": "integer", "minimum": 0}
      }},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "supersedes": {"type": ["string", "null"]}
  }
}
