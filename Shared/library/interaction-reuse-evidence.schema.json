{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/interaction-reuse-evidence.schema.json",
  "title": "Derived Interaction Reuse Evidence",
  "description": "Non-academic production-memory evidence for compositional reuse/extension/local invention. Maturity is derived from lineage; it is not an execution permission or manually promoted prestige field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "authority",
    "interaction_ref",
    "subject_ref",
    "runtime_binding_ref",
    "mechanic_refs",
    "decisions",
    "shared_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^IRE-[A-F0-9]{20}$"
    },
    "authority": {
      "const": "DERIVED_INTERACTION_REUSE_EVIDENCE_ONLY"
    },
    "interaction_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "runtime_binding_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic governed runtime/package identity. LOCAL does not mean unregistered or page-local bypass."
    },
    "mechanic_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slice_ref",
          "mode",
          "relation",
          "implementation_ref",
          "evidence_ref"
        ],
        "properties": {
          "slice_ref": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["R1", "R2", "R3", "R4"]
          },
          "relation": {
            "enum": [
              "CONSUMES",
              "COMPOSES",
              "EXTENDS",
              "DERIVED_FROM",
              "SUPERSEDES",
              "EXAMPLE_OF",
              "CREATES"
            ]
          },
          "implementation_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "shared_binding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation_ref", "owner_ref"],
          "properties": {
            "implementation_ref": {
              "type": "string",
              "minLength": 1
            },
            "owner_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
