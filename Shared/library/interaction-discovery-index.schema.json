{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/interaction-discovery-index.schema.json",
  "title": "Derived Interaction Discovery Index",
  "description": "Advisory production-memory projection over concrete interaction implementation and reuse evidence. It is not academic authority and never grants or withholds permission to research/build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "execution_policy",
    "implementations",
    "duplication_opportunities",
    "source_inventory",
    "index_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority": {"const": "DERIVED_INTERACTION_DISCOVERY_ONLY"},
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "research_may_continue",
        "unindexed_build_allowed",
        "promotion_not_required",
        "similarity_is_not_reuse_evidence"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "research_may_continue": {"const": true},
        "unindexed_build_allowed": {"const": true},
        "promotion_not_required": {"const": true},
        "similarity_is_not_reuse_evidence": {"const": true}
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "implementation_ref",
          "maturity",
          "maturity_status",
          "subject_refs",
          "interaction_refs",
          "mechanic_refs",
          "runtime_binding_refs",
          "package_refs",
          "example_artifact_refs",
          "source_paths",
          "creator_interaction_refs",
          "consumer_interaction_refs",
          "consumer_subject_refs",
          "shared_owner_refs",
          "subject_neutral_shared_claim_proven",
          "reconstruction_debt",
          "lineage_edges"
        ],
        "properties": {
          "implementation_ref": {"type": "string", "minLength": 1},
          "maturity": {
            "type": ["string", "null"],
            "enum": ["LOCAL", "REUSED", "SHARED", null]
          },
          "maturity_status": {"enum": ["OBSERVED", "UNOBSERVED"]},
          "subject_refs": {"$ref": "#/$defs/strings"},
          "interaction_refs": {"$ref": "#/$defs/strings"},
          "mechanic_refs": {"$ref": "#/$defs/strings"},
          "runtime_binding_refs": {"$ref": "#/$defs/strings"},
          "package_refs": {"$ref": "#/$defs/strings"},
          "example_artifact_refs": {"$ref": "#/$defs/strings"},
          "source_paths": {"$ref": "#/$defs/strings"},
          "creator_interaction_refs": {"$ref": "#/$defs/strings"},
          "consumer_interaction_refs": {"$ref": "#/$defs/strings"},
          "consumer_subject_refs": {"$ref": "#/$defs/strings"},
          "shared_owner_refs": {"$ref": "#/$defs/strings"},
          "subject_neutral_shared_claim_proven": {"type": "boolean"},
          "reconstruction_debt": {"$ref": "#/$defs/strings"},
          "lineage_edges": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    },
    "duplication_opportunities": {
      "type": "array",
      "items": {"type": "object"}
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_source_paths", "explicit_reuse_evidence_paths"],
      "properties": {
        "local_source_paths": {"$ref": "#/$defs/strings"},
        "explicit_reuse_evidence_paths": {"$ref": "#/$defs/strings"}
      }
    },
    "index_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
