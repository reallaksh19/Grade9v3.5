{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/test-source-question-intake.schema.json",
  "title": "Stage-1 TEST source question intake bank",
  "description": "Schema for official NCERT and CBSE question intake before academic blueprinting (Issue #68).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_id",
    "subject",
    "grade",
    "source_scope",
    "created_from",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "grade9v3-test-source-question-intake-v1"
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "subject": {
      "type": "string",
      "enum": ["Mathematics", "Physics", "Chemistry", "TEST"]
    },
    "grade": {
      "type": "integer",
      "enum": [9, 10, 11]
    },
    "source_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["NCERT_OFFICIAL", "CBSE_OFFICIAL"]
      },
      "minItems": 1
    },
    "created_from": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intakeQuestion"
      }
    }
  },
  "$defs": {
    "intakeQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_identifier",
        "stem",
        "stem_sha256",
        "source_authority",
        "source_kind",
        "document_title",
        "edition_or_year",
        "source_url",
        "chapter_or_unit",
        "exercise_or_section",
        "question_number",
        "capture_method",
        "wording_custody",
        "text_verification_status",
        "last_checked",
        "subject",
        "grade",
        "topic_label",
        "question_type",
        "official_answer_available",
        "workflow_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "original_identifier": {
          "type": "string",
          "minLength": 1
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "stem_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_authority": {
          "type": "string",
          "enum": ["NCERT_OFFICIAL", "CBSE_OFFICIAL"]
        },
        "source_kind": {
          "type": "string",
          "enum": ["TEXTBOOK", "EXEMPLAR", "SAMPLE_PAPER", "BOARD_PAPER", "OFFICIAL_PRACTICE"]
        },
        "document_title": {
          "type": "string",
          "minLength": 1
        },
        "edition_or_year": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "chapter_or_unit": {
          "type": "string",
          "minLength": 1
        },
        "exercise_or_section": {
          "type": "string",
          "minLength": 1
        },
        "question_number": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": ["integer", "string"]
        },
        "capture_method": {
          "type": "string",
          "enum": ["VERBATIM_EXTRACTION", "OFFICIAL_PDF_VERIFIED_TRANSCRIPTION"]
        },
        "wording_custody": {
          "type": "string",
          "enum": ["VERBATIM"]
        },
        "text_verification_status": {
          "type": "string",
          "enum": [
            "CAPTURED_UNVERIFIED",
            "TEXT_VERIFIED_AGAINST_OFFICIAL",
            "SOURCE_HOLD",
            "TEXT_HOLD"
          ]
        },
        "last_checked": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Physics", "Chemistry", "TEST"]
        },
        "grade": {
          "type": "integer",
          "enum": [9, 10, 11]
        },
        "topic_label": {
          "type": "string",
          "minLength": 1
        },
        "subtopic_label": {
          "type": "string"
        },
        "question_type": {
          "type": "string",
          "enum": [
            "MULTIPLE_CHOICE",
            "SHORT_ANSWER",
            "LONG_ANSWER",
            "ASSERTION_REASON",
            "TRUE_FALSE"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subparts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "official_answer_available": {
          "type": "boolean"
        },
        "answer_key_locator": {
          "type": "string"
        },
        "official_answer_text": {
          "type": "string"
        },
        "workflow_status": {
          "type": "string",
          "enum": [
            "CAPTURED",
            "SOURCE_VERIFIED",
            "TEXT_VERIFIED",
            "LABELLED",
            "TEST_VISIBLE",
            "READY_FOR_BLUEPRINT",
            "SOURCE_HOLD",
            "TEXT_HOLD",
            "IDENTITY_HOLD",
            "DUPLICATE_REVIEW",
            "TOPIC_HOLD"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
