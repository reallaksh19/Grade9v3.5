{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/interaction-shared-claim.schema.json",
  "title": "Derived Interaction SHARED Claim Assessment",
  "description": "Claim-validation projection over observed interaction lineage. It may falsify a SHARED claim but never grants or withholds permission to research, build, or deliver LOCAL/REUSED work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "implementation_ref",
    "observed_maturity",
    "decision",
    "shared_claim_proven",
    "evidence_summary",
    "missing_claim_evidence",
    "execution_policy",
    "claim_note"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority": {"const": "DERIVED_INTERACTION_SHARED_CLAIM_ONLY"},
    "implementation_ref": {"type": "string", "minLength": 1},
    "observed_maturity": {
      "type": ["string", "null"],
      "enum": ["LOCAL", "REUSED", "SHARED", null]
    },
    "decision": {
      "enum": [
        "UNOBSERVED",
        "KEEP_LOCAL",
        "KEEP_REUSED",
        "SHARED_CLAIM_UNPROVEN",
        "SHARED_CLAIM_PROVEN"
      ]
    },
    "shared_claim_proven": {"type": "boolean"},
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator_interaction_refs",
        "consumer_interaction_refs",
        "consumer_subject_refs",
        "shared_owner_refs"
      ],
      "properties": {
        "creator_interaction_refs": {"$ref": "#/$defs/strings"},
        "consumer_interaction_refs": {"$ref": "#/$defs/strings"},
        "consumer_subject_refs": {"$ref": "#/$defs/strings"},
        "shared_owner_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "missing_claim_evidence": {"$ref": "#/$defs/strings"},
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "research_may_continue",
        "local_or_reused_delivery_not_blocked",
        "promotion_required"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "research_may_continue": {"const": true},
        "local_or_reused_delivery_not_blocked": {"const": true},
        "promotion_required": {"const": false}
      }
    },
    "claim_note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
