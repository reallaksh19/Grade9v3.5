{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/evidence-cards.schema.json",
  "title": "Evidence cards for one syllabus node",
  "description": "Every fact a research agent collects: a claim, the verbatim quote that supports it, and where the quote is in a pinned source. Shared/tools/evidence_check.py re-finds each quote in the snapshot bytes; a card whose quote is not there is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "node_ref",
    "cards"
  ],
  "properties": {
    "schema": {
      "const": "evidence-cards/v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "node_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Syllabus spine node this file serves."
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "kind",
        "claim",
        "quote",
        "acquisition_ref",
        "locator",
        "harvested_by",
        "harvested_at"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^EV-[A-Z0-9-]+$"
        },
        "kind": {
          "enum": [
            "SYLLABUS_SCOPE",
            "DEFINITION",
            "RELATION",
            "CONDITION",
            "WORKED_EXAMPLE",
            "MISCONCEPTION",
            "DIAGRAM",
            "QUESTION",
            "ANSWER_KEY",
            "INTERACTIVE_PRECEDENT",
            "LOCATOR_HINT"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 10,
          "description": "The fact in the agent's own words. It must follow from the quote alone."
        },
        "quote": {
          "type": "string",
          "minLength": 20,
          "description": "Verbatim text copied from the source at the locator (at least 6 words). Equations may be garbled by PDF extraction: quote the sentence around them. Keep quotes as short as the claim allows (the repository is public); a question card quotes the stem.",
          "maxLength": 700
        },
        "equation": {
          "type": "string",
          "description": "Optional LaTeX of an equation the quote states; checked by the verifier, not by string match."
        },
        "acquisition_ref": {
          "type": "string",
          "pattern": "^ACQ-[A-F0-9]{20}$"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based page of the PDF file (not the printed page number). 1 for HTML."
            },
            "printed_page": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "question_number": {
              "type": "string"
            },
            "figure": {
              "type": "string"
            }
          }
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required when kind is QUESTION.",
          "required": [
            "exam",
            "year",
            "paper",
            "question_number",
            "answer_key_card_ref"
          ],
          "properties": {
            "exam": {
              "type": "string",
              "minLength": 2
            },
            "year": {
              "type": "integer",
              "minimum": 1978,
              "maximum": 2100
            },
            "paper": {
              "type": "string",
              "minLength": 1,
              "description": "Paper/shift/session exactly as the source names it."
            },
            "question_number": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "has_figure": {
              "type": "boolean"
            },
            "answer_key_card_ref": {
              "type": "string",
              "pattern": "^EV-[A-Z0-9-]+$"
            },
            "jee_tier": {
              "enum": [
                "NONE",
                "MAIN",
                "ADVANCED"
              ]
            }
          }
        },
        "harvested_by": {
          "type": "string",
          "minLength": 1,
          "description": "Agent/session id of the researcher."
        },
        "harvested_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scan_check": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required on scanned-source cards of kind QUESTION, ANSWER_KEY, WORKED_EXAMPLE or RELATION. The quote is OCR output; the second reading is an independent clean transcription of the same passage from the page image. evidence_check compares their numbers itself.",
          "required": [
            "second_reading",
            "second_reader",
            "method"
          ],
          "properties": {
            "second_reading": {
              "type": "string",
              "minLength": 20,
              "description": "Clean transcription of exactly the quoted passage, read from the page image (math in plain text or LaTeX)."
            },
            "second_reader": {
              "type": "string",
              "minLength": 1,
              "description": "Agent or person id; must differ from harvested_by."
            },
            "method": {
              "enum": [
                "HUMAN",
                "VISION_MODEL",
                "SECOND_OCR_ENGINE"
              ]
            },
            "image_crop_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Optional digest of the page-image crop that was read (kept locally)."
            }
          }
        }
      }
    }
  }
}
