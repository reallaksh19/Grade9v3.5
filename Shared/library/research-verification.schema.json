{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/research-verification.schema.json",
  "title": "Independent verification of one syllabus node",
  "description": "Written by the verifier agent, who must not be the researcher or the author. Machine checks are re-run by tools; this record holds what only an independent solver can add: re-derived answers and review findings. Every finding is a duty returned to a named role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "node_ref", "verified_by", "verified_at", "inputs_digest", "questions", "records", "findings"],
  "properties": {
    "schema": {"const": "research-verification/v1"},
    "subject": {"type": "string"},
    "node_ref": {"type": "string"},
    "verified_by": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "inputs_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Digest of the evidence file and cited library records as verified; stale when they change."},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_ref", "independent_solution", "independent_answer", "official_answer", "agrees"],
        "properties": {
          "card_ref": {"type": "string"},
          "independent_solution": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
          "independent_answer": {"type": "string", "minLength": 1},
          "official_answer": {"type": "string", "minLength": 1, "description": "As stated on the answer-key card."},
          "agrees": {"type": "boolean"},
          "numeric_check": {"type": "string", "description": "Optional python expression that evaluates the answer; the board re-runs it."}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_ref", "checked_fields", "agrees"],
        "properties": {
          "record_ref": {"type": "string"},
          "checked_fields": {"type": "array", "items": {"type": "string"}},
          "agrees": {"type": "boolean", "description": "Every checked field follows from its cited cards (or is correct authored pedagogy) and stays within the grade scope."}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "duty_for", "detail"],
        "properties": {
          "target": {"type": "string"},
          "duty_for": {"enum": ["RESEARCHER", "AUTHOR"]},
          "detail": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
