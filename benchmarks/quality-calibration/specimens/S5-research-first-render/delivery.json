    "inputs": {
      "prompts": [
        {
          "id": "pc0941bc5bd",
          "text": "Build a complete Motion in 2D study set for a Grade 9 learner starting from these questions and this syllabus.",
          "supplied_count": 1
        }
      ],
      "questions": [
        {
          "id": "qe64c308ee3",
          "text": "A particle moves from point A (2 m, 3 m) to point B (8 m, 11 m). Find the magnitude of its displacement.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "2",
            "3",
            "8",
            "11"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q768643a6ae",
          "text": "A student walks 30 m east and then 40 m north in 50 s. Find the magnitude of the displacement and the average velocity.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "30",
            "40",
            "50"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "qe316ae6be0",
          "text": "The position of a particle is x = 3t m and y = 4t m, with t in seconds. Find the speed of the particle.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "3",
            "4"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q7a05a97042",
          "text": "A particle's velocity changes from 4 m/s along x to 3 m/s along y in 2 s. Find the magnitude of the average acceleration.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "4",
            "3",
            "2"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "qf37aead9ab",
          "text": "Two balls are 20 m above the ground. Ball A is dropped and ball B is thrown horizontally at 5 m/s at the same instant. Which reaches the ground first, and when? Take g = 10 m/s².",
          "label": null,
          "source_hint": null,
          "conditions": [
            "20",
            "5",
            "10"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q68397907bb",
          "text": "A ball rolls off a table top at 3 m/s and lands 0.4 s later. Find the horizontal distance from the table edge to the landing point.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "3",
            "0.4"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "qddc6a62f5f",
          "text": "A particle starts from rest at the origin with constant acceleration 2 m/s² along x and 1 m/s² along y. Find its position after 4 s.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "2",
            "1",
            "4"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q8e8f4d3a1c",
          "text": "A particle has initial velocity 3 m/s along x and constant acceleration 2 m/s² along y. Find its speed at t = 2 s.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "3",
            "2"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q0b6c23e837",
          "text": "A ball is thrown with speed 20 m/s at 30° above the horizontal. Find the time of flight. Take g = 10 m/s².",
          "label": "Q15",
          "source_hint": "Fixture Source Paper",
          "conditions": [
            "20",
            "30",
            "10"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": true,
          "supplied_count": 1
        },
        {
          "id": "qc5089ef91c",
          "text": "A ball is launched at 20 m/s at 30° above the horizontal. Find the maximum height it reaches. Take g = 10 m/s².",
          "label": null,
          "source_hint": null,
          "conditions": [
            "20",
            "30",
            "10"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "qa0349724e8",
          "text": "Find the horizontal range of a projectile launched at 20 m/s at 45° above level ground. Take g = 10 m/s².",
          "label": null,
          "source_hint": null,
          "conditions": [
            "20",
            "45",
            "10"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q5ddcee54c3",
          "text": "A stone is thrown horizontally at 10 m/s from the top of a cliff 45 m high. Find the time to reach the ground and the horizontal distance travelled. Take g = 10 m/s².",
          "label": null,
          "source_hint": null,
          "conditions": [
            "10",
            "45"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q4187e28aec",
          "text": "",
          "label": "Q7",
          "source_hint": "Fixture Source Paper A (2020)",
          "conditions": [],
          "text_status": "LABEL_ONLY",
          "identity_claim_requested": true,
          "supplied_count": 1
        },
        {
          "id": "qa407fae308",
          "text": "A boat moves at 4 m/s in still water. It heads straight across a river flowing at 3 m/s. Find the resultant speed of the boat relative to the bank.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "4",
            "3"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q467f83a3d7",
          "text": "Rain falls vertically at 6 m/s. A cyclist rides at 8 m/s. Find the speed of the rain relative to the cyclist.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "6",
            "8"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        },
        {
          "id": "q4aca227ff6",
          "text": "A body moves in a circle of radius 2 m with a constant speed of 4 m/s. Find its centripetal acceleration.",
          "label": null,
          "source_hint": null,
          "conditions": [
            "2",
            "4"
          ],
          "text_status": "SUPPLIED",
          "identity_claim_requested": false,
          "supplied_count": 1
        }
