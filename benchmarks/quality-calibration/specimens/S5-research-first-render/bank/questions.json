    {
      "id": "q4187e28aec",
      "text": "A package is released from an aeroplane flying horizontally at 50 m/s at a height of 80 m. How far ahead of the release point does it land? Take g = 10 m/s².",
      "owner_label": "Q7",
      "authored": false,
      "subtopic": "Horizontal launch from a height",
      "hint": "The package keeps the aeroplane's horizontal velocity.",
      "steps": [
        "Fall time: 80 = ½ × 10 × t², so t = 4 s.",
        "Horizontal distance = 50 × 4 = 200 m."
      ],
