    {
      "id": "q5ddcee54c3",
      "text": "A stone is thrown horizontally at 10 m/s from the top of a cliff 45 m high. Find the time to reach the ground and the horizontal distance travelled. Take g = 10 m/s².",
      "owner_label": null,
      "authored": false,
      "subtopic": "Horizontal launch from a height",
      "hint": "The vertical motion starts from rest.",
      "steps": [
        "45 = ½ × 10 × t², so t² = 9 and t = 3 s.",
        "Horizontal distance = 10 × 3 = 30 m."
      ],
      "answer": "3 s and 30 m",
