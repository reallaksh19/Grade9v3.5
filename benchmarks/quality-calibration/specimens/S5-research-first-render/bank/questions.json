    {
      "id": "qc5089ef91c",
      "text": "A ball is launched at 20 m/s at 30° above the horizontal. Find the maximum height it reaches. Take g = 10 m/s².",
      "owner_label": null,
      "authored": false,
      "subtopic": "Projectiles: time of flight, height and range",
      "hint": "At the top the vertical velocity is zero.",
      "steps": [
        "u_y = 20 × sin 30° = 10 m/s.",
        "H = u_y² / 2g = 100 / 20 = 5 m."
      ],
      "answer": "5 m",
