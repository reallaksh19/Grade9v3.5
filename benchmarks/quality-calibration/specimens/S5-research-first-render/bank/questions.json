      "source_identity": null,
      "learner_location": "pages/perpendicular-components-are-independent.html#qf37aead9ab"
    },
    {
      "id": "q68397907bb",
      "text": "A ball rolls off a table top at 3 m/s and lands 0.4 s later. Find the horizontal distance from the table edge to the landing point.",
      "owner_label": null,
      "authored": false,
      "subtopic": "Perpendicular components are independent",
      "hint": "Horizontal velocity is constant.",
      "steps": [
        "Horizontal velocity stays 3 m/s throughout the flight.",
        "Distance = 3 × 0.4 = 1.2 m."
      ],
