    {
      "id": "q467f83a3d7",
      "text": "Rain falls vertically at 6 m/s. A cyclist rides at 8 m/s. Find the speed of the rain relative to the cyclist.",
      "owner_label": null,
      "authored": false,
      "subtopic": "Relative velocity in two dimensions",
      "hint": "Subtract the cyclist's velocity from the rain's velocity.",
      "steps": [
        "v_rain − v_cyclist = (−8, −6) m/s.",
        "Relative speed = √(8² + 6²) = 10 m/s."
      ],
      "answer": "10 m/s",
      "visual": "<figure data-role=\"visual\"><svg role=\"img\" viewBox=\"0 0 360 240\" aria-labelledby=\"t-b-q467f83a3d7 d-b-q467f83a3d7\"><title id=\"t-b-q467f83a3d7\">Rain relative to the cyclist</title><desc id=\"d-b-q467f83a3d7\">Rain velocity, reversed cyclist velocity and the relative velocity.</desc><line x1=\"10\" y1=\"34.0\" x2=\"352\" y2=\"34.0\" stroke=\"#999\"/><line x1=\"263.3\" y1=\"8\" x2=\"263.3\" y2=\"232\" stroke=\"#999\"/><text x=\"338\" y=\"28.0\" font-size=\"12\">x</text><text x=\"269.3\" y=\"18\" font-size=\"12\">y</text><defs><marker id=\"arrow-b-q467f83a3d7\" markerUnits=\"userSpaceOnUse\" markerWidth=\"9\" markerHeight=\"9\" refX=\"8\" refY=\"4.5\" orient=\"auto\"><path d=\"M0,0 L9,4.5 L0,9 z\" fill=\"#2c4fb8\"/></marker></defs><line x1=\"263.3\" y1=\"34.0\" x2=\"263.3\" y2=\"206.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-q467f83a3d7)\"/><text x=\"267.3\" y=\"116.0\" font-size=\"12\">rain</text><line x1=\"263.3\" y1=\"206.0\" x2=\"34.0\" y2=\"206.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-q467f83a3d7)\"/><text x=\"152.7\" y=\"202.0\" font-size=\"12\">−v cyclist</text><line x1=\"263.3\" y1=\"34.0\" x2=\"34.0\" y2=\"206.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-q467f83a3d7)\"/><text x=\"152.7\" y=\"116.0\" font-size=\"12\">relative</text></svg><figcaption>Rain relative to the cyclist</figcaption></figure>",
