    {
      "id": "qa407fae308",
      "text": "A boat moves at 4 m/s in still water. It heads straight across a river flowing at 3 m/s. Find the resultant speed of the boat relative to the bank.",
      "owner_label": null,
      "authored": false,
      "subtopic": "Relative velocity in two dimensions",
      "hint": "The two velocities are perpendicular.",
      "steps": [
        "v = √(4² + 3²).",
        "v = 5 m/s."
      ],
      "answer": "5 m/s",
      "visual": "<figure data-role=\"visual\"><svg role=\"img\" viewBox=\"0 0 360 240\" aria-labelledby=\"t-b-qa407fae308 d-b-qa407fae308\"><title id=\"t-b-qa407fae308\">Boat and river velocities</title><desc id=\"d-b-qa407fae308\">Perpendicular velocity vectors and their resultant.</desc><line x1=\"10\" y1=\"206.0\" x2=\"352\" y2=\"206.0\" stroke=\"#999\"/><line x1=\"34.0\" y1=\"8\" x2=\"34.0\" y2=\"232\" stroke=\"#999\"/><text x=\"338\" y=\"200.0\" font-size=\"12\">x</text><text x=\"40.0\" y=\"18\" font-size=\"12\">y</text><defs><marker id=\"arrow-b-qa407fae308\" markerUnits=\"userSpaceOnUse\" markerWidth=\"9\" markerHeight=\"9\" refX=\"8\" refY=\"4.5\" orient=\"auto\"><path d=\"M0,0 L9,4.5 L0,9 z\" fill=\"#2c4fb8\"/></marker></defs><line x1=\"34.0\" y1=\"206.0\" x2=\"34.0\" y2=\"34.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-qa407fae308)\"/><text x=\"38.0\" y=\"116.0\" font-size=\"12\">4 m/s</text><line x1=\"34.0\" y1=\"34.0\" x2=\"163.0\" y2=\"34.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-qa407fae308)\"/><text x=\"102.5\" y=\"30.0\" font-size=\"12\">3 m/s</text><line x1=\"34.0\" y1=\"206.0\" x2=\"163.0\" y2=\"34.0\" stroke=\"#2c4fb8\" stroke-width=\"2\" marker-end=\"url(#arrow-b-qa407fae308)\"/><text x=\"102.5\" y=\"116.0\" font-size=\"12\">5 m/s</text></svg><figcaption>Boat and river velocities</figcaption></figure>",
