    {
      "id": "qa0349724e8",
      "text": "Find the horizontal range of a projectile launched at 20 m/s at 45° above level ground. Take g = 10 m/s².",
      "owner_label": null,
      "authored": false,
      "subtopic": "Projectiles: time of flight, height and range",
      "hint": "Use R = u² sin 2θ / g.",
      "steps": [
        "sin 2θ = sin 90° = 1.",
        "R = 20² × 1 / 10 = 40 m."
      ],
      "answer": "40 m",
      "visual": "<figure data-role=\"visual\"><svg role=\"img\" viewBox=\"0 0 360 240\" aria-labelledby=\"t-b-qa0349724e8 d-b-qa0349724e8\"><title id=\"t-b-qa0349724e8\">Range at 45 degrees</title><desc id=\"d-b-qa0349724e8\">Projectile path landing at 40 m.</desc><line x1=\"10\" y1=\"206.0\" x2=\"352\" y2=\"206.0\" stroke=\"#999\"/><line x1=\"34.0\" y1=\"8\" x2=\"34.0\" y2=\"232\" stroke=\"#999\"/><text x=\"338\" y=\"200.0\" font-size=\"12\">x</text><text x=\"40.0\" y=\"18\" font-size=\"12\">y</text><path d=\"M34.0,206.0 L41.3,198.9 L48.6,192.1 L55.9,185.7 L63.2,179.7 L70.5,174.1 L77.8,168.8 L85.1,163.8 L92.4,159.3 L99.7,155.1 L107.0,151.2 L114.3,147.8 L121.6,144.7 L128.9,141.9 L136.2,139.6 L143.5,137.6 L150.8,135.9 L158.1,134.6 L165.4,133.7 L172.7,133.2 L180.0,133.0 L187.3,133.2 L194.6,133.7 L201.9,134.6 L209.2,135.9 L216.5,137.6 L223.8,139.6 L231.1,141.9 L238.4,144.7 L245.7,147.8 L253.0,151.2 L260.3,155.1 L267.6,159.3 L274.9,163.8 L282.2,168.8 L289.5,174.1 L296.8,179.7 L304.1,185.7 L311.4,192.1 L318.7,198.9 L326.0,206.0\" fill=\"none\" stroke=\"#d8894a\" stroke-width=\"2\"/><defs><marker id=\"arrow-b-qa0349724e8\" markerUnits=\"userSpaceOnUse\" markerWidth=\"9\" markerHeight=\"9\" refX=\"8\" refY=\"4.5\" orient=\"auto\"><path d=\"M0,0 L9,4.5 L0,9 z\" fill=\"#2c4fb8\"/></marker></defs><circle cx=\"326.0\" cy=\"206.0\" r=\"3.5\" fill=\"#1d2330\"/><text x=\"331.0\" y=\"200.0\" font-size=\"12\">R = 40 m</text></svg><figcaption>Range at 45 degrees</figcaption></figure>",
