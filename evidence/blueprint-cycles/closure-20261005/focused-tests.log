"TRAP" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_WARN"><details class="g9-secondary-disclosure" data-g9-secondary="core2-wrong-route"><summary>Common wrong route · open if you want a warning</summary><div class="g9-secondary-body"><div class="g9-block" data-g9-block="common_wrong_route"><h4>Common wrong route</h4><p>Subtracting scalar speeds instead of velocity vectors.</p></div></div></details></div><div class="g9-component g9-c-attempt" data-g9-component="ATTEMPT" data-g9-level="REQUIRED" data-g9-presentation="ATTEMPT"><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your answer<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></div></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-representation" data-blueprint-slot="representation" data-required="false"></section><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-component g9-c-ladder" data-g9-component="HINT_LADDER" data-g9-level="REQUIRED" data-g9-presentation="LADDER" data-g9-component-items="3"><details class="g9-secondary-disclosure" data-g9-secondary="core2-hints"><summary>Need a hint? · guided support</summary><div class="g9-secondary-body"><div class="g9-eyebrow">Hint ladder · reveal only what you need</div><div class="g9-block" data-g9-block="authored_core2_support"><h4>Guided support</h4><div class="g9-ladder" data-g9-ladder-ref="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-group="AUTHORED_CORE2_PROMPT_REVEAL"><ol data-g9-ladder></ol><ol class="g9-rung-map" aria-label="Rungs still to come"><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div></li></ol><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-AUTHORED_CORE2_PROMPT_REVEAL-1"><li data-g9-rung="1" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[0]" data-g9-support-reveals="CONCEPT" data-g9-support-kind="REPRESENT" data-g9-supports-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-1"><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Resolve both airplane velocities into horizontal and vertical components.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-AUTHORED_CORE2_PROMPT_REVEAL-2"><li data-g9-rung="2" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[1]" data-g9-support-reveals="METHOD" data-g9-support-kind="CONNECT" data-g9-supports-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-2"><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Impose <span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>v</mi><mi>B</mi></msub></mrow><annotation encoding="application/x-tex">v_{B}</annotation></semantics></math></span>/A · <span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>v</mi><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">v_{A}</annotation></semantics></math></span> = 0.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-AUTHORED_CORE2_PROMPT_REVEAL-3"><li data-g9-rung="3" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[2]" data-g9-support-reveals="METHOD" data-g9-support-kind="EXECUTE" data-g9-supports-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-3"><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>After finding relative speed, use the 500 m initial separation.</p></div></li></template><button type="button" data-g9-next-rung>Show guided support</button></div></div></div></details></div><div class="g9-component g9-c-link-list" data-g9-component="CONCEPT_NAV" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="concept_navigation"><h4>Need the concept again?</h4><ul><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEADV-2014-P1-Q11" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" href="#g9-CORE1A--MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS">Split one plane-motion event into independent x/y components with one clock</a></li></ul></div></div></section></div></div><section class="blueprint-slot slot-solution" data-blueprint-slot="solution" data-required="true"><div class="g9-component g9-c-disclosure" data-g9-component="SOLUTION" data-g9-level="REQUIRED" data-g9-presentation="DISCLOSURE"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-solution"><summary>Answer and working</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2-PYQ-PHY-JEEADV-2014-P1-Q11-solution"><div class="g9-component g9-c-step-list" data-g9-component="SOLUTION_STEPS" data-g9-level="REQUIRED" data-g9-presentation="STEP_LIST" data-g9-component-items="3"><div class="g9-block" data-g9-block="structured_working"><h4>Reasoning route</h4><section class="g9-solution-move" data-g9-solution-order="1" data-g9-solution-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-1" data-g9-solution-kind="REPRESENT" data-g9-solution-stage="REPRESENT" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">1</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Represent</h4><p data-g9-solution-action>Resolve A&#x27;s velocity as (150, 50sqrt(3)) m/s. Let B&#x27;s speed be u, so its velocity is (u/2, u sqrt(3)/2).</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 1</p></div></section><section class="g9-solution-move" data-g9-solution-order="2" data-g9-solution-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-2" data-g9-solution-kind="CONNECT" data-g9-solution-stage="CONNECT" data-g9-solution-crux="true"><div class="g9-step-no" aria-hidden="true">2</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Connect</h4><p class="g9-prov" data-g9-crux-label>Key move</p><p data-g9-solution-action>The relative velocity v_B/A is perpendicular to A&#x27;s velocity. Their dot product is zero, which gives u=200 m/s.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 2</p></div></section><section class="g9-solution-move" data-g9-solution-order="3" data-g9-solution-move="PYQ-PHY-JEEADV-2014-P1-Q11-MOVE-3" data-g9-solution-kind="TRANSFORM" data-g9-solution-stage="CALCULATE" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">3</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Calculate</h4><p data-g9-solution-action>Then v_B/A=(-50,50sqrt(3)) m/s, whose magnitude is 100 m/s. Closing 500 m at that relative speed gives t0=5 s.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> 5 s.</p></div></section></div></div><div class="g9-component g9-c-answer-box" data-g9-component="ANSWER" data-g9-level="REQUIRED" data-g9-presentation="ANSWER_BOX"><div class="g9-block" data-g9-block="answer"><p>5 s.</p></div></div><div class="g9-component g9-c-check-box" data-g9-component="CHECK" data-g9-level="EXPECTED" data-g9-presentation="CHECK_BOX"><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>500 m / 100 m/s = 5 s, matching the source answer.</p></div></div></template></div></section></article><article id="g9-CORE2--PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-unit="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-kind="QUESTION" data-g9-role="CORE2" data-g9-search-text="Physics Motion in 2 D Select the gravity-only projectile model before using projectile consequences Medium concept Multi-step reasoning Motion in 2D component and projectile practice Multiple-correct multiple choice JEE (Advanced) 2026 · Paper 1 · Q6 Verified past-exam adaptation A projectile launched from O with speed v at angle theta passes through P, which is 5 m horizontally and 1 m vertically from O. Determine which source statements are correct about the required speed and whether the projectile reaches its maximum height before or after P for specified launch angles. Uniform gravitational acceleration g acts downward. Point P has coordinates (5 m,1 m) relative to launch point O. (A) For theta=45°, v=5sqrt(g)/2 m/s (B) For theta=45°, maximum height is reached before P (C) For theta=30°, maximum height is reached after P (D) For theta=tan^-1(1/5), v=125sqrt(g) m/s" class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-component g9-c-header" data-g9-component="IDENTITY" data-g9-level="REQUIRED" data-g9-presentation="HEADER"><div class="g9-block" data-g9-block="source_identity"><h2>JEE (Advanced) · 2026 · Paper 1 · Q6</h2><p class="g9-prov">Official past paper, faithful restatement of the original</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2" data-g9-meta-record="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-KIN-2D-MOTION" data-g9-meta-value="Motion in 2 D"><strong>Topic:</strong> <span data-g9-meta-label>Motion in 2 D</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-meta-value="Select the gravity-only projectile model before using projectile consequences"><strong>Concept:</strong> <span data-g9-meta-label>Select the gravity-only projectile model before using projectile consequences</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-KIN-2D-PRACTICE" data-g9-meta-value="Motion in 2D component and projectile practice"><strong>Family:</strong> <span data-g9-meta-label>Motion in 2D component and projectile practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-meta-value="multi_correct_mcq"><strong>Question type:</strong> <span data-g9-meta-label>Multiple-correct multiple choice</span></span><span data-g9-meta-item data-g9-meta-kind="source" data-g9-meta-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-meta-value="JEE (Advanced) 2026 · Paper 1 · Q6"><strong>Source:</strong> <span data-g9-meta-label>JEE (Advanced) 2026 · Paper 1 · Q6</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-meta-value="PYQ_ADAPTED"><strong>Provenance:</strong> <span data-g9-meta-label>Verified past-exam adaptation</span></span></div></div><div class="g9-component g9-c-link-list" data-g9-component="SOURCE_PDF" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="source_pdf"><a class="g9-pdf-link g9-source-pdf" data-g9-source-pdf href="https://jeeadv.ac.in/documents/p1_english.pdf" target="_blank" rel="noopener noreferrer" type="application/pdf" aria-label="Open the original past paper as a PDF to print it"><svg class="g9-pdf-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M6 2.5h8l4.5 4.5v14.5H6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 2.5V7h4.5M9 12h6.5M9 15.5h6.5M9 19h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Source paper (PDF)</span></a></div></div><div class="g9-component g9-c-disclosure-grid" data-g9-component="DIFFICULTY_WHY" data-g9-level="EXPECTED" data-g9-presentation="DISCLOSURE_GRID"><button type="button" class="g9-why-toggle" data-g9-toggle aria-expanded="false" aria-controls="g9-why-PYQ-PHY-JEEADV-2026-P1-Q06"><span class="g9-pill g9-pill-band" data-g9-band="D3">D3 · 7/10 · about 3 min</span><span>Why this difficulty?</span></button><div id="g9-why-PYQ-PHY-JEEADV-2026-P1-Q06" class="g9-why" hidden><p>Uses a prescribed point on a projectile trajectory plus apex-location reasoning across several launch angles.</p><div class=g9-dgrid><div class="g9-dcell"><span>Choosing the model</span><b>2/2</b></div><div class="g9-dcell"><span>Representation</span><b>2/2</b></div><div class="g9-dcell"><span>Reasoning chain</span><b>1/2</b></div><div class="g9-dcell"><span>Algebra and numbers</span><b>1/2</b></div><div class="g9-dcell"><span>Traps and exceptions</span><b>1/2</b></div></div></div></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-component g9-c-stem" data-g9-component="STEM" data-g9-level="REQUIRED" data-g9-presentation="STEM"><div class="g9-eyebrow">Attempt first</div><div class="g9-block" data-g9-block="stem"><p>A projectile launched from O with speed v at angle theta passes through P, which is 5 m horizontally and 1 m vertically from O. Determine which source statements are correct about the required speed and whether the projectile reaches its maximum height before or after P for specified launch angles.</p></div></div><div class="g9-component g9-c-callout-info" data-g9-component="CONDITIONS" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_INFO"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Uniform gravitational acceleration g acts downward.</li><li>Point P has coordinates (5 m,1 m) relative to launch point O.</li></ul></div></div><div class="g9-component g9-c-callout-warn" data-g9-component="TRAP" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_WARN"><details class="g9-secondary-disclosure" data-g9-secondary="core2-wrong-route"><summary>Common wrong route · open if you want a warning</summary><div class="g9-secondary-body"><div class="g9-block" data-g9-block="common_wrong_route"><h4>Common wrong route</h4><p>Checking only whether the point lies on the trajectory and not whether the apex occurs before or after it.</p></div></div></details></div><div class="g9-component g9-c-attempt" data-g9-component="ATTEMPT" data-g9-level="REQUIRED" data-g9-presentation="ATTEMPT"><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your answer<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></div></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-representation" data-blueprint-slot="representation" data-required="false"></section><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-component g9-c-ladder" data-g9-component="HINT_LADDER" data-g9-level="REQUIRED" data-g9-presentation="LADDER" data-g9-component-items="3"><details class="g9-secondary-disclosure" data-g9-secondary="core2-hints"><summary>Need a hint? · guided support</summary><div class="g9-secondary-body"><div class="g9-eyebrow">Hint ladder · reveal only what you need</div><div class="g9-block" data-g9-block="authored_core2_support"><h4>Guided support</h4><div class="g9-ladder" data-g9-ladder-ref="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-group="AUTHORED_CORE2_PROMPT_REVEAL"><ol data-g9-ladder></ol><ol class="g9-rung-map" aria-label="Rungs still to come"><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div></li></ol><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-AUTHORED_CORE2_PROMPT_REVEAL-1"><li data-g9-rung="1" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[0]" data-g9-support-reveals="CONCEPT" data-g9-support-kind="REPRESENT" data-g9-supports-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-1"><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Substitute P=(5,1) into the projectile trajectory equation.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-AUTHORED_CORE2_PROMPT_REVEAL-2"><li data-g9-rung="2" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[1]" data-g9-support-reveals="METHOD" data-g9-support-kind="CONNECT" data-g9-supports-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-2"><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>For theta=45°, solve for v before assessing the apex.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-AUTHORED_CORE2_PROMPT_REVEAL-3"><li data-g9-rung="3" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[2]" data-g9-support-reveals="METHOD" data-g9-support-kind="EXECUTE" data-g9-supports-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-3"><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Use the trajectory slope or vertical velocity at x=5 to locate the apex relative to P.</p></div></li></template><button type="button" data-g9-next-rung>Show guided support</button></div></div></div></details></div><div class="g9-component g9-c-link-list" data-g9-component="CONCEPT_NAV" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="concept_navigation"><h4>Need the concept again?</h4><ul><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Select the gravity-only projectile model before using projectile consequences</a></li><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEADV-2026-P1-Q06" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" href="#g9-CORE1A--MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS">Split one plane-motion event into independent x/y components with one clock</a></li></ul></div></div></section></div></div><section class="blueprint-slot slot-solution" data-blueprint-slot="solution" data-required="true"><div class="g9-component g9-c-disclosure" data-g9-component="SOLUTION" data-g9-level="REQUIRED" data-g9-presentation="DISCLOSURE"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-solution"><summary>Answer and working</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2-PYQ-PHY-JEEADV-2026-P1-Q06-solution"><div class="g9-component g9-c-step-list" data-g9-component="SOLUTION_STEPS" data-g9-level="REQUIRED" data-g9-presentation="STEP_LIST" data-g9-component-items="4"><div class="g9-block" data-g9-block="structured_working"><h4>Reasoning route</h4><section class="g9-solution-move" data-g9-solution-order="1" data-g9-solution-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-1" data-g9-solution-kind="REPRESENT" data-g9-solution-stage="REPRESENT" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">1</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Represent</h4><p data-g9-solution-action>Use y=x tan(theta)-g x^2/[2v^2 cos^2(theta)] at P=(5,1). For theta=45°, this gives v^2=25g/4, so v=5sqrt(g)/2; (A) is true.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 1</p></div></section><section class="g9-solution-move" data-g9-solution-order="2" data-g9-solution-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-2" data-g9-solution-kind="CONNECT" data-g9-solution-stage="CONNECT" data-g9-solution-crux="true"><div class="g9-step-no" aria-hidden="true">2</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Connect</h4><p class="g9-prov" data-g9-crux-label>Key move</p><p data-g9-solution-action>For the same 45° case, the slope of the path at x = 5 m is tan θ − g x/(v² cos² θ) = 1 − 5g/((25g/4)(1/2)) = 1 − 1.6 = −0.6 &lt; 0, so the projectile is already descending at P and the apex was passed before P; (B) is true.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 2</p></div></section><section class="g9-solution-move" data-g9-solution-order="3" data-g9-solution-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-3" data-g9-solution-kind="TRANSFORM" data-g9-solution-stage="CALCULATE" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">3</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Calculate</h4><p data-g9-solution-action>For θ = 30°: 1 = 5 tan 30° − 25g/(2v² cos² 30°) gives 25g/(1.5v²) = 2.887 − 1 = 1.887, so v² ≈ 8.83g. The slope at x = 5 m is tan 30° − 5g/(v² cos² 30°) ≈ 0.577 − 5/(8.83 × 0.75) ≈ 0.577 − 0.755 = −0.18 &lt; 0, so the apex is before P and (C) is false.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> (C) is false.</p></div></section><section class="g9-solution-move" data-g9-solution-order="4" data-g9-solution-move="PYQ-PHY-JEEADV-2026-P1-Q06-MOVE-4" data-g9-solution-kind="VERIFY" data-g9-solution-stage="INTERPRET" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">4</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Interpret</h4><p data-g9-solution-action>For θ = tan⁻¹(1/5), the straight-line term x tan θ = 5 × 1/5 = 1 m already equals y at P, so the gravity term g x²/(2v² cos² θ) would have to be zero; no finite v does this, and (D) is false.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>θ = tan⁻¹(1/5)</li><li>P = (5 m, 1 m)</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the source-matched physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> Options (A) and (B).</p></div></section></div></div><div class="g9-component g9-c-answer-box" data-g9-component="ANSWER" data-g9-level="REQUIRED" data-g9-presentation="ANSWER_BOX"><div class="g9-block" data-g9-block="answer"><p>Options (A) and (B).</p></div></div><div class="g9-component g9-c-check-box" data-g9-component="CHECK" data-g9-level="EXPECTED" data-g9-presentation="CHECK_BOX"><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The official final key marks AB.</p></div></div></template></div></section></article><article id="g9-CORE2--PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-unit="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-kind="QUESTION" data-g9-role="CORE2" data-g9-search-text="Physics Motion in 2 D Select the gravity-only projectile model before using projectile consequences Medium concept Multi-step reasoning Motion in 2D component and projectile practice Single-correct multiple choice JEE (Advanced) 2013 · Paper 1 · Q7 Verified past-exam adaptation A particle of mass m is projected from the ground with speed u0 at angle alpha. At the highest point of its trajectory it undergoes a completely inelastic collision with an identical particle that has been thrown vertically upward from the ground with the same initial speed u0. Find the angle made by the composite body with the horizontal immediately after collision. The first collision occurs at the highest point of the oblique projectile. The second particle has the same mass and the same launch-speed magnitude u0. The collision is completely inelastic. (A) pi/4 (B) pi/4 + alpha (C) pi/2 - alpha (D) pi/2" class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-component g9-c-header" data-g9-component="IDENTITY" data-g9-level="REQUIRED" data-g9-presentation="HEADER"><div class="g9-block" data-g9-block="source_identity"><h2>JEE (Advanced) · 2013 · Paper 1 · Q7</h2><p class="g9-prov">Official past paper, faithful restatement of the original</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2" data-g9-meta-record="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-KIN-2D-MOTION" data-g9-meta-value="Motion in 2 D"><strong>Topic:</strong> <span data-g9-meta-label>Motion in 2 D</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-meta-value="Select the gravity-only projectile model before using projectile consequences"><strong>Concept:</strong> <span data-g9-meta-label>Select the gravity-only projectile model before using projectile consequences</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-KIN-2D-PRACTICE" data-g9-meta-value="Motion in 2D component and projectile practice"><strong>Family:</strong> <span data-g9-meta-label>Motion in 2D component and projectile practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-meta-value="single_correct_mcq"><strong>Question type:</strong> <span data-g9-meta-label>Single-correct multiple choice</span></span><span data-g9-meta-item data-g9-meta-kind="source" data-g9-meta-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-meta-value="JEE (Advanced) 2013 · Paper 1 · Q7"><strong>Source:</strong> <span data-g9-meta-label>JEE (Advanced) 2013 · Paper 1 · Q7</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-meta-value="PYQ_ADAPTED"><strong>Provenance:</strong> <span data-g9-meta-label>Verified past-exam adaptation</span></span></div></div><div class="g9-component g9-c-link-list" data-g9-component="SOURCE_PDF" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="source_pdf"><a class="g9-pdf-link g9-source-pdf" data-g9-source-pdf href="https://jeeadv.ac.in/past_qps/2013_1.pdf" target="_blank" rel="noopener noreferrer" type="application/pdf" aria-label="Open the original past paper as a PDF to print it"><svg class="g9-pdf-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M6 2.5h8l4.5 4.5v14.5H6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 2.5V7h4.5M9 12h6.5M9 15.5h6.5M9 19h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Source paper (PDF)</span></a></div></div><div class="g9-component g9-c-disclosure-grid" data-g9-component="DIFFICULTY_WHY" data-g9-level="EXPECTED" data-g9-presentation="DISCLOSURE_GRID"><button type="button" class="g9-why-toggle" data-g9-toggle aria-expanded="false" aria-controls="g9-why-PYQ-PHY-JEEADV-2013-P1-Q07"><span class="g9-pill g9-pill-band" data-g9-band="D3">D3 · 7/10 · about 3 min</span><span>Why this difficulty?</span></button><div id="g9-why-PYQ-PHY-JEEADV-2013-P1-Q07" class="g9-why" hidden><p>Combines an apex projectile state, equal-height speed inference, and a completely inelastic vector-momentum collision.</p><div class=g9-dgrid><div class="g9-dcell"><span>Choosing the model</span><b>2/2</b></div><div class="g9-dcell"><span>Representation</span><b>2/2</b></div><div class="g9-dcell"><span>Reasoning chain</span><b>1/2</b></div><div class="g9-dcell"><span>Algebra and numbers</span><b>1/2</b></div><div class="g9-dcell"><span>Traps and exceptions</span><b>1/2</b></div></div></div></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-component g9-c-stem" data-g9-component="STEM" data-g9-level="REQUIRED" data-g9-presentation="STEM"><div class="g9-eyebrow">Attempt first</div><div class="g9-block" data-g9-block="stem"><p>A particle of mass m is projected from the ground with speed u0 at angle alpha. At the highest point of its trajectory it undergoes a completely inelastic collision with an identical particle that has been thrown vertically upward from the ground with the same initial speed u0. Find the angle made by the composite body with the horizontal immediately after collision.</p></div></div><div class="g9-component g9-c-callout-info" data-g9-component="CONDITIONS" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_INFO"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The first collision occurs at the highest point of the oblique projectile.</li><li>The second particle has the same mass and the same launch-speed magnitude u0.</li><li>The collision is completely inelastic.</li></ul></div></div><div class="g9-component g9-c-callout-warn" data-g9-component="TRAP" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_WARN"><details class="g9-secondary-disclosure" data-g9-secondary="core2-wrong-route"><summary>Common wrong route · open if you want a warning</summary><div class="g9-secondary-body"><div class="g9-block" data-g9-block="common_wrong_route"><h4>Common wrong route</h4><p>Using the second particle&#x27;s launch speed u0 as its collision speed instead of accounting for its rise to the collision height.</p></div></div></details></div><div class="g9-component g9-c-attempt" data-g9-component="ATTEMPT" data-g9-level="REQUIRED" data-g9-presentation="ATTEMPT"><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your answer<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></div></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-representation" data-blueprint-slot="representation" data-required="false"></section><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-component g9-c-ladder" data-g9-component="HINT_LADDER" data-g9-level="REQUIRED" data-g9-presentation="LADDER" data-g9-component-items="3"><details class="g9-secondary-disclosure" data-g9-secondary="core2-hints"><summary>Need a hint? · guided support</summary><div class="g9-secondary-body"><div class="g9-eyebrow">Hint ladder · reveal only what you need</div><div class="g9-block" data-g9-block="authored_core2_support"><h4>Guided support</h4><div class="g9-ladder" data-g9-ladder-ref="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-group="AUTHORED_CORE2_PROMPT_REVEAL"><ol data-g9-ladder></ol><ol class="g9-rung-map" aria-label="Rungs still to come"><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div></li></ol><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-AUTHORED_CORE2_PROMPT_REVEAL-1"><li data-g9-rung="1" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[0]" data-g9-support-reveals="CONCEPT" data-g9-support-kind="REPRESENT" data-g9-supports-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-1"><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>At the first particle&#x27;s apex, write its remaining velocity component.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-AUTHORED_CORE2_PROMPT_REVEAL-2"><li data-g9-rung="2" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[1]" data-g9-support-reveals="METHOD" data-g9-support-kind="CONNECT" data-g9-supports-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-2"><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Use the common collision height to determine the vertical particle&#x27;s speed there.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-AUTHORED_CORE2_PROMPT_REVEAL-3"><li data-g9-rung="3" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[2]" data-g9-support-reveals="METHOD" data-g9-support-kind="EXECUTE" data-g9-supports-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-3"><div class="g9-rung-head"><span class="g9-rung-no">H2</span><span class="g9-rung-label" data-g9-support-stage-label>Carry out</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Add the two equal, perpendicular incoming momenta vectorially.</p></div></li></template><button type="button" data-g9-next-rung>Show guided support</button></div></div></div></details></div><div class="g9-component g9-c-link-list" data-g9-component="CONCEPT_NAV" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="concept_navigation"><h4>Need the concept again?</h4><ul><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Select the gravity-only projectile model before using projectile consequences</a></li><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEADV-2013-P1-Q07" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" href="#g9-CORE1A--MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS">Split one plane-motion event into independent x/y components with one clock</a></li></ul></div></div></section></div></div><section class="blueprint-slot slot-solution" data-blueprint-slot="solution" data-required="true"><div class="g9-component g9-c-disclosure" data-g9-component="SOLUTION" data-g9-level="REQUIRED" data-g9-presentation="DISCLOSURE"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-solution"><summary>Answer and working</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2-PYQ-PHY-JEEADV-2013-P1-Q07-solution"><div class="g9-component g9-c-step-list" data-g9-component="SOLUTION_STEPS" data-g9-level="REQUIRED" data-g9-presentation="STEP_LIST" data-g9-component-items="3"><div class="g9-block" data-g9-block="structured_working"><h4>Reasoning route</h4><section class="g9-solution-move" data-g9-solution-order="1" data-g9-solution-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-1" data-g9-solution-kind="REPRESENT" data-g9-solution-stage="REPRESENT" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">1</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Represent</h4><p data-g9-solution-action>At the first particle&#x27;s apex, its speed is purely horizontal with magnitude u0 cos(alpha).</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from projectile energy/kinematics and momentum conservation in the source-matched collision.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 1</p></div></section><section class="g9-solution-move" data-g9-solution-order="2" data-g9-solution-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-2" data-g9-solution-kind="CONNECT" data-g9-solution-stage="CONNECT" data-g9-solution-crux="true"><div class="g9-step-no" aria-hidden="true">2</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Connect</h4><p class="g9-prov" data-g9-crux-label>Key move</p><p data-g9-solution-action>The collision height is H=u0^2 sin^2(alpha)/(2g). A second identical particle launched vertically upward from the ground with speed u0 has speed sqrt(u0^2-2gH)=u0 cos(alpha) at that height.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from projectile energy/kinematics and momentum conservation in the source-matched collision.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 2</p></div></section><section class="g9-solution-move" data-g9-solution-order="3" data-g9-solution-move="PYQ-PHY-JEEADV-2013-P1-Q07-MOVE-3" data-g9-solution-kind="TRANSFORM" data-g9-solution-stage="CALCULATE" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">3</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Calculate</h4><p data-g9-solution-action>The two equal masses therefore bring equal-magnitude perpendicular momenta into a completely inelastic collision, so the composite momentum bisects the right angle and makes angle pi/4 with the horizontal.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from projectile energy/kinematics and momentum conservation in the source-matched collision.</p><p data-g9-solution-output><strong>Result:</strong> Option (A): pi/4.</p></div></section></div></div><div class="g9-component g9-c-answer-box" data-g9-component="ANSWER" data-g9-level="REQUIRED" data-g9-presentation="ANSWER_BOX"><div class="g9-block" data-g9-block="answer"><p>Option (A): pi/4.</p></div></div><div class="g9-component g9-c-check-box" data-g9-component="CHECK" data-g9-level="EXPECTED" data-g9-presentation="CHECK_BOX"><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Both incoming momentum components have magnitude m u0 <span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>cos</mi><mo>\u2061</mo><mo stretchy="false">(</mo><mi>a</mi><mi>l</mi><mi>p</mi><mi>h</mi><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\\cos (alpha)</annotation></semantics></math></span>, so the post-collision resultant has equal horizontal and vertical components.</p></div></div></template></div></section></article><article id="g9-CORE2--PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-unit="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-kind="QUESTION" data-g9-role="CORE2" data-g9-search-text="Physics Motion in 2 D Split one plane-motion event into independent x/y components with one clock Medium concept Connected reasoning Motion in 2D component and projectile practice Single-correct multiple choice JEE Main 2026 · 04 Apr · Shift 2 · Q29 Verified past-exam adaptation A projectile has coordinates x=24t and y=43.6t-4.9t^2, with x and y in metres and t in seconds. What angle does its velocity vector make with the horizontal at t=2 s? 60° 45° 30° 75°" class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-component g9-c-header" data-g9-component="IDENTITY" data-g9-level="REQUIRED" data-g9-presentation="HEADER"><div class="g9-block" data-g9-block="source_identity"><h2>JEE Main · 2026 · Session 2 · 04 Apr 2026 · Shift 2 · Q29</h2><p class="g9-prov">Official past paper, faithful restatement of the original</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2" data-g9-meta-record="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-KIN-2D-MOTION" data-g9-meta-value="Motion in 2 D"><strong>Topic:</strong> <span data-g9-meta-label>Motion in 2 D</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" data-g9-meta-value="Split one plane-motion event into independent x/y components with one clock"><strong>Concept:</strong> <span data-g9-meta-label>Split one plane-motion event into independent x/y components with one clock</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-KIN-2D-PRACTICE" data-g9-meta-value="Motion in 2D component and projectile practice"><strong>Family:</strong> <span data-g9-meta-label>Motion in 2D component and projectile practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-meta-value="single_correct_mcq"><strong>Question type:</strong> <span data-g9-meta-label>Single-correct multiple choice</span></span><span data-g9-meta-item data-g9-meta-kind="source" data-g9-meta-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-meta-value="JEE Main 2026 · 04 Apr · Shift 2 · Q29"><strong>Source:</strong> <span data-g9-meta-label>JEE Main 2026 · 04 Apr · Shift 2 · Q29</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-meta-value="PYQ_ADAPTED"><strong>Provenance:</strong> <span data-g9-meta-label>Verified past-exam adaptation</span></span></div></div><div class="g9-component g9-c-link-list" data-g9-component="SOURCE_PDF" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="source_pdf"><a class="g9-pdf-link g9-source-pdf" data-g9-source-pdf href="https://cdnbbsr.s3waas.gov.in/s3f8e59f4b2fe7c5705bf878bbd494ccdf/uploads/2026/04/20260409432593766.pdf" target="_blank" rel="noopener noreferrer" type="application/pdf" aria-label="Open the original past paper as a PDF to print it"><svg class="g9-pdf-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M6 2.5h8l4.5 4.5v14.5H6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 2.5V7h4.5M9 12h6.5M9 15.5h6.5M9 19h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Source paper (PDF)</span></a></div></div><div class="g9-component g9-c-disclosure-grid" data-g9-component="DIFFICULTY_WHY" data-g9-level="EXPECTED" data-g9-presentation="DISCLOSURE_GRID"><button type="button" class="g9-why-toggle" data-g9-toggle aria-expanded="false" aria-controls="g9-why-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29"><span class="g9-pill g9-pill-band" data-g9-band="D2">D2 · 3/10 · about 1 min</span><span>Why this difficulty?</span></button><div id="g9-why-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" class="g9-why" hidden><p>Directly translates parametric position into velocity components and then into a direction.</p><div class=g9-dgrid><div class="g9-dcell"><span>Choosing the model</span><b>1/2</b></div><div class="g9-dcell"><span>Representation</span><b>1/2</b></div><div class="g9-dcell"><span>Reasoning chain</span><b>1/2</b></div><div class="g9-dcell"><span>Algebra and numbers</span><b>0/2</b></div><div class="g9-dcell"><span>Traps and exceptions</span><b>0/2</b></div></div></div></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-component g9-c-stem" data-g9-component="STEM" data-g9-level="REQUIRED" data-g9-presentation="STEM"><div class="g9-eyebrow">Attempt first</div><div class="g9-block" data-g9-block="stem"><p>A projectile has coordinates x=24t and y=43.6t-4.9t^2, with x and y in metres and t in seconds. What angle does its velocity vector make with the horizontal at t=2 s?</p></div></div><div class="g9-component g9-c-callout-warn" data-g9-component="TRAP" data-g9-level="EXPECTED" data-g9-presentation="CALLOUT_WARN"><details class="g9-secondary-disclosure" data-g9-secondary="core2-wrong-route"><summary>Common wrong route · open if you want a warning</summary><div class="g9-secondary-body"><div class="g9-block" data-g9-block="common_wrong_route"><h4>Common wrong route</h4><p>Using y/x at t=2 s instead of differentiating to obtain the instantaneous velocity direction.</p></div></div></details></div><div class="g9-component g9-c-attempt" data-g9-component="ATTEMPT" data-g9-level="REQUIRED" data-g9-presentation="ATTEMPT"><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your answer<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></div></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-representation" data-blueprint-slot="representation" data-required="false"></section><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-component g9-c-ladder" data-g9-component="HINT_LADDER" data-g9-level="REQUIRED" data-g9-presentation="LADDER" data-g9-component-items="2"><details class="g9-secondary-disclosure" data-g9-secondary="core2-hints"><summary>Need a hint? · guided support</summary><div class="g9-secondary-body"><div class="g9-eyebrow">Hint ladder · reveal only what you need</div><div class="g9-block" data-g9-block="authored_core2_support"><h4>Guided support</h4><div class="g9-ladder" data-g9-ladder-ref="CORE2-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-group="AUTHORED_CORE2_PROMPT_REVEAL"><ol data-g9-ladder></ol><ol class="g9-rung-map" aria-label="Rungs still to come"><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div></li><li data-g9-rung-ghost><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div></li></ol><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-AUTHORED_CORE2_PROMPT_REVEAL-1"><li data-g9-rung="1" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[0]" data-g9-support-reveals="CONCEPT" data-g9-support-kind="REPRESENT" data-g9-supports-move="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-MOVE-1"><div class="g9-rung-head"><span class="g9-rung-no">H0</span><span class="g9-rung-label" data-g9-support-stage-label>Represent</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>The question asks for the direction of velocity, so differentiate both coordinate functions first.</p></div></li></template><template data-g9-rung-payload="CORE2-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-AUTHORED_CORE2_PROMPT_REVEAL-2"><li data-g9-rung="2" data-g9-support-provenance="AUTHORED_CORE2_PROMPT_REVEAL" data-g9-support-source="scaffolds[1]" data-g9-support-reveals="METHOD" data-g9-support-kind="CONNECT" data-g9-supports-move="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-MOVE-2"><div class="g9-rung-head"><span class="g9-rung-no">H1</span><span class="g9-rung-label" data-g9-support-stage-label>Connect</span><span class="g9-pill g9-pill-guided">Guided</span></div><div data-g9-support-reveal><p>Use <span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>tan</mi><mo>\u2061</mo><mo stretchy="false">(</mo><mi>t</mi><mi>h</mi><mi>e</mi><mi>t</mi><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\\tan (theta)</annotation></semantics></math></span>=<span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>v</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">v_{y}</annotation></semantics></math></span>/<span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>v</mi><mi>x</mi></msub></mrow><annotation encoding="application/x-tex">v_{x}</annotation></semantics></math></span> only after evaluating both components at t=2 s.</p></div></li></template><button type="button" data-g9-next-rung>Show guided support</button></div></div></div></details></div><div class="g9-component g9-c-link-list" data-g9-component="CONCEPT_NAV" data-g9-level="OPTIONAL" data-g9-presentation="LINK_LIST"><div class="g9-block" data-g9-block="concept_navigation"><h4>Need the concept again?</h4><ul><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" href="#g9-CORE1A--MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS">Split one plane-motion event into independent x/y components with one clock</a></li><li><a data-g9-concept-link data-g9-question-ref="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Select the gravity-only projectile model before using projectile consequences</a></li></ul></div></div></section></div></div><section class="blueprint-slot slot-solution" data-blueprint-slot="solution" data-required="true"><div class="g9-component g9-c-disclosure" data-g9-component="SOLUTION" data-g9-level="REQUIRED" data-g9-presentation="DISCLOSURE"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-solution"><summary>Answer and working</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2-PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-solution"><div class="g9-component g9-c-step-list" data-g9-component="SOLUTION_STEPS" data-g9-level="REQUIRED" data-g9-presentation="STEP_LIST" data-g9-component-items="3"><div class="g9-block" data-g9-block="structured_working"><h4>Reasoning route</h4><section class="g9-solution-move" data-g9-solution-order="1" data-g9-solution-move="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-MOVE-1" data-g9-solution-kind="REPRESENT" data-g9-solution-stage="REPRESENT" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">1</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Represent</h4><p data-g9-solution-action>Differentiate the coordinate laws: v_x=dx/dt=24 m/s and v_y=dy/dt=43.6-9.8t.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the stated source quantities and the preserved physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 1</p></div></section><section class="g9-solution-move" data-g9-solution-order="2" data-g9-solution-move="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-MOVE-2" data-g9-solution-kind="CONNECT" data-g9-solution-stage="CONNECT" data-g9-solution-crux="true"><div class="g9-step-no" aria-hidden="true">2</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Connect</h4><p class="g9-prov" data-g9-crux-label>Key move</p><p data-g9-solution-action>At t=2 s, v_y=43.6-19.6=24 m/s.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the stated source quantities and the preserved physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> intermediate result 2</p></div></section><section class="g9-solution-move" data-g9-solution-order="3" data-g9-solution-move="PYQ-PHY-JEEMAIN-2026-04APR-S2-Q29-MOVE-3" data-g9-solution-kind="TRANSFORM" data-g9-solution-stage="CALCULATE" data-g9-solution-crux="false"><div class="g9-step-no" aria-hidden="true">3</div><div class="g9-step-body"><h4 data-g9-solution-stage-label>Calculate</h4><p data-g9-solution-action>Thus tan(theta)=v_y/v_x=1, so theta=45°.</p><div class="g9-block" data-g9-block="solution_inputs"><h4>Uses</h4><ul><li>stated source quantities</li></ul></div><p data-g9-solution-why><em>Why valid:</em> This follows from the stated source quantities and the preserved physical or chemical model.</p><p data-g9-solution-output><strong>Result:</strong> 45°.</p></div></section></div></div><div class="g9-component g9-c-answer-box" data-g9-component="ANSWER" data-g9-level="REQUIRED" data-g9-presentation="ANSWER_BOX"><div class="g9-block" data-g9-block="answer"><p>45°.</p></div></div><div class="g9-component g9-c-check-box" data-g9-component="CHECK" data-g9-level="EXPECTED" data-g9-presentation="CHECK_BOX"><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Equal positive horizontal and vertical velocity components at t=2 s require a 45° direction in the first quadrant.</p></div></div></template></div></section></article></section><section id="g9-role-CORE2A" data-g9-role-section="CORE2A"><h1>Two-dimensional kinematics and projectile model: Supported practice</h1><article id="g9-CORE2A--Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-unit="Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A tracker reports x(t)=4t metres and y(t)=10-2t^2 metres for one particle in one fixed frame. Find the particle&#x27;s position at t=2 s, and explain why x(2 s) may not be paired with y(3 s) to describe one position." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A tracker reports x(t)=4t metres and y(t)=10-2t^2 metres for one particle in one fixed frame. Find the particle&#x27;s position at t=2 s, and explain why x(2 s) may not be paired with y(3 s) to describe one position.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The two functions refer to the same particle and the same time coordinate.</li><li>Use the declared fixed x-y frame.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Treat x(t) and y(t) as two coordinate projections of the same particle in one fixed frame, tied to one common event time t.<br><em>Why valid:</em> A single plane position is defined by simultaneous coordinates of one particle; independent component functions do not create independent clocks.</li><li><strong>TRANSFORM</strong> Substitute t=2 s into both component functions to obtain x(2)=8 m and y(2)=2 m.<br><em>Why valid:</em> The requested state is the event labelled t=2 s, so both component functions must be sampled at that event.</li><li><strong>CONNECT</strong> Pair the two simultaneous values as the position (8,2) m and reject x(2) paired with y(3) as a single physical state.<br><em>Why valid:</em> Coordinates form one state only when they refer to the same object, frame and instant; changing one timestamp changes the event.</li><li><strong>VERIFY</strong> Attach the timestamp to each component value and confirm the two timestamps match before calling the pair a position.<br><em>Why valid:</em> Timestamp agreement is an independent event-identity check that does not depend on the arithmetic values themselves.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Evaluate both component descriptions at the same requested time.</li><li>x(2)=4(2)=8.</li><li>y(2)=10-2(2^2)=2.</li><li>A physical plane state is a simultaneous component pair.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>At t=2 s, x=8 m and y=2 m, so the position is (8,2) m in the declared frame. x(2 s) and y(3 s) cannot form one position because they refer to different instants.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The answer must use one t for both components; mixing timestamps produces no real single-time state.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D1-4" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" data-g9-repair-target="CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1" href="#g9-CORE1A--CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1">Revisit: Recombine only component values that refer to the same frame and the same instant.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored"><ol data-g9-ladder><li data-g9-rung="1">What must be the same when x(t) and y(t) describe one particle at one instant?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-2"><li data-g9-rung="2">Write x(t) and y(t) in two columns connected to one clock t before substituting any number.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-3"><li data-g9-rung="3">Evaluate both component functions at the requested t before pairing them.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-4"><li data-g9-rung="4">Label the time beside each evaluated component before you pair the coordinates.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-unit="Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A particle starts with velocity (3 i + 4 j) m/s and has constant acceleration (2 i - 1 j) m/s^2 for 3 s. Find its velocity and displacement after 3 s." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A particle starts with velocity (3 i + 4 j) m/s and has constant acceleration (2 i - 1 j) m/s^2 for 3 s. Find its velocity and displacement after 3 s.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Both acceleration components are constant over the 3 s interval.</li><li>The initial position is irrelevant because the question asks for displacement.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Resolve the vectors into u_x=3, u_y=4, a_x=2 and a_y=-1, with the same elapsed time 3 s on both axes.<br><em>Why valid:</em> Component kinematics is valid only after the signed components and common physical interval are explicit.</li><li><strong>CONNECT</strong> Apply v=u+at and displacement=ut+(1/2)at^2 separately to x and y while preserving signs and the common time.<br><em>Why valid:</em> The given acceleration vector is constant, so each Cartesian acceleration component is constant over the same interval and the 1D relations apply component-wise.</li><li><strong>TRANSFORM</strong> Compute v_x=9, v_y=1, Delta x=18 and Delta y=7.5 from the two component equations.<br><em>Why valid:</em> Substitution into the component equations preserves the negative y acceleration instead of replacing signed components by magnitudes.</li><li><strong>VERIFY</strong> Check units and signs axis by axis, then confirm both vector components refer to the same 3 s endpoint.<br><em>Why valid:</em> Unit consistency detects relation misuse and the common-endpoint check prevents combining component states from different times.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Use v_x=3+2(3)=9 and v_y=4-1(3)=1.</li><li>Use Delta x=3(3)+0.5(2)(3^2)=18.</li><li>Use Delta y=4(3)+0.5(-1)(3^2)=7.5.</li><li>Both axes use the same 3 s interval.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>v=(9 i + 1 j) m/s and Delta r=(18 i + 7.5 j) m.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Each axis uses only its own signed component values; units are m/s for velocity and m for displacement.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D2-2" data-g9-concept-ref="MIC-PHY-KIN-2D-CONSTANT-ACCELERATION" data-g9-repair-target="CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1" href="#g9-CORE1A--CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1">Revisit: Apply the one-dimensional constant-acceleration relations independently to x and y using only that axis&#x27;s signed values and the same t.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored"><ol data-g9-ladder><li data-g9-rung="1">Write the x and y initial velocity and acceleration values separately before calculating.</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-2"><li data-g9-rung="2">Make a signed table for u_x, u_y, a_x and a_y before choosing equations.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-3"><li data-g9-rung="3">Apply the same 1D constant-acceleration relation independently on each axis using the common 3 s.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-4"><li data-g9-rung="4">Run the constant-acceleration relation once on x and once on y while keeping one shared 3 s interval.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-unit="Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="An ideal projectile is launched with already-resolved components u_x=12 m/s and u_y=20 m/s. Take +y upward and g=10 m/s^2. Find the time to the apex, the velocity at the apex, the acceleration at the apex, and the height gained above launch." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile is launched with already-resolved components u_x=12 m/s and u_y=20 m/s. Take +y upward and g=10 m/s^2. Find the time to the apex, the velocity at the apex, the acceleration at the apex, and the height gained above launch.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>After release, gravity is the only retained force.</li><li>The given initial components are already resolved.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent ideal flight with a_x=0, a_y=-g, constant v_x=u_x and v_y=u_y-gt in the upward-positive frame.<br><em>Why valid:</em> Gravity-only free flight leaves horizontal velocity constant while vertical velocity changes under a constant downward acceleration.</li><li><strong>DECIDE</strong> Identify the apex by v_y=0, not by setting the full velocity or acceleration to zero.<br><em>Why valid:</em> At a vertical turning point v_y changes sign, while horizontal motion continues and gravity remains present.</li><li><strong>TRANSFORM</strong> Solve t=2 s, then evaluate velocity, acceleration and height gain at that same event time.<br><em>Why valid:</em> Every requested quantity describes the same apex event, so the time obtained from v_y=0 must be reused across both components.</li><li><strong>VERIFY</strong> Confirm that only v_y vanishes at the apex while v_x and downward acceleration remain nonzero.<br><em>Why valid:</em> This component check distinguishes a vertical turning point from the false claim that the projectile stops or gravity vanishes.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>At the apex set v_y=u_y-gt=0, so t=20/10=2 s.</li><li>Horizontal acceleration is zero, so v_x remains 12 m/s.</li><li>Gravity still acts at the apex, so a_y=-10 m/s^2.</li><li>Delta y=20(2)-0.5(10)(2^2)=20 m.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The apex occurs at t=2 s. There v=(12 i + 0 j) m/s, a=(0 i - 10 j) m/s^2, and the height gained is 20 m.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Only v_y is zero at the apex; neither the full velocity nor the acceleration is zero.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-4" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For an apex event, set v_y=0 while keeping v_x=u_x and a_y=-g.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored"><ol data-g9-ladder><li data-g9-rung="1">Which component condition defines the apex?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-2"><li data-g9-rung="2">Write separate horizontal and vertical rules before deciding what condition defines the top of the path.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-3"><li data-g9-rung="3">Set only v_y to zero, solve for the shared time, then evaluate the other requested quantities at that time.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-4"><li data-g9-rung="4">At the apex, decide which velocity component changes sign and set only that component to zero.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-unit="Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A stone is launched horizontally at 15 m/s from a cliff 20 m above level ground. Take +y upward and g=10 m/s^2. Find the flight time, horizontal range and impact velocity." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A stone is launched horizontally at 15 m/s from a cliff 20 m above level ground. Take +y upward and g=10 m/s^2. Find the flight time, horizontal range and impact velocity.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>The launch has u_y=0.</li><li>Ground is 20 m below the launch point.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent the horizontal and vertical histories in one declared frame with one shared elapsed time, placing the 20 m drop in the vertical component.<br><em>Why valid:</em> The component equations evolve independently but still describe one stone at one physical instant, so the known landing geometry belongs to y while time remains common.</li><li><strong>DECIDE</strong> Use the vertical ground-contact condition Delta y=-20 m to determine the flight time before calculating horizontal range or impact velocity.<br><em>Why valid:</em> Ground impact is defined by the vertical displacement, so the y equation identifies the event time; that one time then belongs to every component at impact.</li><li><strong>CONNECT</strong> Reuse t_event=2 s in the horizontal displacement and both velocity components.<br><em>Why valid:</em> Range and impact velocity must be reconstructed at the same physical event that the vertical equation identified.</li><li><strong>VERIFY</strong> Check that the ideal fall time is set by vertical motion while horizontal speed changes the range but not the vertical landing event.<br><em>Why valid:</em> With a_x=0 and no drag, the vertical event equation contains no horizontal speed.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Use the vertical condition Delta y=-20=0*t-0.5(10)t^2, giving t=2 s.</li><li>Then Delta x=15(2)=30 m.</li><li>v_x=15 m/s and v_y=-10(2)=-20 m/s at impact.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The flight time is 2 s, the horizontal range is 30 m, and the impact velocity is (15 i - 20 j) m/s.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The fall time comes from vertical motion; changing only horizontal speed would change range but not the ideal fall time.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-6" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For any unequal-height landing, use the actual Delta y=y_f-y_i in the vertical position equation and retain the actual u_y; for a horizontal launch specifically, set u_y=0, then obtain the event time vertically and share it with x.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored"><ol data-g9-ladder><li data-g9-rung="1">Which component equation contains the known 20 m drop?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-2"><li data-g9-rung="2">Draw x and y as separate columns tied to one shared t, and place the 20 m drop only in the y column.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-3"><li data-g9-rung="3">Find the common impact time from y first, then use that same time in x and in the velocity components.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-4"><li data-g9-rung="4">Name the physical condition that says the stone has reached the ground before solving for the event time.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-unit="Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="An ideal projectile is launched and later lands at the same height with u_x=12 m/s, u_y=16 m/s and g=8 m/s^2. Find the total flight time, range and landing velocity." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile is launched and later lands at the same height with u_x=12 m/s, u_y=16 m/s and g=8 m/s^2. Find the total flight time, range and landing velocity.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>Launch and landing heights are equal.</li><li>Take +y upward.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent landing at the launch height with Delta y=0 while keeping a_x=0, a_y=-g and one common flight time.<br><em>Why valid:</em> Same launch and landing height fixes the vertical event displacement without changing the gravity-only component model.</li><li><strong>DECIDE</strong> Choose the nonzero root of the vertical event equation as the landing time and reject t=0 as the launch event.<br><em>Why valid:</em> The equation describes two visits to the launch height; event identity selects the later root because the question asks for landing.</li><li><strong>CONNECT</strong> Reuse t=4 s in horizontal displacement and vertical velocity to obtain range and landing velocity.<br><em>Why valid:</em> Range and landing velocity belong to the same landing event identified by the vertical equation.</li><li><strong>VERIFY</strong> Compare launch and landing components: v_x must match while v_y has equal magnitude and opposite sign.<br><em>Why valid:</em> With zero horizontal acceleration and constant downward gravity, return to the same height restores vertical speed magnitude while reversing its direction.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>At landing Delta y=0=16t-0.5(8)t^2; the nonzero root is t=4 s.</li><li>Horizontal velocity stays 12 m/s, so range=12(4)=48 m.</li><li>v_y=16-8(4)=-16 m/s at landing.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The flight time is 4 s, the range is 48 m, and the landing velocity is (12 i - 16 j) m/s.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At the same height, the horizontal component matches launch and the vertical component has equal magnitude with opposite sign.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-5" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For a return to the launch height, set Delta y=0 and treat any same-height flight-time/range shortcut as conditional on that equality.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored"><ol data-g9-ladder><li data-g9-rung="1">What vertical displacement condition is true at a same-height landing?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-2"><li data-g9-rung="2">Write the landing geometry first: identify Delta y when the projectile returns to its launch height.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-3"><li data-g9-rung="3">Use Delta y=0 to obtain the nonzero landing time, then reuse that time in x and v_y.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-4"><li data-g9-rung="4">The vertical equation has a launch root and a later root; identify which event is requested before reusing the time.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article></section><section id="g9-role-CORE2B" data-g9-role-section="CORE2B"><h1>Two-dimensional kinematics and projectile model: Transfer</h1><article id="g9-CORE2B--Q-PHY-KIN-2D-2B-REPRESENTATION-01" data-g9-unit="Q-PHY-KIN-2D-2B-REPRESENTATION-01" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="A particle is described verbally: at t=0 it is at the origin, moving east at 6 m/s and north at 2 m/s; during the next interval its acceleration is 3 m/s^2 south and zero east-west. Without being given component equations, choose a coordinate convention and write the signed component state that should be used for later calculation." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-KIN-2D-2B-REPRESENTATION-01" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="stem"><h2>A particle is described verbally: at t=0 it is at the origin, moving east at 6 m/s and north at 2 m/s; during the next interval its acceleration is 3 m/s^2 south and zero east-west. Without being given component equations, choose a coordinate convention and write the signed component state that should be used for later calculation.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-KIN-2D-2A-SHARED-CLOCK-01">A tracker reports x(t)=4t metres and y(t)=10-2t^2 metres for one particle in one fixed…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Use one fixed Cartesian frame.</li><li>The verbal directions must be translated into signed components before calculation.</li></ul></div><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Before writing numbers, which two perpendicular positive directions will you declare?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-KIN-2D-2B-REPRESENTATION-01-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-KIN-2D-2B-REPRESENTATION-01-review"><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must convert a verbal direction description into signed x/y state without being handed the component representation.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Choose and declare one perpendicular positive-axis convention before converting the directional facts into signed components.</p></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>One valid choice is +x east and +y north, giving u_x=+6 m/s, u_y=+2 m/s, a_x=0 and a_y=-3 m/s^2, all with one common t.</p><ol><li>Declare +x east and +y north.</li><li>Translate each direction into a sign in that frame.</li><li>Keep the same frame and clock for both component histories.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Declares a single Cartesian frame before assigning signs.</li><li>Translates east/north/south statements into consistent signed components.</li><li>Keeps one common time for the two component histories.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Any consistently declared perpendicular axis convention is acceptable if all signs are transformed consistently.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D1-2" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" data-g9-repair-target="CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1" href="#g9-CORE1A--CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1">Revisit: Represent position, velocity and acceleration as signed x and y components in that same frame.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-KIN-2D-2B-MODEL-VALIDITY-02" data-g9-unit="Q-PHY-KIN-2D-2B-MODEL-VALIDITY-02" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Over 0&lt;=t&lt;=4 s, a particle has a_x=2 m/s^2 but a_y=3t m/s^2. Decide whether the ordinary constant-acceleration equations may be used exactly on x, on y, on both, or on neither over the whole interval. Explain the model choice before doing any further calculation." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-KIN-2D-2B-MODEL-VALIDITY-02" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="stem"><h2>Over 0&lt;=t&lt;=4 s, a particle has a_x=2 m/s^2 but a_y=3t m/s^2. Decide whether the ordinary constant-acceleration equations may be used exactly on x, on y, on both, or on neither over the whole interval. Explain the model choice before doing any further calculation.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02">A particle starts with velocity (3 i + 4 j) m/s and has constant acceleration (2 i - 1…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The acceleration components are given as functions of time.</li><li>No numerical integration is required; the task is model selection.</li></ul></div><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Is &#x27;constant acceleration&#x27; one global label here, or must each component be checked over the interval?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-KIN-2D-2B-MODEL-VALIDITY-02-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-KIN-2D-2B-MODEL-VALIDITY-02-review"><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must decide component-by-component whether the constant-acceleration model is valid instead of being told that it applies.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Decide separately for each axis whether the constant-acceleration condition is satisfied over the whole interval.</p></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The constant-acceleration equations are exact on x because a_x is constant, but not on y because a_y changes with time over the interval.</p><ol><li>Check each acceleration component separately.</li><li>a_x=2 is constant, so the 1D constant-acceleration x relations are valid.</li><li>a_y=3t varies with time, so the constant-a y relations are not exact over the whole interval.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Checks x and y acceleration components separately.</li><li>Accepts constant-acceleration equations only on x.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>A constant total direction or a constant x component does not make the y component constant.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D2-1" data-g9-concept-ref="MIC-PHY-KIN-2D-CONSTANT-ACCELERATION" data-g9-repair-target="CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1" href="#g9-CORE1A--CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1">Revisit: Check separately whether a_x and a_y are constant over the interval before choosing constant-acceleration equations on either axis.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-KIN-2D-2B-UNEQUAL-HEIGHT-03" data-g9-unit="Q-PHY-KIN-2D-2B-UNEQUAL-HEIGHT-03" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="An ideal projectile begins 15 m above level ground with u_x=10 m/s and u_y=10 m/s. Take +y upward and g=10 m/s^2. Find the ground-impact time and horizontal range. Do not assume launch and landing are at the same height." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-KIN-2D-2B-UNEQUAL-HEIGHT-03" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile begins 15 m above level ground with u_x=10 m/s and u_y=10 m/s. Take +y upward and g=10 m/s^2. Find the ground-impact time and horizontal range. Do not assume launch and landing are at the same height.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-KIN-2D-2A-SAME-HEIGHT-05">An ideal projectile is launched and later lands at the same height with u_x=12 m/s,…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>Ground is 15 m below the launch point.</li><li>The initial velocity components are already resolved.</li></ul></div><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>What vertical displacement identifies ground impact relative to the launch point?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-KIN-2D-2B-UNEQUAL-HEIGHT-03-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-KIN-2D-2B-UNEQUAL-HEIGHT-03-review"><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must replace the familiar same-height condition with an unequal-height event condition and carry the resulting time across axes.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Choose Delta y=-15 m as the impact condition instead of reusing the familiar same-height condition Delta y=0.</p></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Ground impact occurs at t=3 s and the horizontal range is 30 m.</p><ol><li>Use the vertical impact condition Delta y=-15=10t-5t^2.</li><li>Solve 5t^2-10t-15=0, giving the physical root t=3 s.</li><li>Reuse t=3 s horizontally: Delta x=10(3)=30 m.</li><li>The same-height shortcut would use the wrong event condition here.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Uses the actual vertical displacement -15 m rather than a same-height shortcut.</li><li>Reuses the physical impact time in the horizontal equation.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Substitution into the vertical displacement gives -15 m; the nonzero same-height time 2u_y/g=2 s is not the ground-impact time.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-6" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For any unequal-height landing, use the actual Delta y=y_f-y_i in the vertical position equation and retain the actual u_y; for a horizontal launch specifically, set u_y=0, then obtain the event time vertically and share it with x.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-KIN-2D-2B-PROJECTILE-VALIDITY-04" data-g9-unit="Q-PHY-KIN-2D-2B-PROJECTILE-VALIDITY-04" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="An object is launched and, after release, a small rocket motor continues to provide a horizontal thrust that gives a_x=2 m/s^2 while gravity gives a_y=-g. Decide whether the standard ideal projectile specialization a_x=0, a_y=-g is valid and state the correct bounded model to use." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-KIN-2D-2B-PROJECTILE-VALIDITY-04" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="stem"><h2>An object is launched and, after release, a small rocket motor continues to provide a horizontal thrust that gives a_x=2 m/s^2 while gravity gives a_y=-g. Decide whether the standard ideal projectile specialization a_x=0, a_y=-g is valid and state the correct bounded model to use.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04">A stone is launched horizontally at 15 m/s from a cliff 20 m above level ground. Take…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>The horizontal rocket thrust remains active after release.</li><li>The question asks for model selection, not a full trajectory calculation.</li></ul></div><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which post-release assumption makes a_x=0 in the standard projectile model, and is it true here?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-KIN-2D-2B-PROJECTILE-VALIDITY-04-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-KIN-2D-2B-PROJECTILE-VALIDITY-04-review"><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must reject the familiar projectile specialization because one of its defining force/model conditions is explicitly broken.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Reject the standard gravity-only projectile specialization because its defining horizontal-acceleration condition is violated.</p></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The standard ideal projectile specialization is not valid because a_x is not zero. Use the more general 2D constant-acceleration model with a_x=2 m/s^2 and a_y=-g for as long as those components remain constant.</p><ol><li>The standard projectile specialization requires gravity-only free flight.</li><li>The active rocket motor adds a retained horizontal acceleration.</li><li>Therefore use the parent 2D constant-acceleration capability rather than the gravity-only projectile specialization.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Rejects the gravity-only projectile specialization.</li><li>Falls back to the general component constant-acceleration model.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If the motor is switched off after release and drag remains negligible, the standard a_x=0 projectile model becomes valid from that later instant.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-1" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: Decide whether the object is in ideal near-Earth free flight after release; neglect air resistance, declare +y, then set a_x=0 and a_y=-g.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-KIN-2D-2B-SAME-HEIGHT-VELOCITY-05" data-g9-unit="Q-PHY-KIN-2D-2B-SAME-HEIGHT-VELOCITY-05" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="An ideal projectile passes the same height once on the way up and once on the way down. Without calculating the times, compare v_x, v_y, speed and acceleration at those two events." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-KIN-2D-2B-SAME-HEIGHT-VELOCITY-05" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile passes the same height once on the way up and once on the way down. Without calculating the times, compare v_x, v_y, speed and acceleration at those two events.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03">An ideal projectile is launched with already-resolved components u_x=12 m/s and u_y=20…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>Both events occur on the same trajectory at the same vertical position.</li><li>Take +y upward.</li></ul></div><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>At the same height, which horizontal quantity is unchanged throughout ideal flight, and what must differ between ascent and descent?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-KIN-2D-2B-SAME-HEIGHT-VELOCITY-05-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-KIN-2D-2B-SAME-HEIGHT-VELOCITY-05-review"><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must compare two equal-height events by component invariants rather than solve a routine time/range calculation.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Choose direct component invariants at equal height as the comparison method instead of solving for the two event times.</p></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>v_x is the same at both events; v_y has equal magnitude and opposite sign; therefore the speed is the same but the velocity vectors differ. Acceleration is the same (0,-g) at both events.</p><ol><li>Horizontal velocity remains constant because a_x=0.</li><li>At equal height in the same gravity-only trajectory, the vertical speed magnitude matches on ascent and descent, with opposite signs.</li><li>Combining the components gives equal speed magnitudes but different velocity directions.</li><li>Gravity gives the same downward acceleration at both events.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Keeps v_x unchanged across the two events.</li><li>Gives v_y equal magnitude and opposite sign.</li><li>Distinguishes equal speed from equal velocity.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The two velocity vectors cannot be identical because one has upward v_y and the other downward v_y.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-7" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="#g9-CORE1A--MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: At the selected event time, reconstruct the requested velocity, speed, direction, displacement or range from simultaneous components and check qualitative limits.</a></p></div></template></section></div></div></article></section></main><footer data-g9-footer>Physics · Two-dimensional kinematics and projectile model</footer><script>\n(()=>{const q=(s,r=document)=>[...r.querySelectorAll(s)];\nconst store={get:k=>{try{return localStorage.getItem(\'g9-\'+k)}catch(e){return null}},set:(k,v)=>{try{localStorage.setItem(\'g9-\'+k,v);return true}catch(e){return false}},remove:k=>{try{localStorage.removeItem(\'g9-\'+k);return true}catch(e){return false}}};\nconst root=document.documentElement;const scope=root.dataset.g9Product&&root.dataset.g9RenderDigest?root.dataset.g9Product+\':\'+root.dataset.g9RenderDigest:\'\';\nconst shell=document.querySelector(\'.g9-shell-header\');if(shell){const offset=()=>root.style.setProperty(\'--g9-header-offset\',(shell.getBoundingClientRect().height+16)+\'px\');new ResizeObserver(offset).observe(shell);offset();}\nconst apply=()=>{root.dataset.theme=store.get(\'theme\')||root.dataset.theme||\'light\';root.style.setProperty(\'--g9-zoom\',store.get(\'zoom\')||\'1\');};apply();\nq(\'[data-g9-theme]\').forEach(b=>b.onclick=()=>{store.set(\'theme\',b.dataset.g9Theme);apply()});\nq(\'[data-g9-zoom]\').forEach(b=>b.onclick=()=>{let z=parseFloat(store.get(\'zoom\')||\'1\');z=b.dataset.g9Zoom===\'inc\'?Math.min(1.6,z+0.1):b.dataset.g9Zoom===\'dec\'?Math.max(0.8,z-0.1):1;store.set(\'zoom\',z.toFixed(1));apply()});\nq(\'[data-g9-font]\').forEach(b=>b.onclick=()=>q(\'[data-g9-zoom="\'+b.dataset.g9Font+\'"]\')[0]?.click());\nfunction fitFigure(f){const svg=q(\'svg\',f)[0];if(!svg||!svg.isConnected)return;const groups=q(\'[data-g9-stage-id]\',svg).filter(g=>getComputedStyle(g).display!==\'none\');if(groups.length){const boxes=groups.map(g=>g.getBBox()).filter(b=>b.width>0&&b.height>0);if(boxes.length){const x=Math.min(...boxes.map(b=>b.x))-12,y=Math.min(...boxes.map(b=>b.y))-12,r=Math.max(...boxes.map(b=>b.x+b.width))+12,b=Math.max(...boxes.map(b=>b.y+b.height))+12;svg.setAttribute(\'viewBox\',[x,y,r-x,b-y].join(\' \'));}}\nconst host=svg.parentElement;const labels=q(\'text\',svg).filter(t=>t.checkVisibility({visibilityProperty:true}));const min=labels.reduce((v,t)=>Math.min(v,parseFloat(getComputedStyle(t).fontSize)||Infinity),Infinity);const box=svg.viewBox.baseVal;const floor=Number(f.dataset.g9MinFigureText)||14;const needed=Number.isFinite(min)&&min>0?Math.ceil(box.width*floor/min):0;svg.style.width=Math.max(host.clientWidth,needed)+\'px\';}\nfunction initFigure(f){if(f.dataset.g9Init)return;f.dataset.g9Init=\'1\';const ids=(f.dataset.g9Stages||\'\').split(\' \').filter(Boolean);fitFigure(f);const host=q(\'.g9-diagram-scroll\',f)[0];if(host)new ResizeObserver(()=>fitFigure(f)).observe(host);if(ids.length<2)return;let i=0;\nconst chips=q(\'[data-g9-stage-goto]\',f);const desc=q(\'[data-g9-stage-desc-text]\',f)[0];\nconst stageMode=f.dataset.g9StageMode||\'cumulative\';const cumulative=stageMode!==\'replace\';\nids.forEach(id=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=\'none\'));\nconst show=()=>{ids.forEach((id,n)=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=(cumulative?n<=i:n===i)?\'\':\'none\'));fitFigure(f);const l=q(\'[data-g9-stage-label]\',f)[0];if(l)l.textContent=\'Stage \'+(i+1)+\' of \'+ids.length;chips.forEach((c,n)=>c.setAttribute(\'aria-pressed\',String(n===i)));if(desc)desc.textContent=(chips[i]&&chips[i].dataset.g9StageDesc)||\'\'};show();chips.forEach((c,n)=>c.onclick=()=>{i=n;show()});\nq(\'[data-g9-stage-step]\',f).forEach(b=>b.onclick=()=>{i=Math.max(0,Math.min(ids.length-1,i+(b.dataset.g9StageStep===\'next\'?1:-1)));show()})}\nfunction nextRung(l){const t=q(\'template[data-g9-rung-payload]\',l)[0];if(!t)return false;const payload=t.content.cloneNode(true);q(\'[data-g9-rung-ghost]\',l)[0]?.remove();q(\'[data-g9-ladder]\',l)[0].append(payload);q(\'figure[data-g9-figure]\',l).forEach(initFigure);t.remove();const b=q(\'[data-g9-next-rung]\',l)[0];if(b){if(!q(\'template[data-g9-rung-payload]\',l).length)b.disabled=true;else b.textContent=\'Show next support\'}return true}\nfunction materialise(a){q(\'details[data-g9-payload-ref]\',a).forEach(d=>{const slot=q(\'[data-g9-payload-slot]\',d)[0];if(!slot||slot.dataset.g9Filled)return;const t=q(\'template[data-g9-payload]\',a).find(x=>x.dataset.g9Payload===d.dataset.g9PayloadRef);if(!t)return;slot.replaceChildren(t.content.cloneNode(true));slot.dataset.g9Filled=\'1\';q(\'figure[data-g9-figure]\',slot).forEach(initFigure)})}\nconst number=t=>{const v=t.trim();if(!/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?(?:\\s*\\/\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?)?$/i.test(v))return false;const p=v.split(\'/\').map(x=>Number(x.trim()));return p.every(Number.isFinite)&&(p.length===1||p[1]!==0)};\nfunction validAttempt(box){const type=box.dataset.g9ResponseType;if(type===\'single_choice\'||type===\'multiple_choice\'||type===\'true_false\')return q(\'[data-g9-choice]:checked\',box).length>0;\nif(type===\'numeric\')return number(q(\'[data-g9-number]\',box)[0]?.value||\'\');if(type===\'short_text\')return !!q(\'[data-g9-attempt]\',box)[0]?.value.trim();\nif(type===\'match\'){const fields=q(\'[data-g9-match]\',box);return fields.length>0&&fields.every(x=>x.value!==\'\')}\nif(q(\'[data-g9-paper]:checked\',box).length)return true;if(type===\'multipart\'){const fields=q(\'[data-g9-part-input]\',box);return fields.length>0&&fields.every(x=>x.value.trim()&&(!x.dataset.g9PartType||x.dataset.g9PartType!==\'numeric\'||number(x.value)))}\nreturn !!q(\'[data-g9-attempt]\',box)[0]?.value.trim()}\nconst stateKey=a=>scope&&a?.dataset.g9Unit?\'state:\'+scope+\':\'+a.dataset.g9Unit:null;const returnKey=concept=>scope&&concept?\'return:\'+scope+\':\'+concept:null;\nfunction readState(key){if(!key)return null;const raw=store.get(key);if(!raw)return null;try{const state=JSON.parse(raw);return state&&typeof state===\'object\'?state:null}catch(e){return null}}\nconst attemptFields=a=>q(\'[data-g9-attempt-box] input,[data-g9-attempt-box] textarea,[data-g9-attempt-box] select\',a);const rungCount=l=>{const list=q(\'[data-g9-ladder]\',l)[0];return list?q(\'[data-g9-rung]\',list).length:0};\nfunction saveCore2State(a){if(a.dataset.g9Role!==\'CORE2\')return;const key=stateKey(a);if(!key)return;const fields=attemptFields(a).map(el=>({value:el.value,checked:!!el.checked}));const ladders={};q(\'.g9-ladder[data-g9-ladder-ref]\',a).forEach(l=>ladders[l.dataset.g9LadderRef]=rungCount(l));const reveals=q(\'details[data-g9-support-reveal]\',a).map(d=>!!d.open);store.set(key,JSON.stringify({attempted:!!a.dataset.attempted,fields,ladders,reveals}))}\nfunction bindSupportRevealState(a){q(\'details[data-g9-support-reveal]\',a).forEach(d=>{if(d.dataset.g9StateBound)return;d.dataset.g9StateBound=\'1\';d.addEventListener(\'toggle\',()=>saveCore2State(a))})}\nfunction restoreCore2State(a,lock){if(a.dataset.g9Role!==\'CORE2\')return;const state=readState(stateKey(a));if(!state)return;const fields=attemptFields(a);(state.fields||[]).forEach((saved,i)=>{const el=fields[i];if(!el||!saved||typeof saved!==\'object\')return;if(Object.prototype.hasOwnProperty.call(saved,\'value\'))el.value=saved.value??\'\';if(el.type===\'checkbox\'||el.type===\'radio\')el.checked=!!saved.checked});Object.entries(state.ladders||{}).forEach(([ref,count])=>{const l=q(\'.g9-ladder[data-g9-ladder-ref]\',a).find(x=>x.dataset.g9LadderRef===ref);if(!l||!Number.isInteger(count)||count<0)return;while(rungCount(l)<count&&nextRung(l)){};});bindSupportRevealState(a);q(\'details[data-g9-support-reveal]\',a).forEach((d,i)=>d.open=!!(state.reveals||[])[i]);if(state.attempted){a.dataset.attempted=\'1\';materialise(a)}lock()}\nconst articles=q(\'article[data-g9-unit],article[data-g9-diagnostic],[data-g9-purpose-item]\');\narticles.forEach(a=>{const lock=()=>q(\'details[data-requires-attempt]\',a).forEach(d=>{if(!a.dataset.attempted){d.dataset.locked=\'\';d.open=false}else delete d.dataset.locked});lock();restoreCore2State(a,lock);\nq(\'details[data-requires-attempt] summary\',a).forEach(s=>s.addEventListener(\'click\',e=>{if(!a.dataset.attempted){e.preventDefault();q(\'[data-g9-attempt-box] input,[data-g9-attempt-box] textarea,[data-g9-attempt-box] select\',a)[0]?.focus()}}));\nq(\'[data-g9-commit]\',a).forEach(b=>b.onclick=()=>{const box=b.closest(\'[data-g9-attempt-box]\');if(!box||!validAttempt(box)){q(\'input,textarea,select\',box||a)[0]?.focus();return}a.dataset.attempted=\'1\';lock();materialise(a);saveCore2State(a)});\na.addEventListener(\'click\',e=>{const b=e.target.closest(\'[data-g9-next-rung]\');if(b&&a.contains(b)){nextRung(b.closest(\'.g9-ladder\'));bindSupportRevealState(a);saveCore2State(a)}});attemptFields(a).forEach(el=>{el.addEventListener(\'input\',()=>saveCore2State(a));el.addEventListener(\'change\',()=>saveCore2State(a))});\nq(\'[data-g9-concept-link]\',a).forEach(link=>link.addEventListener(\'click\',()=>{saveCore2State(a);const key=returnKey(link.dataset.g9ConceptRef);if(key)store.set(key,link.dataset.g9QuestionRef||a.dataset.g9Unit);refreshReturnLinks()}))});\nconst practiceLinks=q(\'[data-g9-practice-link]\');const practiceLabels=new Map(practiceLinks.map(link=>[link,link.textContent]));\nfunction refreshReturnLinks(){practiceLinks.forEach(link=>{const key=returnKey(link.dataset.g9ConceptRef);const active=!!key&&store.get(key)===link.dataset.g9QuestionRef;if(active){link.dataset.g9ReturnLink