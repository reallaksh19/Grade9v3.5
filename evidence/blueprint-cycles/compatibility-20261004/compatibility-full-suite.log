18px;\n}\n\n/* Accordion Summary & Disclosure Controls */\ndetails summary, \nsummary.rung-summary, \ndetails.reveal-block summary, \ndetails.core-box summary {\n  min-height: 52px;\n  padding: 14px 20px;\n  cursor: pointer;\n  touch-action: manipulation;\n  font-size: 15px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  box-sizing: border-box;\n}\n\n/* Touch-Optimized Range Sliders */\ninput[type="range"] {\n  height: var(--tab12-touch-min) !important;\n  touch-action: pan-y;\n  cursor: pointer;\n  margin: 4px 0;\n  accent-color: #38bdf8;\n}\n\ninput[type="range"]::-webkit-slider-thumb {\n  width: var(--tab12-thumb-size);\n  height: var(--tab12-thumb-size);\n  border-radius: 50%;\n  background: #38bdf8;\n  cursor: pointer;\n  border: 2.5px solid #ffffff;\n  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);\n  touch-action: none;\n}\n\ninput[type="range"]::-moz-range-thumb {\n  width: var(--tab12-thumb-size);\n  height: var(--tab12-thumb-size);\n  border-radius: 50%;\n  background: #38bdf8;\n  cursor: pointer;\n  border: 2.5px solid #ffffff;\n  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);\n}\n\n/* Textareas for Virtual Tablet Keyboard Typing */\ntextarea, \ntextarea.attempt-input, \n.attempt-box textarea {\n  min-height: 120px;\n  font-size: 16px;\n  line-height: 1.6;\n  padding: 14px 16px;\n  border-radius: var(--tab12-radius-sm);\n  box-sizing: border-box;\n  touch-action: manipulation;\n}\n\n/* Elimination of sub-14px micro fonts (the shell\'s learner text floor, minimum_learner_text_css_px) */\nsmall, .badge, .subtopic-desc, .node-id, .stat-label, .evidence-citation {\n  font-size: 14px !important;\n}\n\n/* Tailwind utility floor: arbitrary micro-font classes are common in legacy explorers.\n   Keep learner-visible text at or above 14px on the tablet target even when a\n   runtime utility stylesheet is injected after this file. */\n.text-xs,\n[class~="text-[9px]"],\n[class~="text-[10px]"],\n[class~="text-[11px]"],\n[class~="text-[12px]"],\n[class~="text-[12.5px]"] {\n  font-size: 14px !important;\n}\n\n/* ==========================================================================\n   2. ICONS-INSTEAD-OF-TABLES COMPONENT SYSTEM\n   ========================================================================== */\n\n/* Metric Tile Clusters (replaces tabular telemetry) */\n.metric-tile-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 14px;\n  margin: 14px 0;\n}\n\n.metric-tile {\n  background: var(--bg-card, #1f293b);\n  border: 1px solid var(--border, #2e3d56);\n  border-radius: var(--tab12-radius-md);\n  padding: 14px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  position: relative;\n  transition: transform 0.15s, border-color 0.15s;\n}\n\n.metric-tile:hover {\n  border-color: var(--accent, #38bdf8);\n}\n\n.metric-tile-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--text-muted, #94a3b8);\n}\n\n.metric-tile-icon {\n  font-size: 18px;\n  line-height: 1;\n}\n\n.metric-tile-value {\n  font-size: 22px;\n  font-weight: 800;\n  color: var(--accent, #38bdf8);\n  font-family: ui-monospace, SFMono-Regular, monospace;\n  font-variant-numeric: tabular-nums;\n}\n\n.metric-tile-sub {\n  font-size: 14px;\n  color: var(--text-muted, #94a3b8);\n}\n\n/* Tablet Card Deck (replaces table rows) */\n.tablet-card-deck {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin: 16px 0;\n}\n\n.tablet-card-row {\n  background: var(--bg-card, #1f293b);\n  border: 1px solid var(--border, #2e3d56);\n  border-radius: var(--tab12-radius-md);\n  padding: 16px 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 14px;\n  min-height: 64px;\n}\n\n.tablet-card-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  border-radius: 999px;\n  font-size: 14px;\n  font-weight: 700;\n  background: rgba(56, 189, 248, 0.15);\n  border: 1px solid var(--accent, #38bdf8);\n  color: var(--accent, #38bdf8);\n}\n\n/* Dual Comparison Cards (replaces side-by-side comparison tables) */\n.dual-frame-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin: 16px 0;\n}\n\n@media (min-width: 860px) {\n  .dual-frame-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n.dual-frame-card {\n  background: var(--bg-card, #161b22);\n  border: 1.5px solid var(--border, #30363d);\n  border-radius: var(--tab12-radius-md);\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.dual-frame-card.active {\n  border-color: var(--accent, #58a6ff);\n  box-shadow: 0 0 16px rgba(88, 166, 255, 0.2);\n}\n\n.dual-frame-title {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 17px;\n  font-weight: 700;\n  color: var(--text, #f0f6fc);\n}\n\n/* Visual Arithmetic Flow Pipeline (replaces numeric arrays and synthetic division tables) */\n.arithmetic-pipeline {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  overflow-x: auto;\n  padding: 16px 8px;\n  -webkit-overflow-scrolling: touch;\n}\n\n.pipeline-step {\n  background: var(--bg-card, #1f293b);\n  border: 1px solid var(--border, #2e3d56);\n  border-radius: var(--tab12-radius-sm);\n  padding: 12px 18px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  min-width: 110px;\n  text-align: center;\n}\n\n.pipeline-step.highlight {\n  border-color: #34d399;\n  background: rgba(52, 211, 153, 0.1);\n}\n\n.pipeline-arrow {\n  font-size: 20px;\n  color: var(--text-muted, #94a3b8);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 28px;\n}\n\n/* Stage Layout on 12.7" Tablets */\n@media (min-width: 960px) {\n  .stage-grid-12-7 {\n    display: grid;\n    grid-template-columns: 1.85fr 1fr;\n    gap: 24px;\n    align-items: start;\n  }\n}\n</style><title>Orientation map · Momen