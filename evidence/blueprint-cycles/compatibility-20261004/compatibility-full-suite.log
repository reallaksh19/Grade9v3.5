Color" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="220" x2="418" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="150" width="260" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="320" y="110" width="70" height="80" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="126" cy="205" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="324" cy="205" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="130" y="110" width="60" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="135" text-anchor="middle">20 kg</text>\n    <line x1="150" y1="80" x2="220" y2="80" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow)"/>\n    <text x="150" y="72">v forward</text>\n    <line x1="340" y1="80" x2="280" y2="80" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow)"/>\n    <text x="280" y="100" text-anchor="start">a = 3 m/s² (slowing)</text>\n    <text x="20" y="260">the crate does not slip on the bed</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The braking truck</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-COV-04-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-COV-04-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-TRUCK-BRAKE-CRATE" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TRUCKCRATE-V0 VIS-NLM-TRUCKCRATE-V1 VIS-NLM-TRUCKCRATE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 280" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-title g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-title">A crate on the floor of a braking truck</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-desc">Stage 1: A 20 kg crate rides on the flat bed of a truck that moves forward while braking at 3 m/s²; the crate does not slip. Stage 2: The crate slows with the truck, so its acceleration is 3 m/s² backward, and only the bed\'s friction acts along it. Stage 3: Friction on the crate points backward, against its motion, with size 20 × 3 = 60 N.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TRUCKCRATE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 20 kg crate on a braking truck\'s flat bed</text>\n    <line x1="20" y1="220" x2="430" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="220" x2="418" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="150" width="260" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="320" y="110" width="70" height="80" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="126" cy="205" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="324" cy="205" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="130" y="110" width="60" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="135" text-anchor="middle">20 kg</text>\n    <line x1="150" y1="80" x2="220" y2="80" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow)"/>\n    <text x="150" y="72">v forward</text>\n    <line x1="340" y1="80" x2="280" y2="80" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow)"/>\n    <text x="280" y="100" text-anchor="start">a = 3 m/s² (slowing)</text>\n    <text x="20" y="260">the crate does not slip on the bed</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TRUCKCRATE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="60" font-weight="600">the crate slows with the truck:</text>\n    <text x="470" y="82">its a = 3 m/s² backward</text>\n    <text x="470" y="104">only the bed\'s friction acts along it</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TRUCKCRATE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="128" y1="145" x2="78" y2="145" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-04-bound-REP-NLM-TRUCK-BRAKE-CRATE-1--rep-nlm-truckcrate-arrow-acc)"/>\n    <text x="70" y="138" font-weight="600" fill="#1f6fb2">f</text>\n    <text x="470" y="150" font-weight="600" fill="#1f6fb2">friction on the crate: backward</text>\n    <text x="470" y="172" font-weight="600" fill="#1f6fb2">f = 20 × 3 = 60 N</text>\n    <text x="470" y="194">against its motion, set by its deceleration</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the crate on the bed while the truck slows.">1: The braking truck</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find the crate&#x27;s acceleration and the only horizontal force on it.">2: Crate&#x27;s acceleration</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Give friction the direction and size of m a.">3: Friction</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the crate on the braking truck so friction&#x27;s direction and size come from the crate&#x27;s own deceleration.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Imagine the bed perfectly slippery: the crate would keep going while the bed slows, so it would slide forward relative to the bed.</li><li>Friction opposes that slip tendency, so it points backward on the crate.</li><li>The crate slows with the truck at 3 m/s², so the friction is m a = 20 × 3 = 60 N.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Friction on the crate points backward, against its motion, with size 20 × 3 = 60 N.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The same rule gives forward friction when the truck speeds up: the direction follows the slip tendency, and here it happens to be against the motion.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your friction points forward, &#x27;the way the crate is going&#x27;, or is zero because nothing pushes the crate: the crate would slide forward relative to the slowing bed, so friction points backward, 60 N.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM5-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION" data-g9-repair-target="CU-PHY-NLM-FRICTION-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-1">Revisit: Imagine the relative sliding, or tendency to slide, at that named contact if tangential friction were absent; point friction on the chosen body opposite that relative tendency.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: friction&#x27;s direction comes from the slip tendency at the contact, not from the object&#x27;s velocity. The transfer task applies the same rule to a walker&#x27;s shoe on a plank, and follows the partner force onto the plank.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-COV-04-authored"><ol data-g9-ladder><li data-g9-rung="1">Which two surfaces are in contact, and how is each moving while the truck brakes?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-COV-04-authored-2"><li data-g9-rung="2">Draw the crate on the bed with a velocity arrow for each, and mark which way the crate would slide relative to the bed if the bed were slippery.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-COV-04-authored-3"><li data-g9-rung="3">The crate slows with the truck at 3 m/s². Which single horizontal force on the crate gives it that acceleration, and what size does F = ma require?</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-COV-06" data-g9-unit="Q-PHY-NLM-2A-COV-06" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Third-law partner forces act on different bodies Medium concept Connected reasoning Newton-law and observer-frame practice Constructed response Authored practice A book rests on a table. Name the third-law partner of (a) the book&#x27;s weight and (b) the table&#x27;s upward push on the book. For each partner, say which body it acts on and which way it points. The book is at rest on a horizontal table." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-COV-06" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-THIRD-LAW" data-g9-meta-value="Third-law partner forces act on different bodies"><strong>Concept:</strong> <span data-g9-meta-label>Third-law partner forces act on different bodies</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-THIRD-LAW" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-COV-06" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-COV-06" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-COV-06" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A book rests on a table. Name the third-law partner of (a) the book&#x27;s weight and (b) the table&#x27;s upward push on the book. For each partner, say which body it acts on and which way it points.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The book is at rest on a horizontal table.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-COV-06-REP-NLM-BOOK-TABLE-PARTNERS" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-BOOK-TABLE-PARTNERS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BOOKPARTNERS-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The book" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 350">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BOOKPARTNERS-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A book at rest on a horizontal table</text>\n    <line x1="60" y1="170" x2="360" y2="170" stroke="currentColor" stroke-width="3"/>\n    <line x1="80" y1="170" x2="80" y2="250" stroke="currentColor" stroke-width="3"/>\n    <line x1="340" y1="170" x2="340" y2="250" stroke="currentColor" stroke-width="3"/>\n    <rect x="170" y="138" width="90" height="32" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="215" y="159" text-anchor="middle">book</text>\n    <path d="M20 330 A400 60 0 0 1 420 330" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="312" text-anchor="middle">Earth</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The book</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-COV-06-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-COV-06-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-BOOK-TABLE-PARTNERS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BOOKPARTNERS-V0 VIS-NLM-BOOKPARTNERS-V1 VIS-NLM-BOOKPARTNERS-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 350" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-title g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-title">Book on a table: the partners of its weight and of the table\'s push</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-desc">Stage 1: A book rests on a horizontal table on the Earth. Stage 2: Two forces act on the book: (a) the Earth\'s pull, its weight, and (b) the table\'s upward push; both act on the book, so they are not partners. Stage 3: The partner of (a) is the book\'s pull on the Earth, acting on the Earth and pointing up; the partner of (b) is the book\'s push on the table, acting on the table and pointing down.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BOOKPARTNERS-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A book at rest on a horizontal table</text>\n    <line x1="60" y1="170" x2="360" y2="170" stroke="currentColor" stroke-width="3"/>\n    <line x1="80" y1="170" x2="80" y2="250" stroke="currentColor" stroke-width="3"/>\n    <line x1="340" y1="170" x2="340" y2="250" stroke="currentColor" stroke-width="3"/>\n    <rect x="170" y="138" width="90" height="32" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="215" y="159" text-anchor="middle">book</text>\n    <path d="M20 330 A400 60 0 0 1 420 330" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="312" text-anchor="middle">Earth</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BOOKPARTNERS-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="180" y1="150" x2="180" y2="200" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow)"/>\n    <text x="20" y="214" text-anchor="start">(a) Earth on book (weight)</text>\n    <line x1="235" y1="168" x2="235" y2="108" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow)"/>\n    <text x="243" y="112">(b) table on book</text>\n    <text x="470" y="60" font-weight="600">both act on the book:</text>\n    <text x="470" y="82">they are not partners of each other</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BOOKPARTNERS-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="210" y1="300" x2="210" y2="260" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow-acc)"/>\n    <text x="218" y="274" fill="#1f6fb2">book on Earth: up</text>\n    <line x1="300" y1="172" x2="300" y2="212" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-COV-06-bound-REP-NLM-BOOK-TABLE-PARTNERS-1--rep-nlm-bookpartners-arrow-acc)"/>\n    <text x="308" y="214" fill="#1f6fb2">book on table: down</text>\n    <text x="470" y="130" font-weight="600" fill="#1f6fb2">(a) partner: book pulls the Earth,</text>\n    <text x="470" y="152" fill="#1f6fb2">acts on the Earth, points up</text>\n    <text x="470" y="174" font-weight="600" fill="#1f6fb2">(b) partner: book pushes the table,</text>\n    <text x="470" y="196" fill="#1f6fb2">acts on the table, points down</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the book, the table and the Earth.">1: The book</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Show the two forces that act on the book.">2: Forces on the book</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Draw each partner on the body it acts on.">3: Partners</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the book on the table with its two forces and each force&#x27;s third-law partner on the other body.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>The weight is the Earth-book gravitational interaction, so its partner is the book on the Earth.</li><li>The table&#x27;s push is the table-book contact interaction, so its partner is the book on the table.</li><li>Weight and normal push are equal here because the book is at rest, not because of the third law.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>(a) The partner of the Earth&#x27;s pull on the book is the book&#x27;s pull on the Earth, acting on the Earth and pointing up. (b) The partner of the table&#x27;s push on the book is the book&#x27;s push on the table, acting on the table and pointing down. The weight and the table&#x27;s push both act on the book, so they are not partners.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Press down on the book: the table&#x27;s push grows but the weight does not, so the two cannot be a partner pair.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You named the table&#x27;s upward push as the partner of the book&#x27;s weight: both act on the book and come from different agents. The weight&#x27;s partner is the book&#x27;s pull on the Earth.</p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: third-law partners are equal and opposite but act on different bodies, so each belongs to a different body&#x27;s sum. Later tasks keep interaction pairs apart in connected-body problems.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-COV-06-authored"><ol data-g9-ladder><li data-g9-rung="1">For each force on the book, which two bodies take part in that interaction?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-COV-06-authored-2"><li data-g9-rung="2">Draw the book, the table and the Earth as three outlines, and label every arrow &#x27;A on B&#x27;.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-COV-06-authored-3"><li data-g9-rung="3">Swap agent and target: &#x27;Earth on book&#x27; pairs with &#x27;book on Earth&#x27;, and &#x27;table on book&#x27; pairs with &#x27;book on table&#x27;.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-PRACTICAL-12" data-g9-unit="Q-PHY-NLM-PRACTICAL-12" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Net force, not any one force, sets acceleration Medium concept Multi-step reasoning Newton-law and observer-frame practice Experimental design Authored practice Plan a trolley–pulley–hanging-mass experiment to verify Newton’s second law. Describe one controlled variation that tests the effect of net force at fixed system mass, what you measure, and what result would support F_net = m a. Treat friction as small or measure/account for it consistently. Use the same trolley–pulley system while changing the driving load." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-PRACTICAL-12" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="Net force, not any one force, sets acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Net force, not any one force, sets acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-PRACTICAL-12" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-PRACTICAL-12" data-g9-meta-value="experimental_design"><strong>Question type:</strong> <span data-g9-meta-label>Experimental design</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-PRACTICAL-12" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>Plan a trolley–pulley–hanging-mass experiment to verify Newton’s second law. Describe one controlled variation that tests the effect of net force at fixed system mass, what you measure, and what result would support F_net = m a.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Treat friction as small or measure/account for it consistently.</li><li>Use the same trolley–pulley system while changing the driving load.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-PRACTICAL-12-REP-NLM-TROLLEY-PULLEY-EXPERIMENT" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-TROLLEY-PULLEY-EXPERIMENT" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PRACTICAL-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The apparatus" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 340">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PRACTICAL-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Trolley–pulley–hanging-mass experiment</text>\n    <line x1="20" y1="150" x2="330" y2="150" stroke="currentColor" stroke-width="2"/>\n    <line x1="330" y1="150" x2="330" y2="300" stroke="currentColor" stroke-width="2"/>\n    <rect x="90" y="88" width="110" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="112" cy="141" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="178" cy="141" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="145" y="172" text-anchor="middle" font-size="14">trolley + masses</text>\n    <circle cx="340" cy="140" r="14" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="340" cy="140" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="200" y1="110" x2="340" y2="126" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="354" y1="140" x2="354" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="336" y="220" width="36" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="380" y="240">hanger + load</text>\n    <rect x="60" y="60" width="30" height="20" fill="none" stroke="currentColor" stroke-width="1.5"/>\n    <text x="96" y="76" font-size="14">timer / sensor</text>\n    <text x="20" y="330">friction small, or measured and accounted for consistently</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The apparatus</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-PRACTICAL-12-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-PRACTICAL-12-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-TROLLEY-PULLEY-EXPERIMENT" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PRACTICAL-V0 VIS-NLM-PRACTICAL-V1 VIS-NLM-PRACTICAL-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 340" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-title g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-title">Trolley–pulley experiment: vary the driving force at fixed total mass</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-desc">Stage 1: A trolley carrying masses on a track is pulled by a string over a pulley at the edge to a hanger with a load; a timer or sensor measures the motion; friction is small or measured and accounted for. Stage 2: Masses are moved between the trolley and the hanger, so the total moving mass stays fixed while the driving force changes. Stage 3: The acceleration is measured for each trial; a straight line through the origin of a against the corrected net force supports F_net = m a.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-PRACTICAL-12-bound-REP-NLM-TROLLEY-PULLEY-EXPERIMENT-1--rep-nlm-practical-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PRACTICAL-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Trolley–pulley–hanging-mass experiment</text>\n    <line x1="20" y1="150" x2="330" y2="150" stroke="currentColor" stroke-width="2"/>\n    <line x1="330" y1="150" x2="330" y2="300" stroke="currentColor" stroke-width="2"/>\n    <rect x="90" y="88" width="110" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="112" cy="141" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="178" cy="141" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="145" y="172" text-anchor="middle" font-size="14">trolley + masses</text>\n    <circle cx="340" cy="140" r="14" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="340" cy="140" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="200" y1="110" x2="340" y2="126" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="354" y1="140" x2="354" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="336" y="220" width="36" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="380" y="240">hanger + load</text>\n    <rect x="60" y="60" width="30" height="20" fill="none" stroke="currentColor" stroke-width="1.5"/>\n    <text x="96" y="76" font-size="14">timer / sensor</text>\n    <text x="20" y="330">friction small, or measured and accounted for consistently</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PRACTICAL-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <path d="M160 112 C 200 60, 320 60, 350 212" fill="none" stroke="#1f6fb2" stroke-width="1.8" stroke-dasharray="6 4"/>\n    <text x="250" y="60" text-anchor="middle" fill="#1f6fb2">move a mass: trolley ↔ hanger</text>\n    <text x="510" y="60" font-weight="600">controlled variation:</text>\n    <text x="510" y="82">move masses between trolley and hanger</text>\n    <text x="510" y="104">total moving mass stays fixed</text>\n    <text x="510" y="126">driving force (hanger weight) changes</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PRACTICAL-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="510" y="170" font-weight="600" fill="#1f6fb2">measure a for each trial</text>\n    <text x="510" y="192" fill="#1f6fb2">plot a against corrected F_net</text>\n    <text x="510" y="214" fill="#1f6fb2">straight line through origin</text>\n    <text x="510" y="236" font-weight="600" fill="#1f6fb2">supports F_net = m a (slope 1/m)</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the trolley, pulley, hanger and timer.">1: The apparatus</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Move masses between trolley and hanger.">2: Controlled variation</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="State what is measured and what result supports the law.">3: Measurement and test</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the trolley–pulley apparatus and the controlled transfer of masses that changes the net force at fixed system mass.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Choose the trolley plus hanging mass as the moving system and keep its total mass fixed for the force-variation test.</li><li>Move a known mass from trolley to hanger to increase the driving weight without changing total moving mass.</li><li>Measure acceleration from distance/time data or a suitable motion sensor for each trial.</li><li>Correct for friction consistently if it is not negligible.</li><li>For fixed total mass, a plot of corrected F_net against a should be approximately linear through the origin within experimental uncertainty.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Keep the total moving mass approximately fixed while transferring masses between trolley and hanger so the driving force changes, measure acceleration for each trial, and test whether acceleration changes in direct proportion to the corrected net driving force.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Changing force and total mass at the same time without controlling either would not isolate the F_net–a relationship.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your plan adds new masses to the hanger from outside: then the driving force and the moving mass both change, so a change in acceleration cannot be put down to force alone.</p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: to test F_net = m a, vary the net driving force while the system mass stays fixed, by moving masses between trolley and hanger. Later tasks use the same system boundary to find the acceleration of connected bodies.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-PRACTICAL-12-authored"><ol data-g9-ladder><li data-g9-rung="1">To test the effect of force, do not let total moving mass become a second uncontrolled variable.</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-PRACTICAL-12-authored-2"><li data-g9-rung="2">Sketch the trolley on the bench, the string over the pulley and the hanger, and draw one boundary around trolley plus hanger: the mass inside it must stay fixed.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-PRACTICAL-12-authored-3"><li data-g9-rung="3">Transfer masses between the trolley and hanger, then compare corrected net force with measured acceleration.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-unit="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Newton-law and observer-frame practice Derivation Authored practice A small block of mass m rests on a larger block of mass M. The floor under the larger block is smooth. A horizontal force F is applied to the larger block. The coefficient of static friction between the blocks is mu_s. Derive the largest value of F for which the two blocks can move together without slipping. The upper block has no other horizontal force. The contact surfaces remain horizontal. Use the static-friction limit only at impending slip." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A small block of mass m rests on a larger block of mass M. The floor under the larger block is smooth. A horizontal force F is applied to the larger block. The coefficient of static friction between the blocks is mu_s. Derive the largest value of F for which the two blocks can move together without slipping.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The upper block has no other horizontal force.</li><li>The contact surfaces remain horizontal.</li><li>Use the static-friction limit only at impending slip.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-MONM-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The stack" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 280">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-MONM-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Block m on block M; F pulls M; smooth floor</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="120" y="160" width="200" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="195" text-anchor="middle">M</text>\n    <rect x="180" y="120" width="70" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="215" y="145" text-anchor="middle">m</text>\n    <line x1="322" y1="190" x2="392" y2="190" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow)"/>\n    <text x="398" y="195">F</text>\n    <text x="20" y="120">μ_s between the blocks</text>\n    <text x="20" y="260">no other horizontal force on m; surfaces horizontal</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The stack</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-MONM-V0 VIS-NLM-MONM-V1 VIS-NLM-MONM-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 280" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-title g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-title">Block m on block M with F on M: friction must drive m</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-desc">Stage 1: A small block of mass m rests on a larger block of mass M on a smooth floor; a horizontal force F acts on the larger block; the coefficient of static friction between the blocks is μ_s. Stage 2: Without slip both move at a = F/(M + m); friction is the only horizontal force on m, so it must supply m a = mF/(M + m), and N = mg gives a limit μ_s m g. Stage 3: No slip needs mF/(M + m) ≤ μ_s m g, so F_max = μ_s (M + m) g.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-MONM-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Block m on block M; F pulls M; smooth floor</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="120" y="160" width="200" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="195" text-anchor="middle">M</text>\n    <rect x="180" y="120" width="70" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="215" y="145" text-anchor="middle">m</text>\n    <line x1="322" y1="190" x2="392" y2="190" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow)"/>\n    <text x="398" y="195">F</text>\n    <text x="20" y="120">μ_s between the blocks</text>\n    <text x="20" y="260">no other horizontal force on m; surfaces horizontal</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-MONM-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="216" y1="136" x2="266" y2="136" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-bound-REP-NLM-BLOCK-ON-BLOCK-F-ON-LOWER-1--rep-nlm-mOnM-arrow-acc)"/>\n    <text x="250" y="110" fill="#1f6fb2">f on m</text>\n    <text x="470" y="60" font-weight="600">no slip: one a = F/(M + m)</text>\n    <text x="470" y="82">only friction drives m:</text>\n    <text x="470" y="104">f_required = m a = mF/(M + m)</text>\n    <text x="470" y="126">N = mg, limit μ_s m g</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-MONM-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="160" fill="#1f6fb2">no slip needs mF/(M + m) ≤ μ_s m g</text>\n    <text x="470" y="182" font-weight="600" fill="#1f6fb2">F_max = μ_s (M + m) g</text>\n    <text x="470" y="204">μ_s N is used only at impending slip</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show m on M, the pull on M and the smooth floor.">1: The stack</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find the friction the upper block needs to keep up.">2: What m needs</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Compare the need with the limit.">3: Threshold</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the stacked blocks with F on the lower one so the friction the upper block needs is compared with its limit.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Treat both blocks together first: the only external horizontal force on the two-block system is F, so a = F/(M+m).</li><li>For the upper block alone, static friction is the horizontal force that must provide acceleration a, so f_required = m a = mF/(M+m).</li><li>Because the contact is horizontal with no other vertical force on the upper block, N = m g.</li><li>Static contact is possible only while f_required &lt;= mu_s N; equality occurs at impending slip.</li><li>Substituting and cancelling m gives F_max = mu_s(M+m)g.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>While there is no slip, both blocks have a = F/(M+m). The upper block needs friction f_required = m a. Since N = m g here, no slip requires mF/(M+m) &lt;= mu_s m g, so F &lt;= mu_s(M+m)g. Therefore F_max = mu_s(M+m)g.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>For F below this threshold, the required friction is below its maximum; setting f_s = mu_s N for every smaller F would incorrectly predict the same friction at all forces.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your answer is F_max = μ_s m g: that is the friction limit itself, but F must accelerate both blocks, so the limit is scaled up by (M + m)/m.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-3" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Compare each |f_required| with μ_sN; on an incline this comparison can be turned into the angle condition for the onset of sliding rather than setting f=μ_sN from the start.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: for a no-slip threshold, find the shared acceleration from the whole system, then test the friction one block needs against μ_s N. The transfer task leaves the contact state open, so you must first decide whether rest can hold at all.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-authored"><ol data-g9-ladder><li data-g9-rung="1">First suppose the blocks do not slip. What acceleration would the two-block system then have?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-authored-2"><li data-g9-rung="2">Draw one diagram for each block. On the upper block the only horizontal force is the friction from the lower block; on the lower block, F and the partner of that friction.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-THRESHOLD-01-authored-3"><li data-g9-rung="3">Now isolate only the upper block. What horizontal force must accelerate it at that same rate? Compare that required friction with the static limit.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-CONNECTED-02" data-g9-unit="Q-PHY-NLM-2A-CONNECTED-02" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Connected bodies and a justified common acceleration Hard concept Connected reasoning Newton-law and observer-frame practice Derivation Authored practice Two blocks A and B of masses m_A and m_B remain in contact on a smooth horizontal floor. A horizontal force F pushes A toward B, and the contact is maintained. Derive their common acceleration and the magnitude of the contact force exerted by A on B. The floor is frictionless. The blocks remain in contact throughout the motion. Take the direction of F as positive." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-CONNECTED-02" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="Connected bodies and a justified common acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Connected bodies and a justified common acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-02" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-02" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-02" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>Two blocks A and B of masses m_A and m_B remain in contact on a smooth horizontal floor. A horizontal force F pushes A toward B, and the contact is maintained. Derive their common acceleration and the magnitude of the contact force exerted by A on B.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The floor is frictionless.</li><li>The blocks remain in contact throughout the motion.</li><li>Take the direction of F as positive.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-CONNECTED-02-REP-NLM-BLOCKS-AB-PUSH-F" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-BLOCKS-AB-PUSH-F" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ABF-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The blocks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 260">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ABF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Blocks A and B in contact, F pushes A</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="150" y="130" width="80" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="190" y="170" text-anchor="middle">m_A</text>\n    <rect x="230" y="145" width="70" height="55" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="265" y="177.5" text-anchor="middle">m_B</text>\n    <line x1="70" y1="165" x2="146" y2="165" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow)"/>\n    <text x="70" y="155">F</text>\n    <text x="20" y="240">smooth floor; contact maintained; direction of F positive</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The blocks</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-CONNECTED-02-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-02-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-BLOCKS-AB-PUSH-F" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ABF-V0 VIS-NLM-ABF-V1 VIS-NLM-ABF-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 260" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-title g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-title">Blocks A and B pushed by F: isolate B for the contact force</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-desc">Stage 1: Two blocks of masses m_A and m_B stay in contact on a smooth horizontal floor; a horizontal force F pushes A toward B; the direction of F is positive. Stage 2: The fixed contact gives one acceleration; for the pair F = (m_A + m_B) a, and B alone has only the contact force N_AB along x. Stage 3: a = F/(m_A + m_B) and N_AB = m_B a = m_B F/(m_A + m_B).</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ABF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Blocks A and B in contact, F pushes A</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="150" y="130" width="80" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="190" y="170" text-anchor="middle">m_A</text>\n    <rect x="230" y="145" width="70" height="55" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="265" y="177.5" text-anchor="middle">m_B</text>\n    <line x1="70" y1="165" x2="146" y2="165" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow)"/>\n    <text x="70" y="155">F</text>\n    <text x="20" y="240">smooth floor; contact maintained; direction of F positive</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ABF-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <rect x="222" y="136" width="86" height="74" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4"/>\n    <line x1="234" y1="156" x2="278" y2="156" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-02-bound-REP-NLM-BLOCKS-AB-PUSH-F-1--rep-nlm-abF-arrow-acc)"/>\n    <text x="236" y="138" fill="#1f6fb2">N_AB</text>\n    <text x="470" y="60" font-weight="600">fixed contact → one a</text>\n    <text x="470" y="82">whole pair: F = (m_A + m_B) a</text>\n    <text x="470" y="104">B alone: only N_AB acts along x</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ABF-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="150" font-weight="600" fill="#1f6fb2">a = F/(m_A + m_B)</text>\n    <text x="470" y="172" font-weight="600" fill="#1f6fb2">N_AB = m_B a = m_B F/(m_A + m_B)</text>\n    <text x="470" y="194">less than F unless m_A = 0</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show A and B touching and F on A.">1: The blocks</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Use the fixed contact for one a, then isolate B.">2: Common a and B alone</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Solve for a and N_AB.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the two blocks pushed by F with B isolated, so the contact force comes from B&#x27;s own equation.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Because the maintained contact fixes the separation of A and B along the motion direction, they share one acceleration component.</li><li>For the combined system A+B, the contact pair is internal and the external horizontal force is F, giving a = F/(m_A+m_B).</li><li>For B alone, the force exerted by A is external to B and must remain on B&#x27;s free-body diagram.</li><li>Newton II for B gives N_AB = m_B a = m_B F/(m_A+m_B).</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The fixed contact keeps the blocks at one common acceleration a = F/(m_A+m_B). For block B alone, the contact force is its only horizontal force, so N_AB = m_B a = m_B F/(m_A+m_B).</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If m_B tends to zero, the required contact force tends to zero while the system acceleration tends to F/m_A, which is consistent.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your contact force equals F: the push on A is not passed to B undiminished, because part of F accelerates A itself; B needs only m_B a.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM9-5" data-g9-concept-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-repair-target="CU-PHY-NLM-CONNECTED-COMMON-ACCEL-2" href="#g9-CORE1A--CU-PHY-NLM-CONNECTED-COMMON-ACCEL-2">Revisit: Match the chosen system boundary to the requested quantity: use the combined constrained system when internal forces are irrelevant to the shared acceleration, then isolate the body or subsystem that makes a requested interaction force external.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: maintained contact gives one acceleration, the whole system finds it, and the body that feels a contact force is isolated to find that force. The transfer task adds a third cart and leaves the choice of system to you.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-CONNECTED-02-authored"><ol data-g9-ladder><li data-g9-rung="1">What physical condition lets you use one acceleration for both blocks?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-02-authored-2"><li data-g9-rung="2">Draw A and B as two separate diagrams with the contact pair between them, then draw one dashed outline around both blocks.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-02-authored-3"><li data-g9-rung="3">Find the acceleration from the combined system first. Then isolate B; do not cancel the contact force from B&#x27;s own equation.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-unit="Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Ideal-string tension belongs to each body-specific FBD Hard concept Multi-step reasoning Newton-law and observer-frame practice Derivation Authored practice Two carts A and B of masses m_A and m_B are connected by one taut massless inextensible string on a smooth horizontal track. A horizontal force F pulls cart A away from B along the string. Derive the common acceleration and the string tension. Then name one model change that would make equal tension throughout the connector no longer guaranteed. The string is massless, taut and inextensible. There is no pulley in this question. The track is frictionless." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="Ideal-string tension belongs to each body-specific FBD"><strong>Concept:</strong> <span data-g9-meta-label>Ideal-string tension belongs to each body-specific FBD</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-IDEAL-STRING-03" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>Two carts A and B of masses m_A and m_B are connected by one taut massless inextensible string on a smooth horizontal track. A horizontal force F pulls cart A away from B along the string. Derive the common acceleration and the string tension. Then name one model change that would make equal tension throughout the connector no longer guaranteed.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The string is massless, taut and inextensible.</li><li>There is no pulley in this question.</li><li>The track is frictionless.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-IDEAL-STRING-03-REP-NLM-CARTS-STRING-F" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CARTS-STRING-F" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CARTSF-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The carts" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 260">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARTSF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Carts A and B joined by a string; F pulls A away from B</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="40" y="138" width="90" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="85" y="165" text-anchor="middle">m_B</text>\n    <circle cx="58" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="112" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="250" y="138" width="90" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="295" y="165" text-anchor="middle">m_A</text>\n    <circle cx="268" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="322" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="160" x2="250" y2="160" stroke="currentColor" stroke-width="1.8"/>\n    <text x="190" y="150" text-anchor="middle" font-size="14">string</text>\n    <line x1="342" y1="160" x2="402" y2="160" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow)"/>\n    <text x="408" y="165">F</text>\n    <text x="20" y="240">massless, taut, inextensible string; no pulley; smooth track</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The carts</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CARTS-STRING-F" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CARTSF-V0 VIS-NLM-CARTSF-V1 VIS-NLM-CARTSF-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 260" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-title g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-title">Carts A and B on one string, F pulls A: T from B\'s equation</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-desc">Stage 1: Two carts A and B of masses m_A and m_B are connected by one taut massless inextensible string on a smooth track; a horizontal force F pulls A away from B; there is no pulley. Stage 2: The string pulls B toward A and A toward B with the same T; one a serves both; the pair gives F = (m_A + m_B) a and B alone gives T = m_B a. Stage 3: a = F/(m_A + m_B) and T = m_B F/(m_A + m_B); one T needs the massless-string model, and a connector with significant mass would break it.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARTSF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Carts A and B joined by a string; F pulls A away from B</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="40" y="138" width="90" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="85" y="165" text-anchor="middle">m_B</text>\n    <circle cx="58" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="112" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="250" y="138" width="90" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="295" y="165" text-anchor="middle">m_A</text>\n    <circle cx="268" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="322" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="160" x2="250" y2="160" stroke="currentColor" stroke-width="1.8"/>\n    <text x="190" y="150" text-anchor="middle" font-size="14">string</text>\n    <line x1="342" y1="160" x2="402" y2="160" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow)"/>\n    <text x="408" y="165">F</text>\n    <text x="20" y="240">massless, taut, inextensible string; no pulley; smooth track</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARTSF-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="132" y1="174" x2="172" y2="174" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow-acc)"/>\n    <text x="132" y="192" fill="#1f6fb2">T on B</text>\n    <line x1="248" y1="174" x2="208" y2="174" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-bound-REP-NLM-CARTS-STRING-F-1--rep-nlm-cartsF-arrow-acc)"/>\n    <text x="248" y="192" text-anchor="end" fill="#1f6fb2">T on A</text>\n    <text x="470" y="60" font-weight="600">string constraint → one a</text>\n    <text x="470" y="82">pair: F = (m_A + m_B) a</text>\n    <text x="470" y="104">B alone: T = m_B a</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARTSF-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="150" font-weight="600" fill="#1f6fb2">a = F/(m_A + m_B)</text>\n    <text x="470" y="172" font-weight="600" fill="#1f6fb2">T = m_B F/(m_A + m_B)</text>\n    <text x="470" y="194">one T needs the massless-string model;</text>\n    <text x="470" y="216">a heavy connector breaks it</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the two carts, the string and F on A.">1: The carts</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Draw T on each cart along the string and write the equations.">2: Tension on each cart</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Solve and name what the equal-T model needs.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the two carts on one string pulled by F, with T on each cart and B isolated for the tension.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>The taut inextensible connector keeps the cart separation fixed, so their acceleration components along the track are equal.</li><li>Treating A+B as one system gives F = (m_A+m_B)a.</li><li>For B alone, the only horizontal force is the string tension, so T = m_B a.</li><li>Substitution gives T = m_B F/(m_A+m_B).</li><li>Using one tension magnitude is a model consequence, not a universal property of every rope or pulley arrangement.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The string constraint gives one acceleration a = F/(m_A+m_B). For B, T = m_B a, so T = m_B F/(m_A+m_B). Equal tension relies on the ideal massless-string model; a connector with significant mass or a nonideal redirection can invalidate one common T.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The tension is smaller than F for positive m_A and m_B, because part of F accelerates cart A as well as cart B.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your tension equals F: the string has only to accelerate cart B, so T = m_B a, which is less than F.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM10-5" data-g9-concept-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-repair-target="CU-PHY-NLM-IDEAL-STRING-TENSION-2" href="#g9-CORE1A--CU-PHY-NLM-IDEAL-STRING-TENSION-2">Revisit: Determine the tension magnitude from a chosen body&#x27;s signed Newton-II equation; do not replace T by mg or by an applied force merely because those forces appear in the same setup.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: an ideal taut string gives one acceleration and one tension, and the tension comes from the body it pulls. The transfer task breaks one ideal assumption, a rough pulley axle, and asks what survives.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-authored"><ol data-g9-ladder><li data-g9-rung="1">State the connector model before using one symbol T. What does taut and inextensible imply about the two cart accelerations?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-authored-2"><li data-g9-rung="2">Draw cart A and cart B separately. Put the string&#x27;s pull on each, along the string away from that cart, and give both the symbol T only after naming the ideal-string assumptions.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-IDEAL-STRING-03-authored-3"><li data-g9-rung="3">Use the whole two-cart system to find a, then isolate B to find the tension acting on B.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-unit="Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion One fixed-pulley string gives one length constraint Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice A cart on a table is tied to a light inextensible string that runs over a fixed pulley at the table&#x27;s edge and down to a hanging mass. Let x be the cart&#x27;s distance from the pulley along the table and y the hanging mass&#x27;s depth below the pulley, both measured away from the pulley. Now x = 0.9 m and y = 0.5 m. (a) Write the string-length relation. (b) The hanging mass reaches the floor when y = 1.3 m. How far is the cart from the pulley then? (c) At an instant when the cart moves toward the pulley at 0.3 m/s and is speeding up at 1.2 m/s², give the hanging mass&#x27;s signed velocity and acceleration in these coordinates, and say which way it moves. The pulley is fixed. Only the horizontal and the vertical straight segments change length. The string stays taut and inextensible." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="One fixed-pulley string gives one length constraint"><strong>Concept:</strong> <span data-g9-meta-label>One fixed-pulley string gives one length constraint</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FIXED-PULLEY-04" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A cart on a table is tied to a light inextensible string that runs over a fixed pulley at the table&#x27;s edge and down to a hanging mass. Let x be the cart&#x27;s distance from the pulley along the table and y the hanging mass&#x27;s depth below the pulley, both measured away from the pulley. Now x = 0.9 m and y = 0.5 m. (a) Write the string-length relation. (b) The hanging mass reaches the floor when y = 1.3 m. How far is the cart from the pulley then? (c) At an instant when the cart moves toward the pulley at 0.3 m/s and is speeding up at 1.2 m/s², give the hanging mass&#x27;s signed velocity and acceleration in these coordinates, and say which way it moves.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The pulley is fixed.</li><li>Only the horizontal and the vertical straight segments change length.</li><li>The string stays taut and inextensible.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FIXED-PULLEY-04-REP-NLM-CART-TABLE-PULLEY-XY" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CART-TABLE-PULLEY-XY" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="4" data-g9-stages="VIS-NLM-CARTXY-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The cart, pulley and mass" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 430">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARTXY-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A cart on a table tied over a fixed pulley to a hanging mass</text>\n    <line x1="20" y1="110" x2="440" y2="110" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="110" x2="22" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="110" x2="40" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="110" x2="58" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="110" x2="76" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="110" x2="94" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="110" x2="112" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="110" x2="130" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="110" x2="148" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="110" x2="166" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="110" x2="184" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="110" x2="202" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="110" x2="220" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="110" x2="238" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="110" x2="256" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="110" x2="274" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="110" x2="292" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="110" x2="310" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="110" x2="328" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="110" x2="346" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="110" x2="364" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="110" x2="382" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="110" x2="400" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="110" x2="418" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="425" y1="110" x2="425" y2="400" stroke="currentColor" stroke-width="2"/>\n    <circle cx="440" cy="100" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="180" y="70" width="80" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="95" text-anchor="middle">cart</text>\n    <line x1="260" y1="85" x2="440" y2="85" stroke="currentColor" stroke-width="1.5"/>\n    <line x1="455" y1="100" x2="455" y2="200" stroke="currentColor" stroke-width="1.5"/>\n    <rect x="435" y="200" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="455" y="225" text-anchor="middle">m</text>\n    <line x1="440" y1="55" x2="262" y2="55" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow)"/>\n    <text x="300" y="45">x = 0.9 m</text>\n    <line x1="470" y1="100" x2="530" y2="100" stroke="currentColor" stroke-width="1" stroke-dasharray="5 4"/>\n    <line x1="515" y1="100" x2="515" y2="198" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow)"/>\n    <text x="522" y="160">y = 0.5 m</text>\n    <text x="600" y="60">x and y measured away</text>\n    <text x="600" y="82">from the pulley</text>\n    <text x="600" y="104">pulley fixed; string taut</text>\n    <text x="600" y="126">and inextensible</text>\n    <text x="20" y="150">(b) the mass reaches the</text>\n    <text x="20" y="172">floor when y = 1.3 m</text>\n    <text x="20" y="194">(c) cart moves toward the</text>\n    <text x="20" y="216">pulley at 0.3 m/s, speeding</text>\n    <text x="20" y="238">up at 1.2 m/s²</text>\n  </g>\n  \n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The cart, pulley and mass</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CART-TABLE-PULLEY-XY" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="4" data-g9-stages-total="4" data-g9-stages="VIS-NLM-CARTXY-V0 VIS-NLM-CARTXY-V1 VIS-NLM-CARTXY-V2 VIS-NLM-CARTXY-V3" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 430" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-title g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-title">A cart on a table tied over a fixed pulley to a hanging mass, with x = 0.9 m and y = 0.5 m</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-desc">Stage 1: a cart on a table is tied by a light inextensible string over a fixed pulley at the table\'s edge to a hanging mass; x, the cart\'s distance from the pulley, is 0.9 m and y, the mass\'s depth below the pulley, is 0.5 m, both measured away from the pulley. Stage 2: only the two straight segments change length, so x + y = 1.4 m. Stage 3: when y = 1.3 m, x = 1.4 − 1.3 = 0.1 m (dashed positions). Stage 4: with the cart moving toward the pulley at 0.3 m/s and speeding up at 1.2 m/s², dx/dt = −0.3 m/s and d²x/dt² = −1.2 m/s², so dy/dt = +0.3 m/s and d²y/dt² = +1.2 m/s²: the mass moves down, speeding up.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARTXY-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A cart on a table tied over a fixed pulley to a hanging mass</text>\n    <line x1="20" y1="110" x2="440" y2="110" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="110" x2="22" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="110" x2="40" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="110" x2="58" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="110" x2="76" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="110" x2="94" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="110" x2="112" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="110" x2="130" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="110" x2="148" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="110" x2="166" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="110" x2="184" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="110" x2="202" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="110" x2="220" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="110" x2="238" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="110" x2="256" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="110" x2="274" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="110" x2="292" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="110" x2="310" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="110" x2="328" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="110" x2="346" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="110" x2="364" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="110" x2="382" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="110" x2="400" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="110" x2="418" y2="118" stroke="currentColor" stroke-width="1"/>\n    <line x1="425" y1="110" x2="425" y2="400" stroke="currentColor" stroke-width="2"/>\n    <circle cx="440" cy="100" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="180" y="70" width="80" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="95" text-anchor="middle">cart</text>\n    <line x1="260" y1="85" x2="440" y2="85" stroke="currentColor" stroke-width="1.5"/>\n    <line x1="455" y1="100" x2="455" y2="200" stroke="currentColor" stroke-width="1.5"/>\n    <rect x="435" y="200" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="455" y="225" text-anchor="middle">m</text>\n    <line x1="440" y1="55" x2="262" y2="55" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow)"/>\n    <text x="300" y="45">x = 0.9 m</text>\n    <line x1="470" y1="100" x2="530" y2="100" stroke="currentColor" stroke-width="1" stroke-dasharray="5 4"/>\n    <line x1="515" y1="100" x2="515" y2="198" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-bound-REP-NLM-CART-TABLE-PULLEY-XY-1--rep-nlm-cartxy-arrow)"/>\n    <text x="522" y="160">y = 0.5 m</text>\n    <text x="600" y="60">x and y measured away</text>\n    <text x="600" y="82">from the pulley</text>\n    <text x="600" y="104">pulley fixed; string taut</text>\n    <text x="600" y="126">and inextensible</text>\n    <text x="20" y="150">(b) the mass reaches the</text>\n    <text x="20" y="172">floor when y = 1.3 m</text>\n    <text x="20" y="194">(c) cart moves toward the</text>\n    <text x="20" y="216">pulley at 0.3 m/s, speeding</text>\n    <text x="20" y="238">up at 1.2 m/s²</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARTXY-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="600" y="170" font-weight="600">x + y = 0.9 + 0.5 = 1.4 m</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARTXY-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <rect x="340" y="70" width="80" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4"/>\n    <rect x="435" y="360" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4"/>\n    <text x="600" y="210">y = 1.3 m:</text>\n    <text x="600" y="232">x = 1.4 − 1.3 = 0.1 m</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARTXY-V3" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="600" y="276" fill="#1f6fb2">dx/dt = −0.3 m/s,</text>\n    <text x="600" y="298" fill="#1f6fb2">d²x/dt² = −1.2 m/s²</text>\n    <text x="600" y="320" fill="#1f6fb2">dy/dt = +0.3 m/s,</text>\n    <text x="600" y="342" fill="#1f6fb2">d²y/dt² = +1.2 m/s²</text>\n    <text x="600" y="376" font-weight="600" fill="#1f6fb2">the mass moves down,</text>\n    <text x="600" y="398" font-weight="600" fill="#1f6fb2">speeding up</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the string&#x27;s two straight segments and both coordinates.">1: The cart, pulley and mass</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write the fixed-length relation with the values now.">2: Length relation</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Find x when y = 1.3 m.">3: Mass at the floor</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="3" data-g9-stage-desc="Carry the cart&#x27;s signed velocity and acceleration to the mass.">4: Signed rates</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the cart on the table tied over the fixed pulley to the hanging mass, with x = 0.9 m and y = 0.5 m measured away from the pulley.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Only the two straight segments change length, one along the table and one hanging down; the part over the fixed pulley stays the same. So x + y = constant = 0.9 + 0.5 = 1.4 m.</li><li>When y = 1.3 m, x = 1.4 − 1.3 = 0.1 m: the cart is 0.1 m from the pulley.</li><li>Differentiating x + y = constant gives dx/dt + dy/dt = 0 and d²x/dt² + d²y/dt² = 0.</li><li>Toward the pulley means x is decreasing, so dx/dt = −0.3 m/s; speeding up in that direction means d²x/dt² = −1.2 m/s². Then dy/dt = +0.3 m/s and d²y/dt² = +1.2 m/s²: y grows, so the mass moves down, faster and faster.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>x + y = 1.4 m. When y = 1.3 m, x = 0.1 m. Moving toward the pulley and speeding up means dx/dt = −0.3 m/s and d²x/dt² = −1.2 m/s², so dy/dt = +0.3 m/s and d²y/dt² = +1.2 m/s²: the hanging mass moves down at 0.3 m/s and speeds up at 1.2 m/s².</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The mass falls 1.3 − 0.5 = 0.8 m while the cart moves 0.9 − 0.1 = 0.8 m toward the pulley: equal lengths, as an inextensible string requires, even though one segment is horizontal and the other vertical.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You gave the hanging mass a velocity of −0.3 m/s, or a horizontal velocity: the string turns at the pulley, so the mass moves down, and in away-from-pulley coordinates y grows as x shrinks.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM11-3" data-g9-concept-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-repair-target="CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-1" href="#g9-CORE1A--CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-1">Revisit: Differentiate the fixed-length relation at the kinematic level needed by the problem.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: x + y = constant holds whatever direction each straight segment points, because it is a statement about lengths measured from the fixed pulley, so the signed rates are opposite. The transfer task gives the geometry in words with upward coordinates, so the length relation must be rebuilt.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-authored"><ol data-g9-ladder><li data-g9-rung="1">Which two straight parts of the string change length when the cart moves?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-authored-2"><li data-g9-rung="2">Sketch the table, pulley and hanging mass. Mark x along the table and y down from the pulley, each with an arrow pointing away from the pulley.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FIXED-PULLEY-04-authored-3"><li data-g9-rung="3">Write their sum with the values now. When the cart moves toward the pulley, which way does x change, and what must y do?</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-unit="Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion An accelerating observer needs a declared pseudo-force convention Hard concept High-transfer / exception-sensitive Newton-law and observer-frame practice Constructed response Authored practice A delivery van accelerates forward along a straight, level road at 2 m/s². A passenger holds a 0.2 kg apple still, 1.25 m above the van&#x27;s floor, and lets go. Ignore air resistance and take g = 10 m/s². (a) Seen from the roadside, which horizontal forces act on the apple after release, and what does its horizontal velocity do? (b) Seen from inside the van, what pseudo-force (size and direction) must the passenger add, and what horizontal acceleration does it give the apple? (c) Where does the apple land relative to the point on the floor directly below the release point? Show that both descriptions give the same answer. The roadside frame is treated as inertial. The van&#x27;s acceleration stays 2 m/s² forward during the fall. Air resistance is negligible." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRAME-CHOICE" data-g9-meta-value="An accelerating observer needs a declared pseudo-force convention"><strong>Concept:</strong> <span data-g9-meta-label>An accelerating observer needs a declared pseudo-force convention</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRAME-CHOICE" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-meta-value="D4"><strong>Question difficulty:</strong> <span data-g9-meta-label>High-transfer / exception-sensitive</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FRAME-CHOICE-07" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A delivery van accelerates forward along a straight, level road at 2 m/s². A passenger holds a 0.2 kg apple still, 1.25 m above the van&#x27;s floor, and lets go. Ignore air resistance and take g = 10 m/s². (a) Seen from the roadside, which horizontal forces act on the apple after release, and what does its horizontal velocity do? (b) Seen from inside the van, what pseudo-force (size and direction) must the passenger add, and what horizontal acceleration does it give the apple? (c) Where does the apple land relative to the point on the floor directly below the release point? Show that both descriptions give the same answer.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The roadside frame is treated as inertial.</li><li>The van&#x27;s acceleration stays 2 m/s² forward during the fall.</li><li>Air resistance is negligible.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRAME-CHOICE-07-REP-NLM-VAN-APPLE-DROP" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-VAN-APPLE-DROP" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="4" data-g9-stages="VIS-NLM-VANAPPLE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The van and the apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 330">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-VANAPPLE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">An apple released inside a van accelerating forward</text>\n    <line x1="20" y1="290" x2="500" y2="290" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="290" x2="22" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="290" x2="40" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="290" x2="58" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="290" x2="76" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="290" x2="94" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="290" x2="112" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="290" x2="130" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="290" x2="148" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="290" x2="166" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="290" x2="184" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="290" x2="202" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="290" x2="220" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="290" x2="238" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="290" x2="256" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="290" x2="274" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="290" x2="292" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="290" x2="310" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="290" x2="328" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="290" x2="346" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="290" x2="364" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="290" x2="382" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="290" x2="400" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="290" x2="418" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="444" y1="290" x2="436" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="462" y1="290" x2="454" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="480" y1="290" x2="472" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="498" y1="290" x2="490" y2="298" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="100" width="420" height="160" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="120" cy="275" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="420" cy="275" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="300" cy="135" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="250" y="125" text-anchor="end">apple 0.2 kg</text>\n    <line x1="300" y1="252" x2="300" y2="268" stroke="currentColor" stroke-width="2"/>\n    <text x="308" y="250">mark</text>\n    <line x1="310" y1="135" x2="390" y2="135" stroke="currentColor" stroke-width="1" stroke-dasharray="5 4"/>\n    <line x1="380" y1="135" x2="380" y2="258" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow)"/>\n    <text x="388" y="205">1.25 m</text>\n    <line x1="200" y1="70" x2="300" y2="70" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow)"/>\n    <text x="200" y="60">van: a = 2 m/s² forward</text>\n    <text x="520" y="60">released from rest</text>\n    <text x="520" y="82">relative to the van;</text>\n    <text x="520" y="104">g = 10 m/s², no air resistance</text>\n    <text x="520" y="126">the mark is on the floor</text>\n    <text x="520" y="148">directly below the release point</text>\n  </g>\n  \n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The van and the apple</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-VAN-APPLE-DROP" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="4" data-g9-stages-total="4" data-g9-stages="VIS-NLM-VANAPPLE-V0 VIS-NLM-VANAPPLE-V1 VIS-NLM-VANAPPLE-V2 VIS-NLM-VANAPPLE-V3" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 330" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-title g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-title">A 0.2 kg apple released 1.25 m above the floor of a van accelerating forward at 2 m/s²</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-desc">Stage 1: a passenger in a van accelerating forward at 2 m/s² releases a 0.2 kg apple from rest relative to the van, 1.25 m above the floor; a mark on the floor lies directly below the release point; g = 10 m/s² and air resistance is ignored. Stage 2: from the roadside only the weight acts, so the apple keeps the van\'s speed at release; the fall takes 0.5 s and the floor gains 0.25 m on it. Stage 3: in the van a pseudo-force of 0.4 N backward gives the apple 2 m/s² backward, so it drifts 0.25 m back. Stage 4: both descriptions put the landing point 0.25 m behind the mark.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-VANAPPLE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">An apple released inside a van accelerating forward</text>\n    <line x1="20" y1="290" x2="500" y2="290" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="290" x2="22" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="290" x2="40" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="290" x2="58" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="290" x2="76" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="290" x2="94" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="290" x2="112" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="290" x2="130" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="290" x2="148" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="290" x2="166" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="290" x2="184" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="290" x2="202" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="290" x2="220" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="290" x2="238" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="290" x2="256" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="290" x2="274" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="290" x2="292" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="290" x2="310" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="290" x2="328" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="290" x2="346" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="290" x2="364" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="290" x2="382" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="290" x2="400" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="290" x2="418" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="444" y1="290" x2="436" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="462" y1="290" x2="454" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="480" y1="290" x2="472" y2="298" stroke="currentColor" stroke-width="1"/>\n    <line x1="498" y1="290" x2="490" y2="298" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="100" width="420" height="160" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="120" cy="275" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="420" cy="275" r="15" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="300" cy="135" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="250" y="125" text-anchor="end">apple 0.2 kg</text>\n    <line x1="300" y1="252" x2="300" y2="268" stroke="currentColor" stroke-width="2"/>\n    <text x="308" y="250">mark</text>\n    <line x1="310" y1="135" x2="390" y2="135" stroke="currentColor" stroke-width="1" stroke-dasharray="5 4"/>\n    <line x1="380" y1="135" x2="380" y2="258" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow)"/>\n    <text x="388" y="205">1.25 m</text>\n    <line x1="200" y1="70" x2="300" y2="70" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow)"/>\n    <text x="200" y="60">van: a = 2 m/s² forward</text>\n    <text x="520" y="60">released from rest</text>\n    <text x="520" y="82">relative to the van;</text>\n    <text x="520" y="104">g = 10 m/s², no air resistance</text>\n    <text x="520" y="126">the mark is on the floor</text>\n    <text x="520" y="148">directly below the release point</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-VANAPPLE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="520" y="190" font-weight="600">Roadside</text>\n    <text x="520" y="212">only the weight acts; the apple</text>\n    <text x="520" y="234">keeps the van\'s speed at release;</text>\n    <text x="520" y="256">fall 0.5 s; the floor gains 0.25 m</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-VANAPPLE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="292" y1="150" x2="250" y2="150" stroke="#1f6fb2" stroke-width="2.5" stroke-dasharray="6 4" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-bound-REP-NLM-VAN-APPLE-DROP-1--rep-nlm-vanapple-arrow-acc)"/>\n    <text x="160" y="175" fill="#1f6fb2">pseudo-force 0.4 N</text>\n    <text x="520" y="290" fill="#1f6fb2">Van: pseudo-force 0.4 N backward,</text>\n    <text x="520" y="312" fill="#1f6fb2">2 m/s² backward, drifts 0.25 m back</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-VANAPPLE-V3" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <circle cx="275" cy="243" r="9" fill="none" stroke="#1f6fb2" stroke-width="2"/>\n    <text x="70" y="215" font-weight="600" fill="#1f6fb2">lands 0.25 m behind the mark</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the van&#x27;s acceleration, the release height and the mark.">1: The van and the apple</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Describe the fall with physical forces only.">2: Roadside view</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Describe the fall in the van frame with its pseudo-force.">3: Van view</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="3" data-g9-stage-desc="Compare the two descriptions&#x27; landing points.">4: Landing point</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 0.2 kg apple released 1.25 m above the floor of the van accelerating forward at 2 m/s², with the mark directly below the release point.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Vertically nothing differs between the two observers, so the fall time is t = √(2 × 1.25/10) = 0.5 s in both.</li><li>Roadside: after release nothing touches the apple, so the only force is its weight, vertical. Its horizontal velocity stays at u, the van&#x27;s speed at release.</li><li>In 0.5 s the apple moves u × 0.5 forward, while the floor moves u × 0.5 + ½ × 2 × 0.5² = u × 0.5 + 0.25 m. The floor gains 0.25 m, so the apple lands 0.25 m behind the mark.</li><li>Van: the observer accelerates at 2 m/s² forward, so the apple is given a pseudo-force −m a_frame = 0.4 N backward. Relative to the van it starts from rest and accelerates backward at 0.4/0.2 = 2 m/s², moving ½ × 2 × 0.5² = 0.25 m backward.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The fall takes 0.5 s (1.25 = ½ × 10 × t²). Roadside: no horizontal force acts, so the apple keeps the van&#x27;s speed at release while the floor speeds up and gains ½ × 2 × 0.5² = 0.25 m on it. Van: a pseudo-force of 0.2 × 2 = 0.4 N backward gives the apple a backward acceleration of 2 m/s², so it drifts 0.25 m backward. Both descriptions put the landing point 0.25 m behind the point below the release point.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If the van moved at a steady velocity, the floor would move u × 0.5 like the apple and the apple would land directly below the release point, and the van observer would need no pseudo-force. The 0.25 m shift comes only from the van&#x27;s acceleration.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You had the apple land directly below the release point: that is true only if the van keeps a steady velocity. While the van accelerates, the floor gains 0.25 m on the apple during the 0.5 s fall. Or you gave the apple a backward physical force in the roadside account: nothing touches it after release.</p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: an inertial observer uses physical forces only, and an accelerating observer adds −m a_frame; both predict the same measurable landing point. The transfer task asks you to choose the frame yourself from what the description must achieve.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-authored"><ol data-g9-ladder><li data-g9-rung="1">After release, does anything touch the apple? Which forces act on it, and in which directions?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-authored-2"><li data-g9-rung="2">Draw the apple twice, once as the roadside observer sees it and once as the passenger sees it, each with only the forces that observer uses and an arrow for that observer&#x27;s own acceleration.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRAME-CHOICE-07-authored-3"><li data-g9-rung="3">The fall time is the same for both observers. For each observer, write the horizontal acceleration of the apple, and of the floor, during that time.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-unit="Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Friction opposes relative sliding at a contact Medium concept Direct application Newton-law and observer-frame practice Constructed response Authored practice A crate rests on a rough horizontal floor. No horizontal force acts on it, and there is no tendency for the crate to slide relative to the floor. What is the friction force on the crate? The crate remains at rest. No other horizontal interaction acts on the crate." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="Friction opposes relative sliding at a contact"><strong>Concept:</strong> <span data-g9-meta-label>Friction opposes relative sliding at a contact</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-meta-value="D1"><strong>Question difficulty:</strong> <span data-g9-meta-label>Direct application</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-ZERO-08" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A crate rests on a rough horizontal floor. No horizontal force acts on it, and there is no tendency for the crate to slide relative to the floor. What is the friction force on the crate?</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The crate remains at rest.</li><li>No other horizontal interaction acts on the crate.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-ZERO-08-REP-NLM-CRATE-ZERO-FRICTION" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CRATE-ZERO-FRICTION" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CRATE0-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The crate" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CRATE0-V0" font-family="system-ui,sans-ser