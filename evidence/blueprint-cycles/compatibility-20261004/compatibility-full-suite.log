ata-g9-component="LEARNING_TRANSITIONS"]{order:150}article[data-g9-role="CORE1A"] [data-g9-component="MODEL_SCOPE_PROBE"]{order:80}}@media print{article[data-g9-role="CORE1A"] .g9-split{display:grid;grid-template-columns:minmax(0,60fr) minmax(0,40fr);gap:12px}}@media (min-width:1100px){article[data-g9-role="CORE1B"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:22px;align-items:start}article[data-g9-role="CORE1B"] .g9-split-primary-only,article[data-g9-role="CORE1B"] .g9-split-support-only{grid-template-columns:minmax(0,1fr)}}@media print{article[data-g9-role="CORE1B"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:12px}}@media (min-width:1100px){article[data-g9-role="CORE2A"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:22px;align-items:start}article[data-g9-role="CORE2A"] .g9-split-primary-only,article[data-g9-role="CORE2A"] .g9-split-support-only{grid-template-columns:minmax(0,1fr)}}@media print{article[data-g9-role="CORE2A"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:12px}}@media (min-width:1100px){article[data-g9-role="CORE2B"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:22px;align-items:start}article[data-g9-role="CORE2B"] .g9-split-primary-only,article[data-g9-role="CORE2B"] .g9-split-support-only{grid-template-columns:minmax(0,1fr)}}@media print{article[data-g9-role="CORE2B"] .g9-split{display:grid;grid-template-columns:minmax(0,68fr) minmax(0,32fr);gap:12px}}</style></head><body data-core="CORE2A" data-blueprint-ref="BP-CORE2A-SUPPORTED-APPLICATION@1.1.0"><header class="g9-shell-header" data-g9-shell-header><div class="g9-header-inner"><a href="../../index.html" class="g9-brand"><span class="logo-icon">⚡</span><span class="brand-title">Grade9V3.5</span><span class="g9-brand-badge">Learner Platform</span></a><nav class="g9-header-nav" aria-label="Portal Navigation"><a href="../../index.html">Home</a><a href="../../../physics/index.html">Physics</a><a href="../../../chemistry/index.html">Chemistry</a><a href="../../../mathematics/index.html">Mathematics</a><a href="../../index.html">Question Bank</a></nav><div class="g9-header-actions"><button type="button" class="g9-header-btn g9-search-btn" data-g9-action="search" title="Search Grade9V3 (Ctrl/⌘ K)" aria-label="Search"><span class="g9-btn-icon">🔍</span><span class="g9-btn-text">Search</span></button><button type="button" class="g9-header-btn g9-display-btn" data-g9-action="display" title="Display & Theme Settings" aria-label="Display & Theme"><span class="g9-btn-icon">🌙 / ☀️</span><span class="g9-btn-text">Display</span></button><a class="g9-header-btn" data-g9-action="pdf" href="core2a.pdf" title="Open the PDF of this page to print it">PDF</a></div></div><div data-g9-search-panel hidden><input data-g9-search-input type="search" aria-label="Search this page"></div><div data-g9-display-panel hidden><button type="button" data-g9-font="dec">A-</button><button type="button" data-g9-font="reset">A</button><button type="button" data-g9-font="inc">A+</button><button type="button" data-g9-theme="light">Light</button><button type="button" data-g9-theme="dark">Dark</button><button type="button" data-g9-zoom="dec">Zoom -</button><button type="button" data-g9-zoom="reset">100%</button><button type="button" data-g9-zoom="inc">Zoom +</button></div></header><div class="g9-concept-triad-bar"><div class="g9-triad-inner"><div class="g9-triad-context" aria-label="breadcrumb"><a href="../../index.html">Home</a> / <a href="../../../physics/index.html">Physics</a> / <a href="../../../topics/nlm/index.html">Two-dimensional kinematics and projectile model</a> / <span aria-current="page">CORE2A</span></div><span class="g9-triad-concept-title">Concept: Two-dimensional kinematics and projectile model</span><div class="g9-triad-actions"><a class="g9-triad-btn g9-btn-learn" href="core1a.html">📖 Learn</a><a class="g9-triad-btn g9-btn-practice" href="core2.html">✍️ Practice</a><a class="g9-triad-btn g9-btn-qb" href="../../../question-bank/index.html?capability=CAP-KIN-PROJECTILE-MODEL">All questions in QB &rarr;</a></div></div></div><noscript>Answers open after you attempt; this page needs JavaScript.</noscript><main><h1>Two-dimensional kinematics and projectile model: Supported practice</h1><article id="Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-unit="Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A tracker reports x(t)=4t metres and y(t)=10-2t^2 metres for one particle in one fixed frame. Find the particle&#x27;s position at t=2 s, and explain why x(2 s) may not be paired with y(3 s) to describe one position." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-SHARED-CLOCK-01" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A tracker reports x(t)=4t metres and y(t)=10-2t^2 metres for one particle in one fixed frame. Find the particle&#x27;s position at t=2 s, and explain why x(2 s) may not be paired with y(3 s) to describe one position.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The two functions refer to the same particle and the same time coordinate.</li><li>Use the declared fixed x-y frame.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Treat x(t) and y(t) as two coordinate projections of the same particle in one fixed frame, tied to one common event time t.<br><em>Why valid:</em> A single plane position is defined by simultaneous coordinates of one particle; independent component functions do not create independent clocks.</li><li><strong>TRANSFORM</strong> Substitute t=2 s into both component functions to obtain x(2)=8 m and y(2)=2 m.<br><em>Why valid:</em> The requested state is the event labelled t=2 s, so both component functions must be sampled at that event.</li><li><strong>CONNECT</strong> Pair the two simultaneous values as the position (8,2) m and reject x(2) paired with y(3) as a single physical state.<br><em>Why valid:</em> Coordinates form one state only when they refer to the same object, frame and instant; changing one timestamp changes the event.</li><li><strong>VERIFY</strong> Attach the timestamp to each component value and confirm the two timestamps match before calling the pair a position.<br><em>Why valid:</em> Timestamp agreement is an independent event-identity check that does not depend on the arithmetic values themselves.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Evaluate both component descriptions at the same requested time.</li><li>x(2)=4(2)=8.</li><li>y(2)=10-2(2^2)=2.</li><li>A physical plane state is a simultaneous component pair.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>At t=2 s, x=8 m and y=2 m, so the position is (8,2) m in the declared frame. x(2 s) and y(3 s) cannot form one position because they refer to different instants.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The answer must use one t for both components; mixing timestamps produces no real single-time state.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D1-4" data-g9-concept-ref="MIC-PHY-KIN-2D-INDEPENDENT-COMPONENTS" data-g9-repair-target="CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1" href="core1a.html#CU-PHY-KIN-2D-INDEPENDENT-COMPONENTS-1">Revisit: Recombine only component values that refer to the same frame and the same instant.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored"><ol data-g9-ladder><li data-g9-rung="1">What must be the same when x(t) and y(t) describe one particle at one instant?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-2"><li data-g9-rung="2">Write x(t) and y(t) in two columns connected to one clock t before substituting any number.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-3"><li data-g9-rung="3">Evaluate both component functions at the requested t before pairing them.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SHARED-CLOCK-01-authored-4"><li data-g9-rung="4">Label the time beside each evaluated component before you pair the coordinates.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-unit="Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A particle starts with velocity (3 i + 4 j) m/s and has constant acceleration (2 i - 1 j) m/s^2 for 3 s. Find its velocity and displacement after 3 s." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A particle starts with velocity (3 i + 4 j) m/s and has constant acceleration (2 i - 1 j) m/s^2 for 3 s. Find its velocity and displacement after 3 s.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Both acceleration components are constant over the 3 s interval.</li><li>The initial position is irrelevant because the question asks for displacement.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Resolve the vectors into u_x=3, u_y=4, a_x=2 and a_y=-1, with the same elapsed time 3 s on both axes.<br><em>Why valid:</em> Component kinematics is valid only after the signed components and common physical interval are explicit.</li><li><strong>CONNECT</strong> Apply v=u+at and displacement=ut+(1/2)at^2 separately to x and y while preserving signs and the common time.<br><em>Why valid:</em> The given acceleration vector is constant, so each Cartesian acceleration component is constant over the same interval and the 1D relations apply component-wise.</li><li><strong>TRANSFORM</strong> Compute v_x=9, v_y=1, Delta x=18 and Delta y=7.5 from the two component equations.<br><em>Why valid:</em> Substitution into the component equations preserves the negative y acceleration instead of replacing signed components by magnitudes.</li><li><strong>VERIFY</strong> Check units and signs axis by axis, then confirm both vector components refer to the same 3 s endpoint.<br><em>Why valid:</em> Unit consistency detects relation misuse and the common-endpoint check prevents combining component states from different times.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Use v_x=3+2(3)=9 and v_y=4-1(3)=1.</li><li>Use Delta x=3(3)+0.5(2)(3^2)=18.</li><li>Use Delta y=4(3)+0.5(-1)(3^2)=7.5.</li><li>Both axes use the same 3 s interval.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>v=(9 i + 1 j) m/s and Delta r=(18 i + 7.5 j) m.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Each axis uses only its own signed component values; units are m/s for velocity and m for displacement.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D2-2" data-g9-concept-ref="MIC-PHY-KIN-2D-CONSTANT-ACCELERATION" data-g9-repair-target="CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1" href="core1a.html#CU-PHY-KIN-2D-CONSTANT-ACCELERATION-1">Revisit: Apply the one-dimensional constant-acceleration relations independently to x and y using only that axis&#x27;s signed values and the same t.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored"><ol data-g9-ladder><li data-g9-rung="1">Write the x and y initial velocity and acceleration values separately before calculating.</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-2"><li data-g9-rung="2">Make a signed table for u_x, u_y, a_x and a_y before choosing equations.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-3"><li data-g9-rung="3">Apply the same 1D constant-acceleration relation independently on each axis using the common 3 s.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-CONSTANT-ACCEL-02-authored-4"><li data-g9-rung="4">Run the constant-acceleration relation once on x and once on y while keeping one shared 3 s interval.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-unit="Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="An ideal projectile is launched with already-resolved components u_x=12 m/s and u_y=20 m/s. Take +y upward and g=10 m/s^2. Find the time to the apex, the velocity at the apex, the acceleration at the apex, and the height gained above launch." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile is launched with already-resolved components u_x=12 m/s and u_y=20 m/s. Take +y upward and g=10 m/s^2. Find the time to the apex, the velocity at the apex, the acceleration at the apex, and the height gained above launch.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>After release, gravity is the only retained force.</li><li>The given initial components are already resolved.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent ideal flight with a_x=0, a_y=-g, constant v_x=u_x and v_y=u_y-gt in the upward-positive frame.<br><em>Why valid:</em> Gravity-only free flight leaves horizontal velocity constant while vertical velocity changes under a constant downward acceleration.</li><li><strong>DECIDE</strong> Identify the apex by v_y=0, not by setting the full velocity or acceleration to zero.<br><em>Why valid:</em> At a vertical turning point v_y changes sign, while horizontal motion continues and gravity remains present.</li><li><strong>TRANSFORM</strong> Solve t=2 s, then evaluate velocity, acceleration and height gain at that same event time.<br><em>Why valid:</em> Every requested quantity describes the same apex event, so the time obtained from v_y=0 must be reused across both components.</li><li><strong>VERIFY</strong> Confirm that only v_y vanishes at the apex while v_x and downward acceleration remain nonzero.<br><em>Why valid:</em> This component check distinguishes a vertical turning point from the false claim that the projectile stops or gravity vanishes.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>At the apex set v_y=u_y-gt=0, so t=20/10=2 s.</li><li>Horizontal acceleration is zero, so v_x remains 12 m/s.</li><li>Gravity still acts at the apex, so a_y=-10 m/s^2.</li><li>Delta y=20(2)-0.5(10)(2^2)=20 m.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The apex occurs at t=2 s. There v=(12 i + 0 j) m/s, a=(0 i - 10 j) m/s^2, and the height gained is 20 m.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Only v_y is zero at the apex; neither the full velocity nor the acceleration is zero.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-4" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="core1a.html#MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For an apex event, set v_y=0 while keeping v_x=u_x and a_y=-g.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored"><ol data-g9-ladder><li data-g9-rung="1">Which component condition defines the apex?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-2"><li data-g9-rung="2">Write separate horizontal and vertical rules before deciding what condition defines the top of the path.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-3"><li data-g9-rung="3">Set only v_y to zero, solve for the shared time, then evaluate the other requested quantities at that time.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-PROJECTILE-APEX-03-authored-4"><li data-g9-rung="4">At the apex, decide which velocity component changes sign and set only that component to zero.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-unit="Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="A stone is launched horizontally at 15 m/s from a cliff 20 m above level ground. Take +y upward and g=10 m/s^2. Find the flight time, horizontal range and impact velocity." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A stone is launched horizontally at 15 m/s from a cliff 20 m above level ground. Take +y upward and g=10 m/s^2. Find the flight time, horizontal range and impact velocity.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>The launch has u_y=0.</li><li>Ground is 20 m below the launch point.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent the horizontal and vertical histories in one declared frame with one shared elapsed time, placing the 20 m drop in the vertical component.<br><em>Why valid:</em> The component equations evolve independently but still describe one stone at one physical instant, so the known landing geometry belongs to y while time remains common.</li><li><strong>DECIDE</strong> Use the vertical ground-contact condition Delta y=-20 m to determine the flight time before calculating horizontal range or impact velocity.<br><em>Why valid:</em> Ground impact is defined by the vertical displacement, so the y equation identifies the event time; that one time then belongs to every component at impact.</li><li><strong>CONNECT</strong> Reuse t_event=2 s in the horizontal displacement and both velocity components.<br><em>Why valid:</em> Range and impact velocity must be reconstructed at the same physical event that the vertical equation identified.</li><li><strong>VERIFY</strong> Check that the ideal fall time is set by vertical motion while horizontal speed changes the range but not the vertical landing event.<br><em>Why valid:</em> With a_x=0 and no drag, the vertical event equation contains no horizontal speed.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>Use the vertical condition Delta y=-20=0*t-0.5(10)t^2, giving t=2 s.</li><li>Then Delta x=15(2)=30 m.</li><li>v_x=15 m/s and v_y=-10(2)=-20 m/s at impact.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The flight time is 2 s, the horizontal range is 30 m, and the impact velocity is (15 i - 20 j) m/s.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The fall time comes from vertical motion; changing only horizontal speed would change range but not the ideal fall time.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-6" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="core1a.html#MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For any unequal-height landing, use the actual Delta y=y_f-y_i in the vertical position equation and retain the actual u_y; for a horizontal launch specifically, set u_y=0, then obtain the event time vertically and share it with x.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored"><ol data-g9-ladder><li data-g9-rung="1">Which component equation contains the known 20 m drop?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-2"><li data-g9-rung="2">Draw x and y as separate columns tied to one shared t, and place the 20 m drop only in the y column.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-3"><li data-g9-rung="3">Find the common impact time from y first, then use that same time in x and in the velocity components.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-HORIZONTAL-LAUNCH-04-authored-4"><li data-g9-rung="4">Name the physical condition that says the stone has reached the ground before solving for the event time.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-unit="Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="An ideal projectile is launched and later lands at the same height with u_x=12 m/s, u_y=16 m/s and g=8 m/s^2. Find the total flight time, range and landing velocity." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-KIN-2D-2A-SAME-HEIGHT-05" data-g9-meta-incomplete="true"></div><div class="g9-block" data-g9-block="family_identity"><p>Motion in 2D component and projectile practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>An ideal projectile is launched and later lands at the same height with u_x=12 m/s, u_y=16 m/s and g=8 m/s^2. Find the total flight time, range and landing velocity.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Air resistance is neglected.</li><li>Launch and landing heights are equal.</li><li>Take +y upward.</li></ul></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Represent landing at the launch height with Delta y=0 while keeping a_x=0, a_y=-g and one common flight time.<br><em>Why valid:</em> Same launch and landing height fixes the vertical event displacement without changing the gravity-only component model.</li><li><strong>DECIDE</strong> Choose the nonzero root of the vertical event equation as the landing time and reject t=0 as the launch event.<br><em>Why valid:</em> The equation describes two visits to the launch height; event identity selects the later root because the question asks for landing.</li><li><strong>CONNECT</strong> Reuse t=4 s in horizontal displacement and vertical velocity to obtain range and landing velocity.<br><em>Why valid:</em> Range and landing velocity belong to the same landing event identified by the vertical equation.</li><li><strong>VERIFY</strong> Compare launch and landing components: v_x must match while v_y has equal magnitude and opposite sign.<br><em>Why valid:</em> With zero horizontal acceleration and constant downward gravity, return to the same height restores vertical speed magnitude while reversing its direction.</li></ol></div><div class="g9-block" data-g9-block="solution"><ol><li>At landing Delta y=0=16t-0.5(8)t^2; the nonzero root is t=4 s.</li><li>Horizontal velocity stays 12 m/s, so range=12(4)=48 m.</li><li>v_y=16-8(4)=-16 m/s at landing.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The flight time is 4 s, the range is 48 m, and the landing velocity is (12 i - 16 j) m/s.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At the same height, the horizontal component matches launch and the vertical component has equal magnitude with opposite sign.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="K2D3-5" data-g9-concept-ref="MIC-PHY-KIN-PROJECTILE-MODEL" data-g9-repair-target="MIC-PHY-KIN-PROJECTILE-MODEL" href="core1a.html#MIC-PHY-KIN-PROJECTILE-MODEL">Revisit: For a return to the launch height, set Delta y=0 and treat any same-height flight-time/range shortcut as conditional on that equality.</a></p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored"><ol data-g9-ladder><li data-g9-rung="1">What vertical displacement condition is true at a same-height landing?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-2"><li data-g9-rung="2">Write the landing geometry first: identify Delta y when the projectile returns to its launch height.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-3"><li data-g9-rung="3">Use Delta y=0 to obtain the nonzero landing time, then reuse that time in x and v_y.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-KIN-2D-2A-SAME-HEIGHT-05-authored-4"><li data-g9-rung="4">The vertical equation has a launch root and a later root; identify which event is requested before reusing the time.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article></main><footer data-g9-footer>Physics · Two-dimensional kinematics and projectile model</footer><script>\n(()=>{const q=(s,r=document)=>[...r.querySelectorAll(s)];\nconst store={get:k=>{try{return localStorage.getItem(\'g9-\'+k)}catch(e){return null}},set:(k,v)=>{try{localStorage.setItem(\'g9-\'+k,v);return true}catch(e){return false}},remove:k=>{try{localStorage.removeItem(\'g9-\'+k);return true}catch(e){return false}}};\nconst root=document.documentElement;const scope=root.dataset.g9Product&&root.dataset.g9RenderDigest?root.dataset.g9Product+\':\'+root.dataset.g9RenderDigest:\'\';\nconst apply=()=>{root.dataset.theme=store.get(\'theme\')||root.dataset.theme||\'light\';root.style.setProperty(\'--g9-zoom\',store.get(\'zoom\')||\'1\');};apply();\nq(\'[data-g9-theme]\').forEach(b=>b.onclick=()=>{store.set(\'theme\',b.dataset.g9Theme);apply()});\nq(\'[data-g9-zoom]\').forEach(b=>b.onclick=()=>{let z=parseFloat(store.get(\'zoom\')||\'1\');z=b.dataset.g9Zoom===\'inc\'?Math.min(1.6,z+0.1):b.dataset.g9Zoom===\'dec\'?Math.max(0.8,z-0.1):1;store.set(\'zoom\',z.toFixed(1));apply()});\nq(\'[data-g9-font]\').forEach(b=>b.onclick=()=>q(\'[data-g9-zoom="\'+b.dataset.g9Font+\'"]\')[0]?.click());\nfunction initFigure(f){if(f.dataset.g9Init)return;f.dataset.g9Init=\'1\';const ids=(f.dataset.g9Stages||\'\').split(\' \').filter(Boolean);if(ids.length<2)return;let i=0;\nconst chips=q(\'[data-g9-stage-goto]\',f);const desc=q(\'[data-g9-stage-desc-text]\',f)[0];\nconst stageMode=f.dataset.g9StageMode||\'cumulative\';const cumulative=stageMode!==\'replace\';\nids.forEach(id=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=\'none\'));\nconst show=()=>{ids.forEach((id,n)=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=(cumulative?n<=i:n===i)?\'\':\'none\'));const l=q(\'[data-g9-stage-label]\',f)[0];if(l)l.textContent=\'Stag