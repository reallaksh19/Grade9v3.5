 x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="130" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="205" y="170" text-anchor="middle">crate</text>\n    <text x="20" y="275">no horizontal force acts; no tendency to slide</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The crate</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CRATE-ZERO-FRICTION" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CRATE0-V0 VIS-NLM-CRATE0-V1 VIS-NLM-CRATE0-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-title g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-title">A crate at rest on a rough floor with no horizontal force</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-desc">Stage 1: A crate rests on a rough horizontal floor; no horizontal force acts on it and there is no tendency to slide. Stage 2: Only the weight and the floor\'s normal force act; nothing acts along the floor, and with the floor imagined slippery the crate would not slide. Stage 3: The friction force is zero: a rough floor does not by itself make friction act.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CRATE0-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A crate at rest on a rough horizontal floor</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="130" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="205" y="170" text-anchor="middle">crate</text>\n    <text x="20" y="275">no horizontal force acts; no tendency to slide</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CRATE0-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="193" y1="130" x2="193" y2="86" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow)"/>\n    <text x="201" y="100">N (floor on crate)</text>\n    <line x1="217" y1="200" x2="217" y2="244" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-bound-REP-NLM-CRATE-ZERO-FRICTION-1--rep-nlm-crate0-arrow)"/>\n    <text x="225" y="240">weight (Earth on crate)</text>\n    <text x="470" y="60" font-weight="600">forces on the crate:</text>\n    <text x="470" y="82">weight down, floor\'s normal up</text>\n    <text x="470" y="104">nothing along the floor</text>\n    <text x="470" y="126">slippery-floor test: no slide</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CRATE0-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="160" font-weight="600" fill="#1f6fb2">friction force = 0</text>\n    <text x="470" y="182">a rough floor does not by itself</text>\n    <text x="470" y="204">make friction act</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the crate at rest on the rough floor.">1: The crate</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="List the forces and test for a slip tendency.">2: Forces</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="State the friction.">3: Friction</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the crate at rest on the rough floor with no horizontal force acting on it.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Friction responds to relative sliding or a tendency to slide at the contact.</li><li>Here no horizontal force or other effect creates a tangential slip tendency.</li><li>Therefore no tangential contact force is required, so f=0.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The friction force is zero.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Roughness provides the ability to supply friction when needed; it does not require a nonzero friction force in every contact state.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You gave a non-zero friction such as μ_s mg: nothing pushes the crate sideways, so there is no slip tendency and nothing for friction to oppose.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM5-4" data-g9-concept-ref="MIC-PHY-NLM-FRICTION" data-g9-repair-target="CU-PHY-NLM-FRICTION-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-1">Revisit: Decide whether any tangential friction is required at all; allow friction to be zero when the contact has neither relative sliding nor a tendency to slide.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: a rough contact supplies friction only when a slip tendency needs opposing, so a crate at rest with no sideways force has f = 0. The transfer task keeps this rule for a crate that moves together with its platform.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-authored"><ol data-g9-ladder><li data-g9-rung="1">Ask what relative sliding or slip tendency would appear at the contact if friction were absent.</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-authored-2"><li data-g9-rung="2">Sketch the crate and list every horizontal force you can name. If the list is empty, ask what a friction force would have to balance.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-ZERO-08-authored-3"><li data-g9-rung="3">If no tangential force is required to prevent relative sliding, the friction value need not be nonzero.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-unit="Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Connected reasoning Newton-law and observer-frame practice Constructed response Authored practice A 5 kg block rests on a rough horizontal floor. A 12 N horizontal pull is applied, but the block remains at rest. The coefficient of static friction is 0.6 and take g=10 m/s^2. Find the actual static friction and its limiting value. The pull is horizontal. The block remains at rest." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-STATIC-09" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A 5 kg block rests on a rough horizontal floor. A 12 N horizontal pull is applied, but the block remains at rest. The coefficient of static friction is 0.6 and take g=10 m/s^2. Find the actual static friction and its limiting value.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The pull is horizontal.</li><li>The block remains at rest.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-STATIC-09-REP-NLM-BLOCK5-PULL12" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-BLOCK5-PULL12" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BLOCK12-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BLOCK12-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 5 kg block stays at rest under a 12 N pull</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="140" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="175" text-anchor="middle">5 kg</text>\n    <line x1="242" y1="170" x2="312" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow)"/>\n    <text x="318" y="175">12 N</text>\n    <text x="20" y="275">μ_s = 0.6; g = 10 m/s²; pull horizontal</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The block</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-BLOCK5-PULL12" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BLOCK12-V0 VIS-NLM-BLOCK12-V1 VIS-NLM-BLOCK12-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-title g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-title">A 5 kg block at rest on a rough floor under a 12 N pull</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-desc">Stage 1: A 5 kg block rests on a rough horizontal floor while a 12 N horizontal pull acts and it stays at rest; μ_s = 0.6 and g = 10 m/s². Stage 2: N = mg = 50 N, so the static limit is μ_s N = 30 N; at rest static friction must balance the pull. Stage 3: The actual static friction is 12 N opposite the pull, and the limiting value is 30 N.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BLOCK12-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 5 kg block stays at rest under a 12 N pull</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="140" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="175" text-anchor="middle">5 kg</text>\n    <line x1="242" y1="170" x2="312" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow)"/>\n    <text x="318" y="175">12 N</text>\n    <text x="20" y="275">μ_s = 0.6; g = 10 m/s²; pull horizontal</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BLOCK12-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="188" y1="140" x2="188" y2="96" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow)"/>\n    <text x="196" y="110">N = 50 N</text>\n    <line x1="212" y1="200" x2="212" y2="244" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow)"/>\n    <text x="220" y="240">mg = 50 N</text>\n    <text x="470" y="60" font-weight="600">at rest: f_s balances the pull</text>\n    <text x="470" y="82">N = mg = 50 N</text>\n    <text x="470" y="104">limit μ_s N = 0.6 × 50 = 30 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BLOCK12-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="158" y1="186" x2="98" y2="186" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-bound-REP-NLM-BLOCK5-PULL12-1--rep-nlm-block12-arrow-acc)"/>\n    <text x="60" y="180" fill="#1f6fb2">f_s = 12 N</text>\n    <text x="470" y="150" font-weight="600" fill="#1f6fb2">actual static friction = 12 N,</text>\n    <text x="470" y="172" fill="#1f6fb2">opposite the pull</text>\n    <text x="470" y="194" font-weight="600" fill="#1f6fb2">limiting value = 30 N</text>\n    <text x="470" y="216">the two are different numbers</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block, the pull and the rough floor.">1: The block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find N and the static limit.">2: Normal force and limit</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Give the actual static friction.">3: Actual friction</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 5 kg block held at rest by static friction so the actual friction and its limit are kept apart.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Because the block remains at rest, the horizontal net force is zero.</li><li>Static friction therefore supplies the 12 N needed to balance the pull, rather than automatically taking its maximum value.</li><li>The vertical forces give N=mg=50 N.</li><li>The limiting static friction is mu_s N=0.6(50)=30 N, and 12 N is within that limit.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The actual static friction is 12 N opposite the pull; the limiting value is 30 N.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The actual friction must change if the applied pull changes while the block remains static; the 30 N value is only the maximum available.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your friction is 30 N: that is the most static friction can give, but a block at rest under a 12 N pull needs only 12 N; 30 N would drive it backward.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Assume no relative sliding provisionally, choose a body or a whole connected system deliberately, and solve the tangential Newton-II equation for the friction demand at each rough contact.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: static friction takes whatever value rest requires, up to μ_s N; the limit is a ceiling, not the value. The transfer task tilts the push, so the ceiling itself changes with the force.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-authored"><ol data-g9-ladder><li data-g9-rung="1">Because the block remains at rest, what horizontal force must friction balance?<figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-1-REP-NLM-FRICTION-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FRICTION-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="5" data-g9-stages="VIS-NLM-FRICTION-V2" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Force structure" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 470">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-1-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-1-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  \n  \n  <g data-g9-stage-id="VIS-NLM-FRICTION-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="190" y1="215" x2="190" y2="325" stroke="currentColor" stroke-width="3" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-1-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <text x="198" y="322">mg (Earth on crate)</text>\n    <line x1="222" y1="250" x2="222" y2="165" stroke="currentColor" stroke-width="3" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-1-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <text x="215" y="160" text-anchor="end">N (floor on crate)</text>\n    <text x="20" y="360">N comes from the y equation;</text>\n    <text x="20" y="382">it is not assumed equal to mg.</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Make static friction a responsive contact force rather than an automatic mu N value: construct the chosen-body force account, determine the no-slip demand, compare it with the static limit, and switch to the kinetic model only after sliding.</figcaption></figure></li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-authored-2"><li data-g9-rung="2">Draw the block with the 12 N pull, a friction arrow opposite it, the weight and the normal force. Label the friction f, not μ_s N.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-authored-3"><li data-g9-rung="3">Find the required static friction first; compare it with mu_s N only afterward.<figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-3-REP-NLM-FRICTION-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FRICTION-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="5" data-g9-stages="VIS-NLM-FRICTION-V3" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Friction mechanism" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 470">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-3-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-3-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  \n  \n  \n  <g data-g9-stage-id="VIS-NLM-FRICTION-V3" font-family="system-ui,sans-serif" font-size="15">\n    <line x1="150" y1="244" x2="80" y2="244" stroke="#1f6fb2" stroke-width="3.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-STATIC-09-hint-3-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent)"/>\n    <text x="66" y="236" fill="#1f6fb2" font-weight="600">f_s</text>\n    <text x="415" y="28" fill="currentColor" font-weight="600">Friction demand vs limit</text>\n    <line x1="410" y1="80" x2="610" y2="80" stroke="currentColor" stroke-width="2"/>\n    <line x1="410" y1="72" x2="410" y2="88" stroke="currentColor" stroke-width="2"/>\n    <text x="410" y="106" text-anchor="middle" fill="currentColor">0</text>\n    <line x1="560" y1="66" x2="560" y2="94" stroke="currentColor" stroke-width="3"/>\n    <text x="560" y="112" text-anchor="middle" fill="currentColor">μ_s N</text>\n    <text x="560" y="130" text-anchor="middle" fill="currentColor" font-size="14">(limit)</text>\n    <path d="M482 64 L498 64 L490 76 Z" fill="#1f6fb2"/>\n    <text x="490" y="56" text-anchor="middle" fill="#1f6fb2">|f_required|</text>\n    <text x="415" y="160" fill="#1f6fb2" font-weight="600">Contact state: static (no slip)</text>\n    <text x="415" y="182" fill="currentColor">feasible while |f_required| ≤ μ_s N;</text>\n    <text x="415" y="204" fill="currentColor">then f_s = f_required.</text>\n    <text x="415" y="226" fill="currentColor">|f_s| = μ_s N holds only</text>\n    <text x="415" y="246" fill="currentColor">at impending slip.</text>\n  </g>\n  \n</svg>\n<figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Make static friction a responsive contact force rather than an automatic mu N value: construct the chosen-body force account, determine the no-slip demand, compare it with the static limit, and switch to the kinetic model only after sliding.</figcaption></figure></li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-unit="Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Direct application Newton-law and observer-frame practice Constructed response Authored practice A 5 kg block is already sliding to the right on a horizontal floor. A constant 18 N horizontal force pulls it to the right. The coefficient of kinetic friction is 0.20 and take g=10 m/s^2. Find the acceleration. Relative sliding is already established. The applied force is horizontal." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-meta-value="D1"><strong>Question difficulty:</strong> <span data-g9-meta-label>Direct application</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-FRICTION-KINETIC-10" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A 5 kg block is already sliding to the right on a horizontal floor. A constant 18 N horizontal force pulls it to the right. The coefficient of kinetic friction is 0.20 and take g=10 m/s^2. Find the acceleration.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Relative sliding is already established.</li><li>The applied force is horizontal.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-KINETIC-10-REP-NLM-BLOCK5-SLIDE18" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-BLOCK5-SLIDE18" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BLOCK18-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The sliding block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BLOCK18-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 5 kg block already sliding right, pulled with 18 N</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="140" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="175" text-anchor="middle">5 kg</text>\n    <line x1="242" y1="170" x2="312" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="318" y="175">18 N</text>\n    <line x1="290" y1="100" x2="350" y2="100" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="290" y="92">sliding</text>\n    <text x="20" y="275">μ_k = 0.20; g = 10 m/s²; force horizontal</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The sliding block</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-BLOCK5-SLIDE18" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-BLOCK18-V0 VIS-NLM-BLOCK18-V1 VIS-NLM-BLOCK18-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 290" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-title g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-title">A 5 kg block sliding on a rough floor under an 18 N pull</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-desc">Stage 1: A 5 kg block is already sliding to the right on a horizontal floor while a constant 18 N force pulls it right; μ_k = 0.20 and g = 10 m/s². Stage 2: Because it slides, friction is kinetic: N = 50 N and f_k = 0.20 × 50 = 10 N to the left. Stage 3: a = (18 − 10)/5 = 1.6 m/s² to the right.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-BLOCK18-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 5 kg block already sliding right, pulled with 18 N</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="160" y="140" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="175" text-anchor="middle">5 kg</text>\n    <line x1="242" y1="170" x2="312" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="318" y="175">18 N</text>\n    <line x1="290" y1="100" x2="350" y2="100" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="290" y="92">sliding</text>\n    <text x="20" y="275">μ_k = 0.20; g = 10 m/s²; force horizontal</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BLOCK18-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="158" y1="186" x2="118" y2="186" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow-acc)"/>\n    <text x="110" y="180" fill="#1f6fb2">f_k</text>\n    <line x1="188" y1="140" x2="188" y2="96" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="196" y="110">N = 50 N</text>\n    <line x1="212" y1="200" x2="212" y2="244" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-bound-REP-NLM-BLOCK5-SLIDE18-1--rep-nlm-block18-arrow)"/>\n    <text x="220" y="240">mg = 50 N</text>\n    <text x="470" y="60" font-weight="600">sliding: kinetic friction</text>\n    <text x="470" y="82">N = 50 N</text>\n    <text x="470" y="104">f_k = 0.20 × 50 = 10 N, to the left</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-BLOCK18-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="150" fill="#1f6fb2">a = (18 − 10)/5</text>\n    <text x="470" y="172" font-weight="600" fill="#1f6fb2">a = 1.6 m/s² to the right</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block already sliding and the pull.">1: The sliding block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find the kinetic friction opposite the sliding.">2: Kinetic friction</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Apply Newton&#x27;s second law.">3: Acceleration</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the already-sliding block so kinetic friction, opposite the sliding, sets the acceleration.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>The vertical force balance gives N=mg=50 N.</li><li>Because the block is sliding, kinetic friction has magnitude mu_k N=0.20(50)=10 N and points left, opposite the relative sliding.</li><li>The horizontal net force is 18-10=8 N to the right.</li><li>Newton&#x27;s second law gives a=8/5=1.6 m/s^2 to the right.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The block accelerates at 1.6 m/s^2 to the right.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The kinetic model is justified by the stated sliding; no static-friction feasibility test is needed for this already-sliding state.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your acceleration is 3.6 m/s² (18/5, friction left out) or 5.6 m/s² (friction added to the pull): kinetic friction of 10 N acts against the sliding and must be subtracted.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-4" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: At the threshold use |f_s|=μ_sN; once relative sliding is established use |f_k|=μ_kN opposite the sliding, and if several contacts change state, update N and the friction model at each contact before continuing.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: once sliding is given, friction is fixed at μ_k N opposite the sliding, and Newton II gives the acceleration. The transfer task moves the applied force onto one block of a stacked pair, so the no-slip test has to be rebuilt.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-authored"><ol data-g9-ladder><li data-g9-rung="1">The contact state is already given: which friction model belongs to established sliding?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-authored-2"><li data-g9-rung="2">Draw the sliding block with the 18 N pull to the right, its weight and normal force, and a kinetic-friction arrow pointing opposite the sliding.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-FRICTION-KINETIC-10-authored-3"><li data-g9-rung="3">Find N first, then f_k=mu_k N, set its direction opposite the sliding, and apply Newton II.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-unit="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Connected bodies and a justified common acceleration Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Blocks A and B are side by side on a smooth horizontal floor, with A to the left of B and no adhesive connection. Compare two cases. In case 1 a horizontal force pushes A to the right into B and contact is maintained. In case 2 the same force pulls A to the left, away from B. In which case may one common horizontal acceleration be imposed, and why? The contact force is an ordinary normal force and cannot pull the blocks together. The floor is frictionless." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="Connected bodies and a justified common acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Connected bodies and a justified common acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>Blocks A and B are side by side on a smooth horizontal floor, with A to the left of B and no adhesive connection. Compare two cases. In case 1 a horizontal force pushes A to the right into B and contact is maintained. In case 2 the same force pulls A to the left, away from B. In which case may one common horizontal acceleration be imposed, and why?</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The contact force is an ordinary normal force and cannot pull the blocks together.</li><li>The floor is frictionless.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-REP-NLM-UNGLUED-PUSH-PULL" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-UNGLUED-PUSH-PULL" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PUSHPULL-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Two cases" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 300">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PUSHPULL-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Unglued blocks A and B: push A into B, or pull A away</text>\n    <text x="20" y="70">case 1</text>\n    <text x="20" y="190">case 2</text>\n    <line x1="90" y1="120" x2="420" y2="120" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="120" x2="92" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="118" y1="120" x2="110" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="136" y1="120" x2="128" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="154" y1="120" x2="146" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="172" y1="120" x2="164" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="120" x2="182" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="208" y1="120" x2="200" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="226" y1="120" x2="218" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="244" y1="120" x2="236" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="262" y1="120" x2="254" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="280" y1="120" x2="272" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="298" y1="120" x2="290" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="316" y1="120" x2="308" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="334" y1="120" x2="326" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="352" y1="120" x2="344" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="370" y1="120" x2="362" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="388" y1="120" x2="380" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="406" y1="120" x2="398" y2="128" stroke="currentColor" stroke-width="1"/>\n    <rect x="190" y="70" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="100" text-anchor="middle">A</text>\n    <rect x="250" y="70" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="280" y="100" text-anchor="middle">B</text>\n    <line x1="110" y1="95" x2="186" y2="95" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow)"/>\n    <text x="110" y="86">F</text>\n    <line x1="90" y1="240" x2="420" y2="240" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="240" x2="92" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="118" y1="240" x2="110" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="136" y1="240" x2="128" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="154" y1="240" x2="146" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="172" y1="240" x2="164" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="240" x2="182" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="208" y1="240" x2="200" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="226" y1="240" x2="218" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="244" y1="240" x2="236" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="262" y1="240" x2="254" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="280" y1="240" x2="272" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="298" y1="240" x2="290" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="316" y1="240" x2="308" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="334" y1="240" x2="326" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="352" y1="240" x2="344" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="370" y1="240" x2="362" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="388" y1="240" x2="380" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="406" y1="240" x2="398" y2="248" stroke="currentColor" stroke-width="1"/>\n    <rect x="190" y="190" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="220" text-anchor="middle">A</text>\n    <rect x="250" y="190" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="280" y="220" text-anchor="middle">B</text>\n    <line x1="186" y1="215" x2="110" y2="215" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow)"/>\n    <text x="110" y="206" text-anchor="start">F</text>\n    <text x="20" y="280">smooth floor; contact force is a normal push, it cannot pull</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">Two cases</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-UNGLUED-PUSH-PULL" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PUSHPULL-V0 VIS-NLM-PUSHPULL-V1 VIS-NLM-PUSHPULL-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 300" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-title g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-title">Unglued blocks: a common acceleration while pushed, not while pulled apart</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-desc">Stage 1: Blocks A and B sit side by side on a smooth floor with no adhesive; in case 1 a horizontal force pushes A to the right into B; in case 2 the same force pulls A to the left, away from B. Stage 2: In case 1 A presses on B, so N &gt; 0 and the maintained contact fixes the separation: one common acceleration is justified. Stage 3: In case 2 B could follow only if A pulled it, which a normal contact cannot do, so the contact is lost and no common acceleration applies.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PUSHPULL-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Unglued blocks A and B: push A into B, or pull A away</text>\n    <text x="20" y="70">case 1</text>\n    <text x="20" y="190">case 2</text>\n    <line x1="90" y1="120" x2="420" y2="120" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="120" x2="92" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="118" y1="120" x2="110" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="136" y1="120" x2="128" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="154" y1="120" x2="146" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="172" y1="120" x2="164" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="120" x2="182" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="208" y1="120" x2="200" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="226" y1="120" x2="218" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="244" y1="120" x2="236" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="262" y1="120" x2="254" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="280" y1="120" x2="272" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="298" y1="120" x2="290" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="316" y1="120" x2="308" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="334" y1="120" x2="326" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="352" y1="120" x2="344" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="370" y1="120" x2="362" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="388" y1="120" x2="380" y2="128" stroke="currentColor" stroke-width="1"/>\n    <line x1="406" y1="120" x2="398" y2="128" stroke="currentColor" stroke-width="1"/>\n    <rect x="190" y="70" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="100" text-anchor="middle">A</text>\n    <rect x="250" y="70" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="280" y="100" text-anchor="middle">B</text>\n    <line x1="110" y1="95" x2="186" y2="95" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow)"/>\n    <text x="110" y="86">F</text>\n    <line x1="90" y1="240" x2="420" y2="240" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="240" x2="92" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="118" y1="240" x2="110" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="136" y1="240" x2="128" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="154" y1="240" x2="146" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="172" y1="240" x2="164" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="240" x2="182" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="208" y1="240" x2="200" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="226" y1="240" x2="218" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="244" y1="240" x2="236" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="262" y1="240" x2="254" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="280" y1="240" x2="272" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="298" y1="240" x2="290" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="316" y1="240" x2="308" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="334" y1="240" x2="326" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="352" y1="240" x2="344" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="370" y1="240" x2="362" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="388" y1="240" x2="380" y2="248" stroke="currentColor" stroke-width="1"/>\n    <line x1="406" y1="240" x2="398" y2="248" stroke="currentColor" stroke-width="1"/>\n    <rect x="190" y="190" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="220" y="220" text-anchor="middle">A</text>\n    <rect x="250" y="190" width="60" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="280" y="220" text-anchor="middle">B</text>\n    <line x1="186" y1="215" x2="110" y2="215" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-bound-REP-NLM-UNGLUED-PUSH-PULL-1--rep-nlm-pushpull-arrow)"/>\n    <text x="110" y="206" text-anchor="start">F</text>\n    <text x="20" y="280">smooth floor; contact force is a normal push, it cannot pull</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PUSHPULL-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="60" font-weight="600">case 1:</text>\n    <text x="470" y="82">A presses on B: N &gt; 0</text>\n    <text x="470" y="104">maintained contact fixes the gap</text>\n    <text x="470" y="126" font-weight="600" fill="#1f6fb2">→ one common a allowed</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PUSHPULL-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <rect x="250" y="190" width="60" height="50" fill="none" stroke="#1f6fb2" stroke-width="2" stroke-dasharray="5 4" transform="translate(30 0)"/>\n    <text x="470" y="160" font-weight="600">case 2:</text>\n    <text x="470" y="182">B would have to be pulled by A</text>\n    <text x="470" y="204">a normal contact cannot pull</text>\n    <text x="470" y="226" font-weight="600" fill="#1f6fb2">→ contact lost, no common a</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the same force pushing A into B and pulling A away.">1: Two cases</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Check the contact force in the pushing case.">2: Case 1</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Check whether the contact could hold B.">3: Case 2</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the same force pushing and pulling unglued blocks, so the common acceleration is tied to a maintained contact.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Common acceleration must be earned from an active constraint that fixes relative separation.</li><li>When A is pushed into B and contact is maintained, the normal interaction can enforce the shared motion.</li><li>When A is pulled away from B, an ordinary normal force cannot act as a tensile connector to keep them together.</li><li>After separation, each block&#x27;s acceleration must be obtained from its own remaining forces.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>A common acceleration is justified in case 1 while maintained contact fixes the separation. It is not justified in case 2: the normal contact cannot pull B after A is pulled away, so the contact constraint is lost.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If a proposed case-2 solution assigns a nonzero pulling normal force on B to preserve contact, it has given an ordinary contact force a capability it does not have.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You gave both cases the acceleration F/(m_A + m_B): in case 2 that would need an ordinary contact to pull B along, and a contact can only push.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM9-1" data-g9-concept-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-repair-target="CU-PHY-NLM-CONNECTED-COMMON-ACCEL-1" href="#g9-CORE1A--CU-PHY-NLM-CONNECTED-COMMON-ACCEL-1">Revisit: Identify the connection/contact condition and state exactly which relative separation is fixed.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: a common acceleration holds only while a real constraint keeps the separation fixed, and a pushing contact cannot pull. The transfer task asks what each block does once the contact is actually lost.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-authored"><ol data-g9-ladder><li data-g9-rung="1">What physical condition must stay active before equal acceleration can be imposed?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-authored-2"><li data-g9-rung="2">For each case, draw the two blocks and an arrow for how the force moves A. Mark whether A presses into B or moves away from it.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11-authored-3"><li data-g9-rung="3">Ask whether an ordinary contact normal can keep acting when A tries to move away from B.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-2A-ATWOOD-12" data-g9-unit="Q-PHY-NLM-2A-ATWOOD-12" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Ideal-string tension belongs to each body-specific FBD Hard concept Multi-step reasoning Newton-law and observer-frame practice Derivation Authored practice Masses m_A and m_B, with m_B &gt; m_A, hang from the two ends of one taut massless inextensible string over one fixed frictionless massless pulley. Derive the acceleration magnitude a and the common string tension T. State explicitly why T is not equal to either hanging weight during the acceleration. Mass A accelerates upward and mass B accelerates downward. Use the same acceleration magnitude a for the two ends, as required by the fixed string-length constraint. Neglect air resistance." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-2A-ATWOOD-12" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="Ideal-string tension belongs to each body-specific FBD"><strong>Concept:</strong> <span data-g9-meta-label>Ideal-string tension belongs to each body-specific FBD</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2A-ATWOOD-12" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2A-ATWOOD-12" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2A-ATWOOD-12" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Newton-law and observer-frame practice</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>Masses m_A and m_B, with m_B &gt; m_A, hang from the two ends of one taut massless inextensible string over one fixed frictionless massless pulley. Derive the acceleration magnitude a and the common string tension T. State explicitly why T is not equal to either hanging weight during the acceleration.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Mass A accelerates upward and mass B accelerates downward.</li><li>Use the same acceleration magnitude a for the two ends, as required by the fixed string-length constraint.</li><li>Neglect air resistance.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-ATWOOD-12-REP-NLM-ATWOOD-SYMBOLIC" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-ATWOOD-SYMBOLIC" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ATWOODSYM-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The machine" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 370">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ATWOODSYM-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Atwood machine with m_B &gt; m_A</text>\n    <line x1="120" y1="40" x2="240" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="40" x2="122" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="148" y1="40" x2="140" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="166" y1="40" x2="158" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="184" y1="40" x2="176" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="202" y1="40" x2="194" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="220" y1="40" x2="212" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="238" y1="40" x2="230" y2="32" stroke="currentColor" stroke-width="1"/>\n    <circle cx="180" cy="70" r="20" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="180" cy="70" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="180" y1="70" x2="180" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="160" y1="70" x2="160" y2="170" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="200" y1="70" x2="200" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="136" y="170" width="48" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="195" text-anchor="middle">m_A</text>\n    <rect x="174" y="220" width="56" height="48" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="202" y="249" text-anchor="middle">m_B</text>\n    <text x="20" y="336">massless inextensible string; fixed frictionless massless pulley</text>\n    <text x="20" y="358">A accelerates up, B down, with one magnitude a</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The machine</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-2A-ATWOOD-12-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-2A-ATWOOD-12-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-ATWOOD-SYMBOLIC" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ATWOODSYM-V0 VIS-NLM-ATWOODSYM-V1 VIS-NLM-ATWOODSYM-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 370" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-title g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-title">An Atwood machine with masses m_A and m_B, m_B &gt; m_A</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-desc">Stage 1: Masses m_A and m_B, with m_B &gt; m_A, hang from the ends of one taut massless inextensible string over a fixed frictionless massless pulley; A accelerates up and B down with one magnitude a. Stage 2: Each mass has the same T up and its own weight down; A: T − m_A g = m_A a (up positive), B: m_B g − T = m_B a (down positive). Stage 3: a = (m_B − m_A) g/(m_A + m_B) and T = 2 m_A m_B g/(m_A + m_B); during the motion m_A g &lt; T &lt; m_B g, so T equals neither weight.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ATWOODSYM-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Atwood machine with m_B &gt; m_A</text>\n    <line x1="120" y1="40" x2="240" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="40" x2="122" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="148" y1="40" x2="140" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="166" y1="40" x2="158" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="184" y1="40" x2="176" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="202" y1="40" x2="194" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="220" y1="40" x2="212" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="238" y1="40" x2="230" y2="32" stroke="currentColor" stroke-width="1"/>\n    <circle cx="180" cy="70" r="20" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="180" cy="70" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="180" y1="70" x2="180" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="160" y1="70" x2="160" y2="170" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="200" y1="70" x2="200" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="136" y="170" width="48" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="195" text-anchor="middle">m_A</text>\n    <rect x="174" y="220" width="56" height="48" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="202" y="249" text-anchor="middle">m_B</text>\n    <text x="20" y="336">massless inextensible string; fixed frictionless massless pulley</text>\n    <text x="20" y="358">A accelerates up, B down, with one magnitude a</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ATWOODSYM-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="150" y1="168" x2="150" y2="128" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow)"/>\n    <text x="142" y="146" text-anchor="end">T</text>\n    <line x1="160" y1="212" x2="160" y2="248" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow)"/>\n    <text x="152" y="246" text-anchor="end">m_A g</text>\n    <line x1="222" y1="218" x2="222" y2="178" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow)"/>\n    <text x="230" y="196">T</text>\n    <line x1="202" y1="270" x2="202" y2="306" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-2A-ATWOOD-12-bound-REP-NLM-ATWOOD-SYMBOLIC-1--rep-nlm-atwoodsym-arrow)"/>\n    <text x="210" y="300">m_B g</text>\n    <text x="470" y="60" font-weight="600">one T on both ends (ideal string, pulley)</text>\n    <text x="470" y="82">A (up +): T − m_A g = m_A a</text>\n    <text x="470" y="104">B (down +): m_B g − T = m_B a</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ATWOODSYM-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="150" font-weight="600" fill="#1f6fb2">a = (m_B − m_A) g/(m_A + m_B)</text>\n    <text x="470" y="172" font-weight="600" fill="#1f6fb2">T = 2 m_A m_B g/(m_A + m_B)</text>\n    <text x="470" y="194">m_A g &lt; T &lt; m_B g while accelerating:</text>\n    <text x="470" y="216">T equals neither weight</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show m_A and m_B over the fixed pulley.">1: The machine</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Draw T and the weight on each mass and write each equation.">2: Forces and equations</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Solve and compare T with the weights.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the symbolic Atwood machine with T and each weight drawn on its own mass, so T is found rather than set equal to a weight.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>The fixed inextensible string gives equal acceleration magnitudes for the two ends while the ideal string/pulley model licenses one common tension T.</li><li>For A, upward positive gives T-m_A g=m_A a.</li><li>For B, downward positive gives m_B g-T=m_B a.</li><li>Adding the equations gives a=(m_B-m_A)g/(m_A+m_B).</li><li>Substitution into either body equation gives T=2m_A m_B g/(m_A+m_B).</li><li>Because A accelerates upward, its tension exceeds m_A g; because B accelerates downward, its tension is below m_B g.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>The acceleration magnitude is a=(m_B-m_A)g/(m_A+m_B), and the common tension is T=2m_A m_B g/(m_A+m_B). During the motion T&gt;m_A g and T&lt;m_B g, so it is not equal to either weight unless the corresponding acceleration is zero.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If m_A=m_B, the formula reduces to a=0 and T=mg, recovering the equilibrium special case.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your tension is m_A g or m_B g: while the masses accelerate, the string pulls A harder than A&#x27;s weight and pulls B less than B&#x27;s weight.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM10-5" data-g9-concept-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-repair-target="CU-PHY-NLM-IDEAL-STRING-TENSION-2" href="#g9-CORE1A--CU-PHY-NLM-IDEAL-STRING-TENSION-2">Revisit: Determine the tension magnitude from a chosen body&#x27;s signed Newton-II equation; do not replace T by mg or by an applied force merely because those forces appear in the same setup.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: the fixed string length gives equal acceleration magnitudes, the ideal pulley gives one T, and each mass&#x27;s own equation places T between the two weights. The transfer task makes the pulley heavy, so these two claims have to be separated.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-2A-ATWOOD-12-authored"><ol data-g9-ladder><li data-g9-rung="1">Separate the two claims you need: what fixes the acceleration relationship, and what licenses one common tension magnitude?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-ATWOOD-12-authored-2"><li data-g9-rung="2">Draw one diagram per mass, with the tension up and the weight down on each, and mark A&#x27;s acceleration up and B&#x27;s down.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-2A-ATWOOD-12-authored-3"><li data-g9-rung="3">Write one signed Newton-II equation for each mass, then add the equations to eliminate T.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-unit="Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Net force, not any one force, sets acceleration Medium concept Connected reasoning Inclined-plane force modelling Derivation Authored practice A block of mass m is released from rest on a smooth fixed plane inclined at angle theta above the horizontal. Choose axes that make the contact constraint simple, determine the normal reaction, and find the block&#x27;s acceleration along the plane. 0 &lt; theta &lt; 90 degrees. The plane is fixed and smooth. The block remains in contact with the plane." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="Net force, not any one force, sets acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Net force, not any one force, sets acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SMOOTH-01" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Inclined-plane force modelling</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A block of mass m is released from rest on a smooth fixed plane inclined at angle theta above the horizontal. Choose axes that make the contact constraint simple, determine the normal reaction, and find the block&#x27;s acceleration along the plane.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>0 &lt; theta &lt; 90 degrees.</li><li>The plane is fixed and smooth.</li><li>The block remains in contact with the plane.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-SMOOTH-01-REP-NLM-SMOOTH-INCLINE-RELEASE" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-SMOOTH-INCLINE-RELEASE" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-SMOOTH-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-SMOOTH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block released from rest on a smooth fixed incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="121.4" y="140.3" text-anchor="end">m</text>\n    <text x="20" y="300">the block stays in contact with the plane</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The block</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-SMOOTH-INCLINE-RELEASE" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-SMOOTH-V0 VIS-NLM-SMOOTH-V1 VIS-NLM-SMOOTH-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 320" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-title g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-title">A block released on a smooth incline at angle θ</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-desc">Stage 1: A block of mass m is released from rest on a smooth fixed plane inclined at θ above the horizontal and stays in contact. Stage 2: Two forces act, the weight mg and the normal force N; with axes along and across the plane, mg sin θ = m a along it and N − mg cos θ = 0 across it. Stage 3: N = mg cos θ and a = g sin θ down the plane; mg is represented by its components, not added again.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-SMOOTH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block released from rest on a smooth fixed incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="121.4" y="140.3" text-anchor="end">m</text>\n    <text x="20" y="300">the block stays in contact with the plane</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-SMOOTH-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="161.4" y1="170.3" x2="161.4" y2="240.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow)"/>\n    <text x="169.4" y="246.3">mg</text>\n    <line x1="152.4" y1="154.7" x2="124.4" y2="106.2" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-bound-REP-NLM-SMOOTH-INCLINE-RELEASE-1--rep-nlm-smooth-arrow)"/>\n    <text x="116.4" y="100.2" text-anchor="end">N</text>\n    <line x1="161.4" y1="170.3" x2="83.5" y2="215.3" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <line x1="161.4" y1="170.3" x2="191.4" y2="222.2" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="440" y="60" font-weight="600">axes along / across the plane</text>\n    <text x="440" y="82">along (down +): mg sin θ = m a</text>\n    <text x="440" y="104">across: N − mg cos θ = 0 (contact kept)</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-SMOOTH-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="440" y="150" font-weight="600" fill="#1f6fb2">N = mg cos θ</text>\n    <text x="440" y="172" font-weight="600" fill="#1f6fb2">a = g sin θ down the plane</text>\n    <text x="440" y="194">mg is represented by its components,</text>\n    <text x="440" y="216">not added again</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block on the smooth plane.">1: The block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Draw the two forces and the contact-aligned axes.">2: Forces and axes</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Solve both components.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the block on the smooth incline with axes along and across the contact so the maintained contact gives N directly.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Choose the block and use +parallel down the plane and +perpendicular outward from the plane.</li><li>The physical forces are weight mg and the normal reaction N.</li><li>Resolve weight into mg sin(theta) parallel down the plane and mg cos(theta) perpendicular into the plane.</li><li>Maintained contact gives a_perp=0, so N-mg cos(theta)=0.</li><li>Along the plane, mg sin(theta)=m a_parallel, so a_parallel=g sin(theta) down the plane.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Using axes parallel/perpendicular to the plane, weight has components mg sin(theta) down the plane and mg cos(theta) into the plane. Maintained contact gives N=mg cos(theta), and the tangential equation gives acceleration g sin(theta) down the plane.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At theta=0 the tangential acceleration tends to zero and N tends to mg; as theta approaches 90 degrees, N tends to zero and the tangential acceleration tends to g.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You wrote N = mg or a = g: the plane supports only the perpendicular part of the weight, mg cos θ, and only mg sin θ drives the block along it.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM6-4" data-g9-concept-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-repair-target="CU-PHY-NLM-SECOND-LAW-1" href="#g9-CORE1A--CU-PHY-NLM-SECOND-LAW-1">Revisit: Choose axes that make the active constraint easy to express; for a fixed inclined contact, use parallel/perpendicular axes when helpful, resolve the physical forces into those axes, and write separate signed Newton-II equations.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: contact-aligned axes turn maintained contact into a_perp = 0, giving N = mg cos θ and a = g sin θ. The transfer task compares this with laboratory axes to show that both describe the same physics.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-authored"><ol data-g9-ladder><li data-g9-rung="1">Which axis choice turns maintained contact into one simple acceleration statement?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-authored-2"><li data-g9-rung="2">Draw the block on the plane with one axis along the slope and one perpendicular to it, and mark only the weight and the normal force.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SMOOTH-01-authored-3"><li data-g9-rung="3">With axes parallel/perpendicular to the plane, resolve weight before writing the two signed Newton-II equations.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-unit="Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Inclined-plane force modelling Derivation Authored practice A block rests on a rough fixed plane inclined at angle theta. The coefficient of static friction is mu_s. Determine the friction required for rest and derive the condition under which the static state is possible. No other force acts on the block. The block is tested for rest; do not assume limiting friction at the start." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-STATIC-02" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Inclined-plane force modelling</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A block rests on a rough fixed plane inclined at angle theta. The coefficient of static friction is mu_s. Determine the friction required for rest and derive the condition under which the static state is possible.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>No other force acts on the block.</li><li>The block is tested for rest; do not assume limiting friction at the start.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-STATIC-02-REP-NLM-ROUGH-INCLINE-REST" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-ROUGH-INCLINE-REST" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ROUGHREST-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ROUGHREST-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block tested for rest on a rough incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">coefficient of static friction μ_s; no other force</text>\n    <text x="267.5" y="154.1" text-anchor="middle" font-size="14">rough: μ_s</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The block</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-reasoning"><div class="g9-block" data-g9-block="reasoning_route"><ol><li><strong>REPRESENT</strong> Choose axes parallel and perpendicular to the plane, identify the block as the body, and determine the no-friction slip tendency.<br><em>Why valid:</em> The contact-aligned frame makes the normal and tangential force requirements explicit, while the no-friction tendency determines which way static friction would have to act to maintain rest.</li><li><strong>TRANSFORM</strong> Apply perpendicular equilibrium to obtain N = mg cos(theta).<br><em>Why valid:</em> For this item no other force has a perpendicular component and the block remains in contact without perpendicular acceleration.</li><li><strong>CONNECT</strong> Assume rest provisionally and use tangential equilibrium to find the friction required by that state: f_required = mg sin(theta).<br><em>Why valid:</em> Static friction responds to the force demand of the no-slip state; its limiting value is a bound to test afterward, not the starting equality.</li><li><strong>DECIDE</strong> Compare the required friction magnitude with the static limit and accept the rest model only if |f_required| &lt;= mu_s N.<br><em>Why valid:</em> The canonical static-friction relation permits the required no-slip value only while its magnitude stays within mu_s N.</li><li><strong>TRANSFORM</strong> Simplify the feasibility inequality to tan(theta) &lt;= mu_s.<br><em>Why valid:</em> For 0 &lt;= theta &lt; 90 degrees, mg cos(theta) is positive, so division preserves the inequality direction.</li><li><strong>VERIFY</strong> Check that equality is used only at impending slip and that smaller angles require static friction below its maximum.<br><em>Why valid:</em> A limiting equality everywhere would contradict the static-friction bound and the zero/small-demand cases.</li></ol></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-ROUGH-INCLINE-REST" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ROUGHREST-V0 VIS-NLM-ROUGHREST-V1 VIS-NLM-ROUGHREST-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 320" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-title g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-title">A block on a rough incline at angle θ</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-desc">Stage 1: A block rests on a rough fixed plane inclined at θ with coefficient of static friction μ_s; no other force acts. Stage 2: Across the plane N = mg cos θ; along it rest needs friction of size mg sin θ, because the block tends to slide down. Stage 3: Static friction acts up the plane with required size mg sin θ; rest is possible when mg sin θ ≤ μ_s mg cos θ, that is tan θ ≤ μ_s.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ROUGHREST-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block tested for rest on a rough incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">coefficient of static friction μ_s; no other force</text>\n    <text x="267.5" y="154.1" text-anchor="middle" font-size="14">rough: μ_s</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ROUGHREST-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="161.4" y1="170.3" x2="161.4" y2="240.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow)"/>\n    <text x="169.4" y="246.3">mg</text>\n    <line x1="152.4" y1="154.7" x2="124.4" y2="106.2" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow)"/>\n    <text x="116.4" y="100.2" text-anchor="end">N</text>\n    <text x="440" y="60" font-weight="600">across: N = mg cos θ</text>\n    <text x="440" y="82">along: rest needs f = mg sin θ</text>\n    <text x="440" y="104">slip tendency: down the plane</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ROUGHREST-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="187.4" y1="155.3" x2="235.9" y2="127.3" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-bound-REP-NLM-ROUGH-INCLINE-REST-1--rep-nlm-roughrest-arrow-acc)"/>\n    <text x="243.9" y="121.3" text-anchor="start" fill="#1f6fb2">f_s</text>\n    <text x="440" y="150" font-weight="600" fill="#1f6fb2">static friction up the plane,</text>\n    <text x="440" y="172" fill="#1f6fb2">required size mg sin θ</text>\n    <text x="440" y="194" fill="#1f6fb2">rest possible if mg sin θ ≤ μ_s mg cos θ</text>\n    <text x="440" y="216" font-weight="600" fill="#1f6fb2">i.e. tan θ ≤ μ_s</text>\n    <text x="440" y="238">not assumed to be at the limit</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block on the rough plane.">1: The block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find N and the friction that rest would need.">2: Forces and need</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Point friction up the plane and compare with the limit.">3: Condition</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the block on the rough incline so the friction rest needs is found first and then compared with μ_s N.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Without friction the block tends to slide down the plane, so static friction required for rest points up the plane.</li><li>The perpendicular equation gives N=mg cos(theta).</li><li>The no-slip tangential equation requires f_required=mg sin(theta).</li><li>Static contact is possible only if f_required &lt;= mu_s N.</li><li>Cancelling mg cos(theta)&gt;0 gives tan(theta)&lt;=mu_s.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>For rest, N=mg cos(theta) and static friction must act up the plane with required magnitude mg sin(theta). Rest is feasible when mg sin(theta) &lt;= mu_s mg cos(theta), equivalently tan(theta) &lt;= mu_s.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The calculation uses equality f_s=mu_s N only at the limiting angle; for a smaller angle the actual static friction is below its maximum.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You set the friction to μ_s mg cos θ at the start: that is only its limit. Rest needs mg sin θ, and that need is what gets compared with the limit.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-3" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Compare each |f_required| with μ_sN; on an incline this comparison can be turned into the angle condition for the onset of sliding rather than setting f=μ_sN from the start.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: rest on an incline needs friction mg sin θ up the slope, which is possible only while tan θ ≤ μ_s. The transfer task adds a push along the slope, so the needed friction can shrink to zero or reverse.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-authored"><ol data-g9-ladder><li data-g9-rung="1">First ask which way the block would tend to slip if friction vanished.</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-authored-2"><li data-g9-rung="2">Use axes parallel and perpendicular to the plane and mark the block as the chosen body. Without friction, which way would it tend to move?<figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-2-REP-NLM-FRICTION-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FRICTION-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="5" data-g9-stages="VIS-NLM-FRICTION-V1" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Orientation" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 470">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-2-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-2-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  \n  <g data-g9-stage-id="VIS-NLM-FRICTION-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <rect x="140" y="180" width="100" height="70" fill="none" stroke="currentColor" stroke-width="5"/>\n    <text x="20" y="28" font-weight="600">chosen body: crate</text>\n    <line x1="30" y1="110" x2="85" y2="110" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-2-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <line x1="30" y1="110" x2="30" y2="55" stroke="currentColor" stroke-width="1.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-2-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <text x="70" y="130">+x</text>\n    <text x="38" y="64">+y</text>\n    <path d="M30 250 l-10 10 M50 250 l-10 10 M70 250 l-10 10 M90 250 l-10 10 M110 250 l-10 10 M130 250 l-10 10 M150 250 l-10 10 M170 250 l-10 10 M190 250 l-10 10 M210 250 l-10 10 M230 250 l-10 10 M250 250 l-10 10 M270 250 l-10 10 M290 250 l-10 10 M310 250 l-10 10 M330 250 l-10 10 M350 250 l-10 10 M370 250 l-10 10" stroke="currentColor"/>\n    <text x="20" y="280">rough contact</text>\n    <text x="20" y="298">surface (μ_s, μ_k)</text>\n  </g>\n  \n  \n  \n</svg>\n<figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Make static friction a responsive contact force rather than an automatic mu N value: construct the chosen-body force account, determine the no-slip demand, compare it with the static limit, and switch to the kinetic model only after sliding.</figcaption></figure></li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-authored-3"><li data-g9-rung="3">Find N from the perpendicular equation, solve the friction required for rest, then compare that requirement with mu_s N.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-authored-4"><li data-g9-rung="4">Write the friction rest needs and the most the contact can give, μ_s N, each in terms of m, g and θ. Which of the two must not exceed the other?<figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-4-REP-NLM-FRICTION-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FRICTION-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="5" data-g9-stages="VIS-NLM-FRICTION-V2" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Force structure" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 470">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-4-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-4-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  \n  \n  <g data-g9-stage-id="VIS-NLM-FRICTION-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="190" y1="215" x2="190" y2="325" stroke="currentColor" stroke-width="3" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-4-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <text x="198" y="322">mg (Earth on crate)</text>\n    <line x1="222" y1="250" x2="222" y2="165" stroke="currentColor" stroke-width="3" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-4-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow)"/>\n    <text x="215" y="160" text-anchor="end">N (floor on crate)</text>\n    <text x="20" y="360">N comes from the y equation;</text>\n    <text x="20" y="382">it is not assumed equal to mg.</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Make static friction a responsive contact force rather than an automatic mu N value: construct the chosen-body force account, determine the no-slip demand, compare it with the static limit, and switch to the kinetic model only after sliding.</figcaption></figure></li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-authored-5"><li data-g9-rung="5">Once your comparison is written, divide both sides by mg cos θ, which is positive for θ below 90°, to leave a condition on θ and μ_s alone.<figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-5-REP-NLM-FRICTION-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FRICTION-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="5" data-g9-stages="VIS-NLM-FRICTION-V3" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Friction mechanism" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 470">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-5-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-5-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  \n  \n  \n  <g data-g9-stage-id="VIS-NLM-FRICTION-V3" font-family="system-ui,sans-serif" font-size="15">\n    <line x1="150" y1="244" x2="80" y2="244" stroke="#1f6fb2" stroke-width="3.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-STATIC-02-hint-5-REP-NLM-FRICTION-THRESHOLD-1--rep-nlm-fr-arrow-accent)"/>\n    <text x="66" y="236" fill="#1f6fb2" font-weight="600">f_s</text>\n    <text x="415" y="28" fill="currentColor" font-weight="600">Friction demand vs limit</text>\n    <line x1="410" y1="80" x2="610" y2="80" stroke="currentColor" stroke-width="2"/>\n    <line x1="410" y1="72" x2="410" y2="88" stroke="currentColor" stroke-width="2"/>\n    <text x="410" y="106" text-anchor="middle" fill="currentColor">0</text>\n    <line x1="560" y1="66" x2="560" y2="94" stroke="currentColor" stroke-width="3"/>\n    <text x="560" y="112" text-anchor="middle" fill="currentColor">μ_s N</text>\n    <text x="560" y="130" text-anchor="middle" fill="currentColor" font-size="14">(limit)</text>\n    <path d="M482 64 L498 64 L490 76 Z" fill="#1f6fb2"/>\n    <text x="490" y="56" text-anchor="middle" fill="#1f6fb2">|f_required|</text>\n    <text x="415" y="160" fill="#1f6fb2" font-weight="600">Contact state: static (no slip)</text>\n    <text x="415" y="182" fill="currentColor">feasible while |f_required| ≤ μ_s N;</text>\n    <text x="415" y="204" fill="currentColor">then f_s = f_required.</text>\n    <text x="415" y="226" fill="currentColor">|f_s| = μ_s N holds only</text>\n    <text x="415" y="246" fill="currentColor">at impending slip.</text>\n  </g>\n  \n</svg>\n<figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Make static friction a responsive contact force rather than an automatic mu N value: construct the chosen-body force account, determine the no-slip demand, compare it with the static limit, and switch to the kinetic model only after sliding.</figcaption></figure></li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-unit="Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Connected reasoning Inclined-plane force modelling Derivation Authored practice A block is already sliding down a rough fixed plane inclined at angle theta. The coefficient of kinetic friction is mu_k. Derive its acceleration along the plane. The sliding direction is down the plane. No other force acts on the block. The plane is fixed." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-SLIDING-03" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Inclined-plane force modelling</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A block is already sliding down a rough fixed plane inclined at angle theta. The coefficient of kinetic friction is mu_k. Derive its acceleration along the plane.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The sliding direction is down the plane.</li><li>No other force acts on the block.</li><li>The plane is fixed.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-SLIDING-03-REP-NLM-ROUGH-INCLINE-SLIDING" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-ROUGH-INCLINE-SLIDING" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ROUGHSLIDE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The sliding block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ROUGHSLIDE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block already sliding down a rough incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">coefficient of kinetic friction μ_k; no other force</text>\n    <line x1="101.8" y1="147" x2="58.5" y2="172" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow)"/>\n    <text x="50.5" y="188" text-anchor="end">sliding</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The sliding block</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-ROUGH-INCLINE-SLIDING" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-ROUGHSLIDE-V0 VIS-NLM-ROUGHSLIDE-V1 VIS-NLM-ROUGHSLIDE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 320" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-title g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-title">A block sliding down a rough incline at angle θ</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-desc">Stage 1: A block is already sliding down a rough fixed plane inclined at θ with coefficient of kinetic friction μ_k; no other force acts. Stage 2: N = mg cos θ, and kinetic friction of size μ_k mg cos θ acts up the plane, opposite the sliding. Stage 3: Down the plane mg sin θ − μ_k mg cos θ = m a, so a = g(sin θ − μ_k cos θ).</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-ROUGHSLIDE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A block already sliding down a rough incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">coefficient of kinetic friction μ_k; no other force</text>\n    <line x1="101.8" y1="147" x2="58.5" y2="172" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow)"/>\n    <text x="50.5" y="188" text-anchor="end">sliding</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ROUGHSLIDE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="161.4" y1="170.3" x2="161.4" y2="240.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow)"/>\n    <text x="169.4" y="246.3">mg</text>\n    <line x1="152.4" y1="154.7" x2="124.4" y2="106.2" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow)"/>\n    <text x="116.4" y="100.2" text-anchor="end">N</text>\n    <line x1="187.4" y1="155.3" x2="235.9" y2="127.3" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-bound-REP-NLM-ROUGH-INCLINE-SLIDING-1--rep-nlm-roughslide-arrow-acc)"/>\n    <text x="243.9" y="121.3" text-anchor="start" fill="#1f6fb2">f_k</text>\n    <text x="440" y="60" font-weight="600">N = mg cos θ</text>\n    <text x="440" y="82">f_k = μ_k mg cos θ, up the plane</text>\n    <text x="440" y="104">(opposite the sliding)</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-ROUGHSLIDE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="440" y="150" fill="#1f6fb2">down-plane: mg sin θ − μ_k mg cos θ = m a</text>\n    <text x="440" y="172" font-weight="600" fill="#1f6fb2">a = g (sin θ − μ_k cos θ)</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block already sliding down.">1: The sliding block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Draw the weight, N and kinetic friction opposite the sliding.">2: Forces</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Write the down-plane equation.">3: Acceleration</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the block sliding down the rough incline so kinetic friction points up the plane, opposite the sliding.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Maintained contact gives N=mg cos(theta).</li><li>Because the block is sliding down relative to the plane, kinetic friction points up the plane.</li><li>With down-plane positive, m a=mg sin(theta)-mu_k mg cos(theta).</li><li>Divide by m to obtain a=g[sin(theta)-mu_k cos(theta)].</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>N=mg cos(theta). Kinetic friction has magnitude mu_k mg cos(theta) and points up the plane, so the down-plane acceleration is a=g[sin(theta)-mu_k cos(theta)].</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Setting mu_k=0 recovers the smooth-plane result a=g sin(theta).</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>Your acceleration is g(sin θ + μ_k cos θ): friction was added along the sliding, which would make the rough slope faster than a smooth one.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-4" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: At the threshold use |f_s|=μ_sN; once relative sliding is established use |f_k|=μ_kN opposite the sliding, and if several contacts change state, update N and the friction model at each contact before continuing.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: on a fixed incline N = mg cos θ, and kinetic friction up the slope reduces the acceleration to g(sin θ − μ_k cos θ). The transfer task uses this acceleration inside a timing comparison to infer μ_k.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-authored"><ol data-g9-ladder><li data-g9-rung="1">The block is already sliding down the plane; which way must the kinetic friction act at the contact?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-authored-2"><li data-g9-rung="2">Draw the block with axes along and perpendicular to the plane, mark the sliding direction, and put kinetic friction opposite it.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-SLIDING-03-authored-3"><li data-g9-rung="3">Use the perpendicular equation for N, then write the tangential net force with down the plane positive.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-unit="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion Net force, not any one force, sets acceleration Medium concept Multi-step reasoning Inclined-plane force modelling Derivation Authored practice A block of mass m is on a smooth fixed plane that rises to the right at angle theta above the horizontal. A horizontal force P pushes the block to the right. Determine the normal reaction and the acceleration along the plane. 0 &lt; theta &lt; 90 degrees. The block remains in contact with the smooth plane. The applied force P is horizontal and rightward." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="Net force, not any one force, sets acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Net force, not any one force, sets acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Inclined-plane force modelling</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A block of mass m is on a smooth fixed plane that rises to the right at angle theta above the horizontal. A horizontal force P pushes the block to the right. Determine the normal reaction and the acceleration along the plane.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>0 &lt; theta &lt; 90 degrees.</li><li>The block remains in contact with the smooth plane.</li><li>The applied force P is horizontal and rightward.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-REP-NLM-INCLINE-HORIZONTAL-PUSH" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-HORIZONTAL-PUSH" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HPUSH-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The push" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HPUSH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A horizontal push P on a block on a smooth incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">plane rises to the right; P horizontal and rightward; contact kept</text>\n    <line x1="51.4" y1="170.3" x2="131.4" y2="170.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow)"/>\n    <text x="51.4" y="162.3">P</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The push</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-HORIZONTAL-PUSH" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HPUSH-V0 VIS-NLM-HPUSH-V1 VIS-NLM-HPUSH-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 320" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-title g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-title">Horizontal push on a smooth incline: P adds to N and pushes up the plane</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-desc">Stage 1: A block of mass m is on a smooth fixed plane that rises to the right at θ; a horizontal force P pushes it to the right. Stage 2: In plane axes P has P cos θ up the plane and P sin θ into the plane; mg has mg sin θ down the plane and mg cos θ into it. Stage 3: N = mg cos θ + P sin θ and a_∥ = [P cos θ − mg sin θ]/m with uphill positive.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HPUSH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A horizontal push P on a block on a smooth incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 161.4 170.3)"><rect x="133.4 " y="153.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="20" y="300">plane rises to the right; P horizontal and rightward; contact kept</text>\n    <line x1="51.4" y1="170.3" x2="131.4" y2="170.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow)"/>\n    <text x="51.4" y="162.3">P</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HPUSH-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="161.4" y1="170.3" x2="161.4" y2="240.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow)"/>\n    <text x="169.4" y="246.3">mg</text>\n    <line x1="152.4" y1="154.7" x2="124.4" y2="106.2" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-bound-REP-NLM-INCLINE-HORIZONTAL-PUSH-1--rep-nlm-hpush-arrow)"/>\n    <text x="116.4" y="100.2" text-anchor="end">N</text>\n    <text x="440" y="60" font-weight="600">P in plane axes:</text>\n    <text x="440" y="82">P cos θ up the plane</text>\n    <text x="440" y="104">P sin θ into the plane</text>\n    <text x="440" y="126">mg: sin θ down, cos θ into</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HPUSH-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="440" y="160" font-weight="600" fill="#1f6fb2">N = mg cos θ + P sin θ</text>\n    <text x="440" y="182" font-weight="600" fill="#1f6fb2">a_∥ = [P cos θ − mg sin θ]/m</text>\n    <text x="440" y="204">(uphill positive)</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block, the incline rising right and the horizontal P.">1: The push</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Resolve P and mg along and across the plane.">2: Components</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Write both equations.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the horizontal push on the block on a smooth incline so P is resolved into plane components that change both N and the motion.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>Choose +parallel uphill and +perpendicular outward from the plane.</li><li>Resolve the horizontal force into P cos(theta) uphill and P sin(theta) into the plane.</li><li>Resolve weight into mg sin(theta) downhill and mg cos(theta) into the plane.</li><li>Maintained contact gives N-mg cos(theta)-P sin(theta)=0.</li><li>The parallel equation is P cos(theta)-mg sin(theta)=m a_parallel.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Relative to plane-aligned axes, P has P cos(theta) up the plane and P sin(theta) into the plane. Thus N=mg cos(theta)+P sin(theta), and a_parallel=[P cos(theta)-mg sin(theta)]/m with uphill positive.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At P=0 the result reduces to the ordinary smooth-incline equations, with negative uphill acceleration -g sin(theta).</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You wrote N = mg cos θ: the horizontal push also presses the block into the plane and adds P sin θ to the normal force.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM6-4" data-g9-concept-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-repair-target="CU-PHY-NLM-SECOND-LAW-1" href="#g9-CORE1A--CU-PHY-NLM-SECOND-LAW-1">Revisit: Choose axes that make the active constraint easy to express; for a fixed inclined contact, use parallel/perpendicular axes when helpful, resolve the physical forces into those axes, and write separate signed Newton-II equations.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: a horizontal push splits into P cos θ along the slope and P sin θ into it, so both N and the acceleration change. The transfer task adds friction, where that extra normal force raises the friction limit.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-authored"><ol data-g9-ladder><li data-g9-rung="1">The horizontal applied force is not parallel to the plane. Which component presses into the plane and which acts along it?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-authored-2"><li data-g9-rung="2">Draw the block with plane-aligned axes and the horizontal push P, and mark the angle between P and the slope before resolving anything.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04-authored-3"><li data-g9-rung="3">Resolve P and mg in the same plane-aligned axes, use a_perp=0 for N, then use the parallel equation for acceleration.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article><article id="g9-CORE2A--Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-unit="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-kind="QUESTION" data-g9-role="CORE2A" data-g9-search-text="Physics Laws of Motion A free-body diagram belongs to one chosen body Hard concept Multi-step reasoning Inclined-plane force modelling Constructed response Authored practice A block slides down a smooth fixed incline. A student draws three downward-related force arrows on the same free-body diagram: mg vertically downward, mg sin(theta) down the plane, and mg cos(theta) into the plane. Diagnose the diagram and state how the weight should be represented when writing plane-aligned equations. The only physical interactions are Earth-on-block gravity and plane-on-block normal contact. The question is about force ownership and representation, not numerical calculation." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED practice</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2A" data-g9-meta-record="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-meta-value="A free-body diagram belongs to one chosen body"><strong>Concept:</strong> <span data-g9-meta-label>A free-body diagram belongs to one chosen body</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span></div><div class="g9-block" data-g9-block="family_identity"><p>Inclined-plane force modelling</p></div></section><div class="g9-split"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="stem"><h2>A block slides down a smooth fixed incline. A student draws three downward-related force arrows on the same free-body diagram: mg vertically downward, mg sin(theta) down the plane, and mg cos(theta) into the plane. Diagnose the diagram and state how the weight should be represented when writing plane-aligned equations.</h2></div><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The only physical interactions are Earth-on-block gravity and plane-on-block normal contact.</li><li>The question is about force ownership and representation, not numerical calculation.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-DOUBLE-COUNT" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-FBDTRIPLE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The student&#x27;s diagram" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 330">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-FBDTRIPLE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A student\'s free-body diagram of a block sliding down a smooth incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 204.7 145.3)"><rect x="176.7 " y="128.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="204.7" y1="145.3" x2="204.7" y2="215.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="212.7" y="221.3">mg</text>\n    <line x1="204.7" y1="145.3" x2="152.7" y2="175.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="144.7" y="191.3" text-anchor="end">mg sin θ</text>\n    <line x1="204.7" y1="145.3" x2="229.7" y2="188.6" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="237.7" y="206.6">mg cos θ</text>\n    <text x="20" y="310">interactions: Earth on block (gravity), plane on block (normal)</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The student&#x27;s diagram</figcaption></figure><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your attempt<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-reasoning" data-blueprint-slot="reasoning" data-required="true"><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-reasoning"><summary>Reasoning route and full solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-reasoning"><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-DOUBLE-COUNT" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-FBDTRIPLE-V0 VIS-NLM-FBDTRIPLE-V1 VIS-NLM-FBDTRIPLE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 330" role="img" aria-labelledby="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-title g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-desc">\n  <title id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-title">A student\'s free-body diagram of a block sliding down a smooth incline</title>\n  <desc id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-desc">Stage 1: A block slides down a smooth fixed incline; a student draws mg vertically down, mg sin θ down the plane and mg cos θ into the plane on the same diagram; the only interactions are gravity and the plane\'s normal contact. Stage 2: The three arrows describe one physical force, gravity, so the weight is drawn three times: once as mg and again as its two components. Stage 3: In plane-aligned equations the weight is represented either by mg or by its components mg sin θ down the plane and mg cos θ into the plane, never both, alongside the normal force N.</desc>\n  <defs>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-FBDTRIPLE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A student\'s free-body diagram of a block sliding down a smooth incline</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 204.7 145.3)"><rect x="176.7 " y="128.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="204.7" y1="145.3" x2="204.7" y2="215.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="212.7" y="221.3">mg</text>\n    <line x1="204.7" y1="145.3" x2="152.7" y2="175.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="144.7" y="191.3" text-anchor="end">mg sin θ</text>\n    <line x1="204.7" y1="145.3" x2="229.7" y2="188.6" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-bound-REP-NLM-INCLINE-DOUBLE-COUNT-1--rep-nlm-fbdtriple-arrow)"/>\n    <text x="237.7" y="206.6">mg cos θ</text>\n    <text x="20" y="310">interactions: Earth on block (gravity), plane on block (normal)</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-FBDTRIPLE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <ellipse cx="204.7" cy="175.3" rx="90" ry="60" fill="none" stroke="#1f6fb2" stroke-width="2" stroke-dasharray="6 4"/>\n    <text x="200" y="286" text-anchor="middle" font-weight="600" fill="#1f6fb2">one force drawn three times ✗</text>\n    <text x="440" y="60" font-weight="600" fill="#1f6fb2">diagnosis:</text>\n    <text x="440" y="82" fill="#1f6fb2">three downward-related arrows,</text>\n    <text x="440" y="104" fill="#1f6fb2">but gravity is one force</text>\n    <text x="440" y="126" font-weight="600" fill="#1f6fb2">the weight is drawn three times:</text>\n    <text x="440" y="148" fill="#1f6fb2">once as mg, again as its two components</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-FBDTRIPLE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="440" y="180" font-weight="600">in plane-aligned equations use</text>\n    <text x="440" y="202">either mg, or its components</text>\n    <text x="440" y="224">mg sin θ (down the plane) and</text>\n    <text x="440" y="246">mg cos θ (into the plane), never both;</text>\n    <text x="440" y="268">plus the normal force N</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the diagram as the student drew it.">1: The student&#x27;s diagram</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Name what is wrong.">2: Diagnosis</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="State how the weight enters plane-aligned equations.">3: Repair</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the student&#x27;s diagram of the block sliding down the smooth incline, with mg and both its components, then diagnose it and repair how the weight is represented.</figcaption></figure><div class="g9-block" data-g9-block="solution"><ol><li>A free-body inventory is a list of physical interactions acting on the chosen body.</li><li>Gravity is one Earth-on-block interaction, represented by the vector mg.</li><li>Resolving that vector into parallel/perpendicular components changes its coordinate description only.</li><li>The component equations may use the two components instead of the unresolved weight vector; they are not two new agents.</li></ol></div><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>In the student&#x27;s diagram the weight is drawn three times: once as mg and again as its two components. Weight mg is one physical force. For plane-aligned equations it may be represented by the components mg sin(theta) down the plane and mg cos(theta) into the plane, but the original mg must not also be added as a separate force in those component sums.</p></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The physical-force count remains two in this smooth-contact case: weight and normal reaction.</p></div><div class="g9-block" data-g9-block="failure_signal"><h4>If you went wrong</h4><p>You kept mg alongside mg sin θ and mg cos θ, so the weight is drawn three times: once as mg and again as its two components. The components replace the weight; they do not join it.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM3-4" data-g9-concept-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-repair-target="CU-PHY-NLM-FBD-BODY-OWNERSHIP-1" href="#g9-CORE1A--CU-PHY-NLM-FBD-BODY-OWNERSHIP-1">Revisit: When a physical force is resolved into components for chosen axes, keep the body-force inventory unchanged: use the components as a representation of that one force in the equations, not as additional interaction forces alongside the original vector.</a></p></div><div class="g9-block" data-g9-block="exposure_closure"><h4>What this establishes</h4><p>Established: resolving a force changes its description, not the number of forces acting. The transfer task finds the same repeated weight written into component equations.</p></div></template></section></div><div class="g9-col g9-col-support"><section class="blueprint-slot slot-support" data-blueprint-slot="support" data-required="false"><div class="g9-ladder" data-g9-ladder-ref="CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-authored"><ol data-g9-ladder><li data-g9-rung="1">Did choosing new axes create any new physical object acting on the block?</li></ol><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-authored-2"><li data-g9-rung="2">List the physical agents touching or attracting the block, one line each, before drawing any arrow: the number of lines is the number of forces.</li></template><template data-g9-rung-payload="CORE2A-Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05-authored-3"><li data-g9-rung="3">Keep one gravity interaction; use either its original vector or its resolved components in a given equation representation, not both.</li></template><button type="button" data-g9-next-rung>Next hint</button></div></section></div></div></article></section><section id="g9-role-CORE2B" data-g9-role-section="CORE2B"><h1>Force and laws of motion: Transfer</h1><article id="g9-CORE2B--Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-unit="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice A 10 kg crate rests on a rough horizontal floor with μ_s = 0.75; take g = 10 m/s². A rope on the crate can be pulled horizontally, at 37° above the horizontal, or at 53° above the horizontal (sin 37° = cos 53° = 0.6, cos 37° = sin 53° = 0.8). For each direction, find the smallest pull that starts the crate sliding. A worker can pull with at most 61 N: in which of the three directions can the worker start the crate? The crate stays in contact with the floor in every direction. Resolve each pull into horizontal and vertical components. The pull is the unknown: do not take N = mg before the vertical balance is written." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-STATE-01" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 10 kg crate rests on a rough horizontal floor with μ_s = 0.75; take g = 10 m/s². A rope on the crate can be pulled horizontally, at 37° above the horizontal, or at 53° above the horizontal (sin 37° = cos 53° = 0.6, cos 37° = sin 53° = 0.8). For each direction, find the smallest pull that starts the crate sliding. A worker can pull with at most 61 N: in which of the three directions can the worker start the crate?</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FRICTION-THRESHOLD-01">A small block of mass m rests on a larger block of mass M. The floor under the larger…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The crate stays in contact with the floor in every direction.</li><li>Resolve each pull into horizontal and vertical components.</li><li>The pull is the unknown: do not take N = mg before the vertical balance is written.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CRATE10-THREE-DIRECTIONS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="4" data-g9-stages="VIS-NLM-CRATE3DIR-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The crate and three rope directions" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 480">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CRATE3DIR-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 10 kg crate on a rough floor, pulled by a rope in one of three directions</text>\n    <line x1="40" y1="300" x2="460" y2="300" stroke="currentColor" stroke-width="2"/>\n    <line x1="50" y1="300" x2="42" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="68" y1="300" x2="60" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="86" y1="300" x2="78" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="104" y1="300" x2="96" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="122" y1="300" x2="114" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="140" y1="300" x2="132" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="300" x2="150" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="300" x2="168" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="300" x2="186" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="300" x2="204" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="300" x2="222" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="300" x2="240" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="266" y1="300" x2="258" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="284" y1="300" x2="276" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="302" y1="300" x2="294" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="320" y1="300" x2="312" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="338" y1="300" x2="330" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="356" y1="300" x2="348" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="374" y1="300" x2="366" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="392" y1="300" x2="384" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="410" y1="300" x2="402" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="428" y1="300" x2="420" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="446" y1="300" x2="438" y2="308" stroke="currentColor" stroke-width="1"/>\n    <rect x="120" y="220" width="110" height="80" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="175" y="265" text-anchor="middle">crate 10 kg</text>\n    <line x1="230" y1="260" x2="380" y2="260" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="388" y="265">0°</text>\n    <line x1="230" y1="260" x2="350" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="358" y="168">37°</text>\n    <line x1="230" y1="260" x2="320" y2="140" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="300" y="128">53°</text>\n    <text x="40" y="330">rough floor, μ_s = 0.75</text>\n    <text x="480" y="70">g = 10 m/s²</text>\n    <text x="480" y="92">sin 37° = cos 53° = 0.6</text>\n    <text x="480" y="114">cos 37° = sin 53° = 0.8</text>\n    <text x="480" y="136">pull P in each direction: unknown</text>\n    <text x="480" y="158">the worker can pull with at most 61 N</text>\n  </g>\n  \n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The crate and three rope directions</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>At the smallest pull that starts the crate, what contact state is the crate in, and what does that say about the friction?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>N from the actual vertical balance and the comparison of the friction needed with μ_s N carry over; what changes is that the pull is unknown and its direction is the choice.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must turn the no-slip test into a threshold for an unknown pull that also changes N, and compare that threshold across directions, instead of deciding the state for a given pull.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Evaluate the threshold in each direction (75 N, 60 N, 62.5 N) and compare with the worker&#x27;s 61 N.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CRATE10-THREE-DIRECTIONS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="4" data-g9-stages-total="4" data-g9-stages="VIS-NLM-CRATE3DIR-V0 VIS-NLM-CRATE3DIR-V1 VIS-NLM-CRATE3DIR-V2 VIS-NLM-CRATE3DIR-V3" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 480" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-title g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-title">A 10 kg crate on a rough floor, pulled by a rope in one of three directions</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-desc">Stage 1: a 10 kg crate rests on a rough horizontal floor with μ_s = 0.75 and g = 10 m/s²; a rope can pull it horizontally, at 37° or at 53° above the horizontal (sin 37° = cos 53° = 0.6, cos 37° = sin 53° = 0.8); the pull P is unknown, and a worker can pull with at most 61 N. Stage 2: the crate\'s forces with P still unknown: weight mg = 100 N down, N = 100 − P sin θ up, the pull P at θ split into P cos θ and P sin θ, and friction f against the horizontal part. Stage 3: at the start of sliding the need equals the limit, P cos θ = 0.75(100 − P sin θ), so P = 75/(cos θ + 0.75 sin θ). Stage 4: the thresholds are 75 N at 0°, 60 N at 37° and 62.5 N at 53°; against the worker\'s 61 N only the 37° pull starts the crate.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CRATE3DIR-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 10 kg crate on a rough floor, pulled by a rope in one of three directions</text>\n    <line x1="40" y1="300" x2="460" y2="300" stroke="currentColor" stroke-width="2"/>\n    <line x1="50" y1="300" x2="42" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="68" y1="300" x2="60" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="86" y1="300" x2="78" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="104" y1="300" x2="96" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="122" y1="300" x2="114" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="140" y1="300" x2="132" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="300" x2="150" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="300" x2="168" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="300" x2="186" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="300" x2="204" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="300" x2="222" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="300" x2="240" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="266" y1="300" x2="258" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="284" y1="300" x2="276" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="302" y1="300" x2="294" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="320" y1="300" x2="312" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="338" y1="300" x2="330" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="356" y1="300" x2="348" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="374" y1="300" x2="366" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="392" y1="300" x2="384" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="410" y1="300" x2="402" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="428" y1="300" x2="420" y2="308" stroke="currentColor" stroke-width="1"/>\n    <line x1="446" y1="300" x2="438" y2="308" stroke="currentColor" stroke-width="1"/>\n    <rect x="120" y="220" width="110" height="80" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="175" y="265" text-anchor="middle">crate 10 kg</text>\n    <line x1="230" y1="260" x2="380" y2="260" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="388" y="265">0°</text>\n    <line x1="230" y1="260" x2="350" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="358" y="168">37°</text>\n    <line x1="230" y1="260" x2="320" y2="140" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="300" y="128">53°</text>\n    <text x="40" y="330">rough floor, μ_s = 0.75</text>\n    <text x="480" y="70">g = 10 m/s²</text>\n    <text x="480" y="92">sin 37° = cos 53° = 0.6</text>\n    <text x="480" y="114">cos 37° = sin 53° = 0.8</text>\n    <text x="480" y="136">pull P in each direction: unknown</text>\n    <text x="480" y="158">the worker can pull with at most 61 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CRATE3DIR-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="520" y="214" font-weight="600">Forces on the crate, P still unknown</text>\n    <rect x="600" y="300" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="640" y="335" text-anchor="middle">crate</text>\n    <line x1="640" y1="300" x2="640" y2="240" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="648" y="252">N = 100 − P sin θ</text>\n    <line x1="640" y1="360" x2="640" y2="420" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="648" y="416">mg = 100 N</text>\n    <line x1="680" y1="330" x2="760" y2="270" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="768" y="268">P at θ</text>\n    <line x1="680" y1="330" x2="760" y2="330" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4"/>\n    <line x1="760" y1="330" x2="760" y2="270" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4"/>\n    <text x="690" y="350">P cos θ</text>\n    <text x="766" y="306">P sin θ</text>\n    <line x1="600" y1="330" x2="540" y2="330" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-STATE-01-bound-REP-NLM-CRATE10-THREE-DIRECTIONS-1--rep-nlm-crate3dir-arrow)"/>\n    <text x="534" y="326" text-anchor="end">f</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CRATE3DIR-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="40" y="372" font-weight="600">At the start of sliding, the need reaches the limit:</text>\n    <text x="40" y="394">P cos θ = 0.75(100 − P sin θ), so P = 75/(cos θ + 0.75 sin θ)</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CRATE3DIR-V3" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="40" y="428" font-weight="600" fill="#1f6fb2">0°: 75 N; 37°: 60 N; 53°: 62.5 N</text>\n    <text x="40" y="450" fill="#1f6fb2">Against the worker\'s 61 N, only the 37° pull starts the crate.</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the crate, the floor and the three directions the rope can pull.">1: The crate and three rope directions</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Draw the crate&#x27;s forces for a pull P at θ.">2: Forces with P unknown</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Set the need equal to the limit at the start of sliding.">3: Starting condition</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="3" data-g9-stage-desc="Evaluate each direction and compare with the worker&#x27;s 61 N.">4: Three thresholds</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 10 kg crate with the rope at 0°, 37° and 53° and the pull unknown, then build the starting threshold for each direction.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>When the crate is just about to slide, the friction it needs equals the limit μ_s N, and N = 100 − P sin θ. So P cos θ = 0.75(100 − P sin θ), which gives P = 75/(cos θ + 0.75 sin θ). Horizontal: 75 N. At 37°: 75/1.25 = 60 N. At 53°: 75/1.2 = 62.5 N. The 37° pull needs the least, and a worker limited to 61 N can start the crate only in that direction.</p><ol><li>With a pull P at angle θ above the horizontal, the vertical balance gives N = mg − P sin θ = 100 − P sin θ.</li><li>Until the crate moves, friction must equal the horizontal part P cos θ; the smallest starting pull makes that need equal to the limit: P cos θ = 0.75(100 − P sin θ).</li><li>Solving, P = 75/(cos θ + 0.75 sin θ): 75/1 = 75 N at 0°, 75/(0.8 + 0.45) = 60 N at 37°, 75/(0.6 + 0.6) = 62.5 N at 53°.</li><li>Only the 37° threshold, 60 N, is within the worker&#x27;s 61 N; horizontally 75 N is needed, and at 53° 62.5 N.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Writes N = 100 − P sin θ with the pull still unknown, before using the limit.</li><li>Sets the need P cos θ equal to μ_s N only at the start of sliding and finds 75 N, 60 N and 62.5 N.</li><li>Decides that only the 37° direction works for a 61 N worker.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At 37° with P = 60 N: horizontal part 48 N, vertical part 36 N, so N = 64 N and μ_s N = 48 N, exactly the need. At 53° with P = 61 N: need 61 × 0.6 = 36.6 N, but N = 100 − 48.8 = 51.2 N gives a limit of 38.4 N, so the crate stays at rest.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Assume no relative sliding provisionally, choose a body or a whole connected system deliberately, and solve the tangential Newton-II equation for the friction demand at each rough contact.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-unit="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Connected bodies and a justified common acceleration Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Reasoning steps Three carts touch in a line on a level track: A (3 kg) at the back, then B (2 kg), then C (1 kg) at the front. A 30 N push acts on A toward the front. Cart B has a sticking wheel that drags on the track with a 6 N friction force; A and C roll freely. Find the acceleration of the train and the contact force at each of its two joints, A-B and B-C. The carts stay in contact. The only friction is the 6 N drag on B, opposite the motion. Take the direction of the push as positive." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="Connected bodies and a justified common acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Connected bodies and a justified common acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02" data-g9-meta-value="reasoning_steps"><strong>Transfer:</strong> <span data-g9-meta-label>Reasoning steps</span></span></div><div class="g9-block" data-g9-block="stem"><h2>Three carts touch in a line on a level track: A (3 kg) at the back, then B (2 kg), then C (1 kg) at the front. A 30 N push acts on A toward the front. Cart B has a sticking wheel that drags on the track with a 6 N friction force; A and C roll freely. Find the acceleration of the train and the contact force at each of its two joints, A-B and B-C.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-CONNECTED-02">Two blocks A and B of masses m_A and m_B remain in contact on a smooth horizontal…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The carts stay in contact.</li><li>The only friction is the 6 N drag on B, opposite the motion.</li><li>Take the direction of the push as positive.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-REP-NLM-THREE-CART-TRAIN" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-THREE-CART-TRAIN" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TRAIN-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The train" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 290">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TRAIN-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Three carts in contact; a 30 N push on A; 6 N drag on B</text>\n    <line x1="20" y1="200" x2="440" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="200" x2="418" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="80" y="132" width="100" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="130" y="162" text-anchor="middle">A 3 kg</text>\n    <circle cx="100" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="160" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="180" y="132" width="90" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="225" y="162" text-anchor="middle">B 2 kg</text>\n    <circle cx="198" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="252" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="270" y="132" width="70" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="305" y="162" text-anchor="middle">C 1 kg</text>\n    <circle cx="284" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="326" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="20" y1="157" x2="76" y2="157" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow)"/>\n    <text x="20" y="147">30 N</text>\n    <line x1="250" y1="226" x2="205" y2="226" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow)"/>\n    <text x="256" y="231">6 N drag on B</text>\n    <text x="20" y="272">front is to the right; A and C roll freely; the carts stay in contact</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The train</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>How many different contact forces does a three-cart train have, and which forces act on it from outside?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Maintained contact still gives one shared acceleration, and each contact force still belongs only in the equation of the part it acts on. What changes is that the joint forces are no longer mass fractions of the push.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must see that a train has one force per joint, and must choose a cut and a side for each joint when an external force acts on an interior cart.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Find each joint force separately by cutting at that joint and isolating the part on one side with all of its external forces; do not use the mass-fraction rule, since the drag acts on the middle cart.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-THREE-CART-TRAIN" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TRAIN-V0 VIS-NLM-TRAIN-V1 VIS-NLM-TRAIN-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 290" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-title g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-title">Three carts with a drag on the middle one: cut at each joint</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-desc">Stage 1: Three carts touch in a line on a level track, A (3 kg) at the back, then B (2 kg), then C (1 kg); a 30 N push acts on A toward the front and B\'s sticking wheel drags with 6 N. Stage 2: For the whole train a = (30 − 6)/6 = 4 m/s²; each joint force is found by cutting there and isolating one side. Stage 3: Isolating C gives the B–C joint force 1 × 4 = 4 N; isolating A gives 30 − N = 12, so the A–B joint carries 18 N; these are not the mass fractions 15 N and 5 N because the drag acts on B.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TRAIN-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Three carts in contact; a 30 N push on A; 6 N drag on B</text>\n    <line x1="20" y1="200" x2="440" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="200" x2="418" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="80" y="132" width="100" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="130" y="162" text-anchor="middle">A 3 kg</text>\n    <circle cx="100" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="160" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="180" y="132" width="90" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="225" y="162" text-anchor="middle">B 2 kg</text>\n    <circle cx="198" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="252" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="270" y="132" width="70" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="305" y="162" text-anchor="middle">C 1 kg</text>\n    <circle cx="284" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="326" cy="191" r="9" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="20" y1="157" x2="76" y2="157" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow)"/>\n    <text x="20" y="147">30 N</text>\n    <line x1="250" y1="226" x2="205" y2="226" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONNECTED-SYSTEM-02-bound-REP-NLM-THREE-CART-TRAIN-1--rep-nlm-train-arrow)"/>\n    <text x="256" y="231">6 N drag on B</text>\n    <text x="20" y="272">front is to the right; A and C roll freely; the carts stay in contact</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TRAIN-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="60" font-weight="600">whole train:</text>\n    <text x="480" y="82">a = (30 − 6)/6 = 4 m/s²</text>\n    <text x="480" y="104">cut at each joint and isolate one side</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TRAIN-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="180" y1="110" x2="180" y2="190" stroke="currentColor" stroke-width="2"/>\n    <line x1="270" y1="110" x2="270" y2="190" stroke="currentColor" stroke-width="2"/>\n    <text x="180" y="100" text-anchor="middle" fill="#1f6fb2">A–B</text>\n    <text x="270" y="100" text-anchor="middle" fill="#1f6fb2">B–C</text>\n    <text x="480" y="150" font-weight="600" fill="#1f6fb2">B–C: C alone: N = 1 × 4 = 4 N</text>\n    <text x="480" y="172" font-weight="600" fill="#1f6fb2">A–B: A alone: 30 − N = 3 × 4, N = 18 N</text>\n    <text x="480" y="194">not the mass fractions 15 N and 5 N:</text>\n    <text x="480" y="216">the drag acts on the middle cart</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the three carts, the push and the drag on B.">1: The train</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find the common acceleration.">2: Whole train</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Cut at each joint and isolate one side with its external forces.">3: Joint forces</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the three-cart train with the drag acting on the middle cart.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>a = (30 − 6)/6 = 4 m/s². The A-B joint carries 18 N and the B-C joint carries 4 N. The two joint forces are not the mass fractions of the push (15 N and 5 N), because the drag acts on the middle cart.</p><ol><li>Whole train: the contact forces are internal, so 30 − 6 = 6a and a = 4 m/s².</li><li>A-B joint: isolate A, which has the push and the joint force: 30 − N_AB = 3 × 4, so N_AB = 18 N.</li><li>B-C joint: isolate C, whose only horizontal force is the joint force: N_BC = 1 × 4 = 4 N.</li><li>Cart B: 18 − 4 − 6 = 8 N = 2 × 4, as required.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Finds a from the whole train with the drag included and the joint forces left out.</li><li>Cuts at each joint separately and isolates one side with every external force on that side.</li><li>Rejects the mass-fraction shortcut because an external force acts on an interior cart.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Cut at A-B the other way: B + C together feel N_AB and the drag, so N_AB − 6 = 3 × 4 and N_AB = 18 N again. Removing the drag would give a = 5 m/s² and the mass fractions 15 N and 5 N.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM9-5" data-g9-concept-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-repair-target="CU-PHY-NLM-CONNECTED-COMMON-ACCEL-2" href="#g9-CORE1A--CU-PHY-NLM-CONNECTED-COMMON-ACCEL-2">Revisit: Match the chosen system boundary to the requested quantity: use the combined constrained system when internal forces are irrelevant to the shared acceleration, then isolate the body or subsystem that makes a requested interaction force external.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-unit="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Ideal-string tension belongs to each body-specific FBD Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice A 2 kg block hangs from the lower end of a uniform rope of mass 1 kg. A hand pulls the top of the rope so that the rope and block accelerate upward at 2 m/s². Take g = 10 m/s² and up as positive. A student writes one tension T for the whole rope. Decide whether that is licensed here, and find the tension at the top, at the middle and at the bottom of the rope. The rope is uniform and its 1 kg mass is not negligible. Rope and block move together with a = 2 m/s² upward. Tension at a point means the pull between the parts of the rope above and below that point." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="Ideal-string tension belongs to each body-specific FBD"><strong>Concept:</strong> <span data-g9-meta-label>Ideal-string tension belongs to each body-specific FBD</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-STRING-MODEL-03" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 2 kg block hangs from the lower end of a uniform rope of mass 1 kg. A hand pulls the top of the rope so that the rope and block accelerate upward at 2 m/s². Take g = 10 m/s² and up as positive. A student writes one tension T for the whole rope. Decide whether that is licensed here, and find the tension at the top, at the middle and at the bottom of the rope.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-IDEAL-STRING-03">Two carts A and B of masses m_A and m_B are connected by one taut massless…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The rope is uniform and its 1 kg mass is not negligible.</li><li>Rope and block move together with a = 2 m/s² upward.</li><li>Tension at a point means the pull between the parts of the rope above and below that point.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-STRING-MODEL-03-REP-NLM-HEAVY-ROPE-BLOCK" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-HEAVY-ROPE-BLOCK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HEAVYROPE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The rope and block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 310">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HEAVYROPE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block on a uniform 1 kg rope, pulled up by a hand</text>\n    <path d="M150 70 q-12 -18 10 -22 q20 2 12 22 z" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="180" y="58">hand</text>\n    <line x1="160" y1="72" x2="160" y2="220" stroke="currentColor" stroke-width="6"/>\n    <text x="172" y="150">rope 1 kg (uniform)</text>\n    <rect x="130" y="220" width="60" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="245" text-anchor="middle">2 kg</text>\n    <line x1="230" y1="250" x2="230" y2="200" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow)"/>\n    <text x="238" y="214">a = 2 m/s² up</text>\n    <text x="20" y="300">g = 10 m/s², up positive</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The rope and block</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>What property of a string lets you use one symbol T all along it, and does this rope have it?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Each tension force still pulls along the rope on the body it acts on, and Newton II still applies to any chosen part. What changes is that the rope&#x27;s own mass makes the tension depend on where you cut.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must decide that the single-tension model fails for a rope with mass, and must replace it with the tension found at a cut.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Reject one T for the rope: the ideal model needs a massless string, and each piece of this rope needs a net upward force of its own, so the tension must grow toward the top.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-HEAVY-ROPE-BLOCK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HEAVYROPE-V0 VIS-NLM-HEAVYROPE-V1 VIS-NLM-HEAVYROPE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 310" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-title g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-title">A 2 kg block hanging from a 1 kg rope that is pulled upward</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-desc">Stage 1: A 2 kg block hangs from the lower end of a uniform rope of mass 1 kg; a hand pulls the top so that rope and block accelerate upward at 2 m/s²; g = 10 m/s², up positive. Stage 2: One T needs a massless string; this rope\'s own mass must also be accelerated, so the pull grows toward the top: tension at a point = mass below × (g + a) = 12 N per kg. Stage 3: The tension is 24 N at the bottom, 30 N at the middle and 36 N at the top.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HEAVYROPE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block on a uniform 1 kg rope, pulled up by a hand</text>\n    <path d="M150 70 q-12 -18 10 -22 q20 2 12 22 z" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="180" y="58">hand</text>\n    <line x1="160" y1="72" x2="160" y2="220" stroke="currentColor" stroke-width="6"/>\n    <text x="172" y="150">rope 1 kg (uniform)</text>\n    <rect x="130" y="220" width="60" height="40" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="160" y="245" text-anchor="middle">2 kg</text>\n    <line x1="230" y1="250" x2="230" y2="200" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-STRING-MODEL-03-bound-REP-NLM-HEAVY-ROPE-BLOCK-1--rep-nlm-heavyrope-arrow)"/>\n    <text x="238" y="214">a = 2 m/s² up</text>\n    <text x="20" y="300">g = 10 m/s², up positive</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HEAVYROPE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="126" y="76" text-anchor="end">top</text>\n    <text x="126" y="150" text-anchor="end">middle</text>\n    <text x="126" y="222" text-anchor="end">bottom</text>\n    <text x="470" y="60" font-weight="600">one T needs a massless string:</text>\n    <text x="470" y="82">this rope\'s mass must be accelerated too,</text>\n    <text x="470" y="104">so the pull grows toward the top</text>\n    <text x="470" y="126">T(point) = (mass below) × (g + a) = 12 N/kg</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HEAVYROPE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="170" font-weight="600" fill="#1f6fb2">bottom: 2 kg below → 24 N</text>\n    <text x="470" y="192" font-weight="600" fill="#1f6fb2">middle: 2.5 kg below → 30 N</text>\n    <text x="470" y="214" font-weight="600" fill="#1f6fb2">top: 3 kg below → 36 N</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the hand, the 1 kg rope and the 2 kg block accelerating up.">1: The rope and block</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Test whether one T is licensed.">2: Model check</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Evaluate the tension at three points.">3: Tensions</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 2 kg block hanging from the lower end of the 1 kg uniform rope, with a hand pulling the top of the rope.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>One T is not licensed: that model needs a massless string, and this rope&#x27;s mass needs force to accelerate too. The tension at a point is (mass below the point) × (g + a) = 12 N per kg: 24 N at the bottom, 30 N at the middle and 36 N at the top.</p><ol><li>The ideal model&#x27;s single T rests on a massless string; a 1 kg rope carrying a 2 kg block is far from massless.</li><li>Cut the rope at a point and isolate everything below it: T − m_below g = m_below a, so T = m_below (g + a).</li><li>Bottom: m_below = 2 kg, T = 24 N. Middle: 2.5 kg, T = 30 N. Top: 3 kg, T = 36 N.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Rejects a single T because the rope&#x27;s mass is not negligible.</li><li>Finds the tension at a point by isolating everything below it.</li><li>Gets 24 N, 30 N and 36 N, increasing toward the top.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Isolate the rope alone: 36 N up at the top, 24 N down from the block and 10 N of weight give a net 2 N = 1 kg × 2 m/s².</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM10-4" data-g9-concept-ref="MIC-PHY-NLM-IDEAL-STRING-TENSION" data-g9-repair-target="CU-PHY-NLM-IDEAL-STRING-TENSION-2" href="#g9-CORE1A--CU-PHY-NLM-IDEAL-STRING-TENSION-2">Revisit: Check whether the problem introduces rope mass, elasticity, pulley friction, or rotational inertia; if it does, stop using equal tension unless a different model justifies it.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-unit="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion One fixed-pulley string gives one length constraint Hard concept Multi-step reasoning Newton-law and observer-frame practice Derivation Authored practice Representation translation A diagram is replaced by this verbal description: one taut inextensible string passes over one fixed pulley, with mass A on the left end and mass B on the right end. Coordinates x_A and x_B are both defined positive upward. Before writing any Newton-II equations, construct the string-length relation and derive the signed acceleration relation in these coordinates. If A accelerates upward at 2 m/s², what is B&#x27;s signed acceleration? The pulley is fixed. Only the two vertical straight string segments change length. Both coordinates are positive upward, toward the pulley." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="One fixed-pulley string gives one length constraint"><strong>Concept:</strong> <span data-g9-meta-label>One fixed-pulley string gives one length constraint</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04" data-g9-meta-value="representation_translation"><strong>Transfer:</strong> <span data-g9-meta-label>Representation translation</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A diagram is replaced by this verbal description: one taut inextensible string passes over one fixed pulley, with mass A on the left end and mass B on the right end. Coordinates x_A and x_B are both defined positive upward. Before writing any Newton-II equations, construct the string-length relation and derive the signed acceleration relation in these coordinates. If A accelerates upward at 2 m/s², what is B&#x27;s signed acceleration?</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FIXED-PULLEY-04">A cart on a table is tied to a light inextensible string that runs over a fixed pulley…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The pulley is fixed.</li><li>Only the two vertical straight string segments change length.</li><li>Both coordinates are positive upward, toward the pulley.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-REP-NLM-PULLEY-X-UPWARD" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-PULLEY-X-UPWARD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-XUP-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Verbal set-up drawn" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 860 345">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-XUP-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">One string over a fixed pulley; x_A and x_B measured upward</text>\n    <line x1="130" y1="50" x2="250" y2="50" stroke="currentColor" stroke-width="2"/>\n    <line x1="140" y1="50" x2="132" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="50" x2="150" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="50" x2="168" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="50" x2="186" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="50" x2="204" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="50" x2="222" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="50" x2="240" y2="42" stroke="currentColor" stroke-width="1"/>\n    <circle cx="190" cy="80" r="20" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="190" cy="80" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="80" x2="190" y2="50" stroke="currentColor" stroke-width="2"/>\n    <line x1="170" y1="80" x2="170" y2="200" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="210" y1="80" x2="210" y2="160" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="150" y="200" width="40" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="170" y="220" text-anchor="middle">A</text>\n    <rect x="190" y="160" width="40" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="180" text-anchor="middle">B</text>\n    <line x1="60" y1="300" x2="330" y2="300" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="300" x2="100" y2="215" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow)"/>\n    <text x="90" y="250" text-anchor="end">x_A</text>\n    <line x1="290" y1="300" x2="290" y2="175" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow)"/>\n    <text x="298" y="240">x_B</text>\n    <text x="20" y="330">both coordinates positive upward, toward the pulley; pulley fixed</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">Verbal set-up drawn</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Write the actual length of each vertical string segment in terms of its upward coordinate; do not start with an acceleration formula.</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>One fixed pulley and one inextensible string still fix the total changing length; what changes is the coordinate direction, and that the geometry arrives in words.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must translate a verbal fixed-pulley geometry with a different coordinate convention into the string-length equation before obtaining the acceleration constraint.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Build the fixed-length equation from those segment lengths, (h_P − x_A) + (h_P − x_B) = L, rather than copying y_A + y_B = constant from away-from-pulley coordinates.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-PULLEY-X-UPWARD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-XUP-V0 VIS-NLM-XUP-V1 VIS-NLM-XUP-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 860 345" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-title g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-title">Fixed pulley with x_A and x_B measured upward: build the length from the segments</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-desc">Stage 1: One taut inextensible string passes over one fixed pulley with mass A on the left end and B on the right end; x_A and x_B are both positive upward, toward the pulley. Stage 2: The changing segments have lengths h_P − x_A and h_P − x_B, so (h_P − x_A) + (h_P − x_B) = L and x_A + x_B = constant. Stage 3: v_A + v_B = 0 and a_A + a_B = 0, so with a_A = +2 m/s², a_B = −2 m/s²: B accelerates downward at 2 m/s².</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-XUP-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">One string over a fixed pulley; x_A and x_B measured upward</text>\n    <line x1="130" y1="50" x2="250" y2="50" stroke="currentColor" stroke-width="2"/>\n    <line x1="140" y1="50" x2="132" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="50" x2="150" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="50" x2="168" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="50" x2="186" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="50" x2="204" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="50" x2="222" y2="42" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="50" x2="240" y2="42" stroke="currentColor" stroke-width="1"/>\n    <circle cx="190" cy="80" r="20" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="190" cy="80" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="190" y1="80" x2="190" y2="50" stroke="currentColor" stroke-width="2"/>\n    <line x1="170" y1="80" x2="170" y2="200" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="210" y1="80" x2="210" y2="160" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="150" y="200" width="40" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="170" y="220" text-anchor="middle">A</text>\n    <rect x="190" y="160" width="40" height="30" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="180" text-anchor="middle">B</text>\n    <line x1="60" y1="300" x2="330" y2="300" stroke="currentColor" stroke-width="2"/>\n    <line x1="100" y1="300" x2="100" y2="215" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow)"/>\n    <text x="90" y="250" text-anchor="end">x_A</text>\n    <line x1="290" y1="300" x2="290" y2="175" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-PULLEY-REPRESENTATION-04-bound-REP-NLM-PULLEY-X-UPWARD-1--rep-nlm-xup-arrow)"/>\n    <text x="298" y="240">x_B</text>\n    <text x="20" y="330">both coordinates positive upward, toward the pulley; pulley fixed</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-XUP-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="120" y1="80" x2="120" y2="200" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="114" y="150" text-anchor="end" fill="#1f6fb2">h_P − x_A</text>\n    <line x1="260" y1="80" x2="260" y2="160" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="266" y="124" fill="#1f6fb2">h_P − x_B</text>\n    <text x="480" y="60" font-weight="600" fill="#1f6fb2">segment lengths (pulley at h_P):</text>\n    <text x="480" y="82" fill="#1f6fb2">(h_P − x_A) + (h_P − x_B) = L</text>\n    <text x="480" y="104">so x_A + x_B = constant</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-XUP-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="150" font-weight="600">v_A + v_B = 0, a_A + a_B = 0</text>\n    <text x="480" y="172" font-weight="600" fill="#1f6fb2">a_A = +2 m/s² → a_B = −2 m/s²</text>\n    <text x="480" y="194">B accelerates downward at 2 m/s²</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show A on the left, B on the right and both upward coordinates.">1: Verbal set-up drawn</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write each changing segment length in these coordinates.">2: Segment lengths</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Differentiate and apply a_A = +2 m/s².">3: Signed result</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the fixed pulley with both coordinates x_A and x_B measured upward.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Because the changing segment lengths decrease when x_A or x_B increases, the variable string length can be written (C_A - x_A) + (C_B - x_B) = constant. Hence x_A + x_B = constant, so v_A + v_B = 0 and a_A + a_B = 0. Thus if A accelerates upward, B accelerates downward with equal magnitude. With a_A = +2 m/s², a_B = −2 m/s², so B accelerates downward at 2 m/s².</p><ol><li>With the pulley at a fixed height h_P and x measured upward from a fixed level, the segment lengths are h_P − x_A and h_P − x_B.</li><li>The string length is fixed: (h_P − x_A) + (h_P − x_B) = L, so x_A + x_B = 2h_P − L, a constant.</li><li>Differentiating twice gives v_A + v_B = 0 and a_A + a_B = 0.</li><li>With a_A = +2 m/s², a_B = −2 m/s²: B accelerates downward.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Builds the variable string length from the verbal geometry before writing an acceleration relation.</li><li>Uses the declared upward coordinate signs consistently.</li><li>Derives a_A + a_B = 0 from the length relation.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>If both masses accelerated upward in these coordinates, both vertical segments would shorten and the fixed total string length would be violated.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM11-2" data-g9-concept-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-repair-target="CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-1" href="#g9-CORE1A--CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-1">Revisit: Write the variable part of the string length as y_A + y_B and set its total equal to a constant.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-unit="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion An accelerating observer needs a declared pseudo-force convention Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice A 0.2 kg bob hangs from a string tied to the roof of a car that accelerates horizontally to the right at 7.5 m/s²; the bob hangs steady relative to the car. Take g = 10 m/s². A student wants the bob to be at rest in the chosen coordinates. Decide which observer makes that possible and what extra term that observer needs. Then find the string&#x27;s angle from the vertical and its tension, and check both with the roadside frame. The road is horizontal. The car&#x27;s acceleration is constant at 7.5 m/s² to the right. Air resistance is neglected." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRAME-CHOICE" data-g9-meta-value="An accelerating observer needs a declared pseudo-force convention"><strong>Concept:</strong> <span data-g9-meta-label>An accelerating observer needs a declared pseudo-force convention</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRAME-CHOICE" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRAME-SELECTION-05" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 0.2 kg bob hangs from a string tied to the roof of a car that accelerates horizontally to the right at 7.5 m/s²; the bob hangs steady relative to the car. Take g = 10 m/s². A student wants the bob to be at rest in the chosen coordinates. Decide which observer makes that possible and what extra term that observer needs. Then find the string&#x27;s angle from the vertical and its tension, and check both with the roadside frame.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FRAME-CHOICE-07">A delivery van accelerates forward along a straight, level road at 2 m/s². A passenger…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The road is horizontal.</li><li>The car&#x27;s acceleration is constant at 7.5 m/s² to the right.</li><li>Air resistance is neglected.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRAME-SELECTION-05-REP-NLM-CAR-BOB-FRAMES" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CAR-BOB-FRAMES" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CARBOB-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The car and bob" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 300">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARBOB-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 0.2 kg bob hangs steady in a car accelerating at 7.5 m/s²</text>\n    <line x1="20" y1="250" x2="430" y2="250" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="250" x2="22" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="250" x2="40" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="250" x2="58" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="250" x2="76" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="250" x2="94" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="250" x2="112" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="250" x2="130" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="250" x2="148" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="250" x2="166" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="250" x2="184" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="250" x2="202" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="250" x2="220" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="250" x2="238" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="250" x2="256" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="250" x2="274" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="250" x2="292" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="250" x2="310" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="250" x2="328" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="250" x2="346" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="250" x2="364" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="250" x2="382" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="250" x2="400" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="250" x2="418" y2="258" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="80" width="320" height="150" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="124" cy="240" r="10" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="316" cy="240" r="10" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="80" x2="154" y2="178" stroke="currentColor" stroke-width="1.8"/>\n    <circle cx="154" cy="178" r="10" fill="currentColor" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="80" x2="220" y2="200" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="206" y="150" text-anchor="end">θ ?</text>\n    <line x1="300" y1="60" x2="370" y2="60" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow)"/>\n    <text x="250" y="52">a_car = 7.5 m/s²</text>\n    <text x="20" y="285">horizontal road; g = 10 m/s²; air resistance neglected</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The car and bob</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which observer sees the bob stationary after the transient, and is that observer accelerating?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The physical forces on the bob, gravity and the string&#x27;s tension, are the same for every observer, and both descriptions must predict one string direction; what changes is that you choose which observer to use.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must choose between an inertial roadside analysis and an accelerating-car analysis from the task&#x27;s representation goal, instead of being told which frame to use.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Use the car frame and add a pseudo-force −m a_car = 1.5 N to the left to the unchanged physical forces (2 N weight, tension); in the roadside frame add nothing and give the bob a = 7.5 m/s².</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CAR-BOB-FRAMES" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CARBOB-V0 VIS-NLM-CARBOB-V1 VIS-NLM-CARBOB-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 300" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-title g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-title">A bob hanging in a car accelerating at 7.5 m/s²</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-desc">Stage 1: A 0.2 kg bob hangs from a string tied to the roof of a car that accelerates horizontally to the right at 7.5 m/s²; the bob hangs steady relative to the car at an angle θ to be found; g = 10 m/s². Stage 2: In the car frame the bob is at rest once a pseudo-force −m a_car = 1.5 N to the left is added to the 2 N weight and the tension; the roadside frame adds nothing and gives the bob a = 7.5 m/s². Stage 3: tan θ = 1.5/2 = 0.75, so θ ≈ 37° with the bob hanging back, and T = √(1.5² + 2²) = 2.5 N; the roadside frame gives T sin θ = 1.5 N and T cos θ = 2 N, the same result.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CARBOB-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 0.2 kg bob hangs steady in a car accelerating at 7.5 m/s²</text>\n    <line x1="20" y1="250" x2="430" y2="250" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="250" x2="22" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="250" x2="40" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="250" x2="58" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="250" x2="76" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="250" x2="94" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="250" x2="112" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="250" x2="130" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="250" x2="148" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="250" x2="166" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="250" x2="184" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="250" x2="202" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="250" x2="220" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="250" x2="238" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="250" x2="256" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="250" x2="274" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="250" x2="292" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="250" x2="310" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="250" x2="328" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="250" x2="346" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="250" x2="364" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="250" x2="382" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="250" x2="400" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="426" y1="250" x2="418" y2="258" stroke="currentColor" stroke-width="1"/>\n    <rect x="60" y="80" width="320" height="150" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="124" cy="240" r="10" fill="none" stroke="currentColor" stroke-width="2"/>\n    <circle cx="316" cy="240" r="10" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="80" x2="154" y2="178" stroke="currentColor" stroke-width="1.8"/>\n    <circle cx="154" cy="178" r="10" fill="currentColor" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="80" x2="220" y2="200" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="206" y="150" text-anchor="end">θ ?</text>\n    <line x1="300" y1="60" x2="370" y2="60" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow)"/>\n    <text x="250" y="52">a_car = 7.5 m/s²</text>\n    <text x="20" y="285">horizontal road; g = 10 m/s²; air resistance neglected</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARBOB-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="154" y1="188" x2="154" y2="224" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow)"/>\n    <text x="162" y="222">2 N</text>\n    <line x1="154" y1="178" x2="183.7" y2="133.9" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow)"/>\n    <text x="146" y="148" text-anchor="end">T</text>\n    <line x1="142" y1="178" x2="97" y2="178" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRAME-SELECTION-05-bound-REP-NLM-CAR-BOB-FRAMES-1--rep-nlm-carbob-arrow-acc)" stroke-dasharray="7 4"/>\n    <text x="94" y="204" text-anchor="middle" fill="#1f6fb2">1.5 N pseudo</text>\n    <text x="480" y="60" font-weight="600" fill="#1f6fb2">car frame: bob at rest</text>\n    <text x="480" y="82" fill="#1f6fb2">add −m a_car = 1.5 N to the left</text>\n    <text x="480" y="104">roadside frame: no extra term,</text>\n    <text x="480" y="126">bob has a = 7.5 m/s²</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CARBOB-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="160" font-weight="600" fill="#1f6fb2">tan θ = 1.5/2 = 0.75, θ ≈ 37°</text>\n    <text x="480" y="182" fill="#1f6fb2">bob hangs back (to the left)</text>\n    <text x="480" y="204" font-weight="600" fill="#1f6fb2">T = √(1.5² + 2²) = 2.5 N</text>\n    <text x="480" y="226">roadside: T sin θ = 1.5 N, T cos θ = 2 N ✓</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the bob hanging steady in the accelerating car.">1: The car and bob</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Choose the car frame and add its pseudo-force.">2: Frame choice</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Balance the forces and check with the roadside frame.">3: Angle and tension</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the bob hanging from the roof of the car that accelerates at 7.5 m/s².</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Use the car frame, where the bob is at rest, and add a pseudo-force m a_car = 0.2 × 7.5 = 1.5 N to the left. With the 2 N weight, the string must balance both: tan θ = 1.5/2 = 0.75, so θ ≈ 37° from the vertical, with the bob hanging back (to the left), and T = √(1.5² + 2²) = 2.5 N. The roadside frame uses no pseudo-force: T sin θ = m a = 1.5 N and T cos θ = mg = 2 N, the same result.</p><ol><li>Only the car observer sees the bob at rest; that observer accelerates, so a pseudo-force −m a_car = 1.5 N to the left joins the physical forces.</li><li>Car frame, at rest: T sin θ = 1.5 N (horizontal) and T cos θ = 2 N (vertical).</li><li>tan θ = 0.75, θ ≈ 37°, and T = 2.5 N; the bob hangs back, opposite the acceleration.</li><li>Roadside frame: no pseudo-force, the bob accelerates at 7.5 m/s² to the right, so T sin θ = 1.5 N and T cos θ = 2 N, the same equations.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Chooses the car frame because the task wants the bob at rest, and adds −m a_car only there.</li><li>Balances weight, tension and the 1.5 N pseudo-force to get θ ≈ 37° and T = 2.5 N.</li><li>Reproduces the angle in the roadside frame with physical forces only.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Both frames give tan θ = a/g = 0.75 and T = m√(g² + a²) = 0.2 × 12.5 = 2.5 N. With a = 0 the string hangs vertically with T = 2 N.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM4-3" data-g9-concept-ref="MIC-PHY-NLM-FRAME-CHOICE" data-g9-repair-target="CU-PHY-NLM-FRAME-CHOICE-1" href="#g9-CORE1A--CU-PHY-NLM-FRAME-CHOICE-1">Revisit: Add a backward pseudo-force only in the accelerating-observer description and compare it with the roadside account.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-unit="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Friction opposes relative sliding at a contact Medium concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Representation translation A 60 kg person stands on a 20 kg plank that rests on frictionless ice. The person starts to walk forward, accelerating at 0.5 m/s² relative to the ice, and the shoes do not slip on the plank. Find the direction and size of the friction on the person&#x27;s shoes, then the horizontal force on the plank and the plank&#x27;s acceleration. The ice exerts no horizontal force on the plank. The shoes do not slip on the plank. Accelerations are measured relative to the ice." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="Friction opposes relative sliding at a contact"><strong>Concept:</strong> <span data-g9-meta-label>Friction opposes relative sliding at a contact</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-WALKING-02" data-g9-meta-value="representation_translation"><strong>Transfer:</strong> <span data-g9-meta-label>Representation translation</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 60 kg person stands on a 20 kg plank that rests on frictionless ice. The person starts to walk forward, accelerating at 0.5 m/s² relative to the ice, and the shoes do not slip on the plank. Find the direction and size of the friction on the person&#x27;s shoes, then the horizontal force on the plank and the plank&#x27;s acceleration.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-COV-04">A 20 kg crate rides on the flat bed of a truck. The truck brakes, slowing at 3 m/s²,…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The ice exerts no horizontal force on the plank.</li><li>The shoes do not slip on the plank.</li><li>Accelerations are measured relative to the ice.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-WALKING-02-REP-NLM-WALKER-ON-PLANK" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-WALKER-ON-PLANK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PLANK-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The walker" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PLANK-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 60 kg person starts walking on a 20 kg plank on ice</text>\n    <line x1="20" y1="230" x2="430" y2="230" stroke="currentColor" stroke-width="2"/>\n    <text x="360" y="250">frictionless ice</text>\n    <rect x="80" y="214" width="300" height="16" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="90" y="248" font-size="14">plank 20 kg</text>\n    <circle cx="220" cy="134.8" r="10.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="145.6" x2="220" y2="178" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="178" x2="206.5" y2="214" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="178" x2="233.5" y2="214" stroke="currentColor" stroke-width="2"/>\n    <line x1="202" y1="158.2" x2="238" y2="158.2" stroke="currentColor" stroke-width="2"/>\n    <text x="240" y="150">60 kg</text>\n    <line x1="250" y1="110" x2="310" y2="110" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow)"/>\n    <text x="250" y="100">a = 0.5 m/s² (rel. ice)</text>\n    <text x="20" y="305">shoes do not slip on the plank; ice gives no horizontal force</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The walker</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>At the shoe-plank contact, which way would the shoe slide across the plank if the plank were perfectly slippery?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Friction still opposes the slip tendency at the contact, whatever each body&#x27;s overall velocity. What changes is that the second surface is free to move, so its partner force now matters.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must translate the slip-tendency rule from a carried body to the surface it stands on, following the friction partner to predict the plank&#x27;s motion.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Put the partner friction, 30 N backward, on the plank: the plank moves under the contact force it receives, not in the walker&#x27;s direction.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-WALKER-ON-PLANK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PLANK-V0 VIS-NLM-PLANK-V1 VIS-NLM-PLANK-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 320" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-title g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-title">A person starting to walk on a plank that rests on frictionless ice</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-desc">Stage 1: A 60 kg person stands on a 20 kg plank on frictionless ice and starts to walk forward, accelerating at 0.5 m/s² relative to the ice; the shoes do not slip. Stage 2: Only the plank\'s friction pushes the person forward, so it is 60 × 0.5 = 30 N forward on the shoes. Stage 3: Its partner, 30 N backward, acts on the plank, which has no other horizontal force, so the plank accelerates backward at 30/20 = 1.5 m/s².</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PLANK-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 60 kg person starts walking on a 20 kg plank on ice</text>\n    <line x1="20" y1="230" x2="430" y2="230" stroke="currentColor" stroke-width="2"/>\n    <text x="360" y="250">frictionless ice</text>\n    <rect x="80" y="214" width="300" height="16" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="90" y="248" font-size="14">plank 20 kg</text>\n    <circle cx="220" cy="134.8" r="10.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="145.6" x2="220" y2="178" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="178" x2="206.5" y2="214" stroke="currentColor" stroke-width="2"/>\n    <line x1="220" y1="178" x2="233.5" y2="214" stroke="currentColor" stroke-width="2"/>\n    <line x1="202" y1="158.2" x2="238" y2="158.2" stroke="currentColor" stroke-width="2"/>\n    <text x="240" y="150">60 kg</text>\n    <line x1="250" y1="110" x2="310" y2="110" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow)"/>\n    <text x="250" y="100">a = 0.5 m/s² (rel. ice)</text>\n    <text x="20" y="305">shoes do not slip on the plank; ice gives no horizontal force</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PLANK-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="226" y1="206" x2="276" y2="206" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow-acc)"/>\n    <text x="280" y="196" fill="#1f6fb2">f on shoes: 30 N</text>\n    <text x="480" y="60" font-weight="600">person: only the plank\'s friction pushes</text>\n    <text x="480" y="82">them forward: f = 60 × 0.5 = 30 N forward</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PLANK-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="214" y1="226" x2="164" y2="226" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-WALKING-02-bound-REP-NLM-WALKER-ON-PLANK-1--rep-nlm-plank-arrow-acc)"/>\n    <text x="150" y="276" text-anchor="middle" fill="#1f6fb2">30 N on plank</text>\n    <text x="480" y="130" font-weight="600" fill="#1f6fb2">partner: 30 N backward on the plank</text>\n    <text x="480" y="152" font-weight="600" fill="#1f6fb2">plank: a = 30/20 = 1.5 m/s² backward</text>\n    <text x="480" y="174">the plank moves under the force it</text>\n    <text x="480" y="196">receives, not the walker\'s way</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the person starting to walk on the plank on ice.">1: The walker</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find the force that accelerates the person.">2: Friction on the shoes</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Put the partner friction on the plank.">3: The plank</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the person starting to walk on the plank that rests on frictionless ice.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Friction on the shoes points forward and is 60 × 0.5 = 30 N. Its partner, 30 N backward, acts on the plank, which has no other horizontal force, so the plank accelerates backward at 30/20 = 1.5 m/s².</p><ol><li>If the plank&#x27;s surface were slippery, pushing the foot backward would make the shoe slide backward across the plank.</li><li>Friction on the shoe opposes that: forward, and it is the only horizontal force on the person, so f = 60 × 0.5 = 30 N.</li><li>The plank receives the partner of that friction: 30 N backward.</li><li>The ice is frictionless, so the plank&#x27;s acceleration is 30/20 = 1.5 m/s² backward.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Finds the friction on the shoe from the slip tendency at the shoe-plank contact: forward, 30 N.</li><li>Places the partner friction, 30 N backward, on the plank.</li><li>Gets the plank&#x27;s acceleration, 1.5 m/s² backward.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Person and plank together feel no horizontal external force, so 60 × 0.5 forward and 20 × 1.5 backward must cancel: 30 − 30 = 0.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM5-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION" data-g9-repair-target="CU-PHY-NLM-FRICTION-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-1">Revisit: Imagine the relative sliding, or tendency to slide, at that named contact if tangential friction were absent; point friction on the chosen body opposite that relative tendency.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-unit="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Friction opposes relative sliding at a contact Medium concept Connected reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice A 50 kg crate stands on the rough floor of a lift (μ_s = 0.4) while the lift accelerates upward at 2 m/s². Take g = 10 m/s². Find the normal force on the crate and the friction force on it. The lift floor is horizontal. Nothing pushes or pulls the crate sideways. The crate moves with the lift." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="Friction opposes relative sliding at a contact"><strong>Concept:</strong> <span data-g9-meta-label>Friction opposes relative sliding at a contact</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-meta-value="D2"><strong>Question difficulty:</strong> <span data-g9-meta-label>Connected reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ZERO-03" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 50 kg crate stands on the rough floor of a lift (μ_s = 0.4) while the lift accelerates upward at 2 m/s². Take g = 10 m/s². Find the normal force on the crate and the friction force on it.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FRICTION-ZERO-08">A crate rests on a rough horizontal floor. No horizontal force acts on it, and there…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The lift floor is horizontal.</li><li>Nothing pushes or pulls the crate sideways.</li><li>The crate moves with the lift.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-ZERO-03-REP-NLM-LIFT-CRATE-FRICTION-ZERO" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-LIFT-CRATE-FRICTION-ZERO" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-LIFTCRATE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The lift" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 345">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-LIFTCRATE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 50 kg crate on the rough floor of a lift accelerating up</text>\n    <line x1="200" y1="40" x2="200" y2="70" stroke="currentColor" stroke-width="2"/>\n    <rect x="90" y="70" width="220" height="190" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="160" y="200" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="235" text-anchor="middle">50 kg</text>\n    <line x1="340" y1="200" x2="340" y2="140" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow)"/>\n    <text x="348" y="150">a = 2 m/s² up</text>\n    <text x="20" y="335">μ_s = 0.4; g = 10 m/s²; nothing pushes the crate sideways</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The lift</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which way does the crate accelerate, and along which direction does friction act at a floor contact?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Friction still appears only where the contact has a slip tendency to oppose. What changes is that the contact now accelerates and N is larger, and neither creates a tangential need.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must decide not to include a friction force on an accelerating, harder-pressed rough contact, because the acceleration has no tangential component.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Set friction to zero: the acceleration has no component along the floor and nothing else acts sideways, so there is no slip tendency, even though N rose to 600 N and the floor is rough.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-LIFT-CRATE-FRICTION-ZERO" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-LIFTCRATE-V0 VIS-NLM-LIFTCRATE-V1 VIS-NLM-LIFTCRATE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 345" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-title g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-title">A crate on the rough floor of a lift accelerating upward</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-desc">Stage 1: A 50 kg crate stands on the rough floor of a lift (μ_s = 0.4) while the lift accelerates upward at 2 m/s²; nothing pushes the crate sideways; g = 10 m/s². Stage 2: Vertically N − 500 = 50 × 2, so N = 600 N; μ_s N = 240 N is only a limit. Stage 3: The friction force is zero: the acceleration is vertical, so nothing is needed along the floor, even though the floor is rough and N is larger.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-LIFTCRATE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 50 kg crate on the rough floor of a lift accelerating up</text>\n    <line x1="200" y1="40" x2="200" y2="70" stroke="currentColor" stroke-width="2"/>\n    <rect x="90" y="70" width="220" height="190" fill="none" stroke="currentColor" stroke-width="2"/>\n    <rect x="160" y="200" width="80" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="200" y="235" text-anchor="middle">50 kg</text>\n    <line x1="340" y1="200" x2="340" y2="140" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow)"/>\n    <text x="348" y="150">a = 2 m/s² up</text>\n    <text x="20" y="335">μ_s = 0.4; g = 10 m/s²; nothing pushes the crate sideways</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-LIFTCRATE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="188" y1="200" x2="188" y2="156" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow)"/>\n    <text x="196" y="170">N</text>\n    <line x1="212" y1="260" x2="212" y2="304" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ZERO-03-bound-REP-NLM-LIFT-CRATE-FRICTION-ZERO-1--rep-nlm-liftcrate-arrow)"/>\n    <text x="220" y="300">500 N</text>\n    <text x="480" y="60" font-weight="600">vertical: N − 500 = 50 × 2</text>\n    <text x="480" y="82" font-weight="600" fill="#1f6fb2">N = 600 N</text>\n    <text x="480" y="104">μ_s N = 240 N (only a limit)</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-LIFTCRATE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="150" font-weight="600" fill="#1f6fb2">friction = 0</text>\n    <text x="480" y="172" fill="#1f6fb2">a is vertical: nothing is needed</text>\n    <text x="480" y="194" fill="#1f6fb2">along the floor, no slip tendency</text>\n    <text x="480" y="216">rough floor and larger N do not create it</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the crate on the lift floor and the upward acceleration.">1: The lift</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write the vertical equation.">2: Normal force</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Test for a sideways need.">3: Friction</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the crate on the rough floor of the lift that accelerates upward.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>N = 50 × (10 + 2) = 600 N. The friction force is zero: the crate&#x27;s acceleration is vertical, so nothing needs a force along the floor, even though the floor is rough and μ_s N = 240 N.</p><ol><li>Vertical: N − 500 = 50 × 2, so N = 600 N.</li><li>Friction acts along the floor. The crate has no horizontal acceleration and no other horizontal force, so there is no slip tendency.</li><li>Static friction supplies only what is needed, which here is nothing; 240 N is only its ceiling.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Finds N = 600 N from the vertical equation with the lift&#x27;s acceleration.</li><li>Sets friction to zero because no horizontal acceleration or force needs it.</li><li>Treats μ_s N = 240 N as a ceiling that is not reached.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Horizontal Newton II: f = m a_x = 50 × 0 = 0. If the lift instead accelerated sideways, a friction force would be needed, and it would be capped at 0.4 × N.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM5-4" data-g9-concept-ref="MIC-PHY-NLM-FRICTION" data-g9-repair-target="CU-PHY-NLM-FRICTION-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-1">Revisit: Decide whether any tangential friction is required at all; allow friction to be zero when the contact has neither relative sliding nor a tendency to slide.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-unit="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept High-transfer / exception-sensitive Newton-law and observer-frame practice Derivation Authored practice Reasoning steps A block of mass m is pushed on a rough horizontal floor by a force P directed at an angle theta below the horizontal. The coefficient of static friction is mu_s. Derive the largest P for which the block can remain at rest. Then show that for steep enough push angles no P at all can start the block, and find that angle for mu_s = 0.5. 0 &lt; theta &lt; 90 degrees. The block remains in contact with the floor. Do not assume the sign of cos(theta) − mu_s sin(theta) in advance." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-meta-value="D4"><strong>Question difficulty:</strong> <span data-g9-meta-label>High-transfer / exception-sensitive</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04" data-g9-meta-value="reasoning_steps"><strong>Transfer:</strong> <span data-g9-meta-label>Reasoning steps</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A block of mass m is pushed on a rough horizontal floor by a force P directed at an angle theta below the horizontal. The coefficient of static friction is mu_s. Derive the largest P for which the block can remain at rest. Then show that for steep enough push angles no P at all can start the block, and find that angle for mu_s = 0.5.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FRICTION-STATIC-09">A 5 kg block rests on a rough horizontal floor. A 12 N horizontal pull is applied, but…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>0 &lt; theta &lt; 90 degrees.</li><li>The block remains in contact with the floor.</li><li>Do not assume the sign of cos(theta) − mu_s sin(theta) in advance.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-REP-NLM-PUSH-BELOW-HORIZONTAL" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-PUSH-BELOW-HORIZONTAL" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PUSHDOWN-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The push" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 305">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PUSHDOWN-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Push P at angle θ below the horizontal on a rough floor</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="200" y="150" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="245" y="190" text-anchor="middle">m</text>\n    <line x1="126.3" y1="118.4" x2="196" y2="166" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow)"/>\n    <text x="110" y="92">P</text>\n    <line x1="110" y1="118" x2="196" y2="118" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="150" y="112" font-size="14">θ</text>\n    <text x="20" y="292">μ_s; block stays in contact; 0 &lt; θ &lt; 90°</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The push</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Before using any friction limit, how does the downward component of the applied force change the normal reaction?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Static friction is still at most μ_s N and equals it only at impending slip. What changes is that the push also presses the block into the floor, so N grows with P, and the threshold can vanish.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must carry a force that changes both the tangential demand and the normal reaction through the static-friction threshold instead of treating mu_s mg as a fixed limit.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Check the sign of cos(theta) − mu_s sin(theta) before dividing: if positive, P_max exists; if zero or negative, the inequality holds for all P and the block cannot be started, which needs tan(theta) &gt;= 1/mu_s (63.4° for mu_s = 0.5).</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-PUSH-BELOW-HORIZONTAL" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-PUSHDOWN-V0 VIS-NLM-PUSHDOWN-V1 VIS-NLM-PUSHDOWN-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 305" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-title g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-title">A block on a rough floor pushed at an angle below the horizontal</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-desc">Stage 1: A block of mass m on a rough horizontal floor (coefficient μ_s) is pushed by a force P directed at θ below the horizontal; it stays in contact. Stage 2: N = mg + P sin θ and rest needs friction P cos θ, so rest requires P[cos θ − μ_s sin θ] ≤ μ_s m g. Stage 3: If cos θ − μ_s sin θ &gt; 0, P_max = μ_s m g/(cos θ − μ_s sin θ); if it is zero or negative, no P can start the block, which needs tan θ ≥ 1/μ_s: for μ_s = 0.5, tan θ ≥ 2 and θ ≥ 63.4°.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-PUSHDOWN-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Push P at angle θ below the horizontal on a rough floor</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="200" y="150" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="245" y="190" text-anchor="middle">m</text>\n    <line x1="126.3" y1="118.4" x2="196" y2="166" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow)"/>\n    <text x="110" y="92">P</text>\n    <line x1="110" y1="118" x2="196" y2="118" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="150" y="112" font-size="14">θ</text>\n    <text x="20" y="292">μ_s; block stays in contact; 0 &lt; θ &lt; 90°</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PUSHDOWN-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="248" y1="150" x2="248" y2="106" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow)"/>\n    <text x="256" y="120">N = mg + P sin θ</text>\n    <line x1="272" y1="220" x2="272" y2="264" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-ANGLED-THRESHOLD-04-bound-REP-NLM-PUSH-BELOW-HORIZONTAL-1--rep-nlm-pushdown-arrow)"/>\n    <text x="280" y="260">mg</text>\n    <text x="480" y="60" font-weight="600">rest needs friction P cos θ</text>\n    <text x="480" y="82">limit μ_s (mg + P sin θ)</text>\n    <text x="480" y="104">P [cos θ − μ_s sin θ] ≤ μ_s m g</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-PUSHDOWN-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="150" font-weight="600" fill="#1f6fb2">check the sign of cos θ − μ_s sin θ first:</text>\n    <text x="480" y="172" fill="#1f6fb2">&gt; 0: P_max = μ_s m g/(cos θ − μ_s sin θ)</text>\n    <text x="480" y="194" fill="#1f6fb2">≤ 0: no P can start the block,</text>\n    <text x="480" y="216" font-weight="600" fill="#1f6fb2">i.e. tan θ ≥ 1/μ_s</text>\n    <text x="480" y="238" font-weight="600" fill="#1f6fb2">μ_s = 0.5: tan θ ≥ 2, θ ≥ 63.4°</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block and the push at θ below the horizontal.">1: The push</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write N, the friction need and the rest inequality.">2: Need and limit</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Check the sign before dividing.">3: Sign check</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the block on the rough floor with the push directed below the horizontal.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>At rest N = mg + P sin(theta) and the friction needed is P cos(theta), so rest requires P[cos(theta) − mu_s sin(theta)] &lt;= mu_s m g. If cos(theta) &gt; mu_s sin(theta), P_max = mu_s m g/(cos(theta) − mu_s sin(theta)). If tan(theta) &gt;= 1/mu_s, the left side is never positive, so no push can start the block. For mu_s = 0.5 that happens for tan(theta) &gt;= 2, theta &gt;= 63.4°.</p><ol><li>Vertical balance: N = mg + P sin(theta).</li><li>Rest needs friction f = P cos(theta).</li><li>Rest is possible while P cos(theta) &lt;= mu_s(mg + P sin(theta)), i.e. P[cos(theta) − mu_s sin(theta)] &lt;= mu_s mg.</li><li>If the bracket is positive, divide: P_max = mu_s mg/(cos(theta) − mu_s sin(theta)).</li><li>If the bracket is zero or negative (tan(theta) &gt;= 1/mu_s), the inequality holds for every P, so the block never starts; for mu_s = 0.5 that is theta &gt;= 63.4°.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Computes N from the vertical balance including P sin(theta).</li><li>Checks the sign of cos(theta) − mu_s sin(theta) before dividing.</li><li>Identifies tan(theta) &gt;= 1/mu_s (63.4° for mu_s = 0.5) as the range where no P can start the block.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>theta = 0 gives P_max = mu_s mg, the level-push limit. As theta approaches arctan(1/mu_s), P_max grows without bound, which joins the two cases.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-1" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Build the chosen-body free-body diagram and solve the perpendicular dynamics for N before using any friction law: do not assume N = mg; N=mg only in the special level case with no other perpendicular force or acceleration; a downward added component raises N, an upward component lowers it, and if the required contact force would be negative the contact is lost so N=0 and friction=0.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-unit="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Reasoning steps A 2 kg block rests on a 4 kg block on a smooth floor. A horizontal force F acts on the upper block. Between the blocks μ_s = 0.3 and μ_k = 0.2; take g = 10 m/s². Find the largest F for which the blocks move together, and then the acceleration of each block when F = 12 N. The floor under the lower block is smooth. Friction acts only between the blocks. F acts on the upper block only." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05" data-g9-meta-value="reasoning_steps"><strong>Transfer:</strong> <span data-g9-meta-label>Reasoning steps</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 2 kg block rests on a 4 kg block on a smooth floor. A horizontal force F acts on the upper block. Between the blocks μ_s = 0.3 and μ_k = 0.2; take g = 10 m/s². Find the largest F for which the blocks move together, and then the acceleration of each block when F = 12 N.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-FRICTION-KINETIC-10">A 5 kg block is already sliding to the right on a horizontal floor. A constant 18 N…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The floor under the lower block is smooth.</li><li>Friction acts only between the blocks.</li><li>F acts on the upper block only.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-REP-NLM-FORCE-ON-UPPER-BLOCK" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-FORCE-ON-UPPER-BLOCK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TOPF-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The stack" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 280">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TOPF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block on a 4 kg block; F acts on the upper block</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="100" y="160" width="220" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="195" text-anchor="middle">4 kg</text>\n    <rect x="170" y="110" width="80" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="140" text-anchor="middle">2 kg</text>\n    <line x1="252" y1="135" x2="322" y2="135" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow)"/>\n    <text x="328" y="140">F</text>\n    <text x="20" y="60">between blocks: μ_s = 0.3, μ_k = 0.2</text>\n    <text x="20" y="260">smooth floor; g = 10 m/s²; cases: largest F together, and F = 12 N</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The stack</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>If the blocks move together, which block needs friction to keep up, and how large can that friction be?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The whole system still sets the shared acceleration while there is no slip, and the friction one block needs is still tested against μ_s N. What changes is that past the limit each block gets its own equation.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must find the no-slip limit when the force acts on the upper block, then switch to separate accelerations with a kinetic friction pair once that limit is passed.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>At 12 N &gt; 9 N, drop the common acceleration: give each block its own equation, with kinetic friction 4 N backward on the upper block and 4 N forward on the lower block.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-FORCE-ON-UPPER-BLOCK" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TOPF-V0 VIS-NLM-TOPF-V1 VIS-NLM-TOPF-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 280" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-title g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-title">2 kg on 4 kg with F on the upper block: friction must drive the lower one</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-desc">Stage 1: A 2 kg block rests on a 4 kg block on a smooth floor; a horizontal force F acts on the upper block; between the blocks μ_s = 0.3 and μ_k = 0.2; g = 10 m/s². Stage 2: Moving together a = F/6 and the lower block needs friction 4a = 2F/3, at most 0.3 × 20 = 6 N, so F_max = 9 N. Stage 3: At 12 N the blocks slip: kinetic friction 4 N acts backward on the upper block and forward on the lower one, so a_upper = 4 m/s² and a_lower = 1 m/s².</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TOPF-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block on a 4 kg block; F acts on the upper block</text>\n    <line x1="20" y1="220" x2="420" y2="220" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="220" x2="22" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="220" x2="40" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="220" x2="58" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="220" x2="76" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="220" x2="94" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="220" x2="112" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="220" x2="130" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="220" x2="148" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="220" x2="166" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="220" x2="184" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="220" x2="202" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="220" x2="220" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="220" x2="238" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="220" x2="256" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="220" x2="274" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="220" x2="292" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="220" x2="310" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="220" x2="328" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="220" x2="346" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="220" x2="364" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="220" x2="382" y2="228" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="220" x2="400" y2="228" stroke="currentColor" stroke-width="1"/>\n    <rect x="100" y="160" width="220" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="195" text-anchor="middle">4 kg</text>\n    <rect x="170" y="110" width="80" height="50" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="210" y="140" text-anchor="middle">2 kg</text>\n    <line x1="252" y1="135" x2="322" y2="135" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow)"/>\n    <text x="328" y="140">F</text>\n    <text x="20" y="60">between blocks: μ_s = 0.3, μ_k = 0.2</text>\n    <text x="20" y="260">smooth floor; g = 10 m/s²; cases: largest F together, and F = 12 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TOPF-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="210" y1="164" x2="260" y2="164" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-FRICTION-TOP-BLOCK-05-bound-REP-NLM-FORCE-ON-UPPER-BLOCK-1--rep-nlm-topF-arrow-acc)"/>\n    <text x="262" y="184" fill="#1f6fb2">f on 4 kg</text>\n    <text x="480" y="60" font-weight="600">together: a = F/6</text>\n    <text x="480" y="82">lower block needs friction 4a = 2F/3</text>\n    <text x="480" y="104">limit 0.3 × 20 = 6 N</text>\n    <text x="480" y="126" font-weight="600" fill="#1f6fb2">F_max = 9 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TOPF-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="160" font-weight="600" fill="#1f6fb2">F = 12 N &gt; 9 N: the blocks slip</text>\n    <text x="480" y="182" fill="#1f6fb2">kinetic 4 N: back on upper, forward on lower</text>\n    <text x="480" y="204" font-weight="600" fill="#1f6fb2">a_upper = (12 − 4)/2 = 4 m/s²</text>\n    <text x="480" y="226" font-weight="600" fill="#1f6fb2">a_lower = 4/4 = 1 m/s²</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the stack, F on the upper block and the coefficients.">1: The stack</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Find what friction the lower block needs.">2: Moving together</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Give each block its own equation once they slip.">3: F = 12 N</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 2 kg block on the 4 kg block with the force F applied to the upper block.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Moving together, a = F/6 and the lower block needs friction 4a = 2F/3, which may not exceed 0.3 × 20 = 6 N, so F_max = 9 N. At F = 12 N the blocks slip: kinetic friction 0.2 × 20 = 4 N acts backward on the upper block and forward on the lower one, so a_upper = (12 − 4)/2 = 4 m/s² and a_lower = 4/4 = 1 m/s².</p><ol><li>No slip: a = F/(2 + 4). The lower block&#x27;s only horizontal force is friction, so it needs f = 4a = 2F/3.</li><li>Limit: 2F/3 ≤ μ_s × 2 × 10 = 6 N, so F ≤ 9 N.</li><li>At 12 N the common acceleration would need 8 N of friction, more than 6 N, so the blocks slip and have separate accelerations.</li><li>Kinetic friction 4 N: upper block 12 − 4 = 2a_u, a_u = 4 m/s²; lower block 4 = 4a_l, a_l = 1 m/s².</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Finds F_max = 9 N from the friction the lower block needs.</li><li>Drops the common acceleration above 9 N and writes one equation per block with μ_k N.</li><li>Gets 4 m/s² and 1 m/s² and checks that the relative slip matches the friction directions.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>a_u &gt; a_l, so the upper block does slide forward over the lower one, which matches the friction directions used. Total: 12 N = 2 × 4 + 4 × 1.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Assume no relative sliding provisionally, choose a body or a whole connected system deliberately, and solve the tangential Newton-II equation for the friction demand at each rough contact.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-unit="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Connected bodies and a justified common acceleration Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice Blocks A (2 kg) and B (3 kg) touch on a smooth floor, A behind B. A 10 N force pushes A forward, into B, and at the same time a force F pulls B forward. For F = 10 N and for F = 30 N, decide whether the blocks stay in contact, and find the accelerations. The floor is smooth. The blocks are not glued: the contact can push but not pull. Forward is positive." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="Connected bodies and a justified common acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Connected bodies and a justified common acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-CONTACT-LOSS-06" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>Blocks A (2 kg) and B (3 kg) touch on a smooth floor, A behind B. A 10 N force pushes A forward, into B, and at the same time a force F pulls B forward. For F = 10 N and for F = 30 N, decide whether the blocks stay in contact, and find the accelerations.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-CONNECTED-CONSTRAINT-11">Blocks A and B are side by side on a smooth horizontal floor, with A to the left of B…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The floor is smooth.</li><li>The blocks are not glued: the contact can push but not pull.</li><li>Forward is positive.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONTACT-LOSS-06-REP-NLM-CONTACT-LOSS-10-30" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-CONTACT-LOSS-10-30" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CONTACTLOSS-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The blocks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 280">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CONTACTLOSS-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A (2 kg) behind B (3 kg): 10 N pushes A, F pulls B</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="140" y="140" width="70" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="175" y="175" text-anchor="middle">A 2 kg</text>\n    <rect x="210" y="130" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="255" y="170" text-anchor="middle">B 3 kg</text>\n    <line x1="60" y1="170" x2="136" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow)"/>\n    <text x="60" y="160">10 N</text>\n    <line x1="302" y1="165" x2="372" y2="165" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow)"/>\n    <text x="378" y="170">F</text>\n    <text x="20" y="240">smooth floor; not glued: contact pushes, never pulls</text>\n    <text x="20" y="262">forward positive; cases: F = 10 N and F = 30 N</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The blocks</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>What can a contact between two unglued blocks do, and what can it never do?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>A common acceleration still needs an active constraint, and a contact force still can only push. What changes is that whether the constraint holds must be computed, not read off.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must decide whether the common-acceleration model holds by computing the contact force it would need, instead of being told whether contact is kept.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Keep the contact model only where N ≥ 0: accept it for F = 10 N, reject it for F = 30 N, where it would need B to pull A.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-CONTACT-LOSS-10-30" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-CONTACTLOSS-V0 VIS-NLM-CONTACTLOSS-V1 VIS-NLM-CONTACTLOSS-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 280" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-title g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-title">Blocks A (2 kg) and B (3 kg) in contact, A pushed with 10 N while B is pulled with F</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-desc">Stage 1: Blocks A (2 kg) and B (3 kg) touch on a smooth floor, A behind B; a 10 N force pushes A forward into B while a force F pulls B forward; the blocks are not glued; cases F = 10 N and F = 30 N. Stage 2: Assuming contact, a = (10 + F)/5 and A alone gives 10 − N = 2a, where N is B\'s backward push on A and must be at least zero. Stage 3: For F = 10 N, a = 4 m/s² and N = 2 N ≥ 0, so both move at 4 m/s²; for F = 30 N, N would be −6 N, a pull, so they separate with a_A = 5 m/s² and a_B = 10 m/s².</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-CONTACTLOSS-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A (2 kg) behind B (3 kg): 10 N pushes A, F pulls B</text>\n    <line x1="20" y1="200" x2="420" y2="200" stroke="currentColor" stroke-width="2"/>\n    <line x1="30" y1="200" x2="22" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="48" y1="200" x2="40" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="66" y1="200" x2="58" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="84" y1="200" x2="76" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="102" y1="200" x2="94" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="120" y1="200" x2="112" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="138" y1="200" x2="130" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="156" y1="200" x2="148" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="174" y1="200" x2="166" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="192" y1="200" x2="184" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="210" y1="200" x2="202" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="228" y1="200" x2="220" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="246" y1="200" x2="238" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="264" y1="200" x2="256" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="282" y1="200" x2="274" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="300" y1="200" x2="292" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="318" y1="200" x2="310" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="336" y1="200" x2="328" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="354" y1="200" x2="346" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="372" y1="200" x2="364" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="390" y1="200" x2="382" y2="208" stroke="currentColor" stroke-width="1"/>\n    <line x1="408" y1="200" x2="400" y2="208" stroke="currentColor" stroke-width="1"/>\n    <rect x="140" y="140" width="70" height="60" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="175" y="175" text-anchor="middle">A 2 kg</text>\n    <rect x="210" y="130" width="90" height="70" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="255" y="170" text-anchor="middle">B 3 kg</text>\n    <line x1="60" y1="170" x2="136" y2="170" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow)"/>\n    <text x="60" y="160">10 N</text>\n    <line x1="302" y1="165" x2="372" y2="165" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONTACT-LOSS-06-bound-REP-NLM-CONTACT-LOSS-10-30-1--rep-nlm-contactloss-arrow)"/>\n    <text x="378" y="170">F</text>\n    <text x="20" y="240">smooth floor; not glued: contact pushes, never pulls</text>\n    <text x="20" y="262">forward positive; cases: F = 10 N and F = 30 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CONTACTLOSS-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="60" font-weight="600">assume contact: a = (10 + F)/5</text>\n    <text x="480" y="82">A alone: 10 − N = 2a</text>\n    <text x="480" y="104">N = B\'s push on A, backward; needs N ≥ 0</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-CONTACTLOSS-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="140" fill="#1f6fb2">F = 10 N: a = 4, N = 10 − 8 = 2 N ≥ 0</text>\n    <text x="480" y="162" font-weight="600" fill="#1f6fb2">→ together at 4 m/s²</text>\n    <text x="480" y="184" fill="#1f6fb2">F = 30 N: a = 8, N = 10 − 16 = −6 N</text>\n    <text x="480" y="206" font-weight="600" fill="#1f6fb2">→ a pull, impossible: they separate</text>\n    <text x="480" y="228" fill="#1f6fb2">a_A = 5 m/s², a_B = 10 m/s²</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show A behind B, the 10 N push and the pull F.">1: The blocks</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write the common acceleration and A&#x27;s equation with the contact force.">2: Assume contact</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Keep contact only where N ≥ 0.">3: Test N</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show blocks A and B in contact on the smooth floor, A pushed forward with 10 N while B is pulled forward with F.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>F = 10 N: assuming contact, a = 20/5 = 4 m/s² and A needs N = 10 − 2 × 4 = 2 N from B, which is possible, so both move at 4 m/s². F = 30 N: assuming contact, a = 8 m/s² and N = 10 − 16 = −6 N, a pull that a contact cannot give, so they separate: a_A = 10/2 = 5 m/s² and a_B = 30/3 = 10 m/s².</p><ol><li>Assume contact: a = (10 + F)/5. Isolate A: 10 − N = 2a, so N = 10 − 2a.</li><li>F = 10 N: a = 4 m/s², N = 2 N ≥ 0, so contact holds.</li><li>F = 30 N: a = 8 m/s², N = −6 N &lt; 0, so the assumption fails.</li><li>Separate: a_A = 10/2 = 5 m/s², a_B = 30/3 = 10 m/s².</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Assumes contact provisionally and solves for the contact force from A&#x27;s equation.</li><li>Rejects contact when N comes out negative, because a contact can only push.</li><li>Gives separate accelerations, 5 m/s² and 10 m/s², and checks that B runs ahead.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>With F = 30 N, B (10 m/s²) runs ahead of A (5 m/s²), so they do move apart, as the negative N predicted. The switch-over is N = 0, at a = 5 m/s², F = 15 N.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM9-1" data-g9-concept-ref="MIC-PHY-NLM-CONNECTED-COMMON-ACCEL" data-g9-repair-target="CU-PHY-NLM-CONNECTED-COMMON-ACCEL-1" href="#g9-CORE1A--CU-PHY-NLM-CONNECTED-COMMON-ACCEL-1">Revisit: Identify the connection/contact condition and state exactly which relative separation is fixed.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-unit="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion One fixed-pulley string gives one length constraint Hard concept Multi-step reasoning Newton-law and observer-frame practice Constructed response Authored practice Model choice Masses A (3 kg) and B (1 kg) hang from one light inextensible string that does not slip on a fixed pulley with appreciable rotational inertia; no rotational law is supplied. y_A and y_B are measured downward from the pulley, and g = 10 m/s². A is measured to accelerate downward at 4 m/s². Decide which of a_A + a_B = 0 and T_A = T_B can still be used, find a_B, and find the tension in each segment. Coordinates y_A and y_B are measured positive away from the fixed pulley along the two straight string segments. The string remains taut and inextensible and does not slip. Do not invent a torque or rotational-inertia equation." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="One fixed-pulley string gives one length constraint"><strong>Concept:</strong> <span data-g9-meta-label>One fixed-pulley string gives one length constraint</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-PRACTICE" data-g9-meta-value="Newton-law and observer-frame practice"><strong>Family:</strong> <span data-g9-meta-label>Newton-law and observer-frame practice</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>Masses A (3 kg) and B (1 kg) hang from one light inextensible string that does not slip on a fixed pulley with appreciable rotational inertia; no rotational law is supplied. y_A and y_B are measured downward from the pulley, and g = 10 m/s². A is measured to accelerate downward at 4 m/s². Decide which of a_A + a_B = 0 and T_A = T_B can still be used, find a_B, and find the tension in each segment.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-2A-ATWOOD-12">Masses m_A and m_B, with m_B &gt; m_A, hang from the two ends of one taut massless…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Coordinates y_A and y_B are measured positive away from the fixed pulley along the two straight string segments.</li><li>The string remains taut and inextensible and does not slip.</li><li>Do not invent a torque or rotational-inertia equation.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-REP-NLM-HEAVY-PULLEY-3KG-1KG" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-HEAVY-PULLEY-3KG-1KG" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HEAVYPULLEY-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The set-up" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 330">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HEAVYPULLEY-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A (3 kg) and B (1 kg) over a heavy pulley</text>\n    <line x1="120" y1="40" x2="250" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="40" x2="122" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="148" y1="40" x2="140" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="166" y1="40" x2="158" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="184" y1="40" x2="176" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="202" y1="40" x2="194" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="220" y1="40" x2="212" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="238" y1="40" x2="230" y2="32" stroke="currentColor" stroke-width="1"/>\n    <circle cx="185" cy="80" r="28" fill="none" stroke="currentColor" stroke-width="4"/>\n    <circle cx="185" cy="80" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="185" y1="40" x2="185" y2="80" stroke="currentColor" stroke-width="2"/>\n    <text x="222" y="60" font-size="14">pulley with rotational inertia</text>\n    <line x1="157" y1="80" x2="157" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="213" y1="80" x2="213" y2="170" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="127" y="220" width="60" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="157" y="247" text-anchor="middle">A 3 kg</text>\n    <rect x="188" y="170" width="50" height="36" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="213" y="193" text-anchor="middle">B 1 kg</text>\n    <line x1="110" y1="222" x2="110" y2="262" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow)"/>\n    <text x="20" y="290" text-anchor="start">a_A = 4 m/s² down (measured)</text>\n    <text x="20" y="314">string light, inextensible, not slipping; y down from pulley; g = 10 m/s²</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The set-up</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which of the two relations comes from the string&#x27;s length, and which from the pulley being ideal?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The fixed string length still gives a_A + a_B = 0 in away-from-pulley coordinates; what changes is that the pulley is no longer ideal, so equal tension is no longer licensed.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must keep the kinematic length constraint, refuse equal tension after the pulley stops being ideal, and compute the two tensions separately from measured motion.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Do not write one T: with a heavy pulley the two tensions may differ, so give each segment its own tension and find each from its own body.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-HEAVY-PULLEY-3KG-1KG" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HEAVYPULLEY-V0 VIS-NLM-HEAVYPULLEY-V1 VIS-NLM-HEAVYPULLEY-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 330" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-title g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-title">3 kg and 1 kg masses on a string over a heavy pulley</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-desc">Stage 1: Masses A (3 kg) and B (1 kg) hang from one light inextensible string that does not slip on a fixed pulley with appreciable rotational inertia; A is measured to accelerate downward at 4 m/s²; g = 10 m/s². Stage 2: The fixed string length still gives a_A + a_B = 0, so a_B = −4 m/s²; equal tension is not guaranteed because the heavy pulley needs a net torque. Stage 3: From A: 30 − T_A = 3 × 4, so T_A = 18 N; from B: T_B − 10 = 1 × 4, so T_B = 14 N; an ideal pulley would have given 5 m/s² and 15 N.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HEAVYPULLEY-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A (3 kg) and B (1 kg) over a heavy pulley</text>\n    <line x1="120" y1="40" x2="250" y2="40" stroke="currentColor" stroke-width="2"/>\n    <line x1="130" y1="40" x2="122" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="148" y1="40" x2="140" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="166" y1="40" x2="158" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="184" y1="40" x2="176" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="202" y1="40" x2="194" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="220" y1="40" x2="212" y2="32" stroke="currentColor" stroke-width="1"/>\n    <line x1="238" y1="40" x2="230" y2="32" stroke="currentColor" stroke-width="1"/>\n    <circle cx="185" cy="80" r="28" fill="none" stroke="currentColor" stroke-width="4"/>\n    <circle cx="185" cy="80" r="3" fill="currentColor" stroke="currentColor" stroke-width="1"/>\n    <line x1="185" y1="40" x2="185" y2="80" stroke="currentColor" stroke-width="2"/>\n    <text x="222" y="60" font-size="14">pulley with rotational inertia</text>\n    <line x1="157" y1="80" x2="157" y2="220" stroke="currentColor" stroke-width="1.8"/>\n    <line x1="213" y1="80" x2="213" y2="170" stroke="currentColor" stroke-width="1.8"/>\n    <rect x="127" y="220" width="60" height="44" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="157" y="247" text-anchor="middle">A 3 kg</text>\n    <rect x="188" y="170" width="50" height="36" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="213" y="193" text-anchor="middle">B 1 kg</text>\n    <line x1="110" y1="222" x2="110" y2="262" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow)"/>\n    <text x="20" y="290" text-anchor="start">a_A = 4 m/s² down (measured)</text>\n    <text x="20" y="314">string light, inextensible, not slipping; y down from pulley; g = 10 m/s²</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HEAVYPULLEY-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="480" y="60" font-weight="600">fixed length still holds:</text>\n    <text x="480" y="82">a_A + a_B = 0 → a_B = −4 m/s² (up)</text>\n    <text x="480" y="104" font-weight="600">equal tension no longer guaranteed:</text>\n    <text x="480" y="126">the heavy pulley needs a net torque</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HEAVYPULLEY-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="150" y1="218" x2="150" y2="178" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow-acc)"/>\n    <text x="142" y="196" text-anchor="end" fill="#1f6fb2">T_A</text>\n    <line x1="226" y1="168" x2="226" y2="128" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-2B-CONSTRAINT-VS-TENSION-07-bound-REP-NLM-HEAVY-PULLEY-3KG-1KG-1--rep-nlm-heavypulley-arrow-acc)"/>\n    <text x="234" y="146" fill="#1f6fb2">T_B</text>\n    <text x="480" y="160" font-weight="600" fill="#1f6fb2">A: 30 − T_A = 3 × 4 → T_A = 18 N</text>\n    <text x="480" y="182" font-weight="600" fill="#1f6fb2">B: T_B − 10 = 1 × 4 → T_B = 14 N</text>\n    <text x="480" y="204">(an ideal pulley would give 5 m/s², 15 N)</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show A and B over the heavy pulley with A&#x27;s measured acceleration.">1: The set-up</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Keep the length relation, drop equal tension.">2: Which relation survives</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Find each tension from its own body.">3: Each segment&#x27;s tension</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 3 kg and 1 kg masses on one string over a fixed pulley with appreciable rotational inertia.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>a_A+a_B=0 still holds, from the fixed string length, so a_B = −4 m/s² (4 m/s² upward). T_A=T_B is no longer guaranteed with a heavy pulley, so each segment gets its own tension from its own mass: T_A = 3(10 − 4) = 18 N and T_B = 1(10 + 4) = 14 N. An ideal pulley would have given a = 5 m/s² and T = 15 N on both sides.</p><ol><li>The string&#x27;s length is fixed, so y_A + y_B = constant and a_B = −a_A = −4 m/s².</li><li>Equal tension relied on an ideal (massless, frictionless) pulley; a pulley with rotational inertia removes that licence.</li><li>A: 30 − T_A = 3 × 4, so T_A = 18 N. B: T_B − 10 = 1 × 4, so T_B = 14 N.</li><li>The 4 N difference is what turns the heavy pulley; the ideal-pulley result (5 m/s², 15 N) does not apply.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Keeps a_A + a_B = 0 from the fixed length and gives a_B = −4 m/s².</li><li>Refuses one T and gives each segment its own tension.</li><li>Computes T_A = 18 N and T_B = 14 N from each body&#x27;s equation.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Each body&#x27;s equation uses only its own tension, so the two values are independent. If the pulley were ideal, T_A = T_B would force a = 5 m/s², not the measured 4 m/s².</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM11-5" data-g9-concept-ref="MIC-PHY-NLM-SINGLE-STRING-CONSTRAINT" data-g9-repair-target="CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-2" href="#g9-CORE1A--CU-PHY-NLM-SINGLE-STRING-CONSTRAINT-2">Revisit: Keep the kinematic string-length claim separate from the force-transmission claim: derive the acceleration relation from inextensibility and fixed geometry, and use equal tension only when the independent ideal-string/redirection assumptions license it.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-unit="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Net force, not any one force, sets acceleration Medium concept Multi-step reasoning Inclined-plane force modelling Constructed response Authored practice Representation translation A 2 kg block slides down a smooth fixed 30° incline that slopes down to the right. Take g = 10 m/s². Student A uses axes along and perpendicular to the plane; Student B uses horizontal and vertical axes. Carry out Student B&#x27;s solution: write the horizontal and vertical Newton-II equations, state in these axes the condition that keeps the block on the plane, and find N and the acceleration components. Show that the result agrees with Student A&#x27;s a = g sin 30°. The plane is smooth and fixed. +x is horizontal to the right, +y vertically up. The block stays on the plane." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="Net force, not any one force, sets acceleration"><strong>Concept:</strong> <span data-g9-meta-label>Net force, not any one force, sets acceleration</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-AXES-01" data-g9-meta-value="representation_translation"><strong>Transfer:</strong> <span data-g9-meta-label>Representation translation</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 2 kg block slides down a smooth fixed 30° incline that slopes down to the right. Take g = 10 m/s². Student A uses axes along and perpendicular to the plane; Student B uses horizontal and vertical axes. Carry out Student B&#x27;s solution: write the horizontal and vertical Newton-II equations, state in these axes the condition that keeps the block on the plane, and find N and the acceleration components. Show that the result agrees with Student A&#x27;s a = g sin 30°.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-INCLINE-2A-SMOOTH-01">A block of mass m is released from rest on a smooth fixed plane inclined at angle…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The plane is smooth and fixed.</li><li>+x is horizontal to the right, +y vertically up.</li><li>The block stays on the plane.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-AXES-01-REP-NLM-INCLINE-LAB-AXES" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-LAB-AXES" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-LABAXES-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The block and axes" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-LABAXES-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block slides down a smooth 30° incline (down to the right)</text>\n    <polygon points="40,260 370,260 40,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="326" y="252" text-anchor="middle" font-size="14">30°</text>\n    <path d="M340 260 A30 30 0 0 1 344 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(30 231.3 160.3)"><rect x="203.3 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="231.3" y="165.3" text-anchor="middle" font-size="14">2 kg</text>\n    <line x1="420" y1="250" x2="480" y2="250" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="486" y="255">+x</text>\n    <line x1="420" y1="250" x2="420" y2="190" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="428" y="196">+y</text>\n    <text x="20" y="300">g = 10 m/s²; Student B uses horizontal x and vertical y</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The block and axes</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>In horizontal and vertical axes, is either component of the block&#x27;s acceleration zero?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The forces, weight and normal reaction, and the block&#x27;s physical acceleration down the slope stay the same; only the axes used to describe them change.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must translate the same fixed-incline dynamics between contact-aligned and laboratory axes without treating one representation as different physics.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Express &#x27;stays on the plane&#x27; in lab axes as a_y/a_x = −tan 30°, because a_perp = 0 is no longer a single component here.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-LAB-AXES" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-LABAXES-V0 VIS-NLM-LABAXES-V1 VIS-NLM-LABAXES-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-title g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-title">2 kg block on a smooth 30° incline in horizontal and vertical axes</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-desc">Stage 1: A 2 kg block slides down a smooth fixed 30° incline that slopes down to the right; +x is horizontal to the right and +y vertically up; g = 10 m/s². Stage 2: N sin 30° = m a_x and N cos 30° − mg = m a_y, and staying on the plane requires a_y = −a_x tan 30°. Stage 3: N = mg cos 30° ≈ 17.3 N, a_x ≈ 4.33 m/s² and a_y = −2.5 m/s², so |a| = 5 m/s² = g sin 30° down the slope, as with plane axes, where the contact condition is simply a_perp = 0.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-LABAXES-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block slides down a smooth 30° incline (down to the right)</text>\n    <polygon points="40,260 370,260 40,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="326" y="252" text-anchor="middle" font-size="14">30°</text>\n    <path d="M340 260 A30 30 0 0 1 344 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(30 231.3 160.3)"><rect x="203.3 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="231.3" y="165.3" text-anchor="middle" font-size="14">2 kg</text>\n    <line x1="420" y1="250" x2="480" y2="250" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="486" y="255">+x</text>\n    <line x1="420" y1="250" x2="420" y2="190" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="428" y="196">+y</text>\n    <text x="20" y="300">g = 10 m/s²; Student B uses horizontal x and vertical y</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-LABAXES-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="231.3" y1="160.3" x2="231.3" y2="220.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="239.3" y="230.3">mg = 20 N</text>\n    <line x1="240.3" y1="144.7" x2="268.3" y2="96.2" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-AXES-01-bound-REP-NLM-INCLINE-LAB-AXES-1--rep-nlm-labaxes-arrow)"/>\n    <text x="276.3" y="90.2" text-anchor="start">N</text>\n    <text x="520" y="60" font-weight="600">lab axes:</text>\n    <text x="520" y="82">x: N sin 30° = m a_x</text>\n    <text x="520" y="104">y: N cos 30° − mg = m a_y</text>\n    <text x="520" y="126" font-weight="600" fill="#1f6fb2">stays on plane: a_y = −a_x tan 30°</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-LABAXES-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="520" y="170" font-weight="600" fill="#1f6fb2">N = mg cos 30° ≈ 17.3 N</text>\n    <text x="520" y="192" fill="#1f6fb2">a_x ≈ 4.33 m/s², a_y = −2.5 m/s²</text>\n    <text x="520" y="214" font-weight="600" fill="#1f6fb2">|a| = 5 m/s² = g sin 30°, down the slope</text>\n    <text x="520" y="236">plane axes are simpler: a_perp = 0</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block on the incline and Student B&#x27;s lab axes.">1: The block and axes</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write both equations and the stay-on-plane condition in lab axes.">2: Lab-axis equations</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Solve and compare with the plane-axis result.">3: Results</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 2 kg block on the smooth 30° incline with horizontal and vertical lab axes.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Student B: N sin 30° = m a_x and N cos 30° − mg = m a_y, and staying on the plane requires the acceleration to point down the slope: a_y = −a_x tan 30°. This gives N = mg cos 30° ≈ 17.3 N, a_x ≈ 4.33 m/s² and a_y = −2.5 m/s². The magnitude is √(4.33² + 2.5²) = 5 m/s² = g sin 30°, down the slope, as Student A finds. Both axis choices are valid; A&#x27;s are simpler because there the contact condition is just a_perp = 0.</p><ol><li>The plane&#x27;s normal points up and to the right, so N has components N sin 30° (right) and N cos 30° (up); the weight is 20 N down.</li><li>Neither lab component of the acceleration is zero; staying on the plane means the acceleration points along the slope, so a_y = −a_x tan 30°.</li><li>Substitute a_x = N sin 30°/m into N cos 30° − mg = −m a_x tan 30°: N(cos 30° + sin² 30°/cos 30°) = mg, so N = mg cos 30° ≈ 17.3 N.</li><li>a_x = 17.3 × 0.5/2 ≈ 4.33 m/s² and a_y = −4.33 × tan 30° = −2.5 m/s².</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Resolves N and mg into horizontal and vertical components.</li><li>Writes the contact condition as a_y = −a_x tan 30° instead of setting a lab component to zero.</li><li>Finds N ≈ 17.3 N and |a| = 5 m/s², matching the plane-axis solution.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>√(4.33² + 2.5²) = 5 m/s² = 10 × sin 30°, and N matches Student A&#x27;s mg cos 30°: the physics does not depend on the axes.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM6-4" data-g9-concept-ref="MIC-PHY-NLM-SECOND-LAW" data-g9-repair-target="CU-PHY-NLM-SECOND-LAW-1" href="#g9-CORE1A--CU-PHY-NLM-SECOND-LAW-1">Revisit: Choose axes that make the active constraint easy to express; for a fixed inclined contact, use parallel/perpendicular axes when helpful, resolve the physical forces into those axes, and write separate signed Newton-II equations.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-unit="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Friction opposes relative sliding at a contact Medium concept Multi-step reasoning Inclined-plane force modelling Constructed response Authored practice Model choice A 4 kg block rests on a rough fixed 30° incline with μ_s = 0.5; take g = 10 m/s². A force P acts on it up the slope, parallel to the plane. In three trials P = 15 N, 20 N and 26 N, and the block stays at rest each time. In each trial find the direction and size of the static friction, without assuming it points uphill, and check that it is within the static limit. The plane is fixed. The block remains at rest in all three trials. P acts exactly parallel to the plane." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="Friction opposes relative sliding at a contact"><strong>Concept:</strong> <span data-g9-meta-label>Friction opposes relative sliding at a contact</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION" data-g9-meta-value="MEDIUM"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Medium concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02" data-g9-meta-value="model_choice"><strong>Transfer:</strong> <span data-g9-meta-label>Model choice</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 4 kg block rests on a rough fixed 30° incline with μ_s = 0.5; take g = 10 m/s². A force P acts on it up the slope, parallel to the plane. In three trials P = 15 N, 20 N and 26 N, and the block stays at rest each time. In each trial find the direction and size of the static friction, without assuming it points uphill, and check that it is within the static limit.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-INCLINE-2A-STATIC-02">A block rests on a rough fixed plane inclined at angle theta. The coefficient of…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The plane is fixed.</li><li>The block remains at rest in all three trials.</li><li>P acts exactly parallel to the plane.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-REP-NLM-INCLINE-P-THREE-TRIALS" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-P-THREE-TRIALS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-P3-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The block and P" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-P3-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 4 kg block at rest on a rough 30° incline, pushed up the slope</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">30°</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 178.7 160.3)"><rect x="150.7 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="178.7" y="165.3" text-anchor="middle" font-size="14">4 kg</text>\n    <line x1="206.4" y1="144.3" x2="258.4" y2="114.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow)"/>\n    <text x="266.4" y="108.3" text-anchor="start">P</text>\n    <text x="20" y="300">μ_s = 0.5, g = 10 m/s²; trials P = 15 N, 20 N, 26 N; always at rest</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The block and P</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Temporarily remove friction from the model. Which way would the block tend to move in each trial?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>Friction still opposes the slip tendency the block would have without it; what changes is that a push along the slope can cancel that tendency or reverse it.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must choose the static-friction direction from the changed slip tendency, including a zero-friction boundary, instead of carrying over the familiar downhill-gravity case.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Point friction against the tendency in each trial: up when P &lt; 20 N, none at 20 N, down when P &gt; 20 N.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-P-THREE-TRIALS" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-P3-V0 VIS-NLM-P3-V1 VIS-NLM-P3-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-title g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-title">A 4 kg block on a rough 30° incline with a push P up the slope, in three trials</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-desc">Stage 1: A 4 kg block rests on a rough fixed 30° incline with μ_s = 0.5; a force P acts up the slope parallel to the plane, in trials of 15 N, 20 N and 26 N, and the block stays at rest; g = 10 m/s². Stage 2: With up the slope positive, P − 20 + f = 0, so f = 20 − P, and its sign gives its direction; the limit is 0.5 × 34.6 ≈ 17.3 N. Stage 3: At 15 N friction is 5 N up the slope, at 20 N it is zero, and at 26 N it is 6 N down the slope; all are within 17.3 N.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-P3-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 4 kg block at rest on a rough 30° incline, pushed up the slope</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">30°</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 178.7 160.3)"><rect x="150.7 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="178.7" y="165.3" text-anchor="middle" font-size="14">4 kg</text>\n    <line x1="206.4" y1="144.3" x2="258.4" y2="114.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-FRICTION-DIRECTION-02-bound-REP-NLM-INCLINE-P-THREE-TRIALS-1--rep-nlm-p3trials-arrow)"/>\n    <text x="266.4" y="108.3" text-anchor="start">P</text>\n    <text x="20" y="300">μ_s = 0.5, g = 10 m/s²; trials P = 15 N, 20 N, 26 N; always at rest</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-P3-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="60" font-weight="600">along the slope, up +:</text>\n    <text x="470" y="82">P − mg sin 30° + f = 0, mg sin 30° = 20 N</text>\n    <text x="470" y="104">so f = 20 − P (sign gives direction)</text>\n    <text x="470" y="126">limit μ_s N = 0.5 × 34.6 ≈ 17.3 N</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-P3-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="160" font-weight="600" fill="#1f6fb2">P = 15 N: f = 5 N up the slope</text>\n    <text x="470" y="182" font-weight="600" fill="#1f6fb2">P = 20 N: f = 0</text>\n    <text x="470" y="204" font-weight="600" fill="#1f6fb2">P = 26 N: f = 6 N down the slope</text>\n    <text x="470" y="226">all within 17.3 N: rest is possible</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block and the force up the slope.">1: The block and P</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write friction as a signed unknown along the slope.">2: Signed friction</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Evaluate f in each trial and check the limit.">3: Each trial</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the 4 kg block on the rough 30° incline with the push P up the slope in each of the three trials.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>When P&lt;mg sin(theta) static friction acts up the slope, when P&gt;mg sin(theta) it acts down the slope, and at P = mg sin(theta) the required static friction is zero. Here mg sin 30° = 20 N: at P = 15 N friction is 5 N up the slope, at 20 N it is zero, and at 26 N it is 6 N down the slope. The limit is 0.5 × 34.6 ≈ 17.3 N, so all three are possible at rest.</p><ol><li>Along the slope, without friction the net push is P − 20 N (up the slope positive).</li><li>P = 15 N: the block would slide down, so friction points up with 5 N.</li><li>P = 20 N: no tendency, so friction is zero.</li><li>P = 26 N: the block would slide up, so friction points down with 6 N.</li><li>N = mg cos 30° ≈ 34.6 N, so μ_s N ≈ 17.3 N, above all three needs.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Finds each trial&#x27;s slip tendency from P against mg sin 30°.</li><li>Gives 5 N up, zero and 6 N down.</li><li>Checks each against μ_s mg cos 30° ≈ 17.3 N.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>The signed friction up the slope is 20 − P: +5, 0, −6 N. It changes sign exactly at P = mg sin 30°.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM5-2" data-g9-concept-ref="MIC-PHY-NLM-FRICTION" data-g9-repair-target="CU-PHY-NLM-FRICTION-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-1">Revisit: Imagine the relative sliding, or tendency to slide, at that named contact if tangential friction were absent; point friction on the chosen body opposite that relative tendency.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-unit="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Inclined-plane force modelling Derivation Authored practice Reasoning steps A block of mass m is held at rest on a rough fixed plane that rises to the right at angle theta. A horizontal force P pushes to the right. The coefficient of static friction is mu_s. Derive the condition on P and theta for the block to be able to remain at rest. 0 &lt; theta &lt; 90 degrees. The applied force is horizontal. Do not assume the static-friction direction in advance; use a signed required value." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03" data-g9-meta-value="reasoning_steps"><strong>Transfer:</strong> <span data-g9-meta-label>Reasoning steps</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A block of mass m is held at rest on a rough fixed plane that rises to the right at angle theta. A horizontal force P pushes to the right. The coefficient of static friction is mu_s. Derive the condition on P and theta for the block to be able to remain at rest.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-INCLINE-2A-HORIZONTAL-PUSH-04">A block of mass m is on a smooth fixed plane that rises to the right at angle theta…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>0 &lt; theta &lt; 90 degrees.</li><li>The applied force is horizontal.</li><li>Do not assume the static-friction direction in advance; use a signed required value.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-HORIZONTAL-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HTHRESH-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The push" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HTHRESH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Block held at rest on a rough incline by a horizontal push P</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 178.7 160.3)"><rect x="150.7 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="276.5" y="169.6" text-anchor="middle" font-size="14">rough: μ_s</text>\n    <line x1="68.7" y1="160.3" x2="148.7" y2="160.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow)"/>\n    <text x="68.7" y="152.3">P</text>\n    <text x="20" y="300">plane rises to the right; friction direction not assumed</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The push</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which part of the horizontal force changes the contact normal, and which part changes the tangential force demand?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The normal force from the perpendicular balance, the friction that rest requires, and the test against μ_s N all carry over; what changes is that a horizontal push alters both N and the required friction at once.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must integrate force decomposition, altered normal reaction, signed friction demand and static feasibility in dependency order rather than copying N=mg cos(theta) or f=mu_s N.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Use the sign of f_required to determine the required friction direction and test its magnitude against mu_s N.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-HORIZONTAL-THRESHOLD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-HTHRESH-V0 VIS-NLM-HTHRESH-V1 VIS-NLM-HTHRESH-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-title g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-title">Horizontal push on a rough incline: signed friction need against μ_s N</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-desc">Stage 1: A block of mass m is held at rest on a rough fixed plane that rises to the right at θ, with μ_s; a horizontal force P pushes to the right. Stage 2: With uphill positive, N = mg cos θ + P sin θ and f_required = mg sin θ − P cos θ. Stage 3: The sign of f_required gives friction\'s direction, and rest is possible exactly when |mg sin θ − P cos θ| ≤ μ_s (mg cos θ + P sin θ).</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-HTHRESH-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Block held at rest on a rough incline by a horizontal push P</text>\n    <polygon points="40,260 370,260 370,69.5" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="84" y="252" text-anchor="middle" font-size="14">θ</text>\n    <path d="M70 260 A30 30 0 0 0 66 245" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 178.7 160.3)"><rect x="150.7 " y="143.3" width="56" height="34" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="276.5" y="169.6" text-anchor="middle" font-size="14">rough: μ_s</text>\n    <line x1="68.7" y1="160.3" x2="148.7" y2="160.3" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-HORIZONTAL-THRESHOLD-03-bound-REP-NLM-INCLINE-HORIZONTAL-THRESHOLD-1--rep-nlm-hthresh-arrow)"/>\n    <text x="68.7" y="152.3">P</text>\n    <text x="20" y="300">plane rises to the right; friction direction not assumed</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HTHRESH-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="460" y="60" font-weight="600">uphill positive:</text>\n    <text x="460" y="82">N = mg cos θ + P sin θ</text>\n    <text x="460" y="104">f_required = mg sin θ − P cos θ</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-HTHRESH-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="460" y="140" font-weight="600" fill="#1f6fb2">sign of f_required gives the direction:</text>\n    <text x="460" y="162" fill="#1f6fb2">&gt; 0 up the slope, &lt; 0 down the slope</text>\n    <text x="460" y="184" fill="#1f6fb2">rest possible exactly when</text>\n    <text x="460" y="206" font-weight="600" fill="#1f6fb2">|mg sin θ − P cos θ| ≤ μ_s (mg cos θ + P sin θ)</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block, the rough incline and the horizontal P.">1: The push</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write N and the signed friction rest requires.">2: N and need</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Use the sign for direction and test the size against μ_s N.">3: Condition</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the block on the rough incline with the horizontal push acting on it.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>With uphill positive, N=mg cos(theta)+P sin(theta). The static friction required by rest is f_required=mg sin(theta)-P cos(theta). Static equilibrium is feasible exactly when |mg sin(theta)-P cos(theta)| &lt;= mu_s[mg cos(theta)+P sin(theta)].</p><ol><li>Resolve P into P cos(theta) uphill and P sin(theta) into the plane.</li><li>The perpendicular rest condition gives N=mg cos(theta)+P sin(theta).</li><li>The tangential rest equation P cos(theta)+f_s-mg sin(theta)=0 gives the signed required friction f_required=mg sin(theta)-P cos(theta).</li><li>Do not choose a friction direction separately; the sign of f_required supplies it.</li><li>The static model is feasible when the magnitude of that required value does not exceed mu_s N.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Includes the inward perpendicular component P sin(theta) when finding N.</li><li>Solves a signed f_required from the tangential equilibrium equation.</li><li>Tests |f_required| against mu_s N instead of setting friction equal to its limit immediately.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>At P=0 the condition reduces to tan(theta)&lt;=mu_s; if P cos(theta)=mg sin(theta), the required friction is zero.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-1" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: Build the chosen-body free-body diagram and solve the perpendicular dynamics for N before using any friction law: do not assume N = mg; N=mg only in the special level case with no other perpendicular force or acceleration; a downward added component raises N, an upward component lowers it, and if the required contact force would be negative the contact is lost so N=0 and friction=0.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-unit="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion A free-body diagram belongs to one chosen body Hard concept Multi-step reasoning Inclined-plane force modelling Constructed response Authored practice Representation translation A 2 kg block slides down the smooth face of a 5 kg wedge inclined at 30°. The wedge stays at rest on a rough floor. Its slope rises to the right, so the block slides down to the left. Take g = 10 m/s². Build the free-body diagram of the wedge only, and find the floor&#x27;s normal force and the floor&#x27;s friction force on the wedge. The wedge&#x27;s sloping face is smooth. The wedge does not move. +x to the right, +y up." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-meta-value="A free-body diagram belongs to one chosen body"><strong>Concept:</strong> <span data-g9-meta-label>A free-body diagram belongs to one chosen body</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-meta-value="constructed_response"><strong>Question type:</strong> <span data-g9-meta-label>Constructed response</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04" data-g9-meta-value="representation_translation"><strong>Transfer:</strong> <span data-g9-meta-label>Representation translation</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A 2 kg block slides down the smooth face of a 5 kg wedge inclined at 30°. The wedge stays at rest on a rough floor. Its slope rises to the right, so the block slides down to the left. Take g = 10 m/s². Build the free-body diagram of the wedge only, and find the floor&#x27;s normal force and the floor&#x27;s friction force on the wedge.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-INCLINE-2A-FBD-COMPONENTS-05">A block slides down a smooth fixed incline. A student draws three downward-related…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>The wedge&#x27;s sloping face is smooth.</li><li>The wedge does not move.</li><li>+x to the right, +y up.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-REP-NLM-WEDGE-FBD" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-WEDGE-FBD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-WEDGE-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="The wedge" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 860 310">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-WEDGE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block slides down the smooth face of a 5 kg wedge</text>\n    <line x1="40" y1="250" x2="420" y2="250" stroke="currentColor" stroke-width="2"/>\n    <line x1="50" y1="250" x2="42" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="68" y1="250" x2="60" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="86" y1="250" x2="78" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="104" y1="250" x2="96" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="122" y1="250" x2="114" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="140" y1="250" x2="132" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="250" x2="150" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="250" x2="168" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="250" x2="186" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="250" x2="204" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="250" x2="222" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="250" x2="240" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="266" y1="250" x2="258" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="284" y1="250" x2="276" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="302" y1="250" x2="294" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="320" y1="250" x2="312" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="338" y1="250" x2="330" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="356" y1="250" x2="348" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="374" y1="250" x2="366" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="392" y1="250" x2="384" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="410" y1="250" x2="402" y2="258" stroke="currentColor" stroke-width="1"/>\n    <polygon points="80,250 360,250 360,88.3" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="124" y="242" text-anchor="middle" font-size="14">30°</text>\n    <path d="M110 250 A30 30 0 0 0 106 235" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 202.4 162)"><rect x="178.4 " y="147" width="48" height="30" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="202.4" y="167" text-anchor="middle" font-size="14">2 kg</text>\n    <text x="306" y="245" text-anchor="middle">5 kg</text>\n    <line x1="161.4" y1="151" x2="123.3" y2="173" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow)"/>\n    <text x="115.3" y="189" text-anchor="end">slides</text>\n    <text x="20" y="290">wedge at rest on a rough floor; slope rises right; +x right, +y up; g = 10 m/s²</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">The wedge</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>Which bodies touch or attract the wedge? List them before drawing any arrow.</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>A diagram still holds only the forces acting on its own body, and gravity is still one force on each body. What changes is that the wedge&#x27;s diagram must be built from the block&#x27;s contact force, which the block&#x27;s own equation supplies.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must build a second body&#x27;s free-body diagram in a two-body incline set-up, placing only the contact partner of the block&#x27;s force and not the block&#x27;s weight.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Put the partner of that normal force (block on wedge) on the wedge&#x27;s diagram, and leave the block&#x27;s weight off it.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-WEDGE-FBD" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-WEDGE-V0 VIS-NLM-WEDGE-V1 VIS-NLM-WEDGE-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 860 310" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-title g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-title">Wedge under a sliding block: only forces that act on the wedge</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-desc">Stage 1: A 2 kg block slides down the smooth face of a 5 kg wedge inclined at 30°; the wedge stays at rest on a rough floor; the slope rises to the right, so the block slides down to the left. Stage 2: On the wedge: its 50 N weight, the block\'s normal push of 17.3 N into the slope (8.66 N right and 15 N down), the floor\'s normal force and the floor\'s friction. Stage 3: The floor\'s normal force is 65 N and its friction about 8.7 N to the left; the block\'s 20 N weight is not on the wedge\'s diagram.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-WEDGE-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">A 2 kg block slides down the smooth face of a 5 kg wedge</text>\n    <line x1="40" y1="250" x2="420" y2="250" stroke="currentColor" stroke-width="2"/>\n    <line x1="50" y1="250" x2="42" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="68" y1="250" x2="60" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="86" y1="250" x2="78" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="104" y1="250" x2="96" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="122" y1="250" x2="114" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="140" y1="250" x2="132" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="158" y1="250" x2="150" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="176" y1="250" x2="168" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="194" y1="250" x2="186" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="212" y1="250" x2="204" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="230" y1="250" x2="222" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="248" y1="250" x2="240" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="266" y1="250" x2="258" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="284" y1="250" x2="276" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="302" y1="250" x2="294" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="320" y1="250" x2="312" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="338" y1="250" x2="330" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="356" y1="250" x2="348" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="374" y1="250" x2="366" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="392" y1="250" x2="384" y2="258" stroke="currentColor" stroke-width="1"/>\n    <line x1="410" y1="250" x2="402" y2="258" stroke="currentColor" stroke-width="1"/>\n    <polygon points="80,250 360,250 360,88.3" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="124" y="242" text-anchor="middle" font-size="14">30°</text>\n    <path d="M110 250 A30 30 0 0 0 106 235" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-30 202.4 162)"><rect x="178.4 " y="147" width="48" height="30" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <text x="202.4" y="167" text-anchor="middle" font-size="14">2 kg</text>\n    <text x="306" y="245" text-anchor="middle">5 kg</text>\n    <line x1="161.4" y1="151" x2="123.3" y2="173" stroke="currentColor" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow)"/>\n    <text x="115.3" y="189" text-anchor="end">slides</text>\n    <text x="20" y="290">wedge at rest on a rough floor; slope rises right; +x right, +y up; g = 10 m/s²</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-WEDGE-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <line x1="210.4" y1="175.9" x2="235.4" y2="219.2" stroke="#1f6fb2" stroke-width="2.5" marker-end="url(#g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-COMPONENT-TRAP-04-bound-REP-NLM-WEDGE-FBD-1--rep-nlm-wedge-arrow-acc)"/>\n    <text x="243" y="206" fill="#1f6fb2">block on</text>\n    <text x="243" y="226" fill="#1f6fb2">wedge: 17.3 N</text>\n    <text x="470" y="60" font-weight="600">wedge\'s diagram only:</text>\n    <text x="470" y="82">weight 50 N down</text>\n    <text x="470" y="104">block\'s normal push 17.3 N into the slope</text>\n    <text x="470" y="126">(8.66 N right, 15 N down)</text>\n    <text x="470" y="148">floor normal N_f, floor friction f</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-WEDGE-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="180" font-weight="600" fill="#1f6fb2">y: N_f = 50 + 15 = 65 N</text>\n    <text x="470" y="202" font-weight="600" fill="#1f6fb2">x: f ≈ 8.7 N to the left</text>\n    <text x="470" y="224">the block\'s 20 N weight is not</text>\n    <text x="470" y="246">on the wedge\'s diagram</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the block sliding down the wedge&#x27;s smooth face.">1: The wedge</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="List only the forces that act on the wedge.">2: Wedge&#x27;s forces</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Balance the wedge in x and y.">3: Floor forces</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the wedge on the floor with the block sliding down its face.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>On the wedge: its weight 50 N down; the block&#x27;s normal push, 17.3 N perpendicular to the slope into the wedge (8.66 N to the right and 15 N down); the floor&#x27;s normal force; and the floor&#x27;s friction. The floor&#x27;s normal force is 65 N, less than the 70 N total weight, and the floor&#x27;s friction is about 8.7 N to the left. The block&#x27;s 20 N weight is not on the wedge&#x27;s diagram.</p><ol><li>Find the contact force from the block&#x27;s own equation: across the smooth slope it has no acceleration, so N = mg cos 30° ≈ 17.3 N.</li><li>Its partner acts on the wedge, perpendicular to the slope and into it: 17.3 sin 30° ≈ 8.66 N to the right and 17.3 cos 30° = 15 N down.</li><li>The block&#x27;s weight acts on the block; it reaches the wedge only through that contact push.</li><li>Wedge at rest: N_floor = 50 + 15 = 65 N, and the floor&#x27;s friction balances 8.66 N, so it points left.</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Lists only forces acting on the wedge: its weight, the block&#x27;s contact push, the floor&#x27;s normal force and the floor&#x27;s friction.</li><li>Finds the block&#x27;s push from the block&#x27;s own perpendicular equation, 17.3 N, rather than using the block&#x27;s weight.</li><li>Gets N_floor = 65 N and a floor friction of about 8.7 N to the left.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Whole system: the block accelerates at 5 m/s² down the slope (4.33 m/s² left, 2.5 m/s² down). External vertical: 65 − 70 = −5 N = 2 × (−2.5). External horizontal: −8.66 N = 2 × (−4.33). Both agree.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM3-4" data-g9-concept-ref="MIC-PHY-NLM-FBD-BODY-OWNERSHIP" data-g9-repair-target="CU-PHY-NLM-FBD-BODY-OWNERSHIP-1" href="#g9-CORE1A--CU-PHY-NLM-FBD-BODY-OWNERSHIP-1">Revisit: When a physical force is resolved into components for chosen axes, keep the body-force inventory unchanged: use the components as a representation of that one force in the equations, not as additional interaction forces alongside the original vector.</a></p></div></template></section></div></div></article><article id="g9-CORE2B--Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-unit="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-kind="QUESTION" data-g9-role="CORE2B" data-g9-search-text="Physics Laws of Motion Quantitative static and kinetic friction conditions Hard concept Multi-step reasoning Inclined-plane force modelling Derivation Authored practice Reasoning steps A block starts from rest and travels the same distance s down the same incline of angle theta in two trials. On a smooth surface the time is t_0. On a rough surface the block slides throughout and the time is t &gt; t_0. Assuming kinetic friction coefficient mu_k is constant, derive mu_k in terms of theta, t_0 and t. Evaluate mu_k for theta = 37° (tan 37° = 0.75) when t = 2t_0. Both trials start from rest at the same point. The incline angle and travel distance are unchanged. The rough-surface trial has established downward sliding with constant mu_k." class="g9-stage-support"><section class="blueprint-slot slot-identity" data-blueprint-slot="identity" data-required="true"><div class="g9-block" data-g9-block="provenance"><p class="g9-prov">AUTHORED transfer</p></div><div data-g9-meta-strip data-g9-meta-role="CORE2B" data-g9-meta-record="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-search-safe><span data-g9-meta-item data-g9-meta-kind="subject" data-g9-meta-ref="Physics" data-g9-meta-value="Physics"><strong>Subject:</strong> <span data-g9-meta-label>Physics</span></span><span data-g9-meta-item data-g9-meta-kind="topic" data-g9-meta-ref="BUCKET-PHY-NLM-FIRST-LAW" data-g9-meta-value="Laws of Motion"><strong>Topic:</strong> <span data-g9-meta-label>Laws of Motion</span></span><span data-g9-meta-item data-g9-meta-kind="concept" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="Quantitative static and kinetic friction conditions"><strong>Concept:</strong> <span data-g9-meta-label>Quantitative static and kinetic friction conditions</span></span><span data-g9-meta-item data-g9-meta-kind="concept-difficulty" data-g9-meta-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-meta-value="HARD"><strong>Concept difficulty:</strong> <span data-g9-meta-label>Hard concept</span></span><span data-g9-meta-item data-g9-meta-kind="question-difficulty" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-meta-value="D3"><strong>Question difficulty:</strong> <span data-g9-meta-label>Multi-step reasoning</span></span><span data-g9-meta-item data-g9-meta-kind="family" data-g9-meta-ref="FAM-PHY-NLM-INCLINE-MODELLING" data-g9-meta-value="Inclined-plane force modelling"><strong>Family:</strong> <span data-g9-meta-label>Inclined-plane force modelling</span></span><span data-g9-meta-item data-g9-meta-kind="question-type" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-meta-value="derivation"><strong>Question type:</strong> <span data-g9-meta-label>Derivation</span></span><span data-g9-meta-item data-g9-meta-kind="provenance" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-meta-value="AUTHORED"><strong>Provenance:</strong> <span data-g9-meta-label>Authored practice</span></span><span data-g9-meta-item data-g9-meta-kind="transfer-dimension" data-g9-meta-ref="Q-PHY-NLM-INCLINE-2B-TIMING-05" data-g9-meta-value="reasoning_steps"><strong>Transfer:</strong> <span data-g9-meta-label>Reasoning steps</span></span></div><div class="g9-block" data-g9-block="stem"><h2>A block starts from rest and travels the same distance s down the same incline of angle theta in two trials. On a smooth surface the time is t_0. On a rough surface the block slides throughout and the time is t &gt; t_0. Assuming kinetic friction coefficient mu_k is constant, derive mu_k in terms of theta, t_0 and t. Evaluate mu_k for theta = 37° (tan 37° = 0.75) when t = 2t_0.</h2></div><div class="g9-block" data-g9-block="lineage"><h4>Builds on</h4><ul><li><a data-g9-lineage href="#g9-CORE2A--Q-PHY-NLM-INCLINE-2A-SLIDING-03">A block is already sliding down a rough fixed plane inclined at angle theta. The…</a></li></ul></div></section><div class="g9-split g9-split-primary-only"><div class="g9-col g9-col-primary"><section class="blueprint-slot slot-attempt" data-blueprint-slot="attempt" data-required="true"><div class="g9-block" data-g9-block="conditions"><h4>Conditions</h4><ul><li>Both trials start from rest at the same point.</li><li>The incline angle and travel distance are unchanged.</li><li>The rough-surface trial has established downward sliding with constant mu_k.</li></ul></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-TIMING-05-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH" data-g9-stage="PRE_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="1" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TIMING-V0" data-g9-stage-mode="cumulative"><svg role="img" aria-label="Two trials" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 345">\n  \n  \n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TIMING-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Same incline, same distance s from rest: smooth vs rough</text>\n    <polygon points="30,250 220,250 220,106.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="74" y="242" text-anchor="middle" font-size="14">θ</text>\n    <path d="M60 250 A30 30 0 0 0 54 231.9" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-37 143.2 150.9)"><rect x="126.2 " y="139.9" width="34" height="22" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="131.7" y1="135.8" x2="43.9" y2="202" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="79.8" y="160.9" text-anchor="end">s</text>\n    <text x="125" y="280" text-anchor="middle">smooth</text>\n    <text x="125" y="302" text-anchor="middle">time t_0</text>\n    <polygon points="240,250 430,250 430,106.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="284" y="242" text-anchor="middle" font-size="14">θ</text>\n    <path d="M270 250 A30 30 0 0 0 264 231.9" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-37 353.2 150.9)"><rect x="336.2 " y="139.9" width="34" height="22" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="341.7" y1="135.8" x2="253.9" y2="202" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="289.8" y="160.9" text-anchor="end">s</text>\n    <text x="335" y="280" text-anchor="middle">rough (μ_k)</text>\n    <text x="335" y="302" text-anchor="middle">time t &gt; t_0</text>\n    <text x="20" y="330">rough trial slides throughout with constant μ_k; case θ = 37° (tan 37° = 0.75), t = 2t_0</text>\n  </g>\n  \n  \n</svg>\n<figcaption data-g9-block="stage_caption" data-g9-caption="stages">Two trials</figcaption></figure><div class="g9-block" data-g9-block="safe_support"><h4>Where to start</h4><p>The two trials cover the same distance from rest. What relation connects distance, constant acceleration and travel time in each trial?</p></div><div class="g9-attempt" data-g9-attempt-box data-g9-response-type="free_response"><label>Your commitment: the model or representation you choose, and your first relation<textarea data-g9-attempt rows="4"></textarea></label><label class="g9-paper"><input data-g9-paper type="checkbox">I worked this on paper</label><button type="button" data-g9-commit>I have attempted this</button></div></section><section class="blueprint-slot slot-post_attempt" data-blueprint-slot="post_attempt" data-required="true"><div class="g9-block" data-g9-block="lineage_check"><h4>Lineage check</h4><p>Before you open the solution: what from the earlier item still holds here, and what is different?</p></div><details data-g9-reveal data-requires-attempt data-g9-payload-ref="CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-review"><summary>Review and solution</summary><div data-g9-payload-slot></div></details><template data-g9-payload="CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-review"><div class="g9-block" data-g9-block="invariant_changed"><h4>What stayed valid</h4><p>The rough-slope acceleration g(sin θ − μ_k cos θ) and the smooth-slope g sin θ still hold; what changes is that μ_k must be inferred from travel times instead of being used to find an acceleration.</p></div><div class="g9-block" data-g9-block="changed_demand"><h4>What changed</h4><p>The learner must combine the established rough-incline dynamics with an independent timing representation to infer the friction coefficient, rather than being asked directly for acceleration.</p></div><div class="g9-block" data-g9-block="protected_move"><h4>The deciding move</h4><p>Use the shared distance from rest, s = (1/2)a t² in both trials, to turn the times into an acceleration ratio: a/a_0 = t_0²/t², in which s, m and g cancel.</p></div><figure data-g9-figure data-g9-fig="Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH" data-g9-stage="POST_ATTEMPT" data-g9-representation="REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH" data-g9-kind="FREE_BODY_DIAGRAM" data-reveal-stages="3" data-g9-stages-total="3" data-g9-stages="VIS-NLM-TIMING-V0 VIS-NLM-TIMING-V1 VIS-NLM-TIMING-V2" data-g9-stage-mode="cumulative"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 345" role="img" aria-labelledby="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-title g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-desc">\n  <title id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-title">Same distance down the same incline, smooth and rough: times give μ_k</title>\n  <desc id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-desc">Stage 1: A block starts from rest and travels the same distance s down the same incline of angle θ, taking t_0 on a smooth surface and t &gt; t_0 on a rough surface where it slides throughout with constant μ_k; the case to evaluate is θ = 37° with t = 2t_0. Stage 2: a_0 = g sin θ and a = g(sin θ − μ_k cos θ); the same distance from rest gives s = ½ a t² in both trials. Stage 3: a/a_0 = t_0²/t², so μ_k = tan θ (1 − t_0²/t²); for θ = 37° and t = 2t_0, μ_k = 0.75 × (1 − 1/4) = 0.5625 ≈ 0.56.</desc>\n  <defs>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="g9fig-CORE2B-Q-PHY-NLM-INCLINE-2B-TIMING-05-bound-REP-NLM-INCLINE-TIMING-SMOOTH-ROUGH-1--rep-nlm-timing-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#1f6fb2"/></marker>\n  </defs>\n  <g data-g9-stage-id="VIS-NLM-TIMING-V0" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="20" y="26" font-weight="600">Same incline, same distance s from rest: smooth vs rough</text>\n    <polygon points="30,250 220,250 220,106.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="74" y="242" text-anchor="middle" font-size="14">θ</text>\n    <path d="M60 250 A30 30 0 0 0 54 231.9" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-37 143.2 150.9)"><rect x="126.2 " y="139.9" width="34" height="22" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="131.7" y1="135.8" x2="43.9" y2="202" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="79.8" y="160.9" text-anchor="end">s</text>\n    <text x="125" y="280" text-anchor="middle">smooth</text>\n    <text x="125" y="302" text-anchor="middle">time t_0</text>\n    <polygon points="240,250 430,250 430,106.8" fill="none" stroke="currentColor" stroke-width="2"/>\n    <text x="284" y="242" text-anchor="middle" font-size="14">θ</text>\n    <path d="M270 250 A30 30 0 0 0 264 231.9" fill="none" stroke="currentColor" stroke-width="1.2"/>\n    <g transform="rotate(-37 353.2 150.9)"><rect x="336.2 " y="139.9" width="34" height="22" fill="none" stroke="currentColor" stroke-width="2"/></g>\n    <line x1="341.7" y1="135.8" x2="253.9" y2="202" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"/>\n    <text x="289.8" y="160.9" text-anchor="end">s</text>\n    <text x="335" y="280" text-anchor="middle">rough (μ_k)</text>\n    <text x="335" y="302" text-anchor="middle">time t &gt; t_0</text>\n    <text x="20" y="330">rough trial slides throughout with constant μ_k; case θ = 37° (tan 37° = 0.75), t = 2t_0</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TIMING-V1" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="60" font-weight="600">accelerations:</text>\n    <text x="470" y="82">a_0 = g sin θ</text>\n    <text x="470" y="104">a = g (sin θ − μ_k cos θ)</text>\n    <text x="470" y="126" font-weight="600">same s from rest: s = ½ a t² in both</text>\n  </g>\n  <g data-g9-stage-id="VIS-NLM-TIMING-V2" font-family="system-ui,sans-serif" font-size="15" fill="currentColor">\n    <text x="470" y="160" fill="#1f6fb2">a/a_0 = t_0²/t²  (s, m, g cancel)</text>\n    <text x="470" y="182" font-weight="600" fill="#1f6fb2">μ_k = tan θ (1 − t_0²/t²)</text>\n    <text x="470" y="204" fill="#1f6fb2">θ = 37°, t = 2t_0: μ_k = 0.75 × (1 − 1/4)</text>\n    <text x="470" y="226" font-weight="600" fill="#1f6fb2">= 0.5625 ≈ 0.56</text>\n  </g>\n</svg>\n<div class="g9-stage-controls"><div class="g9-stage-chips" role="group" aria-label="Stages"><button type="button" class="g9-stage-chip" data-g9-stage-goto="0" data-g9-stage-desc="Show the smooth and rough trials over the same distance.">1: Two trials</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="1" data-g9-stage-desc="Write each acceleration and the shared-distance relation.">2: Accelerations</button><button type="button" class="g9-stage-chip" data-g9-stage-goto="2" data-g9-stage-desc="Turn the times into an acceleration ratio and solve.">3: μ_k</button></div><p class="g9-stage-desc" data-g9-stage-desc-text></p><div class="g9-stage-stepper"><button type="button" data-g9-stage-step="prev">Previous stage</button><span data-g9-stage-label></span><button type="button" data-g9-stage-step="next">Next stage</button></div></div><figcaption data-g9-block="representation_bridge" data-g9-caption="purpose">Show the two timed trials over the same distance down the same incline, one smooth and one rough.</figcaption></figure><div class="g9-block" data-g9-block="answer"><h4>Answer</h4><p>Smooth acceleration is a_0=g sin(theta), rough acceleration is a=g[sin(theta)-mu_k cos(theta)]. Since s=(1/2)at^2 from rest, a/a_0=t_0^2/t^2. Therefore mu_k=tan(theta)[1-t_0^2/t^2]. For theta = 37° and t = 2t_0, mu_k = 0.75 × (1 − 1/4) = 0.5625 ≈ 0.56.</p><ol><li>The smooth trial gives a_0=g sin(theta).</li><li>The rough sliding trial gives a=g[sin(theta)-mu_k cos(theta)].</li><li>Equal distance from rest gives s=(1/2)a_0 t_0^2=(1/2)a t^2, hence a/a_0=t_0^2/t^2.</li><li>Substitute the two incline accelerations and solve for mu_k.</li><li>This yields mu_k=tan(theta)[1-t_0^2/t^2].</li></ol></div><div class="g9-block" data-g9-block="rubric"><h4>Rubric</h4><ul><li>Builds the smooth and rough incline accelerations from the corresponding force models.</li><li>Uses equal-distance constant-acceleration kinematics to relate a/a_0 to t_0^2/t^2.</li><li>Solves to mu_k=tan(theta)[1-t_0^2/t^2] and checks its limiting sign.</li></ul></div><div class="g9-block" data-g9-block="independent_check"><h4>Independent check</h4><p>Because t&gt;t_0, the bracket is positive. If t approaches t_0, the inferred mu_k approaches zero.</p></div><div class="g9-block" data-g9-block="repair"><h4>Repair</h4><p><a data-g9-repair-ref="NLM8-4" data-g9-concept-ref="MIC-PHY-NLM-FRICTION-QUANT" data-g9-repair-target="CU-PHY-NLM-FRICTION-QUANT-1" href="#g9-CORE1A--CU-PHY-NLM-FRICTION-QUANT-1">Revisit: At the threshold use |f_s|=μ_sN; once relative sliding is established use |f_k|=μ_kN opposite the sliding, and if several contacts change state, update N and the friction model at each contact before continuing.</a></p></div></template></section></div></div></article></section></main><footer data-g9-footer>Physics · Force and laws of motion</footer><script>\n(()=>{const q=(s,r=document)=>[...r.querySelectorAll(s)];\nconst store={get:k=>{try{return localStorage.getItem(\'g9-\'+k)}catch(e){return null}},set:(k,v)=>{try{localStorage.setItem(\'g9-\'+k,v);return true}catch(e){return false}},remove:k=>{try{localStorage.removeItem(\'g9-\'+k);return true}catch(e){return false}}};\nconst root=document.documentElement;const scope=root.dataset.g9Product&&root.dataset.g9RenderDigest?root.dataset.g9Product+\':\'+root.dataset.g9RenderDigest:\'\';\nconst apply=()=>{root.dataset.theme=store.get(\'theme\')||root.dataset.theme||\'light\';root.style.setProperty(\'--g9-zoom\',store.get(\'zoom\')||\'1\');};apply();\nq(\'[data-g9-theme]\').forEach(b=>b.onclick=()=>{store.set(\'theme\',b.dataset.g9Theme);apply()});\nq(\'[data-g9-zoom]\').forEach(b=>b.onclick=()=>{let z=parseFloat(store.get(\'zoom\')||\'1\');z=b.dataset.g9Zoom===\'inc\'?Math.min(1.6,z+0.1):b.dataset.g9Zoom===\'dec\'?Math.max(0.8,z-0.1):1;store.set(\'zoom\',z.toFixed(1));apply()});\nq(\'[data-g9-font]\').forEach(b=>b.onclick=()=>q(\'[data-g9-zoom="\'+b.dataset.g9Font+\'"]\')[0]?.click());\nfunction initFigure(f){if(f.dataset.g9Init)return;f.dataset.g9Init=\'1\';const ids=(f.dataset.g9Stages||\'\').split(\' \').filter(Boolean);if(ids.length<2)return;let i=0;\nconst chips=q(\'[data-g9-stage-goto]\',f);const desc=q(\'[data-g9-stage-desc-text]\',f)[0];\nconst stageMode=f.dataset.g9StageMode||\'cumulative\';const cumulative=stageMode!==\'replace\';\nids.forEach(id=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=\'none\'));\nconst show=()=>{ids.forEach((id,n)=>q(\'[data-g9-stage-id="\'+id+\'"]\',f).forEach(g=>g.style.display=(cumulative?n<=i:n===i)?\'\':\'none\'));const l=q(\'[data-g9-stage-label]\',f)[0];if(l)l.textContent=\'Stage \'+(i+1)+\' of \'+ids.length;chips.forEach((c,n)=>c.setAttribute(\'aria-pressed\',String(n===i)));if(desc)desc.textContent=(chips[i]&&chips[i].dataset.g9StageDesc)||\'\'};show();chips.forEach((c,n)=>c.onclick=()=>{i=n;show()});\nq(\'[data-g9-stage-step]\',f).forEach(b=>b.onclick=()=>{i=Math.max(0,Math.min(ids.length-1,i+(b.dataset.g9StageStep===\'next\'?1:-1)));show()})}\nfunction nextRung(l){const t=q(\'template[data-g9-rung-payload]\',l)[0];if(!t)return false;const payload=t.content.cloneNode(true);q(\'[data-g9-rung-ghost]\',l)[0]?.remove();q(\'figure[data-g9-figure]\',payload).forEach(initFigure);q(\'[data-g9-ladder]\',l)[0].append(payload);t.remove();const b=q(\'[data-g9-next-rung]\',l)[0];if(b){if(!q(\'template[data-g9-rung-payload]\',l).length)b.disabled=true;else b.textContent=\'Show next support\'}return true}\nfunction materialise(a){q(\'details[data-g9-payload-ref]\',a).forEach(d=>{const slot=q(\'[data-g9-payload-slot]\',d)[0];if(!slot||slot.dataset.g9Filled)return;const t=q(\'template[data-g9-payload]\',a).find(x=>x.dataset.g9Payload===d.dataset.g9PayloadRef);if(!t)return;slot.replaceChildren(t.content.cloneNode(true));slot.dataset.g9Filled=\'1\';q(\'figure[data-g9-figure]\',slot).forEach(initFigure)})}\nconst number=t=>{const v=t.trim();if(!/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?(?:\\s*\\/\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?)?$/i.test(v))return false;const p=v.split(\'/\').map(x=>Number(x.trim()));return p.every(Number.isFinite)&&(p.length===1||p[1]!==0)};\nfunction validAttempt(box){const type=box.dataset.g9ResponseType;if(type===\'single_choice\'||type===\'multiple_choice\'||type===\'true_false\')return q(\'[data-g9-choice]:checked\',box).length>0;\nif(type===\'numeric\')return number(q(\'[data-g9-number]\',box)[0]?.value||\'\');if(type===\'short_text\')return !!q(\'[data-g9-attempt]\',box)[0]?.value.trim();\nif(type===\'match\'){const fields=q(\'[data-g9-match]\',box);return fields.length>0&&fields.every(x=>x.value!==\'\')}\nif(q(\'[data-g9-paper]:checked\',box).length)return true;if(type===\'multipart\'){const fields=q(\'[data-g9-part-input]\',box);return fields.length>0&&fields.every(x=>x.value.trim()&&(!x.dataset.g9PartType||x.dataset.g9PartType!==\'numeric\'||number(x.value)))}\nreturn !!q(\'[data-g9-attempt]\',box)[0]?.value.trim()}\nconst stateKey=a=>scope&&a?.dataset.g9Unit?\'state:\'+scope+\':\'+a.dataset.g9Unit:null;const returnKey=concept=>scope&&concept?\'return:\'+scope+\':\'+concept:null;\nfunction readState(key){if(!key)return null;const raw=store.get(key);if(!raw)return null;try{const state=JSON.parse(raw);return state&&typeof state===\'object\'?state:null}catch(e){return null}}\nconst attemptFields=a=>q(\'[data-g9-attempt-box] input,[data-g9-attempt-box] textarea,[data-g9-attempt-box] select\',a);const rungCount=l=>{const list=q(\'[data-g9-ladder]\',l)[0];return list?q(\'[data-g9-rung]\',list).length:0};\nfunction saveCore2State(a){if(a.dataset.g9Role!==\'CORE2\')return;const key=stateKey(a);if(!key)return;const fields=attemptFields(a).map(el=>({value:el.value,checked:!!el.checked}));const ladders={};q(\'.g9-ladder[data-g9-ladder-ref]\',a).forEach(l=>ladders[l.dataset.g9LadderRef]=rungCount(l));const reveals=q(\'details[data-g9-support-reveal]\',a).map(d=>!!d.open);store.set(key,JSON.stringify({attempted:!!a.dataset.attempted,fields,ladders,reveals}))}\nfunction bindSupportRevealState(a){q(\'details[data-g9-support-reveal]\',a).forEach(d=>{if(d.dataset.g9StateBound)return;d.dataset.g9StateBound=\'1\';d.addEventListener(\'toggle\',()=>saveCore2State(a))})}\nfunction restoreCore2State(a,lock){if(a.dataset.g9Role!==\'CORE2\')return;const state=readState(stateKey(a));if(!state)return;const fields=attemptFields(a);(state.fields||[]).forEach((saved,i)=>{const el=fields[i];if(!el||!saved||typeof saved!==\'object\')return;if(Object.prototype.hasOwnProperty.call(saved,\'value\'))el.value=saved.value??\'\';if(el.type===\'checkbox\'||el.type===\'radio\')el.checked=!!saved.checked});Object.entries(state.ladders||{}).forEach(([ref,count])=>{const l=q(\'.g9-ladder[data-g9-ladder-ref]\',a).find(x=>x.dataset.g9LadderRef===ref);if(!l||!Number.isInteger(count)||count<0)return;while(rungCount(l)<count&&nextRung(l)){};});bindSupportRevealState(a);q(\'details[data-g9-support-reveal]\',a).forEach((d,i)=>d.open=!!(state.reveals||[])[i]);if(state.attempted){a.dataset.attempted=\'1\';materialise(a)}lock()}\nconst articles=q(\'article[data-g9-unit],article[data-g9-diagnostic],[data-g9-purpose-item]\');\narticles.forEach(a=>{const lock=()=>q(\'details[data-requires-attempt]\',a).forEach(d=>{if(!a.dataset.attempted){d.dataset.locked=\'\';d.open=false}else delete d.dataset.locked});lock();restoreCore2State(a,lock);\nq(\'details[data-requires-attempt] summary\',a).forEach(s=>s.addEventListener(\'click\',e=>{if(!a.dataset.attempted){e.preventDefault();q(\'[data-g9-attempt-box] input,[data-g9-attempt-box] textarea,[data-g9-attempt-box] select\',a)[0]?.focus()}}));\nq(\'[data-g9-commit]\',a).forEach(b=>b.onclick=()=>{const box=b.closest(\'[data-g9-attempt-box]\');if(!box||!validAttempt(box)){q(\'input,textarea,select\',box||a)[0]?.focus();return}a.dataset.attempted=\'1\';lock();materialise(a);saveCore2State(a)});\na.addEventListener(\'click\',e=>{const b=e.target.closest(\'[data-g9-next-rung]\');if(b&&a.contains(b)){nextRung(b.closest(\'.g9-ladder\'));bindSupportRevealState(a);saveCore2State(a)}});attemptFields(a).forEach(el=>{el.addEventListener(\'input\',()=>saveCore2State(a));el.addEventListener(\'change\',()=>saveCore2State(a))});\nq(\'[data-g9-concept-link]\',a).forEach(link=>link.addEventListener(\'click\',()=>{saveCore2State(a);const key=returnKey(link.dataset.g9ConceptRef);if(key)store.set(key,link.dataset.g9QuestionRef||a.dataset.g9Unit);refreshReturnLinks()}))});\nconst practiceLinks=q(\'[data-g9-practice-link]\');const practiceLabels=new Map(practiceLinks.map(link=>[link,link.textContent]));\nfunction refreshReturnLinks(){practiceLinks.forEach(link=>{const key=returnKey(link.dataset.g9ConceptRef);const active=!!key&&store.get(key)===link.dataset.g9QuestionRef;if(active){link.dataset.g9ReturnLink=\'\';link.textContent=\'Return to question · \'+practiceLabels.get(li