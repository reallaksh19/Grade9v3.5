\n  content: " ✕ Incorrect";\n  margin-inline-start: .4rem;\n  font-weight: 800;\n}\n\n/* Contrast repairs for the learner-visible light theme. */\n[data-theme="light"] .step-content-calc {\n  color: #7c2d12 !important;\n  background: #fff7ed !important;\n  border: 1px solid #c2410c !important;\n}\n[data-theme="light"] .answer-banner,\n[data-theme="light"] .badge-success,\n[data-theme="light"] .saved-pill {\n  color: #065f46 !important;\n}\n[data-theme="light"] .badge-warning,\n[data-theme="light"] .hint-tag,\n[data-theme="light"] .diag-header-another {\n  color: #7c2d12 !important;\n}\n[data-theme="light"] .step-label,\n[data-theme="light"] details > summary {\n  color: #075985 !important;\n}\n[data-theme="light"] .formula-box,\n[data-theme="light"] .math-banner {\n  color: #422006 !important;\n  background: #fef3c7 !important;\n  border-color: #92400e !important;\n}\n[data-theme="light"] footer { color: #475569 !important; }\n\n/* Default dark-theme contrast repairs from U4. */\nhtml[data-theme="dark"] .step-label { color: #7dd3fc !important; }\nhtml[data-theme="dark"] details > summary { color: #7dd3fc !important; }\n.q-count, .open-btn { color: #93c5fd !important; }\n.tag-2d, .tag-1d, .tag-vec, .tag-ncert, .tag-sba, .tag-proj, .tag-cons { color: #ffffff !important; }\nfooter { color: #94a3b8 !important; }\n\n/* The offline 1D master lost Tailwind preflight + custom theme utilities. */\nbody.u4-tailwind-offline {\n  margin: 0 !important;\n  background: #090d16 !important;\n  color: #f1f5f9 !important;\n  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;\n}\n.u4-tailwind-offline.bg-background, .u4-tailwind-offline .bg-background { background-color: #090d16 !important; }\n.u4-tailwind-offline .bg-card { background-color: #111827 !important; }\n.u4-tailwind-offline .border-border { border-color: #334155 !important; }\n.u4-tailwind-offline .bg-slate-950\\/90 { background-color: rgba(2, 6, 23, .94) !important; }\n.u4-tailwind-offline .bg-slate-900 { background-color: #0f172a !important; }\n.u4-tailwind-offline .bg-slate-800 { background-color: #1e293b !important; }\n.u4-tailwind-offline .max-w-7xl { max-width: 80rem !important; }\n.u4-tailwind-offline .overflow-x-auto { overflow-x: auto !important; }\n.u4-tailwind-offline .whitespace-nowrap { white-space: nowrap !important; }\n.u4-tailwind-offline .font-sans { font-family: ui-sans-serif, system-ui, sans-serif !important; }\n.u4-tailwind-offline .text-slate-500,\n.u4-tailwind-offline .text-slate-600 { color: #cbd5e1 !important; }\n.u4-tailwind-offline .text-slate-400 { color: #a8b5c7 !important; }\n.u4-tailwind-offline header { max-width: 100%; }\n\n/* Reflow at phone width and at a 200% zoom-equivalent viewport. */\n@media (max-width: 700px) {\n  header.sticky, .sticky-header, .top-nav.sticky { position: static !important; top: auto !important; }\n}\n@media (max-width: 480px) {\n  .header-actions,\n  .g9-nav-group,\n  .g9-header-actions,\n  .top-nav-header,\n  .course-badge-row,\n  .workspace-title-row {\n    max-width: 100% !important;\n    min-width: 0 !important;\n    flex-wrap: wrap !important;\n  }\n  .g9-block, nav, ol, ul, main, section, article, .app-container, .container {\n    max-width: 100% !important;\n    min-width: 0 !important;\n  }\n  ol, ul { padding-inline-start: 1.5rem !important; }\n  #jump-select { width: 100% !important; max-width: 100% !important; }\n  .tab-btn { white-space: normal !important; min-width: 0 !important; flex: 1 1 140px !important; }\n  .tabs, .tab-strip, .tab-nav, .tab-bar, .g9-tabs, [class*="tabs-row"] {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    white-space: normal !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n  }\n  .g9-nav-group > *, .header-actions > * { max-width: 100% !important; }\n  pre { white-space: pre-wrap !important; overflow-wrap: anywhere !important; max-width: 100% !important; }\n  table { display: block; max-width: 100% !important; overflow-x: auto !important; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: .001ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .001ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n@media (forced-colors: active) {\n  svg text { fill: CanvasText !important; stroke: transparent !important; }\n  :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {\n    outline: 3px solid Highlight !important;\n  }\n}\n</style>\n<style id="pr375-u4-residual-remediation">\n@media (max-width: 480px) {\n  /* Generated CORE1A section-route pills used 24rem + padding, producing ~467px boxes. */\n  [data-g9-section-route] a,\n  [data-g9-concept-route] a,\n  article[data-g9-role="CORE1A"] > .slot-identity [data-g9-section-route] a {\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n    box-sizing: border-box !important;\n    white-space: normal !important;\n    line-height: 1.4 !important;\n    overflow: visible !important;\n    text-overflow: clip !important;\n    overflow-wrap: anywhere !important;\n  }\n\n  /* Consolidated and interactive headers must reflow as complete units, not just their children. */\n  .header-inner,\n  header.g9-shell {\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n    height: auto !important;\n    flex-wrap: wrap !important;\n    justify-content: flex-start !important;\n    align-items: flex-start !important;\n  }\n  .header-inner > *,\n  header.g9-shell > .g9-nav-group {\n    flex: 1 1 100% !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    min-width: 0 !important;\n  }\n  .header-brand,\n  .header-brand h1,\n  .header-actions,\n  header.g9-shell .g9-nav-group,\n  header.g9-shell .g9-breadcrumb {\n    max-width: 100% !important;\n    min-width: 0 !important;\n    flex-wrap: wrap !important;\n    white-space: normal !important;\n  }\n  .header-brand h1 { align-items: flex-start !important; }\n  .header-actions { width: 100% !important; justify-content: flex-start !important; }\n  header.g9-shell { padding-block: 8px !important; }\n  header.g9-shell .g9-breadcrumb { flex: 1 1 100% !important; overflow-wrap: anywhere !important; }\n}\n</style>\n<style id="pr375-u1-remediation">\nhtml{-webkit-text-size-adjust:100%;text-size-adjust:100%} body{overflow-wrap:anywhere} p,li{line-height:1.4}\n:where(p,li,label,button,input,select,textarea,summary,td,th,figcaption,.btn,.q-badge,.tag-pill,.hint-badge,.hint-tag,.subject-badge,.step-label,.diag-header,.formula-box,#saveStatus,.save-status,.tag,.q-count,.open-btn,.stat .label,section.section-header h2,.study-kicker,.brand-badge,.hero-pill,.badge,.core-tag,.telemetry-title,.control-label,.card-action,.breadcrumb){font-size:max(14px,1em)!important}\n:where(a[href="index.html"],header a,nav a,.breadcrumb a,a.g9-bridge-link,[data-g9-block="entry_assumptions"] a){min-height:48px!important;min-width:48px!important;display:inline-flex!important;align-items:center!important;justify-content:center;padding-block:10px!important;box-sizing:border-box!important}\n@media(min-width:1100px){article[data-g9-role="CORE1A"] .g9-split{grid-template-columns:minmax(0,1fr)!important}article[data-g9-role="CORE1A"] .g9-col-support{position:static!important;top:auto!important}}\narticle[data-g9-role="CORE1A"]>.slot-identity [data-g9-section-route] a{white-space:normal!important;overflow:visible!important;text-overflow:clip!important;line-height:1.35!important;min-height:48px!important}\n\n.badge,.study-kicker{font-size:14px!important}\n</style>\n<style id="u2-practice-hub-target">\na[href="index.html"]{min-height:48px!important;min-width:48px!important;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center}\n</style>\n  <!-- KaTeX Typography (Khan Academy Standard) -->\n  <link rel="stylesheet" href="../../vendor/katex/0.16.8/katex.min.css">\n  <script src="../../vendor/katex/0.16.8/katex.min.js"></script>\n  <script src="../../vendor/katex/0.16.8/contrib/auto-render.min.js"></script>\n</head>\n<body>\n\n  <header class="app-header">\n    <div class="header-inner">\n      <div class="header-brand">\n        <h1>\n          <span>🧭</span> Vector Algebra &amp; Resolution Master Suite\n          <span class="subject-badge">Physics</span>\n        </h1>\n      </div>\n      <div class="header-actions" style="display:flex;align-items:center;gap:10px;">\n        <a href="index.html" class="nav-hub-btn" aria-label="Back to Practice Hub" title="Back to Practice Hub" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 16px;border-radius:8px;background:var(--bg-card,#1e293b);color:var(--text-primary,#f8fafc);border:1.5px solid var(--border,#334155);font-size:14px;font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;">← Practice Hub</a>\n        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle Theme">🌓 Mode</button>\n      </div>\n    </div>\n  </header>\n\n    <nav class="tab-nav">\n    <div class="tab-nav-inner">\n      <button class="tab-btn active" onclick="switchTab(\'tab-core1\')">Core 1 Vector Concepts (11 Units)</button>\n      <button class="tab-btn" onclick="switchTab(\'tab-challenges\')">Core 2 Vector Challenges (29)</button>\n    </div>\n  </nav>\n\n  <main class="layout-container">\n    \n    <div class="stage-area">\n      <!-- Tab 1: Core 1 Vector Concepts (11 Units) -->\n      <div id="tab-core1" class="tab-content active">\n        <div class="content-card">\n          <h2><span>🧭</span> Vector Reasoning Foundations (Core 1)</h2>\n          <p>\n            Build vector reasoning as a reusable system before transfer: Physical Meaning &rarr; Geometric Diagram &rarr; Component Projections &rarr; Dot/Cross Interpretation &rarr; Sanity Check.\n          </p>\n          <div class="formula-box">\n            <div><strong>Vector Form:</strong> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \\(\\vec{A} = A_x\\,\\hat{i} + A_y\\,\\hat{j} + A_z\\,\\hat{k}\\)</div>\n            <div><strong>Resultant:</strong> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \\(|\\vec{A} + \\vec{B}| = \\sqrt{A^2 + B^2 + 2AB\\cos\\theta}\\)</div>\n            <div><strong>Relative Velocity:</strong> &nbsp;&nbsp;&nbsp; \\(\\vec{v}_{AB} = \\vec{v}_A - \\vec{v}_B\\) (observer vector is subtracted)</div>\n            <div><strong>Scalar Product:</strong> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \\(\\vec{A} \\cdot \\vec{B} = AB\\cos\\theta = A_x B_x + A_y B_y\\)</div>\n          </div>\n        </div>\n\n<!-- Unit 01: VECTORS 01 - Scalars, vectors and sign -->\n        <article class="content-card" id="unit-01" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 01</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 01 - Scalars, vectors and sign</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Direction is information; sign belongs to a declared axis</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-01 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="1D signed axis and displacement vectors" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-vx" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="currentColor"/></marker>\n    <marker id="arr-ve" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-vw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#f43f5e"/></marker>\n  </defs>\n  <!-- Declared +x Axis -->\n  <line x1="50" y1="130" x2="480" y2="130" stroke="currentColor" stroke-width="2" marker-end="url(#arr-vx)"/>\n  <text x="495" y="135" font-size="14" font-weight="800" fill="currentColor">+x (East)</text>\n  <!-- Origin -->\n  <line x1="220" y1="120" x2="220" y2="140" stroke="currentColor" stroke-width="2"/>\n  <text x="220" y="155" text-anchor="middle" font-size="13" font-weight="700" fill="currentColor">0</text>\n  <!-- +8 m East displacement -->\n  <line x1="220" y1="90" x2="380" y2="90" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-ve)"/>\n  <text x="300" y="78" text-anchor="middle" font-size="13" font-weight="800" fill="#38bdf8">+8 m East (along +x)</text>\n  <!-- -5 m West displacement -->\n  <line x1="220" y1="50" x2="120" y2="50" stroke="#f43f5e" stroke-width="3.5" marker-end="url(#arr-vw)"/>\n  <text x="170" y="38" text-anchor="middle" font-size="13" font-weight="800" fill="#f43f5e">-5 m West (opposite +x)</text>\n  <!-- Rule banner -->\n  <rect x="110" y="175" width="320" height="28" rx="6" fill="rgba(56,189,248,0.12)" stroke="#38bdf8"/>\n  <text x="270" y="194" text-anchor="middle" font-size="12" font-weight="700" fill="#38bdf8">Sign has meaning ONLY after positive axis is declared</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">A scalar is complete with magnitude alone. A vector needs magnitude and direction. In one dimension, direction can be encoded by sign only after you declare the positive axis.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Do not classify from the unit. Ask whether reversing direction changes the physical state. Then declare an axis before attaching + or - signs.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Recognise: displacement, velocity, acceleration, force and momentum are vectors; distance, speed, time and mass are scalars.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Represent: in 1D, choose +x first; then words such as east/west become signed components.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Interpret: a negative answer is not a failed calculation. It points opposite the chosen positive axis.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Validity: the sign changes if the axis convention changes; the physical motion does not.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. Take east as +x. A trolley moves 5 m east then 9 m west. Displacement = +5 + (-9) = -4 m = 4 m west. Distance = 5 + 9 = 14 m.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not use “negative = smaller” or “negative = wrong”. For a vector component, negative normally means opposite the declared positive axis.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">Take north as +y. A displacement is 7 m south.</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">-7 m.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 02: VECTORS 02 - Draw, compare and reverse vectors -->\n        <article class="content-card" id="unit-02" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 02</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 02 - Draw, compare and reverse vectors</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Length represents magnitude; the arrowhead represents direction</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-02 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Equal, parallel and opposite vectors" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-va" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-neg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#f43f5e"/></marker>\n  </defs>\n  <!-- Vector A -->\n  <line x1="70" y1="150" x2="180" y2="70" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-va)"/>\n  <text x="110" y="95" font-size="15" font-weight="800" fill="#38bdf8">Vector A</text>\n  <text x="110" y="170" text-anchor="middle" font-size="12" fill="var(--text-secondary,#94a3b8)">Length = Magnitude</text>\n  <!-- Equal Vector B = A -->\n  <line x1="220" y1="150" x2="330" y2="70" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-va)"/>\n  <text x="260" y="95" font-size="15" font-weight="800" fill="#38bdf8">Vector B = A</text>\n  <text x="275" y="170" text-anchor="middle" font-size="12" fill="#34d399">Same length &amp; direction</text>\n  <!-- Opposite Vector -A -->\n  <line x1="470" y1="70" x2="360" y2="150" stroke="#f43f5e" stroke-width="3.5" marker-end="url(#arr-neg)"/>\n  <text x="430" y="125" font-size="15" font-weight="800" fill="#f43f5e">-A (Opposite)</text>\n  <text x="420" y="170" text-anchor="middle" font-size="12" fill="#f43f5e">Same length, inverted arrow</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">A vector diagram is a physical representation, not decoration. Translating a free vector without rotating or resizing it leaves the vector unchanged. Reversing it creates the opposite vector.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Equal vectors need both the same magnitude and the same direction. The opposite vector -A has the same magnitude as A but points exactly the other way.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Read: direction runs from tail to head.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Scale: relative arrow length should track relative magnitude.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Translate: a free vector may slide without changing.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Reverse: -A reverses direction, not magnitude.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. A 6 N force east and a 6 N force west have equal magnitudes, but they are not equal vectors. They are opposites.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not compare arrows only by length. Two arrows with the same length but different directions are different vectors.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">If B is equal to A but drawn elsewhere on the</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">No. Same magnitude and direction are</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 03: VECTORS 03 - Components, quadrants and angle reference -->\n        <article class="content-card" id="unit-03" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 03</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 03 - Components, quadrants and angle reference</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Choose the frame first; then project the arrow</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-03 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Vector components in Cartesian quadrants" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-v3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n    <marker id="arr-cx" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n  </defs>\n  <!-- Axes -->\n  <line x1="60" y1="130" x2="480" y2="130" stroke="var(--border,#475569)" stroke-width="1.5"/>\n  <text x="490" y="135" font-size="12" font-weight="700" fill="currentColor">+x</text>\n  <line x1="270" y1="200" x2="270" y2="30" stroke="var(--border,#475569)" stroke-width="1.5"/>\n  <text x="275" y="30" font-size="12" font-weight="700" fill="currentColor">+y</text>\n  <!-- Vector in Quadrant II -->\n  <line x1="270" y1="130" x2="150" y2="50" stroke="#34d399" stroke-width="4" marker-end="url(#arr-v3)"/>\n  <text x="180" y="70" font-size="15" font-weight="800" fill="#34d399">v</text>\n  <!-- Component projections -->\n  <line x1="270" y1="130" x2="150" y2="130" stroke="#38bdf8" stroke-width="3" marker-end="url(#arr-cx)"/>\n  <text x="210" y="152" text-anchor="middle" font-size="12" font-weight="800" fill="#38bdf8">v_x = -v cos θ &lt; 0</text>\n  <line x1="150" y1="130" x2="150" y2="55" stroke="#38bdf8" stroke-width="3" marker-end="url(#arr-cx)"/>\n  <text x="95" y="95" text-anchor="middle" font-size="12" font-weight="800" fill="#38bdf8">v_y = +v sin θ &gt; 0</text>\n  <!-- Angle arc -->\n  <path d="M 230 130 A 40 40 0 0 1 245 113" fill="none" stroke="#fbbf24" stroke-width="2"/>\n  <text x="228" y="118" font-size="12" font-weight="800" fill="#fbbf24">θ</text>\n  <!-- Quadrant II pill -->\n  <rect x="330" y="50" width="160" height="50" rx="6" fill="rgba(56,189,248,0.1)" stroke="#38bdf8"/>\n  <text x="410" y="72" text-anchor="middle" font-size="12" font-weight="800" fill="#38bdf8">QUADRANT II</text>\n  <text x="410" y="90" text-anchor="middle" font-size="12" fill="currentColor">x &lt; 0,  y &gt; 0</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Components are the signed projections of one vector onto chosen axes. They are not extra physical vectors; they are another description of the same arrow.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Geometry decides sine/cosine. The component adjacent to the stated angle uses cosine; the opposite component uses sine. Signs come from the arrow direction.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Frame: mark +x and +y before calculating.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Project: identify adjacent and opposite sides relative to the stated angle.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Sign: decide the quadrant before writing the final component values.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Reconstruct: perpendicular components must satisfy A²=Aₓ²+Aᵧ².</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. A 10 N vector is 30° above the negative x-axis. Aₓ = -10 cos30° = -5√3 N Aᵧ = +10 sin30° = +5 N.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not memorize “cosine means x”. If the angle is measured from the y-axis, the y-component may be the adjacent side instead.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">A vector has Aₓ=-6 and Aᵧ=+8. Which quadrant?</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">Quadrant II; magnitude 10.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 04: VECTORS 04 - Add vectors and find a resultant -->\n        <article class="content-card" id="unit-04" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 04</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 04 - Add vectors and find a resultant</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Head-to-tail geometry and component addition must agree</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-04 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Head to tail vector addition" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-va4" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-vb4" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#c084fc"/></marker>\n    <marker id="arr-vr4" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n  </defs>\n  <!-- Vector A -->\n  <line x1="80" y1="160" x2="230" y2="160" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-va4)"/>\n  <text x="155" y="180" text-anchor="middle" font-size="14" font-weight="800" fill="#38bdf8">A</text>\n  <!-- Vector B from head of A -->\n  <line x1="230" y1="160" x2="350" y2="70" stroke="#c084fc" stroke-width="3.5" marker-end="url(#arr-vb4)"/>\n  <text x="310" y="125" font-size="14" font-weight="800" fill="#c084fc">B</text>\n  <!-- Resultant R from tail of A to head of B -->\n  <line x1="80" y1="160" x2="344" y2="75" stroke="#34d399" stroke-width="4" marker-end="url(#arr-vr4)"/>\n  <text x="190" y="95" font-size="15" font-weight="800" fill="#34d399">R = A + B</text>\n  <!-- Component pill right -->\n  <rect x="380" y="60" width="130" height="90" rx="8" fill="rgba(52,211,153,0.1)" stroke="#34d399"/>\n  <text x="445" y="85" text-anchor="middle" font-size="12" font-weight="800" fill="#34d399">COMPONENTS</text>\n  <text x="445" y="112" text-anchor="middle" font-size="12" fill="currentColor">R_x = A_x + B_x</text>\n  <text x="445" y="132" text-anchor="middle" font-size="12" fill="currentColor">R_y = A_y + B_y</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Vector addition combines directional changes. Place vectors head-to-tail; the resultant runs from the first tail to the final head. In components, add x with x and y with y.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">The resultant is not the path length. Geometry and components are two views of the same addition.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Diagram route: place vectors head-to-tail and draw the closing diagonal.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Component route: Rₓ=ΣAₓ, Rᵧ=ΣAᵧ.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Magnitude: for perpendicular components, |R|=√(Rₓ²+Rᵧ²).</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Direction: use signs to fix the quadrant before using an inverse tangent.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. 9 m east then 12 m north gives R=(9,12) m. |R|=√(9²+12²)=15 m. θ=tan⁻¹(12/9)=53.1° north of east.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not add magnitudes blindly when directions differ. 9+12=21 m is the path distance, not the resultant displacement.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">A walker moves 3 m east then 4 m north.</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">5 m.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 05: VECTORS 05 - Subtract vectors and build change vectors -->\n        <article class="content-card" id="unit-05" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 05</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 05 - Subtract vectors and build change vectors</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Final minus initial is a geometric operation</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-05 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Vector subtraction and change vector" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-vi" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-vf" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-dv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#f43f5e"/></marker>\n  </defs>\n  <!-- Initial vector v_i -->\n  <line x1="120" y1="160" x2="260" y2="160" stroke="#38bdf8" stroke-width="3" marker-end="url(#arr-vi)"/>\n  <text x="190" y="180" text-anchor="middle" font-size="14" font-weight="800" fill="#38bdf8">v_initial</text>\n  <!-- Final vector v_f from common origin -->\n  <line x1="120" y1="160" x2="240" y2="60" stroke="#38bdf8" stroke-width="3" marker-end="url(#arr-vf)"/>\n  <text x="160" y="95" font-size="14" font-weight="800" fill="#38bdf8">v_final</text>\n  <!-- Change vector Delta v from head of v_i to head of v_f -->\n  <line x1="260" y1="160" x2="244" y2="68" stroke="#f43f5e" stroke-width="3.5" marker-end="url(#arr-dv)"/>\n  <text x="275" y="110" font-size="14" font-weight="800" fill="#f43f5e">Δv = v_f - v_i</text>\n  <!-- Rule banner -->\n  <rect x="330" y="70" width="170" height="70" rx="8" fill="rgba(244,63,94,0.1)" stroke="#f43f5e"/>\n  <text x="415" y="95" text-anchor="middle" font-size="12" font-weight="800" fill="#f43f5e">SUBTRACTION</text>\n  <text x="415" y="120" text-anchor="middle" font-size="12" fill="currentColor">Draw from TIP of v_i to TIP of v_f</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Vector subtraction means add the opposite: A-B=A+(-B). Changes use the same rule: Δv=v_f-v_i and Δp=p_f-p_i.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">A change vector compares two states. Equal magnitudes do not imply zero change when directions differ.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">State: draw or write the initial and final vectors from a common origin.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Reverse: subtracting a vector means reversing it before addition.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Compute: subtract corresponding components.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Interpret: the change vector has its own magnitude and direction.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. vᵢ=(6,0) m/s and v_f=(0,6) m/s. Δv=(-6,6) m/s |Δv|=√72=6√2 m/s.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not say “speed did not change, so velocity did not change”. Turning changes velocity even at constant speed.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">Velocity changes from +5 m/s to -2 m/s. What is</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">-7 m/s.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 06: VECTORS 06 - Recover magnitude and direction -->\n        <article class="content-card" id="unit-06" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 06</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 06 - Recover magnitude and direction</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Components are coordinates of the vector state</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-06 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Recovering magnitude and direction from components" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-m6" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n  </defs>\n  <!-- Base component triangle -->\n  <line x1="100" y1="160" x2="260" y2="160" stroke="#38bdf8" stroke-width="3"/>\n  <text x="180" y="180" text-anchor="middle" font-size="13" font-weight="800" fill="#38bdf8">A_x = 3</text>\n  <line x1="260" y1="160" x2="260" y2="60" stroke="#38bdf8" stroke-width="3"/>\n  <text x="290" y="115" font-size="13" font-weight="800" fill="#38bdf8">A_y = 4</text>\n  <!-- Hypotenuse Vector -->\n  <line x1="100" y1="160" x2="255" y2="64" stroke="#34d399" stroke-width="4" marker-end="url(#arr-m6)"/>\n  <text x="150" y="95" font-size="15" font-weight="800" fill="#34d399">|A| = 5</text>\n  <!-- Angle -->\n  <path d="M 140 160 A 40 40 0 0 0 133 139" fill="none" stroke="#fbbf24" stroke-width="2"/>\n  <text x="150" y="148" font-size="12" font-weight="800" fill="#fbbf24">θ = 53°</text>\n  <!-- Formulas card -->\n  <rect x="330" y="55" width="170" height="95" rx="8" fill="rgba(56,189,248,0.08)" stroke="#38bdf8"/>\n  <text x="415" y="82" text-anchor="middle" font-size="13" font-weight="800" fill="#38bdf8">RECONSTRUCTION</text>\n  <text x="415" y="110" text-anchor="middle" font-size="12" fill="currentColor">|A| = √(Ax² + Ay²)</text>\n  <text x="415" y="132" text-anchor="middle" font-size="12" fill="currentColor">tan θ = |Ay| / |Ax|</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">When Rₓ and Rᵧ are known, the magnitude follows from the component triangle. The direction needs both a reference axis and the correct quadrant.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Magnitude alone is not a complete vector answer. Report direction whenever the question asks for a vector.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Magnitude: |R|=√(Rₓ²+Rᵧ²) for perpendicular Cartesian components.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Reference angle: tan α=|Rᵧ/Rₓ|.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Quadrant: use the signs of Rₓ and Rᵧ to convert α into a physical direction.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Check: reconstruct the components from the final magnitude and direction.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. F=(9,-12) N. |F|=15 N. Reference angle = tan⁻¹(12/9)=53.1°. Signs (+,-) place it in quadrant IV: 53.1° south of east.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">A calculator inverse tangent can return only a reference angle. It cannot choose the physical quadrant for you.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">R=(-3,-4). Give magnitude and compass-style</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">5 units; 53.1° south of west.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 07: VECTORS 07 - Relative velocity -->\n        <article class="content-card" id="unit-07" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 07</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 07 - Relative velocity</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">The observer is the vector you subtract</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-07 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Relative velocity subtraction" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-car" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-rel" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n  </defs>\n  <!-- Car A -->\n  <rect x="70" y="50" width="80" height="40" rx="6" fill="rgba(56,189,248,0.2)" stroke="#38bdf8"/>\n  <text x="110" y="75" text-anchor="middle" font-size="13" font-weight="800" fill="currentColor">Car A</text>\n  <line x1="150" y1="70" x2="270" y2="70" stroke="#38bdf8" stroke-width="3" marker-end="url(#arr-car)"/>\n  <text x="210" y="60" text-anchor="middle" font-size="12" font-weight="800" fill="#38bdf8">v_A = 20 m/s</text>\n  <!-- Car B -->\n  <rect x="70" y="120" width="80" height="40" rx="6" fill="rgba(192,132,252,0.2)" stroke="#c084fc"/>\n  <text x="110" y="145" text-anchor="middle" font-size="13" font-weight="800" fill="currentColor">Car B</text>\n  <line x1="150" y1="140" x2="230" y2="140" stroke="#c084fc" stroke-width="3" marker-end="url(#arr-car)"/>\n  <text x="190" y="130" text-anchor="middle" font-size="12" font-weight="800" fill="#c084fc">v_B = 15 m/s</text>\n  <!-- Relative velocity vector -->\n  <rect x="310" y="60" width="190" height="90" rx="8" fill="rgba(52,211,153,0.1)" stroke="#34d399"/>\n  <text x="405" y="85" text-anchor="middle" font-size="13" font-weight="800" fill="#34d399">RELATIVE VELOCITY</text>\n  <line x1="340" y1="110" x2="400" y2="110" stroke="#34d399" stroke-width="3" marker-end="url(#arr-rel)"/>\n  <text x="440" y="115" font-size="12" font-weight="800" fill="#34d399">v_AB = v_A - v_B</text>\n  <text x="405" y="138" text-anchor="middle" font-size="12" fill="currentColor">= 20 - 15 = +5 m/s</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Relative velocity asks what one observer sees another object doing. “Velocity of A relative to B” means subtract the observer B from A.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Order follows the words: v_A/B = v_A - v_B. Express both velocities in the same axes before subtracting.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Name roles: object A, observer B.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Same frame: write both ground-frame velocity vectors using one coordinate system.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Subtract: component-by-component.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Special case: if A and B move together with identical velocity, v_A/B must be zero.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. Cyclist A moves east at 8 m/s and B east at 5 m/s. v_A/B = +8-(+5)=+3 m/s: A moves 3 m/s east relative to B.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not reverse the order. v_A/B and v_B/A are opposites.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">If A and B have identical velocity vectors, what is</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">0.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 08: VECTORS 08 - Tangent and radial directions -->\n        <article class="content-card" id="unit-08" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 08</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 08 - Tangent and radial directions</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Circular motion separates velocity direction from acceleration direction</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-08 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Tangent velocity and radial acceleration" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-tan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n    <marker id="arr-rad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#ef4444"/></marker>\n  </defs>\n  <!-- Circle path -->\n  <circle cx="270" cy="120" r="70" fill="none" stroke="var(--border,#475569)" stroke-width="2" stroke-dasharray="4 4"/>\n  <circle cx="270" cy="120" r="4" fill="currentColor"/>\n  <text x="270" y="140" text-anchor="middle" font-size="11" fill="var(--text-secondary,#94a3b8)">Center</text>\n  <!-- Particle at top -->\n  <circle cx="270" cy="50" r="7" fill="#38bdf8"/>\n  <!-- Tangent velocity -->\n  <line x1="270" y1="50" x2="360" y2="50" stroke="#34d399" stroke-width="3.5" marker-end="url(#arr-tan)"/>\n  <text x="320" y="40" font-size="13" font-weight="800" fill="#34d399">v_t (Tangent)</text>\n  <!-- Inward radial acceleration -->\n  <line x1="270" y1="50" x2="270" y2="95" stroke="#ef4444" stroke-width="3.5" marker-end="url(#arr-rad)"/>\n  <text x="280" y="80" font-size="13" font-weight="800" fill="#ef4444">a_c (Radial)</text>\n  <!-- 90 degree angle indicator -->\n  <rect x="270" y="50" width="10" height="10" fill="none" stroke="currentColor"/>\n  <!-- Callout left -->\n  <rect x="60" y="70" width="150" height="70" rx="8" fill="rgba(56,189,248,0.08)" stroke="#38bdf8"/>\n  <text x="135" y="95" text-anchor="middle" font-size="12" font-weight="800" fill="#38bdf8">ORTHOGONAL</text>\n  <text x="135" y="115" text-anchor="middle" font-size="12" fill="currentColor">v_t ⊥ a_c at all times</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">At any point on a circular path, instantaneous velocity is tangent to the path. Centripetal acceleration points radially inward toward the centre.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Constant speed does not mean constant velocity. Direction changes continuously, so the velocity vector changes and acceleration is nonzero.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Draw: mark the radius from the particle to the centre.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Velocity: draw a tangent perpendicular to the radius.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Acceleration: point inward along the radius.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Release: if the inward constraint disappears, the object initially continues along the tangent.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. At the rightmost point of a circle, acceleration points left toward the centre. Velocity is vertical along the tangent; up/down depends on the direction of travel.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not draw the release direction radially outward. “Centrifugal” is not the instantaneous velocity direction in an inertial frame.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">A stone moves clockwise. At the top of the circle</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">Rightward along the tangent.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 09: VECTORS 09 - Interaction pairs and body ownership -->\n        <article class="content-card" id="unit-09" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 09</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 09 - Interaction pairs and body ownership</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">Equal-and-opposite forces can act on different bodies</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-09 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Interaction pairs and body ownership" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-fb" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#c084fc"/></marker>\n  </defs>\n  <!-- Floor -->\n  <line x1="60" y1="160" x2="480" y2="160" stroke="var(--border,#334155)" stroke-width="2"/>\n  <!-- Block A -->\n  <rect x="140" y="80" width="80" height="80" rx="6" fill="rgba(56,189,248,0.15)" stroke="#38bdf8" stroke-width="2"/>\n  <text x="180" y="125" text-anchor="middle" font-size="18" font-weight="800" fill="#38bdf8">A</text>\n  <!-- Block B -->\n  <rect x="250" y="80" width="100" height="80" rx="6" fill="rgba(192,132,252,0.15)" stroke="#c084fc" stroke-width="2"/>\n  <text x="300" y="125" text-anchor="middle" font-size="18" font-weight="800" fill="#c084fc">B</text>\n  <!-- Contact force on B by A -->\n  <line x1="250" y1="120" x2="320" y2="120" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-fa)"/>\n  <text x="285" y="105" text-anchor="middle" font-size="11" font-weight="800" fill="#38bdf8">F_BA</text>\n  <!-- Contact force on A by B -->\n  <line x1="220" y1="120" x2="150" y2="120" stroke="#c084fc" stroke-width="3.5" marker-end="url(#arr-fb)"/>\n  <text x="185" y="105" text-anchor="middle" font-size="11" font-weight="800" fill="#c084fc">F_AB</text>\n  <!-- Bottom rule -->\n  <text x="270" y="195" text-anchor="middle" font-size="13" font-weight="800" fill="var(--accent,#38bdf8)">Different bodies: F_AB acts on A, F_BA acts on B</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Newton-III pairs are vector pairs with equal magnitude and opposite direction, but they act on different bodies. Net-force equations contain only forces acting on the chosen body.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Body ownership prevents false cancellation. Always label force as “A on B”.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Choose body: decide whose force diagram you are drawing.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Name interaction: table on book, book on table, Earth on book, etc.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Pair: F_A on B = -F_B on A.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Net force: only sum forces acting on the same chosen body.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. The normal force of the table on the book and the normal force of the book on the table form a third-law pair. They do not cancel on the book because only one of them acts on the book.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Weight and normal may balance on a resting book, but they are not a Newton-III pair because both act on the same body.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">Can forces acting on different bodies cancel in</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">No.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 10: VECTORS 10 - Angle between vectors and work -->\n        <article class="content-card" id="unit-10" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 10</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 10 - Angle between vectors and work</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">The angle between force and displacement controls the sign</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-10 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Angle between vectors controls work done" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-f10" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n    <marker id="arr-d10" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#34d399"/></marker>\n  </defs>\n  <!-- Ground -->\n  <line x1="60" y1="160" x2="480" y2="160" stroke="var(--border,#334155)" stroke-width="2"/>\n  <!-- Crate -->\n  <rect x="120" y="110" width="70" height="50" rx="6" fill="rgba(56,189,248,0.12)" stroke="#38bdf8"/>\n  <!-- Displacement vector -->\n  <line x1="190" y1="135" x2="340" y2="135" stroke="#34d399" stroke-width="3.5" marker-end="url(#arr-d10)"/>\n  <text x="265" y="152" text-anchor="middle" font-size="13" font-weight="800" fill="#34d399">Δr (Displacement)</text>\n  <!-- Pulling force at angle theta -->\n  <line x1="190" y1="135" x2="290" y2="55" stroke="#38bdf8" stroke-width="3.5" marker-end="url(#arr-f10)"/>\n  <text x="260" y="70" font-size="14" font-weight="800" fill="#38bdf8">F</text>\n  <!-- Angle arc -->\n  <path d="M 230 135 A 40 40 0 0 0 220 111" fill="none" stroke="#fbbf24" stroke-width="2"/>\n  <text x="238" y="125" font-size="12" font-weight="800" fill="#fbbf24">θ</text>\n  <!-- Work formula -->\n  <rect x="360" y="65" width="140" height="70" rx="8" fill="rgba(52,211,153,0.1)" stroke="#34d399"/>\n  <text x="430" y="92" text-anchor="middle" font-size="12" font-weight="800" fill="#34d399">DOT PRODUCT</text>\n  <text x="430" y="118" text-anchor="middle" font-size="13" font-weight="700" fill="currentColor">W = F · Δr · cos θ</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Work is a scalar built from two vectors. Its sign depends on the angle between force and displacement: parallel gives positive work; opposite gives negative work.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Read the angle from the physical arrows before using the equation.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Represent: draw F and s from a common reference.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Angle: identify θ between the vectors.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Relation: W=Fs cosθ.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Checks: θ=0° gives +Fs, θ=90° gives 0, θ=180° gives -Fs.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. A 200 N braking force acts opposite a 15 m displacement. θ=180° W=(200)(15)cos180°=-3000 J.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not infer the work sign from the word “force” alone. Direction relative to displacement decides the sign.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">If force is perpendicular to displacement, what</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">0 J.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n    \n\n        <!-- Unit 11: VECTORS 11 - Bridge to Motion in 2D -->\n        <article class="content-card" id="unit-11" style="margin-bottom: 28px; border: 1.5px solid var(--border); border-radius: var(--tab12-radius-md); padding: 24px; background: var(--bg-card);">\n          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:12px;">\n            <div>\n              <span class="q-badge" style="background:rgba(56,189,248,0.15); border:1px solid var(--accent); color:var(--accent); font-weight:800; font-size:12px; padding:4px 10px; border-radius:999px;">Concept Unit 11</span>\n              <h2 style="font-size:20px; font-weight:700; margin:8px 0 4px; color:var(--text-primary);">VECTORS 11 - Bridge to Motion in 2D</h2>\n              <p style="font-size:14px; color:var(--accent); font-weight:600; margin:0;">One vector state becomes two component equations</p>\n            </div>\n            <span class="tag-pill" style="font-size:12px; font-weight:700; background:rgba(192,132,252,0.15); border:1px solid var(--purple); color:var(--purple);">VEC-11 · Core 1</span>\n          </div>\n\n          <!-- Publication-grade Diagram -->\n          <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:var(--tab12-radius-sm); padding:16px; margin-bottom:20px;">\n            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" role="img" aria-label="Bridge to Motion in 2D orthogonal axes" style="width:100%;max-width:540px;height:auto;display:block;margin:12px auto;">\n  <defs>\n    <marker id="arr-pj" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#38bdf8"/></marker>\n  </defs>\n  <!-- Ground -->\n  <line x1="50" y1="170" x2="480" y2="170" stroke="var(--border,#334155)" stroke-width="2"/>\n  <!-- Parabolic arc -->\n  <path d="M 80 170 Q 230 20 380 170" fill="none" stroke="#38bdf8" stroke-width="3" stroke-dasharray="6 4"/>\n  <!-- Launch vector -->\n  <line x1="80" y1="170" x2="160" y2="90" stroke="#34d399" stroke-width="3.5" marker-end="url(#arr-pj)"/>\n  <text x="110" y="110" font-size="13" font-weight="800" fill="#34d399">u</text>\n  <!-- Apex -->\n  <circle cx="230" cy="58" r="5" fill="#fbbf24"/>\n  <text x="230" y="45" text-anchor="middle" font-size="11" font-weight="700" fill="#fbbf24">Apex (v_y = 0)</text>\n  <!-- Orthogonal equation cards -->\n  <rect x="380" y="45" width="140" height="50" rx="6" fill="rgba(56,189,248,0.12)" stroke="#38bdf8"/>\n  <text x="450" y="66" text-anchor="middle" font-size="11" font-weight="800" fill="#38bdf8">X: a_x = 0</text>\n  <text x="450" y="84" text-anchor="middle" font-size="11" fill="currentColor">x(t) = (u cos θ) t</text>\n  <rect x="380" y="105" width="140" height="50" rx="6" fill="rgba(52,211,153,0.12)" stroke="#34d399"/>\n  <text x="450" y="126" text-anchor="middle" font-size="11" font-weight="800" fill="#34d399">Y: a_y = -g</text>\n  <text x="450" y="144" text-anchor="middle" font-size="11" fill="currentColor">y(t) = u_y t - ½gt²</text>\n</svg>\n          </div>\n\n          <!-- Dual explanation grid -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:18px; margin-bottom:20px;">\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--accent); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--accent); margin-bottom:6px;">What is happening?</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">Motion in a plane becomes manageable when position, velocity and acceleration are split into x and y components. The components share the same time but may evolve differently.</p>\n            </div>\n            <div style="background:var(--bg-card-subtle); border-left:4px solid var(--success); padding:14px 16px; border-radius:0 var(--tab12-radius-sm) var(--tab12-radius-sm) 0;">\n              <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">Key Idea</h4>\n              <p style="font-size:14.5px; line-height:1.6; margin:0; color:var(--text-primary);">The component method is the bridge: represent the vector state first, then solve each axis, then reconstruct the final vector if needed.</p>\n            </div>\n          </div>\n\n          <!-- How it works numbered sequence -->\n          <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border-light); border-radius:var(--tab12-radius-sm); padding:16px 20px; margin-bottom:20px;">\n            <h4 style="font-size:14px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); margin-bottom:10px;">How It Works</h4>\n            <ol style="margin:0; padding-left:22px; display:grid; gap:8px;">\n              <li style="font-size:14px; line-height:1.5; color:var(--text-primary);">State: v=vₓ i+vᵧ j.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Separate: write one equation for x and one for y.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Shared clock: the same time variable belongs to both component motions.</li><li style="font-size:14px; line-height:1.5; color:var(--text-primary);">Reconstruct: speed = √(vₓ²+vᵧ²); direction comes from the component ratio and quadrant.</li>\n            </ol>\n          </div>\n\n          <!-- Work the Idea: Worked Example -->\n          <div style="border:1px solid var(--border); border-radius:var(--tab12-radius-sm); overflow:hidden; margin-bottom:16px; background:var(--bg-card-subtle);">\n            <div style="background:rgba(56,189,248,0.08); padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px;">\n              <span style="font-weight:800; font-size:13px; color:var(--accent);">⚡ WORKED EXAMPLE</span>\n            </div>\n            <div style="padding:14px 16px; font-size:14.5px; line-height:1.6;">\n              Example. vₓ=6 m/s, vᵧ=8 m/s. speed = √(6²+8²)=10 m/s. Direction = tan⁻¹(8/6)=53.1° above +x.\n            </div>\n          </div>\n\n          <!-- Watch out & Quick Check -->\n          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">\n            <div style="background:rgba(245,158,11,0.08); border:1px solid var(--warning); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--warning); margin-bottom:6px;">⚠️ Watch Out</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0; color:var(--text-primary);">Do not solve x and y with different times for the same physical instant.</p>\n            </div>\n            <div style="background:rgba(52,211,153,0.08); border:1px solid var(--success); border-radius:var(--tab12-radius-sm); padding:14px 16px;">\n              <h4 style="font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--success); margin-bottom:6px;">✅ Quick Check</h4>\n              <p style="font-size:14px; line-height:1.5; margin:0 0 6px; color:var(--text-primary);">If vₓ=0 and vᵧ<0, which way does the velocity</p>\n              <details style="margin-top:6px; cursor:pointer;">\n                <summary style="font-size:13px; font-weight:700; color:var(--success); padding:4px 0;">Reveal Answer</summary>\n                <div style="padding-top:6px; font-size:13.5px; font-weight:600; color:var(--text-primary);">Straight downward.</div>\n              </details>\n            </div>\n          </div>\n        </article>\n      </div>\n\n      <div id="tab-challenges" class="tab-content">\n        <div class="content-card" style="border: 2px solid var(--accent); background: linear-gradient(180deg, rgba(56, 189, 248, 0.08), var(--bg-card));">\n          <h2><span>🎯</span> Core 2 Vector Challenges (29 Questions)</h2>\n          <p style="font-size: 15px; color: var(--text-secondary); margin-bottom: 16px;">\n            Master campus routes, return trajectories, missing components, and multi-vector polygons. Fully integrated into the canonical Question Bank with multi-rung hint ladders and step-by-step methods.\n          </p>\n          <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">\n            <a class="btn" href="../../question-bank/index.html?subject=Physics&topic=vectors&mode=study" style="background: var(--accent); color: #080d1a; font-weight: 800; text-decoration: none; padding: 12px 22px; border-radius: var(--tab12-radius-sm); display: inline-flex; align-items: center; gap: 8px;">\n              <span>🎯</span> Practice All Vector Challenges in Question Bank →\n            </a>\n            <a class="btn" href="../../question-bank/index.html?subject=Physics&topic=vectors" style="background: var(--bg-card-subtle); color: var(--text-primary); border: 1px solid var(--border); text-decoration: none; padding: 12px 18px; border-radius: var(--tab12-radius-sm); font-weight: 600;">\n              Browse Vector Question Bank\n            </a>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Support Rail -->\n    <aside class="support-rail">\n            <!-- Concept Navigation Widget -->\n      <div class="support-widget">\n        <h3><span>📑</span> Concept Units (01–11)</h3>\n        <div style="display:flex; flex-direction:column; gap:6px;">\n          <a href="#unit-01" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>01</strong> Scalars, Vectors &amp; Sign</a>\n          <a href="#unit-02" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>02</strong> Draw, Compare &amp; Reverse</a>\n          <a href="#unit-03" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>03</strong> Components &amp; Quadrants</a>\n          <a href="#unit-04" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>04</strong> Vector Addition &amp; Resultant</a>\n          <a href="#unit-05" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>05</strong> Vector Subtraction &amp; Change</a>\n          <a href="#unit-06" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>06</strong> Recover Mag &amp; Direction</a>\n          <a href="#unit-07" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>07</strong> Relative Velocity Frame</a>\n          <a href="#unit-08" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>08</strong> Tangent &amp; Radial Vectors</a>\n          <a href="#unit-09" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>09</strong> Interaction Pairs Ownership</a>\n          <a href="#unit-10" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>10</strong> Vector Angle &amp; Work Done</a>\n          <a href="#unit-11" class="btn" style="min-height:36px; padding:6px 10px; font-size:12px; text-decoration:none; background:var(--bg-surface); border:1px solid var(--border); color:var(--text-primary); text-align:left; border-radius:6px; display:flex; align-items:center; gap:6px;"><strong>11</strong> Bridge to 2D Planar Motion</a>\n        </div>\n      </div>\n\n      \n      <div class="support-widget">\n        <h3><span>⚡</span> Vector Formulas</h3>\n        <div class="formula-box" style="font-size: 13.5px; line-height: 1.6;">\n          <div>\\(R = \\sqrt{A^2 + B^2 + 2AB\\cos\\theta}\\)</div>\n          <div>\\(\\tan\\alpha = \\frac{B\\sin\\theta}{A + B\\cos\\theta}\\)</div>\n          <div>\\(\\vec{A} \\cdot \\vec{B} = A_x B_x + A_y B_y\\)</div>\n          <div>\\(\\cos^2\\alpha + \\cos^2\\beta + \\cos^2\\gamma = 1\\)</div>\n        </div>\n      </div>\n\n      <!-- Interactive 2-Vector Resultant Solver -->\n      <div class="support-widget">\n        <h3><span>🧮</span> 2-Vector Resultant Solver</h3>\n        <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 10px;">\n          Enter vector magnitudes and angle θ between them:\n        </p>\n        <div class="calc-row">\n          <div class="calc-input-group">\n            <label>Mag |A|:</label>\n            <input type="number" id="vecA" value="3.0" step="0.5" oninput="solveVectors()">\n          </div>\n          <div class="calc-input-group">\n            <label>Mag |B|:</label>\n            <input type="number" id="vecB" value="4.0" step="0.5" oninput="solveVectors()">\n          </div>\n        </div>\n        <div class="calc-row">\n          <div class="calc-input-group" style="grid-column: span 2;">\n            <label>Angle θ (degrees):</label>\n            <input type="number" id="vecTheta" value="90" step="5" oninput="solveVectors()">\n          </div>\n        </div>\n        <div class="calc-result" id="vecResult">\n          |R| = 5.00 | α = 53.13°\n        </div>\n      </div>\n\n      <!-- Virtual Keyboard Safe Scratchpad -->\n      <div class="support-widget">\n        <h3><span>📝</span> Study Scratchpad</h3>\n        <p style="font-size: 13.5px; color: var(--text-secondary); margin-bottom: 8px;">\n          Virtual keyboard safe (min-height: 120px) with auto-saving:\n        </p>\n        <textarea id="scratchpadNotes" class="tablet-safe-input" placeholder="Resolve components Ax, Ay, write closure equations, or compute cross products..."></textarea>\n        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">\n          <span id="saveStatus" style="font-size: 12.5px; color: var(--success);">✓ Auto-saved</span>\n          <button class="btn" style="min-height: 48px; padding: 6px 14px; font-size: 13px; background: var(--bg-surface); border: 1px solid var(--border);" onclick="clearNotes()">Clear</button>\n        </div>\n      </div>\n\n    </aside>\n\n  </main>\n\n  <script>\n    function switchTab(tabId) {\n      document.querySelectorAll(\'.tab-btn\').forEach(b => b.classList.remove(\'active\'));\n      document.querySelectorAll(\'.tab-content\').forEach(c => c.classList.remove(\'active\'));\n      const activeBtn = Array.from(document.querySelectorAll(\'.tab-btn\')).find(b => b.getAttribute(\'onclick\').includes(tabId));\n      if (activeBtn) activeBtn.classList.add(\'active\');\n      const targetContent = document.getElementById(tabId);\n      if (targetContent) targetContent.classList.add(\'active\');\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n    }\n\n    const themeBtn = document.getElementById(\'themeToggle\');\n    const htmlEl = document.documentElement;\n    const savedTheme = localStorage.getItem(\'tablet12_theme\') || \'dark\';\n    htmlEl.setAttribute(\'data-theme\', savedTheme);\n    themeBtn.addEventListener(\'click\', () => {\n      const current = htmlEl.getAttribute(\'data-theme\');\n      const next = current === \'dark\' ? \'light\' : \'dark\';\n      htmlEl.setAttribute(\'data-theme\', next);\n      localStorage.setItem(\'tablet12_theme\', next);\n    });\n\n    const pad = document.getElementById(\'scratchpadNotes\');\n    const status = document.getElementById(\'saveStatus\');\n    pad.value = localStorage.getItem(\'vectors_tablet_notes\') || \'\';\n    pad.addEventListener(\'input\', () => {\n      localStorage.setItem(\'vectors_tablet_notes\', pad.value);\n      status.textContent = \'✓ Saved \' + new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' });\n    });\n\n    function clearNotes() {\n      if (confirm(\'Clear scratchpad notes?\')) {\n        pad.value = \'\';\n        localStorage.removeItem(\'vectors_tablet_notes\');\n        status.textContent = \'Notes cleared\';\n      }\n    }\n\n    function solveVectors() {\n      const A = parseFloat(document.getElementById(\'vecA\').value) || 0;\n      const B = parseFloat(document.getElementById(\'vecB\').value) || 0;\n      const deg = parseFloat(document.getElementById(\'vecTheta\').value) || 0;\n      const rad = deg * Math.PI / 180;\n      const R = Math.sqrt(A * A + B * B + 2 * A * B * Math.cos(rad));\n      const alphaRad = Math.atan2(B * Math.sin(rad), A + B * Math.cos(rad));\n      const alphaDeg = alphaRad * 180 / Math.PI;\n      document.getElementById(\'vecResult\').textContent = `|R| = ${R.toFixed(2)} | α = ${alphaDeg.toFixed(2)}°`;\n    }\n    solveVectors();\n  </script>\n<script id="pr375-u4-remediation-script">\n(() => {\n  const humanize = (value) => String(value || \'\')\n    .replace(/([a-z0-9])([A-Z])/g, \'$1 $2\')\n    .replace(/[_-]+/g, \' \')\n    .replace(/\\b(vec)([ab])\\b/gi, \'vector $2\')\n    .replace(/\\bproj\\b/gi, \'projectile\')\n    .replace(/\\s+/g, \' \')\n    .trim();\n\n  const explicitNames = {\n    mass1: \'Mass m1 in kilograms\', mass2: \'Mass m2 in kilograms\',\n    vecA: \'Vector A\', vecB: \'Vector B\',\n    projU: \'Projectile launch speed\', projAngle: \'Projectile launch angle\',\n    \'jump-select\': \'Jump to question\', search: \'Search questions\',\n    searchInput: \'Search questions\', questionSearch: \'Search questions\'\n  };\n\n  const hasLabel = (el) => {\n    if (el.getAttribute(\'aria-label\') || el.getAttribute(\'aria-labelledby\') || el.title) return true;\n    if (el.id && document.querySelector(`label[for="${CSS.escape(el.id)}"]`)) return true;\n    return !!el.closest(\'label\');\n  };\n\n  document.querySelectorAll(\'input, select, textarea\').forEach((el, index) => {\n    if (hasLabel(el)) return;\n    let name = explicitNames[el.id] || el.getAttribute(\'placeholder\') || el.getAttribute(\'name\') || el.id;\n    if (!name) {\n      const nearby = el.parentElement?.textContent?.trim();\n      if (nearby && nearby.length <= 100) name = nearby;\n    }\n    name = humanize(name) || `${el.tagName.toLowerCase()} ${index + 1}`;\n    el.setAttribute(\'aria-label\', name);\n  });\n\n  document.querySelectorAll(\'button\').forEach(btn => {\n    if (btn.textContent.trim().toLowerCase() === \'clear\') btn.classList.add(\'u4-clear-button\');\n  });\n\n  const syncOptions = () => {\n    document.querySelectorAll(\'.opt-btn\').forEach(btn => {\n      const correct = btn.classList.contains(\'selected-correct\');\n      const incorrect = btn.classList.contains(\'selected-incorrect\');\n      btn.setAttribute(\'aria-pressed\', correct || incorrect ? \'true\' : \'false\');\n      const base = btn.getAttrib