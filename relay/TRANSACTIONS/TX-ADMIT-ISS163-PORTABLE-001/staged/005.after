schema_version: relay-v3-ep
id: EP-PORTABLE-163-001
work_package: WP-PORTABLE-163
outcome:
  statement: Compile semantic workbench scenes into explicit versioned data-only portable
    packages, prove the same packages in Grade9V3, external plain-HTML and single-file
    offline hosts, and deliver Redox, long-division and integration cross-subject
    proof packages without moving learner-shell or academic-truth ownership into the
    portability layer.
basis:
  predecessor_checkpoint: CP-LEARNER-175-PRODUCTION-001
  material_base: c6f1ce51ae0631a346487609e88f544fece2fa08
  protocol_basis: reallaksh19/Common@c87cf87b313801e42ecd0fcc7d36af0d90c5f400:skills/engineering-pr-delivery-v3
  semantic_dependencies:
  - path: Shared/workbench/runtime.mjs
    reason: Delivered Core runtime supplies scene validation, semantic state and events.
  - path: Shared/workbench/semantic-workbench.mjs
    reason: Delivered Web Component supplies the detached browser UI and public theming
      boundary.
  - path: Shared/workbench/README.md
    reason: Delivered Core boundary explicitly defers portable-package and external-host
      proof to Issue 163.
  - path: tests/fixtures/workbench/arithmetic-division.json
    reason: Existing long-division semantic witness supplies a non-Physics portability
      source.
  - path: standalone/chemistry-redox-reactions-master-suite.html
    reason: Existing bespoke Redox implementation supplies migration lessons and provenance,
      not portable runtime authority.
scope:
  write:
  - Shared/portable/**
  - Shared/tools/build_portable_workbench.py
  - public/portable-workbench/**
  - standalone/portable-workbench/**
  - tests/fixtures/portable-workbench/**
  - tests/test_portable_workbench.py
  - tests/portable_workbench.test.mjs
  - tests/workbench_browser.test.mjs
  - docs/portable-workbench.md
  - docs/architecture-manifest.json
  - Shared/tools/build_manifest.py
  - Shared/tools/topic_independence_allowlist.json
  read:
  - Shared/workbench/**
  - Shared/library/**
  - Chemistry/**
  - Mathematics/**
  - Physics/**
  - public/chemistry/**
  - standalone/chemistry-redox-reactions-master-suite.html
  - tests/fixtures/workbench/**
  - tests/workbench_runtime.test.mjs
  protect:
  - Shared/workbench/**
  - Shared/library/**
  - Shared/publication_host/**
  - Shared/workbench/core-learning-**
  - Shared/tools/core_learning_**
  - Physics/**
  - Chemistry/**
  - Mathematics/**
  - public/core-learning/**
  - standalone/core-learning/**
  - agents/relay/**
  prohibit:
  - Do not add page-local learner mastery, support policy or question routing.
  - Do not put executable JavaScript inside portable scene/package data.
  - Do not create a new canonical curriculum database.
  - Do not modify delivered Core runtime merely to make a proof fixture pass.
acceptance:
- id: AC-163-PACKAGE
  statement: A validated manifest exposes component API, Transformation IR, adapter
    API and scene-package versions; incompatible or malformed packages fail closed
    with readable diagnostics and no eval/new Function.
  evidence_requirements:
  - test: python -m unittest tests.test_portable_workbench
  - test: node --test tests/portable_workbench.test.mjs
- id: AC-163-HOSTS
  statement: The same generated package works in repository static host, external
    plain-HTML host and generated single-file offline host with no network/CDN dependency
    or parent internal-DOM access.
  evidence_requirements:
  - test: browser contract covers static, external and offline hosts
- id: AC-163-CROSS-SUBJECT
  statement: Redox, long-division and integration proof packages use the same portable
    runtime/build contract without Core source edits.
  evidence_requirements:
  - test: portable package tests cover all three package ids and shared version contract
- id: AC-163-BOUNDARY
  statement: Packages contain compiled scene/adapter data and provenance only; canonical
    subject records and learner-page ownership remain outside the portability layer,
    semantic events carry no mastery interpretation, and normal layouts contain no
    authored pixel coordinates.
  evidence_requirements:
  - oracle: Shared/workbench and canonical subject paths remain unchanged.
  - test: package validation rejects executable payload fields and pixel-coordinate
      placement.
- id: AC-163-PARITY
  statement: Public/external/offline artifacts are generated from one source/build
    path and freshness is mechanically checked.
  evidence_requirements:
  - test: python Shared/tools/build_portable_workbench.py --check
- id: AC-163-REPO
  statement: Exact-head guardrails and pinned V3 validation pass with generated architecture
    metadata current.
  evidence_requirements:
  - test: guardrails and v3-relay on exact PR 192 head
quality_policy:
  level: STANDARD
  independent_review: OPTIONAL
admission_policy:
  qualification: NOT_REQUIRED
  question_policy: NONE
next:
  first_action: Implement the portable package validator/compiler and one-source generated
    hosts around the delivered Core, then add the three cross-subject proof packages
    and browser/offline/version falsifiers.
  stop_conditions:
  - Any required Shared/workbench Core source change must be justified by a generic
    runtime falsifier and split if it alters delivered Issue 162 semantics.
  - Do not absorb Issue 175 learner-page shell/composition ownership.
  - Do not treat bespoke Redox page JavaScript as canonical truth.
  - Portable scene data must remain data-only and version-fail-closed.
