{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grade9v3-test-question-validation-v1",
  "title": "Grade9V3 TEST question academic validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source_bank",
    "scope",
    "validation_kind",
    "validated_at",
    "authority_boundary",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "grade9v3-test-question-validation-v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_bank": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "validation_kind": {
      "const": "ACADEMIC_ANSWER_AND_STRUCTURE"
    },
    "validated_at": {
      "type": "string",
      "format": "date"
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_question_bank_admission",
        "atlas_rungs_enrichment",
        "note"
      ],
      "properties": {
        "production_question_bank_admission": {
          "const": false
        },
        "atlas_rungs_enrichment": {
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "original_identifier",
          "stem_sha256",
          "source_text_verification",
          "official_answer_text",
          "official_answer_locator",
          "academic_validation"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "original_identifier": {
            "type": "string",
            "minLength": 1
          },
          "stem_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_text_verification": {
            "const": "TEXT_VERIFIED_AGAINST_OFFICIAL"
          },
          "official_answer_text": {
            "type": "string",
            "minLength": 1
          },
          "official_answer_locator": {
            "type": "string",
            "minLength": 1
          },
          "academic_validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "independent_result",
              "reasoning",
              "admission_eligible"
            ],
            "properties": {
              "status": {
                "enum": ["PASS", "HOLD", "FAIL"]
              },
              "independent_result": {
                "type": "string",
                "minLength": 1
              },
              "reasoning": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "admission_eligible": {
                "type": "boolean"
              },
              "convention_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
