      "title": "Position measured from the other object",
      "intrinsic_badge": "HARD",
      "inferential_jump": "Replace two positions from an origin by the displacement from B to A.",
      "entry_assumptions": [
        "Signed coordinate-pair arithmetic is available or bridged."
      ],
      "teaching_path": [
        {
          "id": "RP-1",
          "action": "Follow the path origin → B → A.",
          "why_valid": "Vector displacements add along consecutive paths.",
          "inputs": [],
          "output": "r_A = r_B + r_A/B",
          "role": "TRANSFORM"
        },
        {
          "id": "RP-2",
          "action": "Subtract r_B from both sides.",
          "why_valid": "Apply the same vector operation to both sides.",
          "inputs": [],
          "output": "r_A/B = r_A - r_B",
          "role": "TRANSFORM"
        }
      ],
      "elicitation": null,
      "misconceptions": [
        {
          "wrong_idea": "Subtract whichever coordinate appears first in the question.",
          "diagnostic_prompt": "Which displacement carries you from B to A?",
          "repair": "Draw origin → B → A and reconstruct r_A = r_B + r_A/B before subtracting."
        }
      ],
      "representation_refs": [],
      "representations": [],
      "relation_checks": [
        "If A and B occupy the same point, r_A/B is zero.",
        "Reversing A and B reverses the vector."
      ],
      "exit_task": {
        "prompt": "At one instant A is at (7,2) m and B at (3,5) m. Give A relative to B and explain the signs.",
        "source_ref": "SRC-AUTHOR",
        "answer": {
          "kind": "MODEL_RESPONSE",
          "summary": "(4,-3) m: 4 m east and 3 m south from B.",
          "reasoning": [
            "Subtract the same-time coordinates of B from A.",
            "The negative north component means south."
          ],
          "check": "Add (4,-3) to B=(3,5); recover A=(7,2).",
          "acceptable_alternatives": [],
          "subpart_answers": [],
          "verification_status": "CHECKED_BY_AUTHOR"
        },
