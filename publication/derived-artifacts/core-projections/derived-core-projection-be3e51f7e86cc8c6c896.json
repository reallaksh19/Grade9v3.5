        }
      },
      "worked_anchors": [
        {
          "question_ref": "Q-AUTHOR-REL-01",
          "stem": "In a common east/north frame, A moves at (6,0) m/s and B at (0,8) m/s. Find the velocity of A relative to B. State its direction and magnitude.",
          "figure_refs": [
            "REP-REL-VECTOR"
          ],
          "answer": {
            "summary": "(6,-8) m/s, southeast; magnitude 10 m/s.",
            "reasoning": [
              "Subtract (0,8) from (6,0).",
              "The southward component is 8 m/s and eastward component 6 m/s.",
              "Using a right triangle, magnitude is sqrt(36+64)=10 m/s."
            ],
            "check": "Over one second the relative displacement changes by (6,-8) m; reversing the observer gives (-6,8) m/s."
          }
        }
      ]
