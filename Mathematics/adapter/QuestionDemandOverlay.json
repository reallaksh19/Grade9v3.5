{
  "schema_version": "1.0.0",
  "subject": "Mathematics",
  "purpose": "Subject manifestations for the shared 28-cell Difficulty × Demand matrix; this file defines no additional matrix cells.",
  "representation_kinds": ["NUMBER_LINE", "COORDINATE_PLANE", "FUNCTION_GRAPH", "GEOMETRIC_CONSTRUCTION", "TABLE", "TREE_DIAGRAM", "ALGEBRAIC_STATE", "PROOF_DIAGRAM"],
  "demand_overlays": {
    "RCL": {"manifestations":["definition, theorem or property recall","recognize standard form or identity"],"misconceptions":["theorem recalled without hypotheses","definition replaced by an example"],"preferred_strategies":["CONTRAST_CASE","REVERSE_RETRIEVAL"]},
    "CON": {"manifestations":["explain why a property holds","interpret parameter, domain or structure"],"misconceptions":["symbol manipulation without meaning","example mistaken for definition","domain restriction ignored"],"preferred_strategies":["CONTRAST_CASE","BOUNDARY_CASE"]},
    "REP": {"manifestations":["equation to graph","words to algebra","geometry to coordinates","table to pattern"],"misconceptions":["axis or scale misread","geometric invariant lost in algebraic translation","point, length and slope conflated"],"preferred_strategies":["REVERSE_TRANSLATION","CORRESPONDENCE_CHECK"]},
    "PRC": {"manifestations":["algebraic manipulation","construction algorithm","calculation and procedural fluency"],"misconceptions":["illegal cancellation","sign or distributive error","operation applied outside domain"],"preferred_strategies":["SUBSTITUTION_BACK","CORRESPONDENCE_CHECK"]},
    "MOD": {"manifestations":["form an equation or model from a situation","choose theorem or strategy","coordinate multiple constraints"],"misconceptions":["equation formed from surface keywords","constraint omitted","chosen theorem's hypotheses not met"],"preferred_strategies":["ASSUMPTION_CHECK","ALTERNATIVE_MODEL_CHECK","BOUNDARY_CASE"]},
    "PRF": {"manifestations":["formal proof","derivation","justify construction or result"],"misconceptions":["converse assumed","diagram appearance treated as proof","one example presented as proof"],"preferred_strategies":["COUNTEREXAMPLE_BOUNDARY","REVERSE_CHAIN_CHECK"]},
    "EVD": {"manifestations":["statistics or data interpretation","probability experiment or sample reasoning","judge conclusion from graph or table"],"misconceptions":["sample frequency treated as exact probability","correlation treated as causation","scale or truncated axis ignored"],"preferred_strategies":["DATA_CONSISTENCY","UNCERTAINTY_CHECK","ALTERNATIVE_EXPLANATION"]}
  }
}
